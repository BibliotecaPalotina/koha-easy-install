validate_elasticsearch() {
    local e="$1" pend docs bibs
    if ! dpkg -s elasticsearch >/dev/null 2>&1 && ! dpkg -s koha-elasticsearch >/dev/null 2>&1; then
        [ "$e" = "Elasticsearch" ] \
            && v_fail "Elasticsearch: $(t "selected in Koha but package is missing")." \
            || v_warn "Elasticsearch: $(t "not installed (fine, current engine is Zebra)")."
        return 0
    fi

    if systemctl is-active --quiet elasticsearch; then
        v_ok "Elasticsearch: $(t "service active")."
    else
        [ "$e" = "Elasticsearch" ] \
            && v_fail "Elasticsearch: $(t "service INACTIVE")." \
            || v_warn "Elasticsearch: $(t "installed but inactive")."
    fi

    if curl -sS --max-time 5 http://127.0.0.1:9200/ >/dev/null 2>&1; then
        v_ok "Elasticsearch: API 9200 $(t "responded")."
    elif [ "$e" = "Elasticsearch" ]; then
        v_fail "Elasticsearch: API 9200 $(t "no response")."
    fi

    [ "$e" = "Elasticsearch" ] || return 0

    is_koha_es_active_in_xml \
        && v_ok "Koha: $(t "<elasticsearch> block present in koha-conf.xml")." \
        || v_fail "Koha: $(t "<elasticsearch> block MISSING (the indexer will not start)")."

    curl -sS --max-time 5 "http://127.0.0.1:9200/_cat/indices/${DB_NAME}_*?format=json" 2>/dev/null | grep -q "${DB_NAME}_" \
        && v_ok "Elasticsearch: $(t "Koha indices found")." \
        || v_warn "Elasticsearch: $(t "Koha indices unconfirmed")."

    if is_koha_indexer_running; then
        v_ok "Indexer: koha-es-indexer $(t "running")."
    else
        v_fail "Indexer: koha-es-indexer $(t "STOPPED - new records will not reach search")."
    fi

    [ -f /etc/systemd/system/koha-es-indexer@.service ] \
        && v_ok "Indexer: $(t "systemd unit installed (auto-restart)")." \
        || v_warn "Indexer: $(t "no dedicated systemd unit")."

    ss -lnt 2>/dev/null | grep -q ':61613' \
        && v_ok "Broker: RabbitMQ/STOMP (61613) OK." \
        || v_warn "Broker: $(t "no RabbitMQ; Koha will read the queue straight from the database")."

    pend=$(get_pending_es_jobs)
    if [ "${pend:-0}" -eq 0 ] 2>/dev/null; then
        v_ok "Queue: $(t "no pending indexing jobs")."
    elif [ "${pend:-0}" -le 20 ] 2>/dev/null; then
        v_warn "Queue: $pend $(t "pending job(s)")."
    else
        v_fail "Queue: $pend $(t "pending jobs - the indexer is not consuming")."
    fi

    bibs=$(get_total_biblios); docs=$(get_total_es_documents)
    if [[ "$bibs" =~ ^[0-9]+$ ]] && [[ "$docs" =~ ^[0-9]+$ ]]; then
        if [ "$docs" -ge "$bibs" ]; then
            v_ok "Coverage: $docs $(t "documents for") $bibs $(t "records")."
        else
            v_warn "Coverage: $docs/$bibs ($(t "missing") $((bibs-docs)))."
        fi
    fi
}

