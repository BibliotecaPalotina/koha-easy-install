write_backup_config() {
    [ -f "$BACKUP_CONF" ] && return 0
    cat > "$BACKUP_CONF" << 'EOF'
# Configuração dos backups do Koha / Koha backup settings.
RCLONE_REMOTE=""
RCLONE_SQL_FOLDER="Backup_SQL_Koha"
RCLONE_MARC_FOLDER="Backup_MARC_Koha"
KEEP_DAYS=7
EOF
    chmod 600 "$BACKUP_CONF"
}

write_scp_backup_config() {
    [ -f "$SCP_BACKUP_CONF" ] && return 0
    cat > "$SCP_BACKUP_CONF" << 'EOF'
# Configuração do backup automático via SCP (sem rclone).
# Configuration for automatic SCP backup (without rclone).
SCP_HOST=""
SCP_USER=""
SCP_PORT="22"
SCP_FOLDER=""
SCP_KEY="/root/.ssh/koha_backup_ed25519"
EOF
    chmod 600 "$SCP_BACKUP_CONF"
}

set_scp_config() {
    local key="$1" val="$2"
    write_scp_backup_config
    set_shell_config_value "$SCP_BACKUP_CONF" "$key" "$val"
}

write_backup_scripts() {
    mkdir -p "$DIR_SQL" "$DIR_MARC"
    write_backup_config

    cat > /root/backup_sql.sh << EOF
#!/bin/bash
# Backup do banco do Koha. Gerado pelo Koha Easy Install & Tools.
set -o pipefail
umask 077
CONF="${BACKUP_CONF}"
DB="${DB_NAME}"
DIR="${DIR_SQL}"
LOG="${LOG_DIR}/backup_sql.log"
LOCK_FILE="/var/lock/koha_backup.lock"
RCLONE_REMOTE=""; RCLONE_SQL_FOLDER="Backup_SQL_Koha"; KEEP_DAYS=7
[ -f "\$CONF" ] && . "\$CONF"
case "\${KEEP_DAYS}" in ''|*[!0-9]*) KEEP_DAYS=7;; esac

log_backup() { mkdir -p "\$(dirname "\$LOG")" "\$DIR"; printf '%s | %s\\n' "\$(date '+%F %T')" "\$*" >> "\$LOG"; }
exec 9>"\$LOCK_FILE"
if ! flock -n 9; then
    log_backup "INFO: backup SQL ignorado porque outro backup/restauracao esta em andamento"
    exit 0
fi
mkdir -p "\$DIR"

FILE="\$DIR/\${DB}_\$(date +%Y-%m-%d_%Hh%M).sql.gz"

if ! mysqldump --single-transaction --quick --routines --triggers \\
        --default-character-set=utf8mb4 "\$DB" 2>>"\$LOG" | gzip > "\$FILE"; then
    log_backup "FALHA ao gerar \$FILE"
    rm -f "\$FILE"
    exit 1
fi

if ! gzip -t "\$FILE" 2>/dev/null; then
    log_backup "FALHA: arquivo corrompido, removido: \$FILE"
    rm -f "\$FILE"
    exit 1
fi

SIZE=\$(stat -c %s "\$FILE" 2>/dev/null || echo 0)
if [ "\$SIZE" -lt 10240 ]; then
    log_backup "FALHA: backup suspeito (\$SIZE bytes), removido: \$FILE"
    rm -f "\$FILE"
    exit 1
fi
log_backup "OK: \$FILE (\$SIZE bytes)"

RCLONE_REMOTE="\$(printf '%s' "\$RCLONE_REMOTE" | xargs)"
if [ -n "\$RCLONE_REMOTE" ] && [ -f /root/.config/rclone/rclone.conf ]; then
    if ! rclone listremotes --config /root/.config/rclone/rclone.conf 2>/dev/null | grep -Fxq "\${RCLONE_REMOTE}:"; then
        log_backup "AVISO: RCLONE_REMOTE='\${RCLONE_REMOTE}' não existe no rclone.conf; upload pulado"
    elif /usr/bin/rclone --config /root/.config/rclone/rclone.conf copy "\$FILE" "\${RCLONE_REMOTE}:\${RCLONE_SQL_FOLDER}/" >>"\$LOG" 2>&1; then
        log_backup "Nuvem OK: \${RCLONE_REMOTE}:\${RCLONE_SQL_FOLDER}/"
    else
        log_backup "AVISO: envio para a nuvem falhou (cópia local preservada)"
    fi
fi

# Envio via SCP direto (sem rclone), se configurado
SCP_CONF="${CONF_DIR}/scp_backup.conf"
SCP_HOST=""; SCP_USER=""; SCP_PORT="22"; SCP_FOLDER=""; SCP_KEY=""
[ -f "\$SCP_CONF" ] && . "\$SCP_CONF"
if [ -n "\$SCP_HOST" ] && [ -n "\$SCP_USER" ] && [ -n "\$SCP_FOLDER" ]; then
    if scp -P "\$SCP_PORT" -i "\$SCP_KEY" -o BatchMode=yes -o ConnectTimeout=10 \\
           -o StrictHostKeyChecking=accept-new "\$FILE" "\${SCP_USER}@\${SCP_HOST}:\${SCP_FOLDER%/}/" >>"\$LOG" 2>&1; then
        log_backup "SCP OK: \${SCP_USER}@\${SCP_HOST}:\${SCP_FOLDER}"
    else
        log_backup "AVISO: envio via SCP falhou (copia local preservada)"
    fi
fi

find "\$DIR" -name '*.sql.gz' -mtime "+\${KEEP_DAYS}" -delete 2>/dev/null
exit 0
EOF

    cat > /root/backup_marc.sh << EOF
#!/bin/bash
# Backup dos registros MARC21 (bibliográficos e autoridades).
set -o pipefail
umask 077
CONF="${BACKUP_CONF}"
INST="${INSTANCE}"
DIR="${DIR_MARC}"
LOG="${LOG_DIR}/backup_marc.log"
LOCK_FILE="/var/lock/koha_backup.lock"
RCLONE_REMOTE=""; RCLONE_MARC_FOLDER="Backup_MARC_Koha"; KEEP_DAYS=7
[ -f "\$CONF" ] && . "\$CONF"
case "\${KEEP_DAYS}" in ''|*[!0-9]*) KEEP_DAYS=7;; esac

log_backup() { mkdir -p "\$(dirname "\$LOG")" "\$DIR"; printf '%s | %s\\n' "\$(date '+%F %T')" "\$*" >> "\$LOG"; }
exec 9>"\$LOCK_FILE"
if ! flock -n 9; then
    log_backup "INFO: backup MARC ignorado porque outro backup/restauracao esta em andamento"
    exit 0
fi
mkdir -p "\$DIR"

EXPORT_CMD="/usr/share/koha/bin/export_records.pl"
[ -f "\$EXPORT_CMD" ] || EXPORT_CMD="\$(find /usr/share/koha -name export_records.pl 2>/dev/null | head -n1)"
if [ -z "\$EXPORT_CMD" ]; then log_backup "FALHA: export_records.pl nao encontrado"; exit 1; fi

DATE=\$(date '+%Y-%m-%d_%H%M')
BIB_FILE="\$DIR/biblios_\${DATE}.mrc"
AUTH_FILE="\$DIR/authorities_\${DATE}.mrc"
PACKAGE="\$DIR/koha_marc_\${DATE}.tar.gz"

if ! /usr/sbin/koha-shell "\$INST" -c "perl \$EXPORT_CMD --record-type=bibs --format=marc --filename=\$BIB_FILE" >>"\$LOG" 2>&1; then
    log_backup "FALHA: exportacao bibliografica"; rm -f "\$BIB_FILE" "\$AUTH_FILE"; exit 1
fi
if ! /usr/sbin/koha-shell "\$INST" -c "perl \$EXPORT_CMD --record-type=auths --format=marc --filename=\$AUTH_FILE" >>"\$LOG" 2>&1; then
    log_backup "FALHA: exportacao de autoridades"; rm -f "\$BIB_FILE" "\$AUTH_FILE"; exit 1
fi

if [ ! -s "\$BIB_FILE" ]; then
    log_backup "FALHA: exportacao bibliografica vazia"
    rm -f "\$BIB_FILE" "\$AUTH_FILE"
    exit 1
fi
if [ ! -s "\$AUTH_FILE" ]; then
    log_backup "AVISO: exportacao de authorities vazia"
fi

if ! tar -czf "\$PACKAGE" -C "\$DIR" "\$(basename "\$BIB_FILE")" "\$(basename "\$AUTH_FILE")" 2>>"\$LOG"; then
    log_backup "FALHA: criacao do pacote MARC"
    rm -f "\$PACKAGE" "\$BIB_FILE" "\$AUTH_FILE"
    exit 1
fi
rm -f "\$BIB_FILE" "\$AUTH_FILE"
if ! tar -tzf "\$PACKAGE" >/dev/null 2>&1; then
    log_backup "FALHA: pacote MARC não passou no teste tar.gz"
    rm -f "\$PACKAGE"
    exit 1
fi
log_backup "OK: \$PACKAGE (\$(stat -c %s "\$PACKAGE" 2>/dev/null) bytes)"

RCLONE_REMOTE="\$(printf '%s' "\$RCLONE_REMOTE" | xargs)"
if [ -n "\$RCLONE_REMOTE" ] && [ -f /root/.config/rclone/rclone.conf ]; then
    if ! rclone listremotes --config /root/.config/rclone/rclone.conf 2>/dev/null | grep -Fxq "\${RCLONE_REMOTE}:"; then
        log_backup "AVISO: RCLONE_REMOTE='\${RCLONE_REMOTE}' não existe no rclone.conf; upload pulado"
    elif /usr/bin/rclone --config /root/.config/rclone/rclone.conf copy "\$PACKAGE" "\${RCLONE_REMOTE}:\${RCLONE_MARC_FOLDER}/" >>"\$LOG" 2>&1; then
        log_backup "Nuvem OK: \${RCLONE_REMOTE}:\${RCLONE_MARC_FOLDER}/"
    else
        log_backup "AVISO: envio para a nuvem falhou"
    fi
fi

find "\$DIR" -name 'koha_marc_*.tar.gz' -mtime "+\${KEEP_DAYS}" -delete 2>/dev/null
exit 0
EOF

    chmod 700 /root/backup_sql.sh /root/backup_marc.sh
    chown root:root /root/backup_sql.sh /root/backup_marc.sh
    if ! bash -n /root/backup_sql.sh >/dev/null 2>&1 || ! bash -n /root/backup_marc.sh >/dev/null 2>&1; then
        log "FALHA: script de backup gerado com sintaxe inválida."
        return 1
    fi
    return 0
}

write_cron_tasks() {
    local email_block=""
    if [ -f "$CRON_TASKS" ] && grep -q '^# BEGIN KOHA EMAIL NOTICES' "$CRON_TASKS"; then
        email_block=$(sed -n '/^# BEGIN KOHA EMAIL NOTICES$/,/^# END KOHA EMAIL NOTICES$/p' "$CRON_TASKS")
    fi

    cat > "$CRON_TASKS" << EOF
# ======================================================================
# KOHA EASY INSTALL & TOOLS - TAREFAS AUTOMATICAS / SCHEDULED TASKS
# ======================================================================
# COMO AJUSTAR A HORA / HOW TO CHANGE TIME
# Colunas: MINUTO HORA DIA_DO_MES MES DIA_DA_SEMANA(0=domingo) usuario comando
# Exemplo: "30 01 * * *" = todo dia as 01:30.
# ======================================================================
$CRON_PATH
MAILTO=""

30 0 * * * root /usr/bin/journalctl --vacuum-time=14d >/dev/null 2>&1
0 1 5 * * root /usr/bin/mysqlcheck --check --databases ${DB_NAME} >/dev/null 2>&1
0 5 * * * root /usr/sbin/koha-plack --restart ${INSTANCE} >/dev/null 2>&1
0 23 * * * root /bin/bash /root/backup_sql.sh >/dev/null 2>&1
0 3 * * 0 root /bin/bash /root/backup_marc.sh >/dev/null 2>&1
30 1 * * * root /usr/sbin/koha-shell ${INSTANCE} -c "/usr/share/koha/bin/cronjobs/cleanup_database.pl --sessions --sessdays 2 --zebraqueue 10" >/dev/null 2>&1
EOF

    if [ -n "$email_block" ]; then
        printf '%s\n' "$email_block" >> "$CRON_TASKS"
    else
        cat >> "$CRON_TASKS" << EOF
# BEGIN KOHA EMAIL NOTICES
0 8 * * * root /usr/sbin/koha-shell ${INSTANCE} -c "/usr/share/koha/bin/cronjobs/overdue_notices.pl -v -t" >/dev/null 2>&1
5 8 * * * root /usr/sbin/koha-shell ${INSTANCE} -c "/usr/share/koha/bin/cronjobs/process_message_queue.pl -v" >/dev/null 2>&1
# END KOHA EMAIL NOTICES
EOF
    fi

    chmod 644 "$CRON_TASKS"
    chown root:root "$CRON_TASKS"
    systemctl restart cron >/dev/null 2>&1 || true
}

