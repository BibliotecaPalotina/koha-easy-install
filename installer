funcao_backup_manual() {
    exigir_banco || return 0
    if ! backup_lock_acquire; then
        msg_info "$(t "Backup em andamento" "Backup in progress")" "$(t "Outro backup ou restauração já está em andamento. Tente novamente depois." "Another backup or restore is already running. Try again later.")" 9 72
        return 0
    fi
    msg_info "$(t "Destino do Backup" "Backup Destination")" \
"$(t "Escolha onde salvar o arquivo.\n\n  Pendrive/USB: normalmente em /media ou /mnt\n  Para baixar depois: scp root@$(ip_servidor):CAMINHO ." "Choose where to save the file.\n\n  USB drive: usually under /media or /mnt\n  To download later: scp root@$(ip_servidor):PATH .")" 12 76
    local destino
    destino=$(selecionar_diretorio "$REAL_HOME") || { backup_lock_release; return 0; }
    [ -z "$destino" ] && { backup_lock_release; return 0; }
    local alvo="${destino%/}/${DB_NAME}_manual_$(date +%Y-%m-%d_%Hh%M).sql.gz"
    clear
    caixa_explicacao "Gerando o backup..." "Generating the backup..."
    if mysqldump --single-transaction --quick --routines --triggers \
         --default-character-set=utf8mb4 "$DB_NAME" | gzip > "$alvo" && gzip -t "$alvo" 2>/dev/null; then
        log "backup manual: $alvo"
        backup_lock_release
        msg_ok "$(t "Backup gerado e verificado:\n$alvo\n\nTamanho: $(du -h "$alvo" | cut -f1)" "Backup generated and verified:\n$alvo\n\nSize: $(du -h "$alvo" | cut -f1)")" 11 76
    else
        rm -f "$alvo"
        backup_lock_release
        msg_erro "" "$(t "Falha ao gerar o backup. Verifique o espaço em disco." "Failed to generate the backup. Check the free disk space.")" 9 70
    fi
}

# ======================================================================
# 5. TESTAR O ÚLTIMO BACKUP (restauração de ensaio)
# ======================================================================
funcao_testar_backup() {
    exigir_koha || return 0
    local ultimo
    ultimo=$(find "$DIR_SQL" -name '*.sql.gz' -printf '%T@ %p\n' 2>/dev/null | sort -rn | head -n1 | cut -d' ' -f2-)
    if [ -z "$ultimo" ]; then
        msg_erro "" "$(t "Nenhum backup automático encontrado em ${DIR_SQL}." "No automatic backup found in ${DIR_SQL}.")" 9 70
        return 0
    fi
    if ! gzip -t "$ultimo" 2>/dev/null; then
        msg_erro "" "$(t "O último backup falhou no teste gzip e não será restaurado no teste." "The latest backup failed gzip validation and will not be tested.")" 9 74
        return 1
    fi
    perguntar "$(t "Testar Backup" "Test Backup")" \
"$(t "Um backup só vale se restaurar. Este teste importa o arquivo\nmais recente em um banco temporário e confere o conteúdo.\nO acervo em produção NÃO é tocado.\n\nArquivo: $(basename "$ultimo")\nData: $(date -r "$ultimo" '+%d/%m/%Y %H:%M')\n\nExecutar o teste agora?" "A backup is only worth it if it restores. This test imports the newest\nfile into a temporary database and checks it.\nProduction data is NOT touched.\n\nFile: $(basename "$ultimo")\nDate: $(date -r "$ultimo" '+%Y-%m-%d %H:%M')\n\nRun the test now?")" 17 76 || return 0
    clear
    local teste="koha_teste_restauracao"
    caixa_explicacao "Importando em banco temporário..." "Importing into a temporary database..."
    if ! mysql -e "DROP DATABASE IF EXISTS ${teste}; CREATE DATABASE ${teste} CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;" >/dev/null 2>&1; then
        msg_erro "" "$(t "Não foi possível criar o banco temporário de teste." "Could not create the temporary test database.")" 9 72
        return 1
    fi
    if ! zcat "$ultimo" | mysql "$teste"; then
        mysql -e "DROP DATABASE IF EXISTS ${teste};" >/dev/null 2>&1 || true
        msg_erro "" "$(t "O backup NÃO restaurou. Verifique o arquivo com urgência." "The backup DID NOT restore. Check the file urgently.")" 9 72
        return 1
    fi
    local tab bib usu
    tab=$(sql "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='${teste}';")
    bib=$(sql "SELECT COUNT(*) FROM ${teste}.biblio;")
    usu=$(sql "SELECT COUNT(*) FROM ${teste}.borrowers;")
    mysql -e "DROP DATABASE IF EXISTS ${teste};" >/dev/null 2>&1 || true
    log "teste de backup: $ultimo tabelas=$tab biblios=$bib"
    if [ "${tab:-0}" -gt 50 ] 2>/dev/null && [ "${bib:-0}" -ge 0 ] 2>/dev/null; then
        msg_ok "$(t "BACKUP ÍNTEGRO E RESTAURÁVEL.\n\nArquivo: $(basename "$ultimo")\nTabelas: ${tab}\nRegistros bibliográficos: ${bib}\nUsuários: ${usu}" "BACKUP IS INTACT AND RESTORABLE.\n\nFile: $(basename "$ultimo")\nTables: ${tab}\nBibliographic records: ${bib}\nPatrons: ${usu}")" 13 74
    else
        msg_erro "" "$(t "O backup importou, mas tem só ${tab} tabelas. Suspeito." "The backup imported but has only ${tab} tables. Suspicious.")" 9 72
        return 1
    fi
    return 0
}

