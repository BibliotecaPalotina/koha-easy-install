        echo ""
        echo "$(t "Como este servidor não possui navegador web, você deve autorizar" "Because this server has no web browser, you must authorize")"
        echo "$(t "a conexão a partir do seu próprio computador pessoal (Windows/Mac/Linux)." "the connection from your personal computer (Windows/Mac/Linux).")"
        echo ""
        echo "----------------------------------------------------------------------"
        echo -e "\e[1;33m$(t "PASSO 1: No seu computador pessoal, abra o PowerShell (Windows) ou Terminal (Mac/Linux)." "STEP 1: On your personal PC, open PowerShell (Windows) or Terminal (Mac/Linux).")\e[0m"
        echo "$(t "Se estiver no Windows e o 'rclone' não for reconhecido, instale com: winget install Rclone.Rclone" "If on Windows and 'rclone' is not recognized, install with: winget install Rclone.Rclone")"
        echo ""
        echo '  rclone authorize "drive"'
        echo ""
        echo "----------------------------------------------------------------------"
        echo "$(t "PASSO 2: O navegador abrirá. Faça login na conta Google da biblioteca e autorize." "STEP 2: Your browser will open. Log in with the library Google account and authorize.")"
        echo "$(t "PASSO 3: O seu computador exibirá um código extenso iniciando com '{\"' e terminando com '}'.'" "STEP 3: Your PC will print a long token string starting with '{\"' and ending with '}'.")"
        echo "----------------------------------------------------------------------"
        echo ""
        local token_input=""
        while true; do
            echo -e "\e[1;32m$(t "Cole o bloco JSON completo do token abaixo e pressione [ENTER]:" "Paste the complete token JSON string below and press [ENTER]:")\e[0m"
            read -r token_input
            token_input=$(echo "$token_input" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
            if [ -z "$token_input" ]; then
                echo -e "\n\e[1;31m[ERRO] O token não pode ser vazio. Tente novamente ou tecle Ctrl+C para cancelar.\e[0m\n"
                continue
            fi
            if [[ ! "$token_input" =~ ^\{.*\}$ ]]; then
                echo -e "\n\e[1;31m[ERRO] Formato inválido! O token deve começar com '{' e terminar com '}'. Tente novamente:\e[0m\n"
                continue
            fi
            if ! python3 -c 'import sys, json; json.loads(sys.argv[1])' "$token_input" 2>/dev/null; then
                echo -e "\n\e[1;31m[ERRO] O JSON fornecido está corrompido ou foi cortado ao copiar. Tente novamente:\e[0m\n"
                continue
            fi
            break
        done
        echo ""
        echo -e "\e[1;34m[INFO] $(t "Registrando conexão remota 'gdrive' no Rclone..." "Registering 'gdrive' remote in Rclone...")\e[0m"
        rclone config delete gdrive >/dev/null 2>&1 || true
        if rclone config create gdrive drive config_is_local false token "$token_input" --non-interactive < /dev/null >/dev/null 2>&1; then
            echo -e "\e[1;32m[OK] $(t "Conexão 'gdrive' criada com sucesso!" "'gdrive' remote successfully created!")\e[0m"
            validate_and_register_rclone "gdrive"
        else
            echo -e "\e[1;31m[ERRO] $(t "Falha ao registrar a conexão no Rclone." "Failed to register connection in Rclone.")\e[0m"
            read -r -p "$(t "Pressione [ENTER] para voltar ao menu..." "Press [ENTER] to return to menu...")"
        fi
        return 0
    else
        clear
        rclone config
        local conn_name
        conn_name=$(dialog --title "$(t "Nome da Conexão" "Remote Name")" \
            --inputbox "$(t "Digite o NOME EXATO criado no assistente do Rclone:" "Enter the EXACT NAME configured in Rclone:")" 10 70 3>&1 1>&2 2>&3) || return 0
        validate_and_register_rclone "$conn_name"
        return 0
    fi
}

# ======================================================================
# 12. CONFIGURAR BACKUP AUTOMÁTICO SCP / CONFIGURE AUTOMATIC SCP BACKUP
# ======================================================================
function_configure_automatic_scp_backup() {
    write_scp_backup_config
    local host user port folder key
    
    msg_info "$(t "Descobrir IP e Usuário" "Find IP and User")" \
"$(t "Execute no terminal/PowerShell da máquina de DESTINO:\n\nWindows (PowerShell):\nWrite-Host \"IP: \$((Get-NetRoute -DestinationPrefix '0.0.0.0/0' | Get-NetIPAddress -AddressFamily IPv4).IPAddress) | Usuario: \$env:USERNAME\"\n\nLinux:\necho \"IP: \$(ip route get 1.1.1.1 2>/dev/null | awk '{print \$7; exit}') | Usuario: \$(whoami)\"\n\nmacOS:\necho \"IP: \$(ipconfig getifaddr \$(route -n get default 2>/dev/null | awk '/interface:/{print \$2}')) | Usuario: \$(whoami)\"" \
"Run in the DESTINATION machine terminal/PowerShell:\n\nWindows (PowerShell):\nWrite-Host \"IP: \$((Get-NetRoute -DestinationPrefix '0.0.0.0/0' | Get-NetIPAddress -AddressFamily IPv4).IPAddress) | User: \$env:USERNAME\"\n\nLinux:\necho \"IP: \$(ip route get 1.1.1.1 2>/dev/null | awk '{print \$7; exit}') | User: \$(whoami)\"\n\nmacOS:\necho \"IP: \$(ipconfig getifaddr \$(route -n get default 2>/dev/null | awk '/interface:/{print \$2}')) | User: \$(whoami)\"")" 24 90

    host=$(dialog --title "$(t "Backup Automático via SCP" "Automatic SCP Backup")" \
        --inputbox "$(t "Endereço (IP ou domínio) do servidor de destino:" "Address (IP or hostname) of the destination server:")" 10 70 3>&1 1>&2 2>&3) || return 0
    [ -z "$host" ] && return 0

    user=$(dialog --title "$(t "Usuário" "Username")" \
        --inputbox "$(t "Usuário SSH no destino:" "SSH username on the destination:")" 9 60 "$REAL_USER" 3>&1 1>&2 2>&3) || return 0
    [ -z "$user" ] && return 0

    port=$(dialog --title "Porta SSH / SSH Port" \
        --inputbox "$(t "Porta SSH do destino:" "SSH port of the destination:")" 9 60 "22" 3>&1 1>&2 2>&3) || return 0
    [ -z "$port" ] && port="22"
    if ! validate_port_number "$port"; then
        msg_error "" "$(t "Porta SSH inválida. Use um número entre 1 e 65535." "Invalid SSH port. Use a number between 1 and 65535.")" 9 72
        return 1
    fi

    folder=$(dialog --title "$(t "Pasta de Destino" "Destination Folder")" \
        --inputbox "$(t "Pasta no destino onde salvar os backups (deve existir):" "Folder on the destination to save backups (must exist):")" 10 70 "/home/${user}/koha_backups" 3>&1 1>&2 2>&3) || return 0
    [ -z "$folder" ] && return 0

    key="/root/.ssh/koha_backup_ed25519"
    mkdir -p /root/.ssh && chmod 700 /root/.ssh
    if [ ! -f "$key" ]; then
        display_explanation "Gerando chave SSH dedicada para o backup..." "Generating a dedicated SSH key for backups..."
        if ! ssh-keygen -t ed25519 -f "$key" -N "" -C "koha-backup@$(hostname)" >/dev/null 2>&1; then
            msg_error "" "$(t "Não foi possível gerar a chave SSH dedicada para backup." "Could not generate the dedicated backup SSH key.")" 9 74
            return 1
        fi
    fi
    [ -s "${key}.pub" ] || { msg_error "" "$(t "A chave pública de backup não existe." "The backup public key does not exist.")" 9 70; return 1; }

    clear
    echo "======================================================================"
    echo "$(t "AUTORIZANDO A CHAVE NO SERVIDOR DE DESTINO" "AUTHORIZING THE KEY ON THE DESTINATION SERVER")"
    echo "======================================================================"
    echo "$(t "Vou tentar copiar a chave pública automaticamente. Será pedida a\nSENHA do usuário '${user}' no destino UMA VEZ (só agora)." "I will try to copy the public key automatically. The password for\nuser '${user}' on the destination will be asked ONCE (just now).")"
    echo ""
    if ssh-copy-id -p "$port" -i "${key}.pub" -o StrictHostKeyChecking=accept-new "${user}@${host}" 2>&1 | tee -a "$RUN_LOG"; then
        echo -e "\n$(t "Chave copiada com sucesso." "Key copied successfully.")"
    else
        msg_info "$(t "Copie manualmente" "Copy manually")" \
"$(t "Não foi possível copiar a chave automaticamente.\n\nCopie o conteúdo abaixo e cole no final do arquivo\n~/.ssh/authorized_keys do usuário '${user}' no destino:\n\n$(cat "${key}.pub" 2>/dev/null)" "Could not copy the key automatically.\n\nCopy the content below and paste it at the end of\n~/.ssh/authorized_keys for user '${user}' on the destination:\n\n$(cat "${key}.pub" 2>/dev/null)")" 20 78
    fi

    display_explanation "Testando a conexão sem senha..." "Testing passwordless connection..."
    local remote_folder_q; remote_folder_q=$(shell_single_quote "$folder")
    if ! ssh -p "$port" -i "$key" -o BatchMode=yes -o StrictHostKeyChecking=accept-new -o ConnectTimeout=10 \
            "${user}@${host}" "mkdir -p -- ${remote_folder_q} && echo OK" 2>>"$RUN_LOG" | grep -q OK; then
        msg_error "" "$(t "A conexão sem senha falhou. Verifique se a chave foi mesmo autorizada\nno destino e se a porta/usuário estão corretos.\n\nLog: $RUN_LOG" "Passwordless connection failed. Check that the key was really\nauthorized on the destination and that port/user are correct.\n\nLog: $RUN_LOG")" 12 76
        return 1
    fi

    if ! set_scp_config "SCP_HOST" "$host" || ! set_scp_config "SCP_USER" "$user" || \
       ! set_scp_config "SCP_PORT" "$port" || ! set_scp_config "SCP_FOLDER" "$folder" || \
       ! set_scp_config "SCP_KEY" "$key"; then
        msg_error "" "$(t "Não foi possível salvar a configuração SCP de forma segura." "Could not save SCP configuration safely.")" 9 74
        return 1
    fi
    chmod 600 "$SCP_BACKUP_CONF"

    log "backup automatico via SCP configurado: ${user}@${host}:${folder}"
    msg_ok "$(t "Backup automático via SCP configurado e testado com sucesso.\n\nDestino: ${user}@${host}:${folder}\n\nA partir de agora, o backup diário das 23h também envia uma\ncópia para lá, sem depender do rclone." "Automatic SCP backup configured and tested successfully.\n\nDestination: ${user}@${host}:${folder}\n\nFrom now on, the daily 23:00 backup also sends a copy there,\nwithout going through rclone.")" 12 78
}

# ======================================================================
# 13. TAREFAS AGENDADAS / SCHEDULED TASKS
# ======================================================================
function_manage_crons() {
    [ -f "$CRON_TASKS" ] || write_cron_tasks
    msg_info "$(t "Tarefas Agendadas" "Scheduled Tasks")" \
"$(t "O arquivo de agendamentos vai abrir no editor nano.\n\nAltere apenas os NÚMEROS das duas primeiras colunas\n(minuto e hora). Não apague a linha PATH do topo:\nsem ela as tarefas falham em silêncio.\n\nPara salvar: CTRL+O, ENTER, depois CTRL+X." \
"The schedule file will open in the nano editor.\n\nChange only the NUMBERS in the first two columns\n(minute and hour). Do not delete the PATH line at the top:\nwithout it the tasks fail silently.\n\nTo save: CTRL+O, ENTER, then CTRL+X.")" 16 76
    cp -f "$CRON_TASKS" "${CRON_TASKS}.bak" 2>/dev/null
    nano "$CRON_TASKS"
    chmod 644 "$CRON_TASKS"
    if ! grep -q '^PATH=' "$CRON_TASKS"; then
        sed -i "1i $CRON_PATH" "$CRON_TASKS"
        msg_info "$(t "Corrigido" "Fixed")" "$(t "A linha PATH tinha sido removida. Recoloquei automaticamente." "The PATH line had been removed. It was restored automatically.")" 9 70
    fi
    systemctl restart cron >/dev/null 2>&1
    msg_ok "$(t "Agendamentos atualizados.\nCópia do arquivo anterior: ${CRON_TASKS}.bak" "Schedules updated.\nPrevious file copy: ${CRON_TASKS}.bak")" 9 70
}

