validate_pre_installation() {
    local free_disk p
    v_reset "pré-instalação"
    [ "$EUID" -eq 0 ] && v_ok "Root OK." || v_fail "Root: $(t "privilégios insuficientes" "insufficient privileges")."

    if [ -r /etc/os-release ] && grep -qiE '^(ID|ID_LIKE)=.*(debian|ubuntu)' /etc/os-release; then
        v_ok "SO: $(t "base Debian/Ubuntu" "Debian/Ubuntu based") ($(. /etc/os-release; echo "$PRETTY_NAME"))."
    else
        v_fail "SO: $(t "este instalador só suporta Debian/Ubuntu" "this installer only supports Debian/Ubuntu")."
    fi

    validate_command apt-get   "APT"
    validate_command dpkg      "DPKG"
    validate_command systemctl "Systemd"
    validate_command ss        "Rede"
    validate_command wget      "Download"
    validate_command gpg       "GPG"

    getent hosts debian.koha-community.org >/dev/null 2>&1 \
        && v_ok "DNS: $(t "repositório Koha resolve" "Koha repository resolves")." \
        || v_fail "DNS: $(t "repositório Koha não resolve" "Koha repository does not resolve")."
    curl -fsSI --max-time 10 https://debian.koha-community.org/koha/ >/dev/null 2>&1 \
        && v_ok "HTTPS: $(t "repositório Koha respondeu" "Koha repository responded")." \
        || v_fail "HTTPS: $(t "repositório Koha não respondeu" "Koha repository did not respond")."

    free_disk=$(get_free_space_mb /)
    if [ "${free_disk:-0}" -ge 10240 ] 2>/dev/null; then v_ok "Disco: ${free_disk} MB."
    elif [ "${free_disk:-0}" -ge 5120 ] 2>/dev/null; then v_warn "Disco: ${free_disk} MB ($(t "apertado para Elasticsearch" "tight for Elasticsearch"))."
    else v_fail "Disco: ${free_disk:-0} MB ($(t "mínimo recomendado: 5 GB" "recommended minimum: 5 GB"))."; fi

    for p in 80 8080; do
        if ss -lnt 2>/dev/null | awk '{print $4}' | grep -Eq "([.:]$p)\$"; then
            v_warn "TCP $p $(t "já está em uso (outro servidor web?)" "already in use (another web server?)")."
        else
            v_ok "TCP $p $(t "livre" "free")."
        fi
