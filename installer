# ======================================================================
# FILE EXPLORER
# ======================================================================
select_file() {
    local current="${1:-/}" choice items=()
    [ -d "$current" ] || current="/"
    while true; do
        items=()
        [ "$current" != "/" ] && items+=(".." "$(t "[Back]")")
        while IFS= read -r d; do
            [ -n "$d" ] && items+=("$d" "$(t "[Folder]")")
        done < <(find "$current" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort)
        while IFS= read -r f; do
            [ -n "$f" ] && items+=("$f" "$(t "Backup file")")
        done < <(find "$current" -mindepth 1 -maxdepth 1 -type f \( -name '*.sql' -o -name '*.sql.gz' \) -printf '%f\n' 2>/dev/null | sort)

        [ ${#items[@]} -eq 0 ] && items+=(".." "$(t "[Empty - Back]")")

        choice=$(whiptail --title "$(t "File Explorer")" \
            --cancel-button "$(t "Back")" \
            --menu "$(t "Current folder:") $current\n\n$(t "Pick the backup (.sql or .sql.gz):")" \
            22 76 12 "${items[@]}" 3>&1 1>&2 2>&3) || return 1
        [ -z "$choice" ] && return 1

        if [ "$choice" = ".." ]; then
            current=$(dirname "$current")
        elif [ -d "$current/$choice" ]; then
            current="${current%/}/$choice"
        elif [ -f "$current/$choice" ]; then
            printf '%s' "${current%/}/$choice"
            return 0
        fi
    done
}

select_directory() {
    local current="${1:-/}" choice dirs=() marker
    marker=">>> $(t "SAVE HERE") <<<"
    [ -d "$current" ] || current="/"
    while true; do
        dirs=("$marker" "$current")
        [ "$current" != "/" ] && dirs+=(".." "$(t "[Back]")")
        while IFS= read -r d; do
            [ -n "$d" ] && dirs+=("$d" "$(t "[Folder]")")
        done < <(find "$current" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort)

        choice=$(whiptail --title "$(t "Folder Picker")" \
            --cancel-button "$(t "Back")" \
            --menu "$(t "Current folder:") $current" 22 76 12 "${dirs[@]}" 3>&1 1>&2 2>&3) || return 1
        [ -z "$choice" ] && return 1

        if [ "$choice" = "$marker" ]; then
            printf '%s' "$current"; return 0
        elif [ "$choice" = ".." ]; then
            current=$(dirname "$current")
        elif [ -d "$current/$choice" ]; then
            current="${current%/}/$choice"
        fi
    done
}

# ======================================================================
# VALIDATION SYSTEM
# ======================================================================
VALIDATION_LOG="${LOG_DIR}/validacao-$(date '+%Y%m%d-%H%M%S').log"
V_OK=0; V_WARN=0; V_FAIL=0

v_reset() {
    V_OK=0; V_WARN=0; V_FAIL=0
    VALIDATION_LOG="${LOG_DIR}/validacao-$(date '+%Y%m%d-%H%M%S').log"
    {
        echo "======================================================================"
        echo "KOHA EASY INSTALLER & MANAGER - VALIDATION REPORT"
        echo "Context: ${1:-general}"
        echo "Date: $(date '+%Y-%m-%d %H:%M:%S %Z')"
        echo "Host: $(hostname)    Panel: v${PANEL_VERSION}"
        echo "======================================================================"
    } > "$VALIDATION_LOG"
}
v_ok()   { V_OK=$((V_OK+1));    printf '[ OK ] %s\n' "$1" | tee -a "$VALIDATION_LOG"; }
v_warn() { V_WARN=$((V_WARN+1)); printf '[%s] %s\n' "$(t "WARN")" "$1" | tee -a "$VALIDATION_LOG"; }
v_fail() { V_FAIL=$((V_FAIL+1)); printf '[%s] %s\n' "$(t "FAIL")" "$1" | tee -a "$VALIDATION_LOG"; }
v_info() { printf '[INFO] %s\n' "$1" | tee -a "$VALIDATION_LOG"; }

validate_command() {
    if command -v "$1" >/dev/null 2>&1; then v_ok "$2: '$1' $(t "available")."; return 0; fi
    v_fail "$2: '$1' $(t "not found")."; return 1
}

validate_file() {
    if [ -f "$1" ]; then v_ok "$2: $1"; return 0; fi
    v_fail "$2: $(t "missing"): $1"; return 1
}

validate_service() {
    local s="$1" d="$2" req="${3:-sim}"
    if ! systemctl cat "$s" >/dev/null 2>&1; then
        if [ "$req" = "sim" ]; then v_fail "$d: $(t "service not installed") ($s)."
        else v_warn "$d: $(t "optional, not installed") ($s)."; fi
        return 1
    fi
    if systemctl is-active --quiet "$s"; then v_ok "$d: $(t "active") ($s)."; return 0; fi
    if [ "$req" = "sim" ]; then v_fail "$d: $(t "INACTIVE") ($s)."
    else v_warn "$d: $(t "optional, inactive") ($s)."; fi
    return 1
}

validate_local_port() {
    if ss -lnt 2>/dev/null | awk '{print $4}' | grep -Eq "([.:]$1)\$"; then
        v_ok "$2: TCP $1 $(t "listening")."; return 0
    fi
    v_fail "$2: TCP $1 $(t "not listening")."; return 1
}

validate_http() {
    local code
    code=$(curl -sS -L --max-time 10 -o /dev/null -w '%{http_code}' "$1" 2>/dev/null)
    if [[ "$code" =~ ^[23][0-9][0-9]$ ]]; then v_ok "$2: HTTP $code."; return 0; fi
    v_fail "$2: HTTP ${code:-$(t "no response")} ($1)."; return 1
}

validate_mariadb() {
    local c
    if ! mysql -Nse 'SELECT 1;' >/dev/null 2>&1; then
        v_fail "MariaDB: $(t "local connection failed")."; return 1
    fi
    v_ok "MariaDB: $(t "local connection OK")."
    c=$(run_sql "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='${DB_NAME}';")
    c="${c:-0}"
    if [ "$c" -gt 50 ] 2>/dev/null; then
        v_ok "${DB_NAME}: $c $(t "tables")."
    else
        v_warn "${DB_NAME}: $c $(t "tables (waiting for Web Installer or restore)")."
    fi
    local charset
    charset=$(run_sql "SELECT default_character_set_name FROM information_schema.schemata WHERE schema_name='${DB_NAME}';")
    case "$charset" in
        utf8mb4) v_ok "${DB_NAME}: $(t "utf8mb4 charset")." ;;
        "")      : ;;
        *)       v_warn "${DB_NAME}: charset '$charset' ($(t "utf8mb4 is recommended"))." ;;
    esac
    return 0
}

get_search_engine() { run_sql "SELECT value FROM ${DB_NAME}.systempreferences WHERE variable='SearchEngine' LIMIT 1;"; }

validate_koha_instance() {
    local e
    validate_file "$KOHA_CONF" "Koha: $(t "configuration")"
    validate_file "/etc/apache2/sites-enabled/${INSTANCE}.conf" "Apache: $(t "Koha site")"

    if command -v koha-list >/dev/null 2>&1 && koha-list 2>/dev/null | grep -qx "$INSTANCE"; then
        v_ok "Koha: $(t "instance registered") ('$INSTANCE')."
    else
        v_fail "Koha: $(t "instance not registered") ('$INSTANCE')."
    fi

    if [ -f "$KOHA_CONF" ] && command -v xmllint >/dev/null 2>&1; then
        if xmllint --noout "$KOHA_CONF" >/dev/null 2>&1; then
            v_ok "Koha: koha-conf.xml $(t "well-formed")."
        else
            v_fail "Koha: koha-conf.xml $(t "has an XML error")."
        fi
    fi

    if command -v koha-plack >/dev/null 2>&1; then
        if koha-plack --status "$INSTANCE" 2>/dev/null | grep -qi "running"; then
            v_ok "Plack: $(t "running")."
        else
            v_warn "Plack: $(t "status unconfirmed")."
        fi
    fi

    e=$(get_search_engine)
    case "$e" in
        Zebra|Elasticsearch) v_info "Koha: SearchEngine=$e." ;;
        "")                  v_warn "Koha: SearchEngine $(t "not defined yet")." ;;
        *)                   v_warn "Koha: SearchEngine=$e (?)." ;;
    esac
}

validate_zebra() {
    [ "$1" != "Zebra" ] && return 0
    if is_koha_zebra_running; then
        v_ok "Zebra: $(t "daemon active")."
    else
        v_fail "Zebra: $(t "daemon INACTIVE")."
    fi
    if [ -f "$CRON_ZEBRA" ]; then
        v_ok "Zebra: $(t "incremental indexing scheduled")."
    else
        v_warn "Zebra: $(t "no incremental indexing cron (new records may lag)")."
    fi
}

validate_cron() {
    validate_file "$CRON_TASKS" "Cron: $(t "central file")" || return 1
    [ "$(stat -c '%a' "$CRON_TASKS" 2>/dev/null)" = "644" ] \
        && v_ok "Cron: $(t "permissions 644")." \
        || v_warn "Cron: $(t "permissions differ from 644 (cron ignores the file)")."
    grep -q '^PATH=' "$CRON_TASKS" 2>/dev/null \
        && v_ok "Cron: PATH $(t "declared")." \
        || v_fail "Cron: $(t "no PATH line (koha-shell is not found and tasks fail silently)")."
    grep -q 'backup_sql.sh'  "$CRON_TASKS" 2>/dev/null && v_ok "Cron: $(t "SQL backup")." || v_warn "Cron: backup SQL $(t "missing")."
    grep -q 'backup_marc.sh' "$CRON_TASKS" 2>/dev/null && v_ok "Cron: $(t "MARC21 backup")." || v_warn "Cron: backup MARC21 $(t "missing")."
    validate_service cron "Cron"
}

validate_ufw() {
    if ! command -v ufw >/dev/null 2>&1; then
        v_warn "UFW: $(t "not installed")."; return 1
    fi
    if ufw status 2>/dev/null | grep -q '^Status: active'; then
        v_ok "UFW: $(t "firewall active")."
    else
        v_warn "UFW: $(t "firewall inactive (normal on WSL/containers)")."
    fi
}

validate_backups() {
    local newest age
    if [ -d "$DIR_SQL" ]; then
        newest=$(find "$DIR_SQL" -name '*.sql.gz' -printf '%T@ %p\n' 2>/dev/null | sort -rn | head -n1 | cut -d' ' -f2-)
        if [ -n "$newest" ]; then
            age=$(( ( $(date +%s) - $(stat -c %Y "$newest") ) / 86400 ))
            if [ "$age" -le 2 ]; then
                v_ok "Backup SQL: $(t "newest is") ${age}d ($(basename "$newest"))."
            else
                v_warn "Backup SQL: $(t "newest is") ${age} $(t "days old")."
            fi
            gzip -t "$newest" >/dev/null 2>&1 \
                && v_ok "Backup SQL: $(t "archive is intact")." \
                || v_fail "Backup SQL: $(t "archive is CORRUPT"): $newest"
        else
            v_warn "Backup SQL: $(t "no local file yet")."
        fi
    fi
    if [ -f "$BACKUP_CONF" ] && grep -q '^RCLONE_REMOTE="[^"]\+"' "$BACKUP_CONF" 2>/dev/null; then
        v_ok "Cloud: $(t "rclone remote configured")."
    else
        v_warn "Cloud: $(t "remote backup not configured (Backup Center)")."
    fi
}

get_free_space_mb() {
    local val
    val=$(df -Pm "${1:-/}" 2>/dev/null | awk 'NR==2{print $4}')
    val=$(echo "$val" | tr -dc '0-9')
    printf '%s' "${val:-0}"
}

validate_network_and_system() {
    local ram free_disk
    validate_command curl "Internet"
    if getent hosts debian.koha-community.org >/dev/null 2>&1; then
        v_ok "DNS: debian.koha-community.org OK."
    else
        v_fail "DNS: $(t "cannot resolve") debian.koha-community.org."
    fi
    
    # CORREÇÃO: LC_ALL=C força a leitura com ponto decimal ignorando o idioma local
    ram=$(LC_ALL=C awk '/MemTotal:/ {printf "%.1f", $2/1024/1024}' /proc/meminfo 2>/dev/null)
    v_info "RAM: ${ram:-?} GB."
    
    free_disk=$(get_free_space_mb /)
    if [ "${free_disk:-0}" -ge 5120 ] 2>/dev/null; then v_ok "Disk: ${free_disk} MB $(t "free")."
    elif [ "${free_disk:-0}" -ge 2048 ] 2>/dev/null; then v_warn "Disk: ${free_disk} MB $(t "free")."
    else v_fail "Disk: ${free_disk:-0} MB $(t "free (under 2 GB)")."; fi
    
    swapon --show 2>/dev/null | grep -q '/' && v_ok "SWAP: $(t "active")." || v_warn "SWAP: $(t "none")."
    timedatectl show -p NTPSynchronized --value 2>/dev/null | grep -q '^yes$' \
        && v_ok "NTP: $(t "synchronized")." \
        || v_warn "NTP: $(t "unconfirmed")."
    v_info "$(t "Timezone"): $(timedatectl show -p Timezone --value 2>/dev/null)"
}

validate_complete_system() {
    local engine tables
    v_reset "${1:-$(t "full validation")}"
    v_info "$(t "=== SYSTEM / NETWORK ===")"
    validate_network_and_system
    v_info "$(t "=== SERVICES ===")"
    validate_service mariadb      "MariaDB"
    validate_service apache2      "Apache"
    validate_service memcached    "Memcached"
    validate_service koha-common  "Koha common"
    validate_service cron         "Cron"
    validate_service fail2ban     "Fail2ban" "no"
    
    if /usr/sbin/koha-plack --status "$INSTANCE" 2>/dev/null | grep -qi "running"; then
        v_ok "Plack (${INSTANCE}): $(t "running")."
    else
        v_warn "Plack (${INSTANCE}): $(t "not active or running")."
    fi

    v_info "$(t "=== KOHA / DATABASE ===")"
    validate_mariadb
    validate_koha_instance

    if [ -S "/var/run/koha/${INSTANCE}/plack.sock" ]; then
        v_ok "Plack Socket: /var/run/koha/${INSTANCE}/plack.sock OK."
    else
        v_warn "Plack Socket: $(t "socket file missing")."
    fi

    validate_local_port 80   "OPAC"
    validate_local_port 8080 "Staff"
    
    tables=$(run_sql "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='${DB_NAME}';")
    if [ "${tables:-0}" -lt 50 ] 2>/dev/null; then
        v_warn "OPAC: HTTP 500 $(t "expected (empty DB, waiting for Web Installer)")."
    else
        validate_http "http://127.0.0.1:80/"   "OPAC"
    fi
    
    validate_http "http://127.0.0.1:8080/" "Staff"
    
    engine=$(get_search_engine)
    v_info "$(t "=== SEARCH ===")"
    validate_zebra "$engine"
    validate_elasticsearch "$engine"
    v_info "$(t "=== APACHE / CRON / BACKUP / FIREWALL ===")"
    apachectl configtest >/dev/null 2>&1 && v_ok "Apache: configtest OK." || v_fail "Apache: configtest $(t "failed")."
    validate_cron
    validate_backups
    validate_ufw
    printf "\n$(t "RESULT"): OK=%s | $(t "WARNINGS")=%s | $(t "FAILURES")=%s\nLog: %s\n" "$V_OK" "$V_WARN" "$V_FAIL" "$VALIDATION_LOG" | tee -a "$VALIDATION_LOG"
    log "validation '${1:-general}': ok=$V_OK warn=$V_WARN fail=$V_FAIL"
    [ "$V_FAIL" -eq 0 ]
}

show_validation_report() {
    if [ ! -f "$VALIDATION_LOG" ] || [ ! -s "$VALIDATION_LOG" ]; then
        msg_error "" "$(t "Diagnostic log file not found or is empty.\nPlease run validation first.")" 10 74
        return 0
    fi

    whiptail --title "$(t "Diagnostic Report")" \
        --scrolltext --textbox "$VALIDATION_LOG" 22 78 3>&1 1>&2 2>&3 || {
            clear
            cat "$VALIDATION_LOG"
            echo -e "\n======================================================================"
            read -p "$(t "Press [ENTER] to close diagnostics...")"
            clear
        }
}

validate_pre_installation() {
    msg_info "$(t "Welcome to Koha Easy Installer!")" \
        "$(t "This project democratizes collection management, automating the setup of a robust, fast and free infrastructure for libraries.\n\nThe wizard will install and tune MariaDB, Apache, Memcached and Koha.\n\nEstimated time: 10 to 30 minutes.\nPlease do not close the terminal during installation.")" 16 78
        
    clear
    local free_disk p
    v_reset "pre-installation"
    [ "$EUID" -eq 0 ] && v_ok "Root OK." || v_fail "Root: $(t "insufficient privileges")."

    if [ -r /etc/os-release ] && grep -qiE '^(ID|ID_LIKE)=.*(debian|ubuntu)' /etc/os-release; then
        v_ok "OS: $(t "Debian/Ubuntu based") ($(. /etc/os-release; echo "$PRETTY_NAME"))."
    else
        v_fail "OS: $(t "this installer only supports Debian/Ubuntu")."
    fi

    validate_command apt-get   "APT"
    validate_command dpkg      "DPKG"
    validate_command systemctl "Systemd"
    validate_command ss        "$(t "Network")"
    validate_command wget      "Download"
    validate_command gpg       "GPG"

    getent hosts debian.koha-community.org >/dev/null 2>&1 \
        && v_ok "DNS: $(t "Koha repository resolves")." \
        || v_fail "DNS: $(t "Koha repository does not resolve")."
    curl -fsSI --max-time 10 https://debian.koha-community.org/koha/ >/dev/null 2>&1 \
        && v_ok "HTTPS: $(t "Koha repository responded")." \
        || v_fail "HTTPS: $(t "Koha repository did not respond")."

    free_disk=$(get_free_space_mb /)
    if [ "${free_disk:-0}" -ge 10240 ] 2>/dev/null; then v_ok "Disk: ${free_disk} MB $(t "free")."
    elif [ "${free_disk:-0}" -ge 5120 ] 2>/dev/null; then v_warn "Disk: ${free_disk} MB ($(t "tight for Elasticsearch"))."
    else v_fail "Disk: ${free_disk:-0} MB ($(t "recommended minimum: 5 GB"))."; fi

    for p in 80 8080; do
        if ss -lnt 2>/dev/null | awk '{print $4}' | grep -Eq "([.:]$p)\$"; then
            v_warn "TCP $p $(t "already in use (another web server?)")."
        else
            v_ok "TCP $p $(t "free")."
        fi
    done

    if [ "$V_FAIL" -ne 0 ]; then
        local err_list
        err_list=$(grep -E '\[FAIL\]' "$VALIDATION_LOG" | sed -E 's/\[FAIL\] //' | head -n 4)
        
        if prompt_yes_no "$(t "Pre-validation Failed")" \
            "$(t "System does not meet minimum requirements ($V_FAIL critical error).\n\nReason(s):\n${err_list}\n\nDo you want to open the full report for more details?")" 16 78; then
            show_validation_report
        fi
        return 1
    fi
    prompt_yes_no "$(t "Pre-validation OK")" \
        "$(t "No critical errors.\n\nOK: $V_OK   Warnings: $V_WARN\n\nStart the installation now?")" 12 70
}

