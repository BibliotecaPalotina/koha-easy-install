configure_firewall() {
    command -v ufw >/dev/null 2>&1 || return 0
    local p

    for p in $(get_ssh_ports); do
        validate_port_number "$p" && ufw allow "${p}/tcp" >/dev/null 2>&1 || true
    done

    # Público por padrão: OPAC e HTTPS.
    for p in 80 443; do
        ufw allow "${p}/tcp" >/dev/null 2>&1 || true
    done

    # Mantido por compatibilidade com o fluxo de autenticação OAuth/Rclone do projeto.
    ufw allow 53682/tcp >/dev/null 2>&1 || true

    # Não abrir interfaces administrativas/interoperabilidade globalmente por padrão.
    ufw delete allow 8080/tcp >/dev/null 2>&1 || true
    ufw delete deny 8080/tcp >/dev/null 2>&1 || true
    ufw delete allow 587/tcp >/dev/null 2>&1 || true
    ufw delete allow 6001/tcp >/dev/null 2>&1 || true
    ufw delete allow 2100/tcp >/dev/null 2>&1 || true

    # Staff: somente localhost e redes privadas por padrão.
    ufw allow from 127.0.0.1 to any port 8080 proto tcp >/dev/null 2>&1 || true
    ufw allow from 10.0.0.0/8 to any port 8080 proto tcp >/dev/null 2>&1 || true
    ufw allow from 172.16.0.0/12 to any port 8080 proto tcp >/dev/null 2>&1 || true
    ufw allow from 192.168.0.0/16 to any port 8080 proto tcp >/dev/null 2>&1 || true

    if ! ufw --force enable >/dev/null 2>&1; then
        log "UFW nao pode ser ativado (provavel WSL/container)"
    fi
}

