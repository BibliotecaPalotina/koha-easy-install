force_stop_koha_zebra() {
    local pidfile="/var/run/koha/${INSTANCE}/zebrasrv.pid" pid comm uid
    [ -r "$pidfile" ] || return 0
    pid=$(cat "$pidfile" 2>/dev/null || true)
    [[ "$pid" =~ ^[0-9]+$ ]] || return 0
    kill -0 "$pid" 2>/dev/null || return 0
    comm=$(ps -p "$pid" -o comm= 2>/dev/null | awk '{$1=$1;print}')
    [ "$comm" = "zebrasrv" ] || return 0
    uid=$(ps -p "$pid" -o user= 2>/dev/null | awk '{$1=$1;print}')
    [ "$uid" = "${INSTANCE}-koha" ] || return 0
    kill "$pid" >/dev/null 2>&1 || true
    for _ in 1 2 3 4 5; do
        kill -0 "$pid" 2>/dev/null || return 0
        sleep 1
    done
    kill -9 "$pid" >/dev/null 2>&1 || true
    return 0
}

