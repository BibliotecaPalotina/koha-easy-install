    done
    if [ "$es_ok" = "no" ]; then
        systemctl disable --now elasticsearch >/dev/null 2>&1 || true
        write_cron_zebra
        systemctl enable --now "koha-zebra-daemon@${INSTANCE}" >/dev/null 2>&1 || true
        backup_lock_release
        msg_error "" "$(t "O Elasticsearch não subiu na porta 9200. O Zebra foi mantido." "Elasticsearch did not start on port 9200. Zebra was kept.")" 12 76
        return 1
    fi

    display_explanation "Declarando o Elasticsearch no koha-conf.xml..." "Declaring Elasticsearch in koha-conf.xml..."
    if ! set_xml_elasticsearch inserir; then
        systemctl disable --now elasticsearch >/dev/null 2>&1 || true
        write_cron_zebra
        systemctl enable --now "koha-zebra-daemon@${INSTANCE}" >/dev/null 2>&1 || true
        backup_lock_release
        msg_error "" "$(t "Não consegui ativar o bloco do Elasticsearch no koha-conf.xml. O Zebra foi restaurado." "Could not enable the Elasticsearch block in koha-conf.xml. Zebra was restored.")" 11 78
        return 1
    fi
    if ! set_search_engine "Elasticsearch"; then
        set_xml_elasticsearch remover >/dev/null 2>&1 || true
        write_cron_zebra; systemctl enable --now "koha-zebra-daemon@${INSTANCE}" >/dev/null 2>&1 || true
        systemctl disable --now elasticsearch >/dev/null 2>&1 || true
        backup_lock_release
        msg_error "" "$(t "Não foi possível mudar SearchEngine para Elasticsearch. O Zebra foi restaurado." "Could not set SearchEngine to Elasticsearch. Zebra was restored.")" 10 76
        return 1
    fi
    display_explanation "Limpando o cache de preferências (Memcached)..." "Flushing the preferences cache (Memcached)..."
    systemctl restart memcached >/dev/null 2>&1 || true
    if ! prepare_koha_broker; then
        set_xml_elasticsearch remover >/dev/null 2>&1 || true
        set_search_engine "Zebra" >/dev/null 2>&1 || true
        systemctl disable --now elasticsearch >/dev/null 2>&1 || true
        write_cron_zebra
        systemctl enable --now "koha-zebra-daemon@${INSTANCE}" >/dev/null 2>&1 || true
        backup_lock_release
        msg_error "" "$(t "Não foi possível configurar a mensageria do Koha para o Elasticsearch. O Zebra foi restaurado." "Could not configure Koha job messaging for Elasticsearch. Zebra was restored.")" 12 78
        return 1
    fi
    curl -sS -X DELETE --max-time 10 "http://127.0.0.1:9200/${DB_NAME}_biblios" >/dev/null 2>&1 || true
    curl -sS -X DELETE --max-time 10 "http://127.0.0.1:9200/${DB_NAME}_authorities" >/dev/null 2>&1 || true
    display_explanation "Reiniciando o Koha com o Elasticsearch ativo..." "Restarting Koha with Elasticsearch enabled..."
    systemctl restart koha-common >/dev/null 2>&1 || true
    display_explanation "Subindo o indexador contínuo..." "Starting the continuous indexer..."
    local indexer_ok="yes"
    if ! manage_koha_indexers start; then indexer_ok="no"; fi
    local cut_time; cut_time=$(date '+%Y-%m-%d %H:%M:%S')
    local rebuild_ok="yes"
    display_explanation "Reindexando o acervo no Elasticsearch..." "Reindexing the catalog into Elasticsearch..."
    if [ "$indexer_ok" = "yes" ] && ! rebuild_koha_elasticsearch "$cut_time"; then rebuild_ok="no"; fi
    backup_lock_release
    koha-plack --restart "$INSTANCE" >/dev/null 2>&1 || true
    validate_complete_system "ativação do Elasticsearch"
    if [ "$indexer_ok" = "yes" ] && [ "$rebuild_ok" = "yes" ] && is_koha_indexer_running; then
        msg_ok "$(t "Sistema operando com ELASTICSEARCH.\n\nO indexador tem reinício automático e o vigia confere a fila a cada 5 minutos." "System now running on ELASTICSEARCH.\n\nThe indexer has automatic recovery and the watchdog checks the queue every 5 minutes.")" 12 78
    elif [ "$indexer_ok" = "no" ]; then
        msg_error "" "$(t "O Elasticsearch está ativo, mas o indexador não subiu. Use a opção de reparar." "Elasticsearch is active but the indexer did not start. Use the repair option.")" 11 76
        return 1
    else
        msg_error "" "$(t "O Elasticsearch está ativo, mas a reindexação falhou. Use a opção de Reparar Indexação." "Elasticsearch is active but rebuilding failed. Use Repair Indexing option.")" 11 78
        return 1
    fi
}

adjust_elasticsearch_heap() {
    local ram_mb heap cfg tmp
    ram_mb=$(awk '/MemTotal:/ {printf "%d", $2/1024}' /proc/meminfo 2>/dev/null)
    if   [ "${ram_mb:-0}" -ge 16384 ]; then heap="4g"
    elif [ "${ram_mb:-0}" -ge 8192 ];  then heap="2g"
    elif [ "${ram_mb:-0}" -ge 4096 ];  then heap="1g"
    else heap="512m"; fi
    mkdir -p /etc/elasticsearch/jvm.options.d || return 1
    cfg="/etc/elasticsearch/jvm.options.d/koha.options"
    tmp=$(mktemp "${cfg}.tmp.XXXXXX") || return 1
    if ! printf -- '-Xms%s\n-Xmx%s\n' "$heap" "$heap" > "$tmp"; then
        rm -f "$tmp"
        return 1
    fi
    chmod 644 "$tmp"
    chown root:root "$tmp" 2>/dev/null || true
    if ! mv -f "$tmp" "$cfg"; then
        rm -f "$tmp"
        return 1
    fi
    log "ES heap = $heap (RAM ${ram_mb}MB)"
}

set_elasticsearch_yaml_value() {
    local key="$1" value="$2" file="${3:-/etc/elasticsearch/elasticsearch.yml}"
    case "$key" in
        discovery.type|network.host) ;;
        *) return 1 ;;
    esac
    [ -f "$file" ] || return 1
    python3 - "$file" "$key" "$value" << 'PYEOF'
import os, re, sys, tempfile

path, key, value = sys.argv[1], sys.argv[2], sys.argv[3]
if key not in ("discovery.type", "network.host"):
    raise SystemExit(2)
with open(path, "r", encoding="utf-8") as f:
    lines = f.readlines()
pat = re.compile(r"^[ \t]*" + re.escape(key) + r"[ \t]*:")
out = []
found = False
replacement = f"{key}: {value}\n"
for line in lines:
    if pat.match(line):
        if not found:
            out.append(replacement)
            found = True
        continue
    out.append(line)
if not found:
    out.append(replacement)
st = os.stat(path)
fd, tmp = tempfile.mkstemp(prefix="." + os.path.basename(path) + ".", dir=os.path.dirname(path) or ".")
try:
    with os.fdopen(fd, "w", encoding="utf-8", newline="") as f:
        f.writelines(out)
        f.flush()
        os.fsync(f.fileno())
    os.chown(tmp, st.st_uid, st.st_gid)
    os.chmod(tmp, st.st_mode)
    os.replace(tmp, path)
except Exception:
    try:
        os.unlink(tmp)
    except FileNotFoundError:
        pass
    raise
PYEOF
}

