$(t "BACKUP" "BACKUP")
  $(t "Último SQL" "Latest SQL")    : $(find "$DIR_SQL" -name '*.sql.gz' -printf '%TY-%Tm-%Td %TH:%TM\n' 2>/dev/null | sort -r | head -n1 || echo '-')
  $(t "Nuvem" "Cloud")         : $(grep -o 'RCLONE_REMOTE="[^"]*"' "$BACKUP_CONF" 2>/dev/null | cut -d'"' -f2 | grep . || echo "$(t "não configurada" "not configured")")
  $(t "SCP Auto" "SCP Auto")      : $(grep -o 'SCP_HOST="[^"]*"' "$SCP_BACKUP_CONF" 2>/dev/null | cut -d'"' -f2 | grep . || echo "$(t "não configurado" "not configured")")" 30 78 2>/dev/null || true
