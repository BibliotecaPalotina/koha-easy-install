normalize_panel_language() {
    case "$1" in
        pt-*|pt_BR|pt_PT|por) printf '%s' "pt" ;;
        en-*|en_GB|en_NZ|eng) printf '%s' "en" ;;
        es-*|es_ES|spa)       printf '%s' "es" ;;
        fr-*|fra|fre)         printf '%s' "fr" ;;
        de-*|de_DE|de_CH|deu|ger) printf '%s' "de" ;;
        it-*|ita)             printf '%s' "it" ;;
        nl-*|nld|dut)         printf '%s' "nl" ;;
        pl-*|pol)             printf '%s' "pl" ;;
        ru-*|rus)             printf '%s' "ru" ;;
        uk-*|ukr)             printf '%s' "uk" ;;
        ja-*|jpn)             printf '%s' "ja" ;;
        ko-*|kor)             printf '%s' "ko" ;;
        zh-Hans-*|zh-CN)      printf '%s' "zh-CN" ;;
        zh-Hant-*|zh-TW)      printf '%s' "zh-TW" ;;
        ar-*|ara)             printf '%s' "ar" ;;
        he-*|heb)             printf '%s' "he" ;;
        fa-*|fas|per)         printf '%s' "fa" ;;
        tr-*|tur)             printf '%s' "tr" ;;
        cs-*|ces|cze)         printf '%s' "cs" ;;
        sv-*|swe)             printf '%s' "sv" ;;
        nb-*|nn-*|no|nor)     printf '%s' "no" ;;
        ca-*|cat)             printf '%s' "ca" ;;
        *)                    printf '%s' "${1%%-*}" ;;
    esac
}

