#!/usr/bin/env bash
# ======================================================================
# KOHA EASY INSTALL - ADVANCED MANAGEMENT SUITE
# Suíte de implantação, manutenção, tuning e backups do Koha ILS.
# Deployment, maintenance, tuning and backup suite for Koha ILS.
# ----------------------------------------------------------------------
# Arquivo único e autossuficiente. Atualização pela opção "Atualizar
# este painel" (baixa, valida a sintaxe e só então substitui).
# Single, self-sufficient file. Updates via "Update this panel" option.
# ======================================================================
# TESTE_SYNC_PALOTINA_OK=1

set -o pipefail
umask 022

PANEL_VERSION="3.0"
UPDATE_URL="https://raw.githubusercontent.com/BibliotecaPalotina/koha-easy-install/refs/heads/main/installer"

# ======================================================================
# ELEVAÇÃO DE PRIVILÉGIOS / PRIVILEGE ESCALATION
# ======================================================================
if [ "${EUID:-$(id -u)}" -ne 0 ]; then
    echo ""
    echo "+---------------------------------------------------------------+"
    echo "| Privilegios de administrador (root) necessarios.              |"
    echo "| Root privileges required. Please enter your password:         |"
    echo "+---------------------------------------------------------------+"
    echo ""
    if [ -f "$0" ]; then
        exec sudo -E bash "$0" "$@"
    fi
    echo "ERRO/ERROR: rode como root / run as root: sudo bash $0"
    exit 1
fi

REAL_USER="${SUDO_USER:-${USER:-root}}"
REAL_HOME="$(getent passwd "$REAL_USER" 2>/dev/null | cut -d: -f6)"
[ -z "$REAL_HOME" ] && REAL_HOME="/root"
[ -d "$REAL_HOME" ] || REAL_HOME="/root"

# ======================================================================
# IDIOMA / LANGUAGE
# ======================================================================
case "${LANG:-}${LC_ALL:-}" in
    pt*|*pt_BR*) SYS_LANG="pt" ;;
    *)           SYS_LANG="en" ;;
esac

t() { if [ "$SYS_LANG" = "pt" ]; then printf '%b' "$1"; else printf '%b' "$2"; fi; }

# ======================================================================
# TRAVAS DE EXECUÇÃO / EXECUTION LOCKS (PID BASED)
# ======================================================================
PANEL_LOCK_FILE="/var/run/koha_easy_install.pid"
if [ -f "$PANEL_LOCK_FILE" ]; then
    LOCK_PID=$(cat "$PANEL_LOCK_FILE" 2>/dev/null | tr -dc '0-9')
    if [ -n "$LOCK_PID" ] && kill -0 "$LOCK_PID" 2>/dev/null; then
        echo ""
        echo "$(t "ERRO: o Koha Easy Install já está em execução (PID: $LOCK_PID)." "ERROR: Koha Easy Install is already running (PID: $LOCK_PID).")"
        echo ""
        exit 1
    fi
fi
echo $$ > "$PANEL_LOCK_FILE"

BACKUP_LOCK_FILE="/var/run/koha_backup.pid"
backup_lock_acquire() {
    if [ -f "$BACKUP_LOCK_FILE" ]; then
        local b_pid
        b_pid=$(cat "$BACKUP_LOCK_FILE" 2>/dev/null | tr -dc '0-9')
        if [ -n "$b_pid" ] && kill -0 "$b_pid" 2>/dev/null; then
            return 1
        fi
    fi
    echo $$ > "$BACKUP_LOCK_FILE"
    return 0
}
backup_lock_release() {
    rm -f "$BACKUP_LOCK_FILE" 2>/dev/null || true
}

# ======================================================================
# CONSTANTES GLOBAIS / GLOBAL CONSTANTS
# ======================================================================
INSTANCE="library"
DB_NAME="koha_${INSTANCE}"
KOHA_CONF="/etc/koha/sites/${INSTANCE}/koha-conf.xml"
CRON_TASKS="/etc/cron.d/koha_tasks"
CRON_ZEBRA="/etc/cron.d/koha_zebra_queue"
CRON_ES="/etc/cron.d/koha_es_watchdog"
CONF_DIR="/etc/koha-easy-install"
BACKUP_CONF="${CONF_DIR}/backup.conf"
SCP_BACKUP_CONF="${CONF_DIR}/scp_backup.conf"
DIR_SQL="/var/backups/koha_sql"
DIR_MARC="/var/backups/koha_marc"
LOG_DIR="/var/log/koha-easy-install"
RUN_LOG="${LOG_DIR}/painel-$(date '+%Y%m%d').log"
CRON_PATH='PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'

mkdir -p "$LOG_DIR" "$CONF_DIR" 2>/dev/null

log() { printf '%s | %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$RUN_LOG" 2>/dev/null; }
log "===== painel iniciado (v$PANEL_VERSION, usuario=$REAL_USER) ====="

# ======================================================================
# DEPENDÊNCIAS MÍNIMAS DO PRÓPRIO PAINEL / PANEL DEPENDENCIES
# ======================================================================
for dep in whiptail curl python3 unzip; do
    if ! command -v "$dep" >/dev/null 2>&1; then
        echo "$(t "Instalando dependência do painel: $dep" "Installing panel dependency: $dep")"
        DEBIAN_FRONTEND=noninteractive apt-get install -y "$dep" >/dev/null 2>&1 || {
            echo "$(t "Não foi possível instalar '$dep'. Abortando." "Could not install '$dep'. Aborting.")"
            rm -f "$PANEL_LOCK_FILE"
            exit 1
        }
    fi
done

# ======================================================================
# LIMPEZA AO SAIR / CLEANUP ON EXIT
# ======================================================================
APT_TIMERS_STOPPED="no"
restore_apt_timers() {
    [ "$APT_TIMERS_STOPPED" = "yes" ] || return 0
    systemctl start apt-daily.timer apt-daily-upgrade.timer unattended-upgrades >/dev/null 2>&1
    APT_TIMERS_STOPPED="no"
}
on_exit() { 
    restore_apt_timers
    rm -f "$PANEL_LOCK_FILE"
    log "===== painel encerrado ====="
}
trap on_exit EXIT
trap 'echo ""; echo "$(t "Interrompido pelo usuário." "Interrupted by user.")"; exit 130' INT TERM

# ======================================================================
# INTERFACE / UI HELPERS
# ======================================================================
display_explanation() {
    local msg; msg="$(t "$1" "$2")"
    echo ""
    echo "+---------------------------------------------------------------------------+"
    echo "| $msg"
    echo "+---------------------------------------------------------------------------+"
    echo ""
    log "ETAPA: $msg"
}

msg_info()  { whiptail --title "$1" --msgbox "$2" "${3:-12}" "${4:-74}" 2>/dev/null || true; }
msg_error() { log "ERRO: $2"; whiptail --title "$(t "Erro" "Error")" --msgbox "$2" "${3:-14}" "${4:-78}" 2>/dev/null || true; }
msg_ok()    { whiptail --title "$(t "Sucesso" "Success")" --msgbox "$1" "${2:-10}" "${3:-74}" 2>/dev/null || true; }
prompt_yes_no() { whiptail --title "$1" --yesno "$2" "${3:-12}" "${4:-74}" 2>/dev/null; }

pause_terminal() {
    echo ""
    echo "$(t "Pressione [ENTER] para voltar ao painel..." "Press [ENTER] to return to the panel...")"
    read -r _ || true
}

# ======================================================================
# REDE & SISTEMA / NETWORK & SYSTEM
# ======================================================================
get_server_ip() {
    local ip=""
    ip=$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="src"){print $(i+1); exit}}')
    [ -z "$ip" ] && ip=$(hostname -I 2>/dev/null | awk '{print $1}')
    [ -z "$ip" ] && ip="127.0.0.1"
    printf '%s' "$ip"
}

get_ssh_ports() {
    local p=""
    p=$(grep -shoriE '^[[:space:]]*Port[[:space:]]+[0-9]+' /etc/ssh/sshd_config /etc/ssh/sshd_config.d/*.conf 2>/dev/null | grep -oE '[0-9]+' | sort -u)
    [ -z "$p" ] && p=$(ss -lntp 2>/dev/null | grep -i sshd | awk '{print $4}' | sed 's/.*[:.]//' | sort -u)
    [ -z "$p" ] && p="22"
    printf '%s' "$p"
}

get_free_space_mb() { df -Pm "${1:-/}" 2>/dev/null | awk 'NR==2{print $4}'; }

is_koha_installed() { [ -f "$KOHA_CONF" ]; }

is_database_ready() {
    mysql -Nse "SELECT 1 FROM information_schema.tables WHERE table_schema='${DB_NAME}' AND table_name='systempreferences' LIMIT 1;" 2>/dev/null | grep -q 1
}

require_koha() {
    if ! is_koha_installed; then
        msg_error "" "$(t "O Koha ainda não foi instalado.\nUse a opção 1 do painel." "Koha is not installed yet.\nUse option 1 in the panel.")" 9 64
        return 1
    fi
    return 0
}

require_database() {
    require_koha || return 1
    if ! is_database_ready; then
        msg_error "" "$(t "O banco ainda está vazio.\n\nConclua o Web Installer no navegador (Staff) ou restaure um backup." "Database is still empty.\n\nFinish the Web Installer in the browser (Staff) or restore a backup.")" 11 72
        return 1
    fi
    return 0
}

get_database_password() {
    [ -f "$KOHA_CONF" ] || return 1
    grep -oP '(?<=<pass>)[^<]+' "$KOHA_CONF" 2>/dev/null | head -n 1
}

run_sql() { mysql -N -B -e "$1" 2>/dev/null; }

# ======================================================================
# APT BLINDADO / SHIELDED APT
# ======================================================================
APT_OPTS=(-y -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold -o Acquire::ForceIPv4=true)

wait_for_apt_locks() {
    display_explanation "Verificando travas do APT/DPKG..." "Checking APT/DPKG locks..."
    systemctl stop apt-daily.timer apt-daily-upgrade.timer >/dev/null 2>&1
    APT_TIMERS_STOPPED="yes"

    local wait_time=0
    while fuser /var/lib/dpkg/lock-frontend >/dev/null 2>&1 || \
          fuser /var/lib/apt/lists/lock  >/dev/null 2>&1 || \
          fuser /var/lib/dpkg/lock        >/dev/null 2>&1; do
        echo "$(t "[INFO] APT ocupado. Aguardando 3s..." "[INFO] APT busy. Waiting 3s...")"
        sleep 3
        wait_time=$((wait_time + 3))
        if [ "$wait_time" -ge 300 ]; then
            echo "$(t "[ERRO] APT continua travado após 5 minutos. A operação foi cancelada." "[ERROR] APT is still locked after 5 minutes. Operation cancelled.")"
            restore_apt_timers
            return 1
        fi
    done
    if ! dpkg --configure -a >/dev/null 2>&1; then
        echo "$(t "[ERRO] dpkg --configure -a falhou. Corrija o estado do dpkg antes de continuar." "[ERROR] dpkg --configure -a failed. Fix dpkg before continuing.")"
        restore_apt_timers
        return 1
    fi
    return 0
}

apt_update_indices() {
    local attempt=1 max=3
    while [ "$attempt" -le "$max" ]; do
        if apt-get update -y -o Acquire::ForceIPv4=true >/tmp/koha_apt_update.log 2>&1; then
            rm -f /tmp/koha_apt_update.log
            return 0
        fi
        sleep 2
        if apt-get update -y --fix-missing -o Acquire::ForceIPv4=true >>/tmp/koha_apt_update.log 2>&1; then
            rm -f /tmp/koha_apt_update.log
            return 0
        fi
        log "APT update reportou erro ou aviso (tentativa $attempt). Ignorando se não for crítico..."
        sleep 2
        attempt=$((attempt + 1))
    done
    return 0
}

apt_install() {
    local packages=("$@") attempt=1 max=3
    while [ "$attempt" -le "$max" ]; do
        if DEBIAN_FRONTEND=noninteractive apt-get install "${APT_OPTS[@]}" "${packages[@]}"; then
            log "APT ok: ${packages[*]}"
            return 0
        fi
        echo ""
        echo "$(t "[AVISO] Tentativa $attempt de $max falhou. Corrigindo índices..." "[WARN] Attempt $attempt of $max failed. Fixing indices...")"
        apt_update_indices >/dev/null 2>&1
        dpkg --configure -a >/dev/null 2>&1
        apt-get -f install "${APT_OPTS[@]}" >/dev/null 2>&1
        sleep 3
        attempt=$((attempt + 1))
    done
    log "APT FALHOU: ${packages[*]}"
    msg_error "" "$(t "Falha ao instalar após $max tentativas:\n${packages[*]}\n\nVerifique a internet e o espaço em disco." "Failed to install after $max attempts:\n${packages[*]}\n\nCheck your internet connection and disk space.")" 12 74
    return 1
}

# ======================================================================
# EXPLORADOR DE ARQUIVOS / FILE EXPLORER
# ======================================================================
select_file() {
    local current="${1:-/}" choice items=()
    [ -d "$current" ] || current="/"
    while true; do
        items=()
        [ "$current" != "/" ] && items+=(".." "$(t "[Voltar]" "[Back]")")
        while IFS= read -r d; do
            [ -n "$d" ] && items+=("$d" "$(t "[Pasta]" "[Folder]")")
        done < <(find "$current" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort)
        while IFS= read -r f; do
            [ -n "$f" ] && items+=("$f" "$(t "Arquivo de backup" "Backup file")")
        done < <(find "$current" -mindepth 1 -maxdepth 1 -type f \( -name '*.sql' -o -name '*.sql.gz' \) -printf '%f\n' 2>/dev/null | sort)

        [ ${#items[@]} -eq 0 ] && items+=(".." "$(t "[Vazio - Voltar]" "[Empty - Back]")")

        choice=$(whiptail --title "$(t "Explorador de Arquivos" "File Explorer")" \
            --cancel-button "$(t "Voltar" "Back")" \
            --menu "$(t "Pasta atual:" "Current folder:") $current\n\n$(t "Escolha o backup (.sql ou .sql.gz):" "Pick the backup (.sql or .sql.gz):")" \
            22 76 12 "${items[@]}" 3>&1 1>&2 2>&3) || return 1
        [ -z "$choice" ] && return 1

        if [ "$choice" = ".." ]; then
            current=$(dirname "$current")
        elif [ -d "$current/$choice" ]; then
            current="${current%/}/$choice"
        elif [ -f "$current/$choice" ]; then
            printf '%s' "${current%/}/$choice"
            return 0
        fi
    done
}

select_directory() {
    local current="${1:-/}" choice dirs=() marker
    marker=">>> $(t "SALVAR AQUI" "SAVE HERE") <<<"
    [ -d "$current" ] || current="/"
    while true; do
        dirs=("$marker" "$current")
        [ "$current" != "/" ] && dirs+=(".." "$(t "[Voltar]" "[Back]")")
        while IFS= read -r d; do
            [ -n "$d" ] && dirs+=("$d" "$(t "[Pasta]" "[Folder]")")
        done < <(find "$current" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort)

        choice=$(whiptail --title "$(t "Seletor de Pasta" "Folder Picker")" \
            --cancel-button "$(t "Voltar" "Back")" \
            --menu "$(t "Pasta atual:" "Current folder:") $current" 22 76 12 "${dirs[@]}" 3>&1 1>&2 2>&3) || return 1
        [ -z "$choice" ] && return 1

        if [ "$choice" = "$marker" ]; then
            printf '%s' "$current"; return 0
        elif [ "$choice" = ".." ]; then
            current=$(dirname "$current")
        elif [ -d "$current/$choice" ]; then
            current="${current%/}/$choice"
        fi
    done
}

# ======================================================================
# SISTEMA DE VALIDAÇÃO / VALIDATION SYSTEM
# ======================================================================
VALIDATION_LOG="${LOG_DIR}/validacao-$(date '+%Y%m%d-%H%M%S').log"
V_OK=0; V_WARN=0; V_FAIL=0

v_reset() {
    V_OK=0; V_WARN=0; V_FAIL=0
    VALIDATION_LOG="${LOG_DIR}/validacao-$(date '+%Y%m%d-%H%M%S').log"
    {
        echo "======================================================================"
        echo "KOHA EASY INSTALL - RELATORIO DE VALIDACAO / VALIDATION REPORT"
        echo "Contexto/Context: ${1:-geral}"
        echo "Data/Date: $(date '+%Y-%m-%d %H:%M:%S %Z')"
        echo "Host: $(hostname)   Painel: v${PANEL_VERSION}"
        echo "======================================================================"
    } > "$VALIDATION_LOG"
}
v_ok()   { V_OK=$((V_OK+1));     printf '[ OK ] %s\n' "$1" | tee -a "$VALIDATION_LOG"; }
v_warn() { V_WARN=$((V_WARN+1)); printf '[AVISO] %s\n' "$1" | tee -a "$VALIDATION_LOG"; }
v_fail() { V_FAIL=$((V_FAIL+1)); printf '[FALHA] %s\n' "$1" | tee -a "$VALIDATION_LOG"; }
v_info() { printf '[INFO] %s\n' "$1" | tee -a "$VALIDATION_LOG"; }

validate_command() {
    if command -v "$1" >/dev/null 2>&1; then v_ok "$2: '$1' $(t "disponível" "available")."; return 0; fi
    v_fail "$2: '$1' $(t "não encontrado" "not found")."; return 1
}

validate_file() {
    if [ -f "$1" ]; then v_ok "$2: $1"; return 0; fi
    v_fail "$2: $(t "ausente" "missing"): $1"; return 1
}

validate_service() {
    local s="$1" d="$2" req="${3:-sim}"
    if ! systemctl cat "$s" >/dev/null 2>&1; then
        if [ "$req" = "sim" ]; then v_fail "$d: $(t "serviço não instalado" "service not installed") ($s)."
        else v_warn "$d: $(t "opcional, não instalado" "optional, not installed") ($s)."; fi
        return 1
    fi
    if systemctl is-active --quiet "$s"; then v_ok "$d: $(t "ativo" "active") ($s)."; return 0; fi
    if [ "$req" = "sim" ]; then v_fail "$d: $(t "INATIVO" "INACTIVE") ($s)."
    else v_warn "$d: $(t "opcional, inativo" "optional, inactive") ($s)."; fi
    return 1
}

validate_local_port() {
    if ss -lnt 2>/dev/null | awk '{print $4}' | grep -Eq "([.:]$1)\$"; then
        v_ok "$2: TCP $1 $(t "em escuta" "listening")."; return 0
    fi
    v_fail "$2: TCP $1 $(t "não está em escuta" "not listening")."; return 1
}

validate_http() {
    local code
    code=$(curl -sS -L --max-time 10 -o /dev/null -w '%{http_code}' "$1" 2>/dev/null)
    if [[ "$code" =~ ^[23][0-9][0-9]$ ]]; then v_ok "$2: HTTP $code."; return 0; fi
    v_fail "$2: HTTP ${code:-$(t "sem resposta" "no response")} ($1)."; return 1
}

validate_mariadb() {
    local c
    if ! mysql -Nse 'SELECT 1;' >/dev/null 2>&1; then
        v_fail "MariaDB: $(t "conexão local falhou" "local connection failed")."; return 1
    fi
    v_ok "MariaDB: $(t "conexão local OK" "local connection OK")."
    c=$(run_sql "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='${DB_NAME}';")
    c="${c:-0}"
    if [ "$c" -gt 50 ] 2>/dev/null; then
        v_ok "${DB_NAME}: $c $(t "tabelas" "tables")."
    else
        v_warn "${DB_NAME}: $c $(t "tabelas (aguardando Web Installer ou restauração)" "tables (waiting for Web Installer or restore)")."
    fi
    local charset
    charset=$(run_sql "SELECT default_character_set_name FROM information_schema.schemata WHERE schema_name='${DB_NAME}';")
    case "$charset" in
        utf8mb4) v_ok "${DB_NAME}: charset utf8mb4." ;;
        "")      : ;;
        *)       v_warn "${DB_NAME}: charset '$charset' ($(t "o recomendado é utf8mb4" "utf8mb4 is recommended"))." ;;
    esac
    return 0
}

get_search_engine() { run_sql "SELECT value FROM ${DB_NAME}.systempreferences WHERE variable='SearchEngine' LIMIT 1;"; }

validate_koha_instance() {
    local e
    validate_file "$KOHA_CONF" "Koha: $(t "configuração" "configuration")"
    validate_file "/etc/apache2/sites-enabled/${INSTANCE}.conf" "Apache: $(t "site do Koha" "Koha site")"

    if command -v koha-list >/dev/null 2>&1 && koha-list 2>/dev/null | grep -qx "$INSTANCE"; then
        v_ok "Koha: $(t "instância registrada" "instance registered") ('$INSTANCE')."
    else
        v_fail "Koha: $(t "instância não registrada" "instance not registered") ('$INSTANCE')."
    fi

    if [ -f "$KOHA_CONF" ] && command -v xmllint >/dev/null 2>&1; then
        if xmllint --noout "$KOHA_CONF" >/dev/null 2>&1; then
            v_ok "Koha: koha-conf.xml $(t "bem formado" "well-formed")."
        else
            v_fail "Koha: koha-conf.xml $(t "com erro de XML" "has an XML error")."
        fi
    fi

    if command -v koha-plack >/dev/null 2>&1; then
        if koha-plack --status "$INSTANCE" 2>/dev/null | grep -qi "running"; then
            v_ok "Plack: $(t "rodando" "running")."
        else
            v_warn "Plack: $(t "status não confirmado" "status unconfirmed")."
        fi
    fi

    e=$(get_search_engine)
    case "$e" in
        Zebra|Elasticsearch) v_info "Koha: SearchEngine=$e." ;;
        "")                  v_warn "Koha: SearchEngine $(t "ainda não definido" "not defined yet")." ;;
        *)                   v_warn "Koha: SearchEngine=$e (?)." ;;
    esac
}

validate_zebra() {
    [ "$1" != "Zebra" ] && return 0
    if is_koha_zebra_running; then
        v_ok "Zebra: $(t "daemon ativo" "daemon active")."
    else
        v_fail "Zebra: $(t "daemon INATIVO" "daemon INACTIVE")."
    fi
    if [ -f "$CRON_ZEBRA" ]; then
        v_ok "Zebra: $(t "indexação incremental agendada" "incremental indexing scheduled")."
    else
        v_warn "Zebra: $(t "sem cron de indexação incremental (registros novos podem demorar)" "no incremental indexing cron (new records may lag)")."
    fi
}

validate_cron() {
    validate_file "$CRON_TASKS" "Cron: $(t "arquivo central" "central file")" || return 1
    [ "$(stat -c '%a' "$CRON_TASKS" 2>/dev/null)" = "644" ] \
        && v_ok "Cron: $(t "permissões 644" "permissions 644")." \
        || v_warn "Cron: $(t "permissões diferentes de 644 (o cron ignora o arquivo)" "permissions differ from 644 (cron ignores the file)")."
    grep -q '^PATH=' "$CRON_TASKS" 2>/dev/null \
        && v_ok "Cron: PATH $(t "declarado" "declared")." \
        || v_fail "Cron: $(t "sem linha PATH (koha-shell não é encontrado e as tarefas falham em silêncio)" "no PATH line (koha-shell is not found and tasks fail silently)")."
    grep -q 'backup_sql.sh'  "$CRON_TASKS" 2>/dev/null && v_ok "Cron: backup SQL." || v_warn "Cron: backup SQL $(t "ausente" "missing")."
    grep -q 'backup_marc.sh' "$CRON_TASKS" 2>/dev/null && v_ok "Cron: backup MARC21." || v_warn "Cron: backup MARC21 $(t "ausente" "missing")."
    validate_service cron "Cron"
}

validate_ufw() {
    if ! command -v ufw >/dev/null 2>&1; then
        v_warn "UFW: $(t "não instalado" "not installed")."; return 1
    fi
    if ufw status 2>/dev/null | grep -q '^Status: active'; then
        v_ok "UFW: $(t "firewall ativo" "firewall active")."
    else
        v_warn "UFW: $(t "firewall inativo (normal em WSL/containers)" "firewall inactive (normal on WSL/containers)")."
    fi
}

validate_backups() {
    local newest age
    if [ -d "$DIR_SQL" ]; then
        newest=$(find "$DIR_SQL" -name '*.sql.gz' -printf '%T@ %p\n' 2>/dev/null | sort -rn | head -n1 | cut -d' ' -f2-)
        if [ -n "$newest" ]; then
            age=$(( ( $(date +%s) - $(stat -c %Y "$newest") ) / 86400 ))
            if [ "$age" -le 2 ]; then
                v_ok "Backup SQL: $(t "mais recente com" "newest is") ${age}d ($(basename "$newest"))."
            else
                v_warn "Backup SQL: $(t "mais recente tem" "newest is") ${age} $(t "dias" "days old")."
            fi
            gzip -t "$newest" >/dev/null 2>&1 \
                && v_ok "Backup SQL: $(t "arquivo íntegro" "archive is intact")." \
                || v_fail "Backup SQL: $(t "arquivo CORROMPIDO" "archive is CORRUPT"): $newest"
        else
            v_warn "Backup SQL: $(t "nenhum arquivo local ainda" "no local file yet")."
        fi
    fi
    if [ -f "$BACKUP_CONF" ] && grep -q '^RCLONE_REMOTE="[^"]\+"' "$BACKUP_CONF" 2>/dev/null; then
        v_ok "Nuvem: $(t "remote do rclone configurado" "rclone remote configured")."
    else
        v_warn "Nuvem: $(t "backup remoto não configurado (opção 11)" "remote backup not configured (option 11)")."
    fi
    if [ -f "$SCP_BACKUP_CONF" ] && grep -q '^SCP_HOST="[^"]\+"' "$SCP_BACKUP_CONF" 2>/dev/null; then
        v_ok "SCP: $(t "backup via SCP automático configurado" "automatic SCP backup configured")."
    else
        v_warn "SCP: $(t "backup via SCP automático não configurado (opção 12)" "automatic SCP backup not configured (option 12)")."
    fi
}

validate_network_and_system() {
    local ram free_disk
    validate_command curl "Internet"
    if getent hosts debian.koha-community.org >/dev/null 2>&1; then
        v_ok "DNS: debian.koha-community.org OK."
    else
        v_fail "DNS: $(t "não resolve" "cannot resolve") debian.koha-community.org."
    fi
    ram=$(awk '/MemTotal:/ {printf "%.1f", $2/1024/1024}' /proc/meminfo 2>/dev/null)
    v_info "RAM: ${ram:-?} GB."
    free_disk=$(get_free_space_mb /)
    if [ "${free_disk:-0}" -ge 5120 ] 2>/dev/null; then v_ok "Disco: ${free_disk} MB $(t "livres" "free")."
    elif [ "${free_disk:-0}" -ge 2048 ] 2>/dev/null; then v_warn "Disco: ${free_disk} MB $(t "livres" "free")."
    else v_fail "Disco: ${free_disk:-0} MB $(t "livres (menos de 2 GB)" "free (under 2 GB)")."; fi
    swapon --show 2>/dev/null | grep -q '/' && v_ok "SWAP: $(t "ativa" "active")." || v_warn "SWAP: $(t "inexistente" "none")."
    timedatectl show -p NTPSynchronized --value 2>/dev/null | grep -q '^yes$' \
        && v_ok "NTP: $(t "sincronizado" "synchronized")." \
        || v_warn "NTP: $(t "não confirmado" "unconfirmed")."
    v_info "$(t "Fuso horário" "Timezone"): $(timedatectl show -p Timezone --value 2>/dev/null)"
}

validate_complete_system() {
    local engine
    v_reset "${1:-validação completa}"
    v_info "=== SISTEMA / REDE ==="
    validate_network_and_system
    v_info "=== SERVIÇOS ==="
    validate_service mariadb     "MariaDB"
    validate_service apache2     "Apache"
    validate_service memcached   "Memcached"
    validate_service koha-common "Koha common"
    validate_service cron        "Cron"
    validate_service fail2ban    "Fail2ban" "nao"
    v_info "=== KOHA / BANCO ==="
    validate_mariadb
    validate_koha_instance
    validate_local_port 80   "OPAC"
    validate_local_port 8080 "Staff"
    validate_http "http://127.0.0.1:80/"   "OPAC"
    validate_http "http://127.0.0.1:8080/" "Staff"
    engine=$(get_search_engine)
    v_info "=== BUSCA ==="
    validate_zebra "$engine"
    validate_elasticsearch "$engine"
    v_info "=== APACHE / CRON / BACKUP / FIREWALL ==="
    apachectl configtest >/dev/null 2>&1 && v_ok "Apache: configtest OK." || v_fail "Apache: configtest $(t "falhou" "failed")."
    validate_cron
    validate_backups
    validate_ufw
    printf '\nRESULTADO: OK=%s | AVISOS=%s | FALHAS=%s\nLog: %s\n' "$V_OK" "$V_WARN" "$V_FAIL" "$VALIDATION_LOG" | tee -a "$VALIDATION_LOG"
    log "validacao '${1:-geral}': ok=$V_OK warn=$V_WARN fail=$V_FAIL"
    [ "$V_FAIL" -eq 0 ]
}

validate_pre_installation() {
    local free_disk p
    v_reset "pré-instalação"
    [ "$EUID" -eq 0 ] && v_ok "Root OK." || v_fail "Root: $(t "privilégios insuficientes" "insufficient privileges")."

    if [ -r /etc/os-release ] && grep -qiE '^(ID|ID_LIKE)=.*(debian|ubuntu)' /etc/os-release; then
        v_ok "SO: $(t "base Debian/Ubuntu" "Debian/Ubuntu based") ($(. /etc/os-release; echo "$PRETTY_NAME"))."
    else
        v_fail "SO: $(t "este instalador só suporta Debian/Ubuntu" "this installer only supports Debian/Ubuntu")."
    fi

    validate_command apt-get   "APT"
    validate_command dpkg      "DPKG"
    validate_command systemctl "Systemd"
    validate_command ss        "Rede"
    validate_command wget      "Download"
    validate_command gpg       "GPG"

    getent hosts debian.koha-community.org >/dev/null 2>&1 \
        && v_ok "DNS: $(t "repositório Koha resolve" "Koha repository resolves")." \
        || v_fail "DNS: $(t "repositório Koha não resolve" "Koha repository does not resolve")."
    curl -fsSI --max-time 10 https://debian.koha-community.org/koha/ >/dev/null 2>&1 \
        && v_ok "HTTPS: $(t "repositório Koha respondeu" "Koha repository responded")." \
        || v_fail "HTTPS: $(t "repositório Koha não respondeu" "Koha repository did not respond")."

    free_disk=$(get_free_space_mb /)
    if [ "${free_disk:-0}" -ge 10240 ] 2>/dev/null; then v_ok "Disco: ${free_disk} MB."
    elif [ "${free_disk:-0}" -ge 5120 ] 2>/dev/null; then v_warn "Disco: ${free_disk} MB ($(t "apertado para Elasticsearch" "tight for Elasticsearch"))."
    else v_fail "Disco: ${free_disk:-0} MB ($(t "mínimo recomendado: 5 GB" "recommended minimum: 5 GB"))."; fi

    for p in 80 8080; do
        if ss -lnt 2>/dev/null | awk '{print $4}' | grep -Eq "([.:]$p)\$"; then
            v_warn "TCP $p $(t "já está em uso (outro servidor web?)" "already in use (another web server?)")."
        else
            v_ok "TCP $p $(t "livre" "free")."
        fi
    done

    if [ "$V_FAIL" -ne 0 ]; then
        msg_error "" "$(t "A pré-validação encontrou $V_FAIL erro(s) crítico(s).\nAvisos: $V_WARN\n\nLog: $VALIDATION_LOG" "Pre-validation found $V_FAIL critical error(s).\nWarnings: $V_WARN\n\nLog: $VALIDATION_LOG")" 12 74
        return 1
    fi
    prompt_yes_no "$(t "Pré-validação OK" "Pre-validation OK")" \
        "$(t "Nenhum erro crítico.\n\nOK: $V_OK   Avisos: $V_WARN\n\nIniciar a instalação agora?" "No critical errors.\n\nOK: $V_OK   Warnings: $V_WARN\n\nStart the installation now?")" 12 70
}

show_validation_report() {
    [ -f "$VALIDATION_LOG" ] || { msg_info "$(t "Validação" "Validation")" "$(t "Nenhum relatório gerado ainda." "No report generated yet.")" 8 60; return; }
    whiptail --title "$(t "Relatório" "Report")" --scrolltext --textbox "$VALIDATION_LOG" 30 100 2>/dev/null || true
}

# ======================================================================
# MOTOR DE BUSCA: XML, INDEXADOR E MENSAGERIA / SEARCH ENGINE: XML & BROKER
# ======================================================================
edit_xml() {
    python3 - "$1" "$2" "$KOHA_CONF" "${3:-}" << 'PYEOF'
import re, sys, os, tempfile

action, tag, path, body = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]

with open(path, "r", encoding="utf-8") as f:
    text = f.read()

parts = re.split(r"(<!--.*?-->)", text, flags=re.DOTALL)
pattern = re.compile(r"[ \t]*<%s>.*?</%s>[ \t]*\n?" % (tag, tag), re.DOTALL)
for i, p in enumerate(parts):
    if not p.startswith("<!--"):
        parts[i] = pattern.sub("", p)
text = "".join(parts)

if action == "inserir":
    if "</config>" not in text:
        sys.exit("ERRO: </config> nao encontrado em koha-conf.xml")
    text = text.replace("</config>", body + "</config>", 1)

st = os.stat(path)
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path))
with os.fdopen(fd, "w", encoding="utf-8") as f:
    f.write(text)
os.chown(tmp, st.st_uid, st.st_gid)
os.chmod(tmp, st.st_mode)
os.replace(tmp, path)
PYEOF
}

set_xml_elasticsearch() {
    local body=""
    [ -f "$KOHA_CONF" ] || return 1
    if [ "$1" = "inserir" ]; then
        body=$(printf '  <elasticsearch>\n    <server>127.0.0.1:9200</server>\n    <index_name>%s</index_name>\n  </elasticsearch>\n' "${DB_NAME}")
    fi
    edit_xml "$1" "elasticsearch" "$body" || return 1
    if command -v xmllint >/dev/null 2>&1 && ! xmllint --noout "$KOHA_CONF" >/dev/null 2>&1; then
        msg_error "" "$(t "A edição do koha-conf.xml gerou um XML inválido. Restaure pelo backup automático do Koha." "Editing koha-conf.xml produced invalid XML. Restore from Koha's own backup.")" 10 74
        return 1
    fi
    return 0
}

is_koha_es_active_in_xml() {
    [ -f "$KOHA_CONF" ] || return 1
    if command -v xmllint >/dev/null 2>&1; then
        local n
        n=$(xmllint --xpath 'count(/config/elasticsearch)' "$KOHA_CONF" 2>/dev/null || echo 0)
        [ "$n" -gt 0 ] && return 0
    fi
    python3 - "$KOHA_CONF" << 'PYEOF'
import sys, re
with open(sys.argv[1], 'r', encoding='utf-8') as f:
    txt = f.read()
clean = re.sub(r'<!--.*?-->', '', txt, flags=re.DOTALL)
if '<elasticsearch>' in clean:
    sys.exit(0)
sys.exit(1)
PYEOF
}

prepare_koha_broker() {
    dpkg -s rabbitmq-server >/dev/null 2>&1 || return 1
    rabbitmq-plugins enable rabbitmq_stomp >/dev/null 2>&1
    systemctl enable --now rabbitmq-server >/dev/null 2>&1
    return 0
}

get_koha_es_worker_path() {
    local p
    for p in /usr/share/koha/bin/workers/es_indexer_daemon.pl \
             /usr/share/koha/bin/workers/background_jobs_worker.pl; do
        [ -f "$p" ] && { printf '%s' "$p"; return 0; }
    done
    p=$(find /usr/share/koha -name 'es_indexer_daemon.pl' 2>/dev/null | head -n1)
    [ -n "$p" ] && { printf '%s' "$p"; return 0; }
    return 1
}

is_official_indexer_running() {
    [ -r /usr/share/koha/bin/koha-functions.sh ] || return 1
    /bin/bash -c '. /usr/share/koha/bin/koha-functions.sh; is_es_indexer_running "$1"' _ "$INSTANCE" >/dev/null 2>&1
}

install_koha_indexer_service() {
    local unit="koha-es-indexer@.service"
    local native1="/usr/lib/systemd/system/${unit}"
    local native2="/lib/systemd/system/${unit}"

    [ -x /usr/sbin/koha-es-indexer ] || return 1

    if [ -f "$native1" ] || [ -f "$native2" ]; then
        rm -f "/etc/systemd/system/${unit}"
        systemctl daemon-reload
    else
        cat > "/etc/systemd/system/${unit}" << 'EOF'
[Unit]
Description=Koha Elasticsearch indexer supervisor (%i)
After=network-online.target mariadb.service elasticsearch.service memcached.service koha-common.service
Wants=network-online.target elasticsearch.service mariadb.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/bin/bash -c 'set -u; inst="$1"; /usr/sbin/koha-es-indexer --start --quiet "$inst" || exit 1; if [ -r /usr/share/koha/bin/koha-functions.sh ]; then . /usr/share/koha/bin/koha-functions.sh; else exit 1; fi; while is_es_indexer_running "$inst"; do sleep 5; done; exit 1' _ %i
ExecStop=/usr/sbin/koha-es-indexer --stop --quiet %i
Restart=always
RestartSec=10
TimeoutStartSec=60
TimeoutStopSec=60
SyslogIdentifier=koha-es-indexer-%i

[Install]
WantedBy=multi-user.target
EOF
        chmod 644 "/etc/systemd/system/${unit}"
        chown root:root "/etc/systemd/system/${unit}"
        systemctl daemon-reload
    fi

    cat > /usr/local/bin/koha-es-watchdog.sh << EOF
#!/bin/bash
set -u
INST="${INSTANCE}"
DB="${DB_NAME}"
UNIT="koha-es-indexer@\${INST}"
MARKER="/run/koha-easy-install/es-rebuild.in-progress"
LOCK_FILE="/var/run/koha_es_watchdog.pid"

mkdir -p "\$(dirname "\$MARKER")" 2>/dev/null || exit 0

if [ -f "\$LOCK_FILE" ]; then
    L_PID=\$(cat "\$LOCK_FILE" 2>/dev/null | tr -dc '0-9')
    if [ -n "\$L_PID" ] && kill -0 "\$L_PID" 2>/dev/null; then
        exit 0
    fi
fi
echo \$$ > "\$LOCK_FILE"
trap 'rm -f "\$LOCK_FILE"' EXIT

if [ -e "\$MARKER" ]; then
    REBUILD_PID=""
    read -r REBUILD_PID < "\$MARKER" 2>/dev/null || true
    if [[ "\$REBUILD_PID" =~ ^[0-9]+$ ]] && kill -0 "\$REBUILD_PID" 2>/dev/null; then
        exit 0
    fi
    rm -f "\$MARKER"
fi

if [ ! -r "/etc/koha/sites/\${INST}/koha-conf.xml" ] || \
   ! xmllint --xpath 'count(/config/elasticsearch)' "/etc/koha/sites/\${INST}/koha-conf.xml" 2>/dev/null | grep -qx '1'; then
    exit 0
fi

if ! curl -sS --max-time 5 http://127.0.0.1:9200/ >/dev/null 2>&1; then
    logger -t koha-es-watchdog "Elasticsearch API indisponível; indexador não será reiniciado nesta rodada"
    exit 0
fi

INDEXER_UP="no"
if [ -r /usr/share/koha/bin/koha-functions.sh ]; then
    if /bin/bash -c '. /usr/share/koha/bin/koha-functions.sh; is_es_indexer_running "$1"' _ "\$INST" >/dev/null 2>&1; then
        INDEXER_UP="sim"
    fi
fi

if [ "\$INDEXER_UP" != "sim" ]; then
    logger -t koha-es-watchdog "indexador Elasticsearch parado; recuperando \$INST"
    if ! systemctl restart "\$UNIT" >/dev/null 2>&1; then
        /usr/sbin/koha-es-indexer --restart --quiet "\$INST" >/dev/null 2>&1 || true
    fi
    sleep 2
    if [ -r /usr/share/koha/bin/koha-functions.sh ] && \
       /bin/bash -c '. /usr/share/koha/bin/koha-functions.sh; is_es_indexer_running "$1"' _ "\$INST" >/dev/null 2>&1; then
        logger -t koha-es-watchdog "indexador Elasticsearch recuperado com sucesso"
    else
        logger -t koha-es-watchdog "falha ao recuperar o indexador Elasticsearch"
    fi
    exit 0
fi

PEND=\$(mysql -Nse "SELECT COUNT(*) FROM \${DB}.background_jobs WHERE type='update_elastic_index' AND status IN ('new','started') AND enqueued_on < DATE_SUB(NOW(), INTERVAL 5 MINUTE);" 2>/dev/null || echo 0)
if [ "\${PEND:-0}" -gt 0 ] 2>/dev/null; then
    logger -t koha-es-watchdog "\$PEND job(s) de Elasticsearch presos há mais de 5 minutos; reiniciando \$UNIT"
    if systemctl restart "\$UNIT" >/dev/null 2>&1; then
        sleep 2
        if [ -r /usr/share/koha/bin/koha-functions.sh ] && \
           /bin/bash -c '. /usr/share/koha/bin/koha-functions.sh; is_es_indexer_running "$1"' _ "\$INST" >/dev/null 2>&1; then
            logger -t koha-es-watchdog "indexador reiniciado após fila presa"
        else
            logger -t koha-es-watchdog "indexador não confirmou recuperação após fila presa"
        fi
    else
        /usr/sbin/koha-es-indexer --restart --quiet "\$INST" >/dev/null 2>&1 || true
    fi
fi
EOF
    chmod 755 /usr/local/bin/koha-es-watchdog.sh
    chown root:root /usr/local/bin/koha-es-watchdog.sh

    {
        echo "$CRON_PATH"
        echo "# Vigia do indexador Elasticsearch (a cada 5 minutos)"
        echo "*/5 * * * * root /usr/local/bin/koha-es-watchdog.sh >/dev/null 2>&1"
    } > "$CRON_ES"
    chmod 644 "$CRON_ES"
    chown root:root "$CRON_ES"

    systemctl daemon-reload
    systemctl enable "koha-es-indexer@${INSTANCE}" >/dev/null 2>&1 || true
    systemctl restart cron >/dev/null 2>&1 || true
    return 0
}

manage_koha_indexers() {
    if [ "$1" = "start" ]; then
        koha-worker --start "$INSTANCE" >/dev/null 2>&1 || true
        koha-worker --start --queue long_tasks "$INSTANCE" >/dev/null 2>&1 || true
        if is_koha_es_active_in_xml; then
            install_koha_indexer_service || return 1
            if ! systemctl restart "koha-es-indexer@${INSTANCE}" >/dev/null 2>&1; then
                /usr/sbin/koha-es-indexer --start --quiet "$INSTANCE" >/dev/null 2>&1 || true
            fi
            local i
            for i in $(seq 1 30); do
                is_koha_indexer_running && return 0
                sleep 2
            done
            return 1
        fi
        return 0
    fi

    systemctl disable --now "koha-es-indexer@${INSTANCE}" >/dev/null 2>&1 || true
    koha-es-indexer --stop --quiet "$INSTANCE" >/dev/null 2>&1 || true
    rm -f "$CRON_ES"
    systemctl restart cron >/dev/null 2>&1 || true
    return 0
}

is_koha_indexer_running() {
    is_official_indexer_running && return 0
    pgrep -af '[e]s_indexer_daemon' 2>/dev/null | grep -Fq "$INSTANCE" && return 0
    pgrep -af '[b]ackground_jobs_worker' 2>/dev/null | grep -Fq "$INSTANCE" && \
        pgrep -af '[b]ackground_jobs_worker' 2>/dev/null | grep -Fq 'elastic_index' && return 0
    systemctl is-active --quiet "koha-es-indexer@${INSTANCE}" && return 0
    return 1
}

is_koha_zebra_running() {
    if [ -r /usr/share/koha/bin/koha-functions.sh ]; then
        /bin/bash -c '. /usr/share/koha/bin/koha-functions.sh; is_zebra_running "$1"' _ "$INSTANCE" >/dev/null 2>&1 && return 0
    fi
    systemctl is-active --quiet "koha-zebra-daemon@${INSTANCE}" && return 0
    return 1
}

get_pending_es_jobs() {
    local n
    n=$(run_sql "SELECT COUNT(*) FROM ${DB_NAME}.background_jobs WHERE type='update_elastic_index' AND status IN ('new','started');")
    printf '%s' "${n:-0}"
}
get_total_es_documents() { curl -sS --max-time 5 "http://127.0.0.1:9200/${DB_NAME}_biblios/_count" 2>/dev/null | grep -oP '"count"\s*:\s*\K[0-9]+' | head -n1; }
get_total_biblios()      { run_sql "SELECT COUNT(*) FROM ${DB_NAME}.biblio;"; }

force_stop_koha_zebra() {
    local pidfile="/var/run/koha/${INSTANCE}/zebrasrv.pid" pid comm uid
    [ -r "$pidfile" ] || return 0
    pid=$(cat "$pidfile" 2>/dev/null || true)
    [[ "$pid" =~ ^[0-9]+$ ]] || return 0
    kill -0 "$pid" 2>/dev/null || return 0
    comm=$(ps -p "$pid" -o comm= 2>/dev/null | awk '{$1=$1;print}')
    [ "$comm" = "zebrasrv" ] || return 0
    uid=$(ps -p "$pid" -o user= 2>/dev/null | awk '{$1=$1;print}')
    [ "$uid" = "${INSTANCE}-koha" ] || return 0
    kill "$pid" >/dev/null 2>&1 || true
    for _ in 1 2 3 4 5; do
        kill -0 "$pid" 2>/dev/null || return 0
        sleep 1
    done
    kill -9 "$pid" >/dev/null 2>&1 || true
    return 0
}

clear_orphan_jobs() {
    local cut_time="$1"
    mysql -e "UPDATE ${DB_NAME}.background_jobs SET status='cancelled' WHERE type='update_elastic_index' AND status='new' AND enqueued_on < '${cut_time}';" >/dev/null 2>&1
}

ES_REBUILD_LOCK_FILE="/var/lock/koha_es_rebuild.lock"
ES_REBUILD_MARKER="/run/koha-easy-install/es-rebuild.in-progress"

rebuild_koha_elasticsearch() {
    local cut_time="${1:-$(date '+%Y-%m-%d %H:%M:%S')}"
    local rc
    mkdir -p "$(dirname "$ES_REBUILD_MARKER")" || return 1

    (
        exec 7>"$ES_REBUILD_LOCK_FILE"
        chmod 600 "$ES_REBUILD_LOCK_FILE" 2>/dev/null || true
        if ! flock -n 7; then
            log "Rebuild Elasticsearch ignorado: outro rebuild já está em execução."
            exit 75
        fi
        printf '%s\n' "${BASHPID:-$$}" > "$ES_REBUILD_MARKER" || exit 1
        trap 'rm -f "$ES_REBUILD_MARKER"' EXIT HUP INT TERM
        if ! command -v koha-elasticsearch >/dev/null 2>&1; then
            log "koha-elasticsearch não encontrado."
            exit 1
        fi
        koha-elasticsearch --rebuild -d "$INSTANCE"
    )
    rc=$?

    if [ "$rc" -eq 0 ]; then
        clear_orphan_jobs "$cut_time"
    elif [ "$rc" -eq 75 ]; then
        msg_info "$(t "Reindexação já em andamento" "Reindex already running")" \
            "$(t "Outro processo já está reconstruindo o índice Elasticsearch. Aguarde a conclusão." "Another process is already rebuilding the Elasticsearch index. Wait for it to finish.")" 9 72
    fi
    return "$rc"
}

validate_elasticsearch() {
    local e="$1" pend docs bibs
    if ! dpkg -s elasticsearch >/dev/null 2>&1 && ! dpkg -s koha-elasticsearch >/dev/null 2>&1; then
        [ "$e" = "Elasticsearch" ] \
            && v_fail "Elasticsearch: $(t "selecionado no Koha, mas o pacote não está instalado" "selected in Koha but package is missing")." \
            || v_warn "Elasticsearch: $(t "não instalado (ok, o motor atual é o Zebra)" "not installed (fine, current engine is Zebra)")."
        return 0
    fi

    if systemctl is-active --quiet elasticsearch; then
        v_ok "Elasticsearch: $(t "serviço ativo" "service active")."
    else
        [ "$e" = "Elasticsearch" ] \
            && v_fail "Elasticsearch: $(t "serviço INATIVO" "service INACTIVE")." \
            || v_warn "Elasticsearch: $(t "instalado, mas inativo" "installed but inactive")."
    fi

    if curl -sS --max-time 5 http://127.0.0.1:9200/ >/dev/null 2>&1; then
        v_ok "Elasticsearch: API 9200 $(t "respondeu" "responded")."
    elif [ "$e" = "Elasticsearch" ]; then
        v_fail "Elasticsearch: API 9200 $(t "sem resposta" "no response")."
    fi

    [ "$e" = "Elasticsearch" ] || return 0

    is_koha_es_active_in_xml \
        && v_ok "Koha: $(t "bloco <elasticsearch> presente no koha-conf.xml" "<elasticsearch> block present in koha-conf.xml")." \
        || v_fail "Koha: $(t "bloco <elasticsearch> AUSENTE (o indexador não sobe sem ele)" "<elasticsearch> block MISSING (the indexer will not start)")."

    curl -sS --max-time 5 "http://127.0.0.1:9200/_cat/indices/${DB_NAME}_*?format=json" 2>/dev/null | grep -q "${DB_NAME}_" \
        && v_ok "Elasticsearch: $(t "índices do Koha encontrados" "Koha indices found")." \
        || v_warn "Elasticsearch: $(t "índices do Koha não confirmados" "Koha indices unconfirmed")."

    if is_koha_indexer_running; then
        v_ok "Indexador: koha-es-indexer $(t "rodando" "running")."
    else
        v_fail "Indexador: koha-es-indexer $(t "PARADO - registros novos não entram na busca" "STOPPED - new records will not reach search")."
    fi

    [ -f /etc/systemd/system/koha-es-indexer@.service ] \
        && v_ok "Indexador: $(t "serviço systemd instalado (reinício automático)" "systemd unit installed (auto-restart)")." \
        || v_warn "Indexador: $(t "sem serviço systemd dedicado" "no dedicated systemd unit")."

    ss -lnt 2>/dev/null | grep -q ':61613' \
        && v_ok "Mensageria: RabbitMQ/STOMP (61613) OK." \
        || v_warn "Mensageria: $(t "sem RabbitMQ; o Koha lerá a fila direto do banco" "no RabbitMQ; Koha will read the queue straight from the database")."

    pend=$(get_pending_es_jobs)
    if [ "${pend:-0}" -eq 0 ] 2>/dev/null; then
        v_ok "Fila: $(t "nenhum job de indexação pendente" "no pending indexing jobs")."
    elif [ "${pend:-0}" -le 20 ] 2>/dev/null; then
        v_warn "Fila: $pend $(t "job(s) pendente(s)" "pending job(s)")."
    else
        v_fail "Fila: $pend $(t "jobs pendentes - o indexador não está consumindo" "pending jobs - the indexer is not consuming")."
    fi

    bibs=$(get_total_biblios); docs=$(get_total_es_documents)
    if [[ "$bibs" =~ ^[0-9]+$ ]] && [[ "$docs" =~ ^[0-9]+$ ]]; then
        if [ "$docs" -ge "$bibs" ]; then
            v_ok "Cobertura: $docs $(t "documentos para" "documents for") $bibs $(t "registros" "records")."
        else
            v_warn "Cobertura: $docs/$bibs ($(t "faltam" "missing") $((bibs-docs)))."
        fi
    fi
}

