        3>&1 1>&2 2>&3) || return 0

    clear
    echo -e "\e[1;33m>>> $(t "Exibindo as últimas 50 linhas do log em tempo real..." "Displaying the last 50 log lines in real-time...")\e[0m"
    echo -e "\e[1;33m>>> $(t "Pressione [CTRL+C] a qualquer momento para sair e voltar ao menu." "Press [CTRL+C] at any time to exit and return to the menu.")\e[0m\n"
    
    # Foi adicionado o --line-buffered para garantir que os logs apareçam instantaneamente
    if [ "$opc" = "1" ]; then
