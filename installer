# 25. NAVEGADOR WEB DE TERMINAL / TERMINAL WEB BROWSER (LINKS)
# ======================================================================
function_run_links() {
    if ! command -v links >/dev/null 2>&1; then
        whiptail --title "$(t "Instalando" "Installing")" --infobox "$(t "Aguarde, instalando o navegador de terminal (links)..." "Please wait, installing terminal web browser (links)...")" 8 60
        apt-get update -qq && apt-get install -y links -qq
    fi
    local opc
    opc=$(whiptail --title "$(t "Navegador de Terminal (Links)" "Terminal Web Browser (Links)")" \
        --menu "$(t "Qual interface do Koha deseja testar internamente?\n\n(Use as setas para navegar e 'Q' para fechar o navegador)" "Which Koha interface do you want to test internally?\n\n(Use arrow keys to navigate and 'Q' to close the browser)")" 14 76 2 \
        "1" "$(t "Catálogo Público (OPAC - Porta 80)" "Public Catalog (OPAC - Port 80)")" \
        "2" "$(t "Intranet Administrativa (Staff - Porta 8080)" "Administrative Intranet (Staff - Port 8080)")" \
        3>&1 1>&2 2>&3) || return 0

    if [ "$opc" = "1" ]; then
        links http://localhost:80
    elif [ "$opc" = "2" ]; then
        links http://localhost:8080
    fi
}

# ======================================================================
# 26. MONITORAMENTO DE RECURSOS / RESOURCE MONITORING (HTOP/NETHOGS)
# ======================================================================
function_run_monitor() {
    if ! command -v htop >/dev/null 2>&1 || ! command -v nethogs >/dev/null 2>&1; then
        whiptail --title "$(t "Instalando" "Installing")" --infobox "$(t "Aguarde, instalando ferramentas de telemetria (htop e nethogs)..." "Please wait, installing telemetry tools (htop and nethogs)...")" 8 70
        apt-get update -qq && apt-get install -y htop nethogs -qq
    fi
    local opc
    opc=$(whiptail --title "$(t "Monitoramento de Recursos" "Resource Monitoring")" \
        --menu "$(t "Escolha a ferramenta em tempo real:\n\n(Pressione 'F10' ou 'Q' para sair da tela e voltar ao painel)" "Choose the real-time tool:\n\n(Press 'F10' or 'Q' to exit the screen and return to the panel)")" 14 76 2 \
        "1" "$(t "Htop (Uso de CPU, RAM e Processos Ativos)" "Htop (CPU, RAM and Active Processes usage)")" \
        "2" "$(t "Nethogs (Consumo de Banda de Rede por Processo)" "Nethogs (Network Bandwidth usage by Process)")" \
        3>&1 1>&2 2>&3) || return 0

    if [ "$opc" = "1" ]; then
        htop
    elif [ "$opc" = "2" ]; then
        local iface
        iface=$(ip route | awk '/default/ {print $5}')
        nethogs "$iface"
    fi
}

# ======================================================================
# 27. AUDITORIA DE LOGS EM TEMPO REAL / REAL-TIME LOG AUDITING
# ======================================================================
function_view_logs() {
    local opc
    opc=$(whiptail --title "$(t "Auditoria de Logs do Apache" "Apache Log Auditing")" \
        --menu "$(t "Selecione o log para monitoramento contínuo:\n\n(Pressione CTRL+C para parar de visualizar e voltar ao menu)" "Select the log for continuous monitoring:\n\n(Press CTRL+C to stop viewing and return to the menu)")" 14 76 2 \
        "1" "$(t "Erros do Staff / Intranet (koha_${INSTANCE}_error.log)" "Staff / Intranet Errors (koha_${INSTANCE}_error.log)")" \
        "2" "$(t "Erros do OPAC (koha_${INSTANCE}_opac_error.log)" "OPAC Errors (koha_${INSTANCE}_opac_error.log)")" \
        3>&1 1>&2 2>&3) || return 0

    clear
    echo -e "\e[1;33m>>> $(t "Exibindo as últimas 50 linhas do log em tempo real..." "Displaying the last 50 log lines in real-time...")\e[0m"
    echo -e "\e[1;33m>>> $(t "Pressione [CTRL+C] a qualquer momento para sair e voltar ao menu." "Press [CTRL+C] at any time to exit and return to the menu.")\e[0m\n"
    
    # Foi adicionado o --line-buffered para garantir que os logs apareçam instantaneamente
    if [ "$opc" = "1" ]; then
        tail -n 50 -f "/var/log/apache2/koha_${INSTANCE}_error.log" | grep --line-buffered --color=auto -iE "error|fatal|warn|denied|fail|$"
    elif [ "$opc" = "2" ]; then
        tail -n 50 -f "/var/log/apache2/koha_${INSTANCE}_opac_error.log" | grep --line-buffered --color=auto -iE "error|fatal|warn|denied|fail|$"
    fi
}

# ======================================================================
# 28. ATUALIZAR O PAINEL / UPDATE THE PANEL
# ======================================================================
function_autoupdate() {
    prompt_yes_no "$(t "Atualizar o Painel" "Update the Panel")" \
"$(t "Baixa a versão mais recente deste painel do GitHub, confere se\no arquivo é um script válido e só então substitui o atual.\nUma cópia da versão atual é guardada antes.\n\nVersão instalada: ${PANEL_VERSION}\n\nContinuar?" \
"Downloads the latest version of this panel from GitHub, checks that\nthe file is a valid script and only then replaces the current one.\nA copy of the current version is kept first.\n\nInstalled version: ${PANEL_VERSION}\n\nContinue?")" 15 78 || return 0
    clear
    display_explanation "Baixando a nova versão..." "Downloading the new version..."
    local target="/usr/local/bin/options.sh"
    local target_dir; target_dir=$(dirname "$target")
    local tmp; tmp="$(mktemp "${target_dir}/.options.sh.update.XXXXXX")" || {
        msg_error "" "$(t "Não consegui criar um arquivo temporário no mesmo diretório do painel." "Could not create a temporary file in the panel directory.")" 9 76
        return 1
    }
    if ! curl -fsSL --retry 3 --retry-delay 2 --connect-timeout 10 --max-time 120 "$UPDATE_URL" -o "$tmp"; then
        rm -f "$tmp"
        msg_error "" "$(t "Não foi possível baixar. O painel atual continua funcionando." "Download failed. The current panel keeps working.")" 9 72
        return 1
    fi
    local size; size=$(stat -c %s "$tmp" 2>/dev/null || echo 0)
    
    # MUDANÇA AQUI: Alterado de "30" para "31" para refletir o novo tamanho do menu
    if [ "$size" -lt 10240 ] || ! head -n1 "$tmp" | grep -q '^#!.*bash' || \
       ! grep -q 'KOHA EASY INSTALL' "$tmp" || ! grep -q '"31"' "$tmp"; then
        rm -f "$tmp"
        msg_error "" "$(t "O arquivo baixado está incompleto, não parece ser o painel correto ou está inválido ($size bytes). Atualização cancelada." "The downloaded file is incomplete, not the expected panel, or invalid ($size bytes). Update cancelled.")" 11 78
        return 1
    fi
    if ! bash -n "$tmp" 2>/dev/null; then
        rm -f "$tmp"
        msg_error "" "$(t "O arquivo baixado tem erro de sintaxe. Atualização cancelada para não quebrar o painel." "The downloaded file has a syntax error. Update cancelled to avoid breaking the panel.")" 10 76
        return 1
    fi

    chmod 755 "$tmp"
    local backup="${target}.bak-$(date +%Y%m%d-%H%M%S)"
    if [ -f "$target" ]; then
        if ! cp -p "$target" "$backup"; then
            rm -f "$tmp"
            msg_error "" "$(t "Não consegui criar a cópia de segurança do painel atual. Atualização cancelada." "Could not create a backup of the current panel. Update cancelled.")" 10 76
            return 1
        fi
    fi

    if mv -f "$tmp" "$target" && chmod 755 "$target" && chown root:root "$target"; then
        log "painel atualizado a partir de $UPDATE_URL; backup=$backup"
        msg_ok "$(t "Painel atualizado com sucesso!\n\nBackup da versão anterior:\n${backup}\n\nFeche e abra de novo com: sudo options.sh" "Panel updated successfully!\n\nBackup of previous version:\n${backup}\n\nClose and reopen with: sudo options.sh")" 12 76
        rm -f "$PANEL_LOCK_FILE"
        exit 0
    fi

    rm -f "$tmp"
    if [ -f "$backup" ]; then
        cp -p "$backup" "$target" 2>/dev/null || true
    fi
    msg_error "" "$(t "Falha ao substituir $target. Tente novamente; a versão anterior foi preservada." "Failed to replace $target. Try again; the previous version was preserved.")" 10 76
    return 1
}

# ======================================================================
# 29. REINICIAR O SERVIDOR / REBOOT SERVER
# ======================================================================
function_reboot_server() {
    prompt_yes_no "$(t "Reiniciar" "Reboot")" "$(t "Reiniciar o servidor agora?\nTodo mundo que estiver usando o catálogo será desconectado." "Reboot the server now?\nEveryone using the catalog will be disconnected.")" 10 74 || return 0
    clear
    echo "$(t "Reiniciando em 5 segundos..." "Rebooting in 5 seconds...")"
    log "reboot solicitado pelo painel"
    sleep 5
    reboot
}

