RCLONE_MARC_FOLDER="Backup_MARC_Koha"
KEEP_DAYS=7
EOF
    chmod 600 "$BACKUP_CONF"
}

write_scp_backup_config() {
    [ -f "$SCP_BACKUP_CONF" ] && return 0
    cat > "$SCP_BACKUP_CONF" << 'EOF'
# Configuração do backup automático via SCP (sem rclone).
# Configuration for automatic SCP backup (without rclone).
SCP_HOST=""
SCP_USER=""
SCP_PORT="22"
SCP_FOLDER=""
SCP_KEY="/root/.ssh/koha_backup_ed25519"
EOF
    chmod 600 "$SCP_BACKUP_CONF"
}

set_scp_config() {
    local key="$1" val="$2"
    write_scp_backup_config
    if grep -qE "^${key}=" "$SCP_BACKUP_CONF" 2>/dev/null; then
        sed -i -E "s|^${key}=.*|${key}=\"${val}\"|" "$SCP_BACKUP_CONF"
    else
        echo "${key}=\"${val}\"" >> "$SCP_BACKUP_CONF"
    fi
}

write_backup_scripts() {
    mkdir -p "$DIR_SQL" "$DIR_MARC"
    write_backup_config

    cat > /root/backup_sql.sh << EOF
#!/bin/bash
# Backup do banco do Koha. Gerado pelo Koha Easy Install & Tools.
set -o pipefail
umask 077
CONF="${BACKUP_CONF}"
DB="${DB_NAME}"
DIR="${DIR_SQL}"
LOG="${LOG_DIR}/backup_sql.log"
LOCK_FILE="/var/lock/koha_backup.lock"
RCLONE_REMOTE=""; RCLONE_SQL_FOLDER="Backup_SQL_Koha"; KEEP_DAYS=7
[ -f "\$CONF" ] && . "\$CONF"
case "\${KEEP_DAYS}" in ''|*[!0-9]*) KEEP_DAYS=7;; esac

log_backup() { mkdir -p "\$(dirname "\$LOG")" "\$DIR"; printf '%s | %s\\n' "\$(date '+%F %T')" "\$*" >> "\$LOG"; }
exec 9>"\$LOCK_FILE"
if ! flock -n 9; then
    log_backup "INFO: backup SQL ignorado porque outro backup/restauracao esta em andamento"
    exit 0
fi
mkdir -p "\$DIR"

FILE="\$DIR/\${DB}_\$(date +%Y-%m-%d_%Hh%M).sql.gz"

if ! mysqldump --single-transaction --quick --routines --triggers \\
        --default-character-set=utf8mb4 "\$DB" 2>>"\$LOG" | gzip > "\$FILE"; then
    log_backup "FALHA ao gerar \$FILE"
    rm -f "\$FILE"
    exit 1
fi

if ! gzip -t "\$FILE" 2>/dev/null; then
    log_backup "FALHA: arquivo corrompido, removido: \$FILE"
    rm -f "\$FILE"
    exit 1
fi

SIZE=\$(stat -c %s "\$FILE" 2>/dev/null || echo 0)
if [ "\$SIZE" -lt 10240 ]; then
    log_backup "FALHA: backup suspeito (\$SIZE bytes), removido: \$FILE"
    rm -f "\$FILE"
    exit 1
fi
log_backup "OK: \$FILE (\$SIZE bytes)"

RCLONE_REMOTE="\$(printf '%s' "\$RCLONE_REMOTE" | xargs)"
if [ -n "\$RCLONE_REMOTE" ] && [ -f /root/.config/rclone/rclone.conf ]; then
    if ! rclone listremotes --config /root/.config/rclone/rclone.conf 2>/dev/null | grep -qx "\${RCLONE_REMOTE}:"; then
        log_backup "AVISO: RCLONE_REMOTE='\${RCLONE_REMOTE}' não existe no rclone.conf; upload pulado"
    elif /usr/bin/rclone --config /root/.config/rclone/rclone.conf copy "\$FILE" "\${RCLONE_REMOTE}:\${RCLONE_SQL_FOLDER}/" >>"\$LOG" 2>&1; then
        log_backup "Nuvem OK: \${RCLONE_REMOTE}:\${RCLONE_SQL_FOLDER}/"
    else
        log_backup "AVISO: envio para a nuvem falhou (cópia local preservada)"
    fi
fi

# Envio via SCP direto (sem rclone), se configurado
SCP_CONF="${CONF_DIR}/scp_backup.conf"
SCP_HOST=""; SCP_USER=""; SCP_PORT="22"; SCP_FOLDER=""; SCP_KEY=""
[ -f "\$SCP_CONF" ] && . "\$SCP_CONF"
if [ -n "\$SCP_HOST" ] && [ -n "\$SCP_USER" ] && [ -n "\$SCP_FOLDER" ]; then
    if scp -P "\$SCP_PORT" -i "\$SCP_KEY" -o BatchMode=yes -o ConnectTimeout=10 \\
           -o StrictHostKeyChecking=accept-new "\$FILE" "\${SCP_USER}@\${SCP_HOST}:\${SCP_FOLDER%/}/" >>"\$LOG" 2>&1; then
        log_backup "SCP OK: \${SCP_USER}@\${SCP_HOST}:\${SCP_FOLDER}"
    else
        log_backup "AVISO: envio via SCP falhou (copia local preservada)"
    fi
fi

find "\$DIR" -name '*.sql.gz' -mtime "+\${KEEP_DAYS}" -delete 2>/dev/null
exit 0
EOF

    cat > /root/backup_marc.sh << EOF
#!/bin/bash
# Backup dos registros MARC21 (bibliográficos e autoridades).
set -o pipefail
umask 077
CONF="${BACKUP_CONF}"
INST="${INSTANCE}"
DIR="${DIR_MARC}"
LOG="${LOG_DIR}/backup_marc.log"
LOCK_FILE="/var/lock/koha_backup.lock"
RCLONE_REMOTE=""; RCLONE_MARC_FOLDER="Backup_MARC_Koha"; KEEP_DAYS=7
[ -f "\$CONF" ] && . "\$CONF"
case "\${KEEP_DAYS}" in ''|*[!0-9]*) KEEP_DAYS=7;; esac

log_backup() { mkdir -p "\$(dirname "\$LOG")" "\$DIR"; printf '%s | %s\\n' "\$(date '+%F %T')" "\$*" >> "\$LOG"; }
exec 9>"\$LOCK_FILE"
if ! flock -n 9; then
