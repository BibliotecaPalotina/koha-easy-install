======================================================================
EOF
    chmod 600 /root/credenciais_koha.txt

    configurar_firewall
    escrever_banner "$ip" "$DB_NAME"

    if [ -f "$0" ]; then
        install -m 755 "$0" /usr/local/bin/options.sh 2>/dev/null
