# ======================================================================
# 1. INSTALAÇÃO DO SERVIDOR
# ======================================================================
funcao_instalar_koha() {
    msg_info "$(t "Instalação" "Installation")" \
        "$(t "Este assistente vai instalar MariaDB, Apache, Memcached e o Koha (motor de busca Zebra por padrão).\n\nPode levar de 10 a 30 minutos. Não feche o terminal." "This wizard installs MariaDB, Apache, Memcached and Koha (Zebra search engine by default).\n\nIt can take 10 to 30 minutes. Do not close the terminal.")" 13 74
    clear
    validar_pre_instalacao || return 0

    local fuso
    fuso=$(escolher_fuso_horario) && [ -n "$fuso" ] && timedatectl set-timezone "$fuso" >/dev/null 2>&1

    aguardar_travas_apt || return 1

    caixa_explicacao "Configurando idioma e codificação UTF-8..." "Configuring locales and UTF-8..."
    apt_atualizar_indices
    apt_instalar locales || return 1
    locale-gen pt_BR.UTF-8 en_US.UTF-8 >/dev/null 2>&1
    if [ "$SYS_LANG" = "pt" ]; then update-locale LANG=pt_BR.UTF-8; else update-locale LANG=en_US.UTF-8; fi

    caixa_explicacao "Sincronizando o relógio (NTP)..." "Synchronizing the clock (NTP)..."
    apt_instalar systemd-timesyncd >/dev/null 2>&1
    systemctl enable --now systemd-timesyncd >/dev/null 2>&1
    timeout 15 bash -c 'until timedatectl show -p NTPSynchronized --value | grep -q yes; do sleep 1; done' >/dev/null 2>&1

    caixa_explicacao "Criando memória virtual (SWAP de 4 GB)..." "Creating virtual memory (4 GB SWAP)..."
    if [ "$(swapon --show 2>/dev/null | wc -l)" -le 1 ] && [ ! -f /swapfile ]; then
        if [ "$(espaco_livre_mb /)" -ge 8192 ] 2>/dev/null; then
            fallocate -l 4G /swapfile 2>/dev/null || dd if=/dev/zero of=/swapfile bs=1M count=4096 status=none
            chmod 600 /swapfile
            mkswap /swapfile >/dev/null 2>&1
            if swapon /swapfile 2>/dev/null; then
                grep -q '^/swapfile' /etc/fstab || echo '/swapfile none swap sw 0 0' >> /etc/fstab
            else
                rm -f /swapfile
                echo "$(t "[AVISO] SWAP não pôde ser ativada (normal em WSL/containers)." "[WARN] SWAP could not be enabled (normal on WSL/containers).")"
            fi
        else
            echo "$(t "[AVISO] Espaço insuficiente para SWAP de 4 GB. Pulando." "[WARN] Not enough space for a 4 GB SWAP. Skipping.")"
        fi
    fi

    aguardar_travas_apt || return 1
    caixa_explicacao "Atualizando o sistema..." "Upgrading the system..."
    apt_atualizar_indices
    if ! DEBIAN_FRONTEND=noninteractive apt-get upgrade "${APT_OPTS[@]}"; then
        restaurar_timers_apt
        msg_erro "" "$(t "A atualização do sistema falhou. O Koha não será alterado nesta etapa." "System upgrade failed. Koha will not be changed at this stage.")" 10 74
        return 1
    fi

    caixa_explicacao "Instalando dependências essenciais..." "Installing essential dependencies..."
    apt_instalar nano curl wget gpg ca-certificates ufw apt-transport-https \
                 fail2ban libsasl2-modules rclone avahi-daemon memcached \
                 python3 libxml2-utils unzip pv glabels || return 1
    systemctl enable --now avahi-daemon fail2ban memcached >/dev/null 2>&1

    caixa_explicacao "Adicionando os repositórios do Koha e do Elasticsearch..." "Adding Koha and Elasticsearch repositories..."
    mkdir -p /usr/share/keyrings
    if ! curl -fsSL --retry 3 --max-time 60 https://debian.koha-community.org/koha/gpg.asc \
        | gpg --dearmor --yes -o /usr/share/keyrings/koha-keyring.gpg 2>/dev/null; then
        msg_erro "" "$(t "Não foi possível baixar a chave do repositório do Koha. Verifique a internet." "Could not download the Koha repository key. Check your internet connection.")" 9 74
        return 1
    fi
    echo "deb [signed-by=/usr/share/keyrings/koha-keyring.gpg] https://debian.koha-community.org/koha stable main" > /etc/apt/sources.list.d/koha.list

    if curl -fsSL --retry 3 --max-time 60 https://artifacts.elastic.co/GPG-KEY-elasticsearch \
        | gpg --dearmor --yes -o /usr/share/keyrings/elasticsearch-keyring.gpg 2>/dev/null; then
        echo "deb [signed-by=/usr/share/keyrings/elasticsearch-keyring.gpg] https://artifacts.elastic.co/packages/7.x/apt stable main" > /etc/apt/sources.list.d/elastic-7.x.list
    else
        rm -f /etc/apt/sources.list.d/elastic-7.x.list
        echo "$(t "[AVISO] Repositório do Elasticsearch indisponível; seguindo só com o Zebra." "[WARN] Elasticsearch repository unavailable; continuing with Zebra only.")"
    fi

    apt_atualizar_indices
    caixa_explicacao "Instalando MariaDB e Koha (esta é a etapa mais demorada)..." "Installing MariaDB and Koha (longest step)..."
    apt_instalar mariadb-server koha-common || return 1
    systemctl enable --now mariadb >/dev/null 2>&1

    caixa_explicacao "Configurando o Apache e os padrões do Koha..." "Configuring Apache and Koha defaults..."
    definir_koha_sites_conf
    a2enmod rewrite cgi deflate headers proxy proxy_http >/dev/null 2>&1
    grep -qE '^[[:space:]]*Listen[[:space:]]+8080' /etc/apache2/ports.conf 2>/dev/null \
        || sed -i '/^[[:space:]]*Listen[[:space:]]\+80$/a Listen 8080' /etc/apache2/ports.conf
    systemctl restart apache2 memcached >/dev/null 2>&1

    # ---- instância existente ----
    local existe="nao"
    [ -d "/etc/koha/sites/${INSTANCIA}" ] && existe="sim"
    [ "$(sql "SELECT 1 FROM information_schema.schemata WHERE schema_name='${DB_NAME}';")" = "1" ] && existe="sim"

    if [ "$existe" = "sim" ]; then
        perguntar "$(t "Instância já existe" "Instance already exists")" \
            "$(t "Já existe uma instalação do Koha nesta máquina.\n\nREINSTALAR APAGA o banco ${DB_NAME} e toda a configuração.\nIsso NÃO pode ser desfeito por este script.\n\nQuer continuar para a confirmação final?" "A Koha installation already exists.\n\nREINSTALLING DELETES the ${DB_NAME} database and all configuration.\nThis CANNOT be undone by this script.\n\nContinue to the final confirmation?")" 16 76 || return 0

        local confirma
        confirma=$(whiptail --title "$(t "CONFIRMAÇÃO FINAL" "FINAL CONFIRMATION")" --inputbox \
            "$(t "Digite exatamente a palavra abaixo para apagar tudo:\n\nREINSTALAR" "Type exactly the word below to erase everything:\n\nREINSTALL")" 12 66 3>&1 1>&2 2>&3) || return 0
        if [ "$confirma" != "$(t "REINSTALAR" "REINSTALL")" ]; then
            msg_info "$(t "Cancelado" "Cancelled")" "$(t "Confirmação incorreta. Nada foi apagado." "Wrong confirmation. Nothing was deleted.")" 8 62
            return 0
        fi

        caixa_explicacao "Salvando um backup de segurança antes de apagar..." "Saving a safety backup before deleting..."
        if ! backup_lock_acquire; then
            msg_erro "" "$(t "Outro backup ou restauração está em andamento. A reinstalação foi cancelada." "Another backup or restore is already running. Reinstallation was cancelled.")" 9 74
            return 1
        fi
        mkdir -p "$DIR_SQL"
        local resgate="${DIR_SQL}/PRE-REINSTALACAO_$(date +%Y-%m-%d_%Hh%M).sql.gz"
        if ! mysqldump --single-transaction --quick --routines --triggers "$DB_NAME" 2>/dev/null | gzip > "$resgate" || ! gzip -t "$resgate" 2>/dev/null || [ "$(stat -c %s "$resgate" 2>/dev/null || echo 0)" -lt 10240 ]; then
            rm -f "$resgate"
            backup_lock_release
            perguntar "$(t "Backup de segurança falhou" "Safety backup failed")" \
                "$(t "Não foi possível validar o backup pré-reinstalação.

Por segurança, a instalação anterior NÃO será apagada.

Tentar novamente?" "The pre-reinstallation backup could not be validated.

For safety, the previous installation will NOT be deleted.

Try again?")" 13 74 >/dev/null 2>&1 || true
            return 1
        fi
        echo "$(t "Backup de segurança:" "Safety backup:") $resgate"

        caixa_explicacao "Removendo a instalação anterior..." "Removing the previous installation..."
        koha_indexadores_gerenciar stop
        if [ -d "/etc/koha/sites/${INSTANCIA}" ]; then
            if ! koha-remove "$INSTANCIA" >/dev/null 2>&1; then
                backup_lock_release
                msg_erro "" "$(t "O Koha não conseguiu remover a instância anterior. Nenhum DROP adicional foi executado." "Koha could not remove the previous instance. No additional DROP was executed.")" 10 74
                return 1
            fi
        fi
        if ! mysql -e "DROP DATABASE IF EXISTS ${DB_NAME}; DROP USER IF EXISTS '${DB_NAME}'@'localhost'; FLUSH PRIVILEGES;" >/dev/null 2>&1; then
            backup_lock_release
            msg_erro "" "$(t "Não foi possível limpar completamente o banco/usuário da instalação anterior." "Could not completely clean the previous database/user.")" 9 74
            return 1
        fi
        rm -rf "/etc/koha/sites/${INSTANCIA}"
        backup_lock_release
    fi

    caixa_explicacao "Criando a instância '${INSTANCIA}' do Koha..." "Creating the '${INSTANCIA}' Koha instance..."
    if ! koha-create --create-db "$INSTANCIA"; then
        msg_erro "" "$(t "Falha ao criar a instância do Koha.\nVeja o terminal para o erro exato." "Failed to create the Koha instance.\nSee the terminal for the exact error.")" 9 70
        return 1
    fi

