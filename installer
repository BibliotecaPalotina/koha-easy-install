}

# ======================================================================
# 5. TESTAR O ÚLTIMO BACKUP (restauração de ensaio)
# ======================================================================
funcao_testar_backup() {
    exigir_koha || return 0
    local ultimo
    ultimo=$(find "$DIR_SQL" -name '*.sql.gz' -printf '%T@ %p\n' 2>/dev/null | sort -rn | head -n1 | cut -d' ' -f2-)
    if [ -z "$ultimo" ]; then
        msg_erro "" "$(t "Nenhum backup automático encontrado em ${DIR_SQL}." "No automatic backup found in ${DIR_SQL}.")" 9 70
        return 0
    fi

    perguntar "$(t "Testar Backup" "Test Backup")" \
"$(t "Um backup só vale se restaurar. Este teste importa o arquivo\nmais recente em um banco temporário e confere o conteúdo.\nO acervo em produção NÃO é tocado.\n\nArquivo: $(basename "$ultimo")\nData: $(date -r "$ultimo" '+%d/%m/%Y %H:%M')\n\nExecutar o teste agora?" \
"A backup is only worth it if it restores. This test imports the newest\nfile into a temporary database and checks it.\nProduction data is NOT touched.\n\nFile: $(basename "$ultimo")\nDate: $(date -r "$ultimo" '+%Y-%m-%d %H:%M')\n\nRun the test now?")" 17 76 || return 0

    clear
    local teste="koha_teste_restauracao"
    caixa_explicacao "Importando em banco temporário..." "Importing into a temporary database..."
    mysql -e "DROP DATABASE IF EXISTS ${teste}; CREATE DATABASE ${teste} CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;"
    if ! zcat "$ultimo" | mysql "$teste"; then
        mysql -e "DROP DATABASE IF EXISTS ${teste};" >/dev/null 2>&1
        msg_erro "" "$(t "O backup NÃO restaurou. Verifique o arquivo com urgência." "The backup DID NOT restore. Check the file urgently.")" 9 72
        return 1
    fi

    local tab bib usu
    tab=$(sql "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='${teste}';")
    bib=$(sql "SELECT COUNT(*) FROM ${teste}.biblio;")
    usu=$(sql "SELECT COUNT(*) FROM ${teste}.borrowers;")
    mysql -e "DROP DATABASE IF EXISTS ${teste};" >/dev/null 2>&1

    log "teste de backup: $ultimo tabelas=$tab biblios=$bib"
    if [ "${tab:-0}" -gt 50 ] 2>/dev/null && [ "${bib:-0}" -ge 0 ] 2>/dev/null; then
        msg_ok "$(t "BACKUP ÍNTEGRO E RESTAURÁVEL.\n\nArquivo: $(basename "$ultimo")\nTabelas: ${tab}\nRegistros bibliográficos: ${bib}\nUsuários: ${usu}" "BACKUP IS INTACT AND RESTORABLE.\n\nFile: $(basename "$ultimo")\nTables: ${tab}\nBibliographic records: ${bib}\nPatrons: ${usu}")" 13 74
    else
        msg_erro "" "$(t "O backup importou, mas tem só ${tab} tabelas. Suspeito." "The backup imported but has only ${tab} tables. Suspicious.")" 9 72
    fi
}

