validate_and_register_rclone() {
    local name="$1" err
    [ -z "$name" ] && return 1
    if ! rclone listremotes 2>/dev/null | grep -qx "${name}:"; then
        msg_error "" "$(t "There is no rclone remote called '$name'.\n\nExisting remotes:\n$(rclone listremotes 2>/dev/null)")" 14 74
        return 1
    fi
    if ! err=$(rclone mkdir "${name}:Backup_SQL_Koha" 2>&1); then
        msg_error "" "$(t "Remote '$name' exists but the write test failed.\n\nDetail:\n$err")" 16 78
        return 1
    fi
    rclone mkdir "${name}:Backup_MARC_Koha" >/dev/null 2>&1
    write_backup_config
    if grep -qE "^RCLONE_REMOTE=" "$BACKUP_CONF" 2>/dev/null; then
        sed -i -E "s|^RCLONE_REMOTE=.*|RCLONE_REMOTE=\"${name}\"|" "$BACKUP_CONF"
    else
        echo "RCLONE_REMOTE=\"${name}\"" >> "$BACKUP_CONF"
    fi
    if ! grep -qE "^RCLONE_REMOTE=\"${name}\"$" "$BACKUP_CONF" 2>/dev/null; then
        msg_error "" "$(t "The remote was validated, but I could NOT save '${name}' in ${BACKUP_CONF}.\nCheck the file permissions.")" 11 76
        return 1
    fi
    chmod 600 "$BACKUP_CONF"
    log "rclone remote configured: $name"
    display_explanation "Testing the real cloud upload..."
    bash /root/backup_sql.sh >/dev/null 2>&1
    if rclone lsf "${name}:Backup_SQL_Koha" 2>/dev/null | grep -q '\.sql\.gz$'; then
        msg_ok "$(t "Cloud enabled and tested successfully.\n\nRemote: ${name}\nSQL folder: Backup_SQL_Koha (confirmed with a file inside)")" 11 76
    else
        msg_info "$(t "Cloud configured")" "$(t "Configuration saved, but I could not find the test file at ${name}:Backup_SQL_Koha.\n\nCheck the log: ${LOG_DIR}/backup_sql.log")" 11 76
    fi
    return 0
}

function_configure_rclone() {
    local choice
    choice=$(whiptail --title "$(t "Cloud Backup")" \
        --cancel-button "$(t "Back")" \
        --menu "$(t "How do you want to configure auto cloud backups?")" 16 76 3 \
        "1" "$(t "Express: Generate token on another PC (SSH / Headless)")" \
        "2" "$(t "Express: Authenticate directly on this server")" \
        "3" "$(t "Manual: Standard Rclone Wizard (Other services)")" 3>&1 1>&2 2>&3) || return 0
    [ -z "$choice" ] && return 0

    if [ "$choice" = "1" ]; then
        clear
        echo "======================================================================"
        echo -e "\e[1;36m$(t "EXPRESS GOOGLE DRIVE CONFIGURATION (VIA PERSONAL PC)")\e[0m"
        echo "======================================================================"
        echo ""
        echo "$(t "Because this server has no direct web browser, you can authorize")"
        echo "$(t "the connection from your personal computer (Windows/Mac/Linux).")"
        echo ""
        echo "----------------------------------------------------------------------"
        echo -e "\e[1;33m$(t "STEP 1: On your personal PC, open PowerShell as an admin (Windows) or Terminal (Mac/Linux).")\e[0m"
        echo "$(t "If on Windows and 'rclone' is not recognized, install with: winget install Rclone.Rclone")"
        echo ""
        echo '  rclone authorize "drive"'
        echo ""
        echo "$(t "If the above command gives a socket/port error on Windows, run as Administrator:")"
        echo ""
        echo "  wsl --shutdown"
        echo "  net stop winnat"
        echo "  net stop hns"
        echo "  netsh int ipv4 set dynamic tcp start=49152 num=16384"
        echo "  netsh int ipv6 set dynamic tcp start=49152 num=16384"
        echo '  rclone authorize "drive"'
        echo "----------------------------------------------------------------------"
        echo "$(t "STEP 2: Your browser will open. Log in with the library Google account and authorize.")"
        echo "$(t "STEP 3: Your PC will print a long token string starting with '{\"' and ending with '}'.")"
        echo "----------------------------------------------------------------------"
        echo ""
        local token_input=""
        while true; do
            echo -e "\e[1;32m$(t "Paste the complete token JSON string below and press [ENTER]:")\e[0m"
            read -r token_input
            token_input=$(echo "$token_input" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
            if [ -z "$token_input" ]; then
                echo -e "\n\e[1;31m$(t "[ERROR] Token cannot be empty. Try again or press Ctrl+C to cancel.")\e[0m\n"
                continue
            fi
            if [[ ! "$token_input" =~ ^\{.*\}$ ]]; then
                echo -e "\n\e[1;31m$(t "[ERROR] Invalid format! Token must start with '{' and end with '}'. Try again:")\e[0m\n"
                continue
            fi
            if ! python3 -c 'import sys, json; json.loads(sys.argv[1])' "$token_input" 2>/dev/null; then
                echo -e "\n\e[1;31m$(t "[ERROR] Provided JSON is corrupt or was truncated when copying. Try again:")\e[0m\n"
                continue
            fi
            break
        done
        echo ""
        echo -e "\e[1;34m[INFO] $(t "Registering 'gdrive' remote in Rclone...")\e[0m"
        rclone config delete gdrive >/dev/null 2>&1 || true
        if rclone config create gdrive drive config_is_local false token "$token_input" --non-interactive < /dev/null >/dev/null 2>&1; then
            echo -e "\e[1;32m[OK] $(t "'gdrive' remote successfully created!")\e[0m"
            validate_and_register_rclone "gdrive"
        else
            echo -e "\e[1;31m[ERROR] $(t "Failed to register connection in Rclone.")\e[0m"
            read -r -p "$(t "Press [ENTER] to return to menu...")"
        fi
        return 0

    elif [ "$choice" = "2" ]; then
        clear
        echo "======================================================================"
        echo -e "\e[1;36m$(t "DIRECT SERVER AUTHENTICATION (LOCAL / WITH BROWSER OR TUNNEL)")\e[0m"
        echo "======================================================================"
        echo ""
        echo "$(t "Rclone will start an authentication server on this machine on port 53682.")"
        echo "$(t "An authorization link will be printed below.")"
        echo ""
        echo "$(t "1. Open the generated link in any browser with network access to this server.")"
        echo "$(t "2. Log in with your Google account and authorize the app.")"
        echo "$(t "3. The terminal will capture the token automatically without copy-pasting!")"
        echo ""
        echo "----------------------------------------------------------------------"
        echo -e "\e[1;33m$(t "Waiting for browser authorization (Press CTRL+C to cancel)...")\e[0m"
        echo "----------------------------------------------------------------------"
        echo ""

        local token_output
        token_output=$(rclone authorize "drive" --auth-no-open-browser 2>&1 | tee /dev/tty)
        local extracted_token
        extracted_token=$(echo "$token_output" | grep -o '{.*}' | head -n 1)

        if [ -n "$extracted_token" ] && python3 -c 'import sys, json; json.loads(sys.argv[1])' "$extracted_token" 2>/dev/null; then
            echo ""
            echo -e "\e[1;32m[OK] $(t "Token captured automatically!")\e[0m"
            rclone config delete gdrive >/dev/null 2>&1 || true
            if rclone config create gdrive drive config_is_local false token "$extracted_token" --non-interactive < /dev/null >/dev/null 2>&1; then
                echo -e "\e[1;32m[OK] $(t "'gdrive' remote successfully created!")\e[0m"
                validate_and_register_rclone "gdrive"
            else
                msg_error "" "$(t "Failed to register gdrive remote in Rclone.")" 8 66
            fi
        else
            echo ""
            echo -e "\e[1;31m[ERROR] $(t "Could not capture token automatically. Try Option 1.")\e[0m"
            echo "$token_output" | tail -n 10
            echo ""
            pause_terminal
        fi
        return 0

    else
        clear
        rclone config
        local conn_name
        conn_name=$(whiptail --title "$(t "Remote Name")" \
            --inputbox "$(t "Enter the EXACT NAME configured in Rclone:")" 10 70 3>&1 1>&2 2>&3) || return 0
        validate_and_register_rclone "$conn_name"
        return 0
    fi
}

