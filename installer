    local opc
    opc=$(dialog --title "$(t "Auditoria de Logs do Apache" "Apache Log Auditing")" \
        --menu "$(t "Selecione o log para monitoramento contínuo:\n\n(Pressione CTRL+C para parar de visualizar e voltar ao menu)" "Select the log for continuous monitoring:\n\n(Press CTRL+C to stop viewing and return to the menu)")" 14 76 2 \
