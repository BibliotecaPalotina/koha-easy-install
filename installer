# ======================================================================
# 3. RESTAURAR BANCO / RESTORE DATABASE
# ======================================================================
function_restore_database() {
    require_koha || return 0

    msg_info "$(t "Origem do Arquivo" "File Source")" \
"$(t "COMO ENVIAR O BACKUP PARA O SERVIDOR:\n\nOPÇÃO 1 — Windows (Arrastar e Soltar):\n1. No Bloco de Notas, cole o código abaixo e salve na Área de Trabalho como 'Enviar_Backup.bat':\n   @echo off\n   chcp 65001 >nul\n   scp \"%~1\" ${REAL_USER}@$(get_server_ip):${REAL_HOME}/\n   pause\n2. Depois, basta ARRASTAR o arquivo .sql em cima desse ícone.\n\nOPÇÃO 2 — Linux, macOS ou Terminal Direto:\n   scp \"caminho_do_arquivo.sql\" ${REAL_USER}@$(get_server_ip):${REAL_HOME}/\n\nOPÇÃO 3 — Pendrive/USB: conecte no servidor e verifique em /media ou /mnt\n\n(Na próxima tela, navegue até a pasta e selecione o arquivo importado.)" \
"HOW TO SEND THE BACKUP TO THE SERVER:\n\nOPTION 1 — Windows (Drag and Drop):\n1. In Notepad, paste the code below and save on Desktop as 'Enviar_Backup.bat':\n   @echo off\n   chcp 65001 >nul\n   scp \"%~1\" ${REAL_USER}@$(get_server_ip):${REAL_HOME}/\n   pause\n2. Then, just DRAG the .sql file onto that icon.\n\nOPTION 2 — Linux, macOS or Direct Terminal:\n   scp \"path_to_file.sql\" ${REAL_USER}@$(get_server_ip):${REAL_HOME}/\n\nOPTION 3 — USB drive: plug into server and check /media or /mnt\n\n(On the next screen, browse to the folder and select the file.)")" 28 82

    local file
    file=$(select_file "$REAL_HOME") || return 0
    [ -z "$file" ] && return 0

    display_explanation "Conferindo o arquivo de backup..." "Checking the backup file..."
    if [[ "$file" == *.gz ]]; then
        if ! gzip -t "$file" 2>/dev/null; then
            msg_error "" "$(t "O arquivo está corrompido (falhou no teste do gzip).\nNada foi alterado." "The file is corrupt (failed the gzip test).\nNothing was changed.")" 9 70
            return 0
        fi
        if ! zcat "$file" 2>/dev/null | head -c 200000 | grep -qi 'CREATE TABLE'; then
            prompt_yes_no "$(t "Arquivo suspeito" "Suspicious file")" "$(t "Não encontrei comandos SQL no início do arquivo.\nEle pode não ser um backup do Koha.\n\nContinuar mesmo assim?" "No SQL statements found at the start of the file.\nIt may not be a Koha backup.\n\nContinue anyway?")" 11 72 || return 0
        fi
    else
        if ! head -c 200000 "$file" | grep -qi 'CREATE TABLE'; then
            prompt_yes_no "$(t "Arquivo suspeito" "Suspicious file")" "$(t "Não encontrei comandos SQL no início do arquivo.\n\nContinuar mesmo assim?" "No SQL statements found at the start of the file.\n\nContinue anyway?")" 10 72 || return 0
        fi
    fi

    prompt_yes_no "$(t "Confirmar Restauração" "Confirm Restore")" \
"$(t "Arquivo:\n$file\n\nATENÇÃO: o acervo atual será SUBSTITUÍDO.\n\nContinuar?" \
"File:\n$file\n\nWARNING: the current catalog will be REPLACED.\n\nContinue?")" 13 74 || return 0

    clear
    if ! backup_lock_acquire; then
        msg_error "" "$(t "Outro backup ou restauração já está em andamento.\nNada foi alterado." "Another backup or restore is already running.\nNothing was changed.")" 10 72
        return 0
    fi

    local fail_restore=0

    display_explanation "Recriando o banco com charset utf8mb4..." "Recreating the database with utf8mb4 charset..."
    manage_koha_indexers stop
    if ! mysql -e "DROP DATABASE IF EXISTS ${DB_NAME};
              CREATE DATABASE ${DB_NAME} CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
              GRANT ALL PRIVILEGES ON ${DB_NAME}.* TO '${DB_NAME}'@'localhost';
              FLUSH PRIVILEGES;"; then
        backup_lock_release
        msg_error "" "$(t "Não foi possível recriar o banco de dados." "Could not recreate the database.")" 9 70
        return 1
    fi

    display_explanation "Importando o acervo (pode demorar vários minutos)..." "Importing the catalog (may take several minutes)..."
    local ok="yes"
    if [[ "$file" == *.gz ]]; then
        if ! zcat "$file" | mysql --default-character-set=utf8mb4 "$DB_NAME"; then ok="no"; fi
    else
        if ! mysql --default-character-set=utf8mb4 "$DB_NAME" < "$file"; then ok="no"; fi
    fi

    local tables; tables=$(run_sql "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='${DB_NAME}';")
    if [ "$ok" = "no" ] || [ "${tables:-0}" -lt 50 ] 2>/dev/null; then
        fail_restore=1
        backup_lock_release
        msg_error "" "$(t "A importação não produziu um banco Koha completo (${tables:-0} tabelas)." "The import did not produce a complete Koha database (${tables:-0} tables).")" 11 76
        return 1
    fi

    display_explanation "Atualizando o schema para a versão instalada do Koha..." "Upgrading the schema to the installed Koha version..."
    systemctl restart memcached >/dev/null 2>&1 || true
    if ! koha-upgrade-schema "$INSTANCE"; then
        backup_lock_release
        msg_error "" "$(t "A migração do schema falhou. O banco importado foi preservado para diagnóstico." "Schema migration failed. The imported database was preserved for diagnosis.")" 11 78
        return 1
    fi

    display_explanation "Sincronizando o motor de busca..." "Synchronizing the search engine..."
    local engine="Zebra"
    if dpkg -s koha-elasticsearch >/dev/null 2>&1 && is_koha_es_active_in_xml; then engine="Elasticsearch"; fi
    if ! mysql -e "UPDATE ${DB_NAME}.systempreferences SET value='${engine}' WHERE variable='SearchEngine';" >/dev/null 2>&1; then
        backup_lock_release
        msg_error "" "$(t "Não consegui definir o motor de busca após a restauração." "Could not set the search engine after restore.")" 9 72
        return 1
    fi
    systemctl restart memcached >/dev/null 2>&1 || true

    local rebuild_ok="yes"
    local cut_time
    cut_time=$(date '+%Y-%m-%d %H:%M:%S')
    if [ "$engine" = "Elasticsearch" ]; then
        prepare_koha_broker || true
        systemctl restart koha-common >/dev/null 2>&1 || true
        if ! manage_koha_indexers start; then rebuild_ok="no"; fi
        if [ "$rebuild_ok" = "yes" ] && ! rebuild_koha_elasticsearch "$cut_time"; then rebuild_ok="no"; fi
    else
        systemctl enable --now "koha-zebra-daemon@${INSTANCE}" >/dev/null 2>&1 || true
        systemctl restart "koha-zebra-daemon@${INSTANCE}" >/dev/null 2>&1 || true
        write_cron_zebra
        if ! koha-rebuild-zebra -f -v -b -a "$INSTANCE"; then rebuild_ok="no"; fi
    fi

    backup_lock_release
    systemctl restart memcached >/dev/null 2>&1 || true
    koha-plack --restart "$INSTANCE" >/dev/null 2>&1 || true

    validate_complete_system "restauração do banco"
    log "restauracao concluida a partir de $file (motor=$engine rebuild=$rebuild_ok)"

    if [ "$rebuild_ok" = "no" ]; then
        msg_error "" "$(t "O banco foi restaurado, mas a reconstrução do índice falhou.\nUse a opção de reparar indexação." "The database was restored, but index rebuilding failed.\nUse the repair indexing option.")" 11 78
        return 1
    fi

    msg_ok "$(t "Acervo restaurado e indexado com sucesso!\n\nMotor de busca: ${engine}\nTabelas: ${tables}" "Catalog restored and indexed successfully!\n\nSearch engine: ${engine}\nTables: ${tables}")" 12 74
    return 0
}

# ======================================================================
# 4. BACKUP MANUAL LOCAL / MANUAL LOCAL BACKUP
# ======================================================================
function_manual_backup() {
    require_database || return 0
    if ! backup_lock_acquire; then
        msg_info "$(t "Backup em andamento" "Backup in progress")" "$(t "Outro backup ou restauração já está em andamento. Tente novamente depois." "Another backup or restore is already running. Try again later.")" 9 72
        return 0
    fi
    msg_info "$(t "Destino do Backup" "Backup Destination")" \
"$(t "Escolha onde salvar o arquivo.\n\n  Pendrive/USB: normalmente em /media ou /mnt\n  Para baixar depois: scp root@$(get_server_ip):CAMINHO ." "Choose where to save the file.\n\n  USB drive: usually under /media or /mnt\n  To download later: scp root@$(get_server_ip):PATH .")" 12 76
    local target_dir
    target_dir=$(select_directory "$REAL_HOME") || { backup_lock_release; return 0; }
    [ -z "$target_dir" ] && { backup_lock_release; return 0; }
    local target_file="${target_dir%/}/${DB_NAME}_manual_$(date +%Y-%m-%d_%Hh%M).sql.gz"
    clear
    display_explanation "Gerando o backup..." "Generating the backup..."
    if mysqldump --single-transaction --quick --routines --triggers \
         --default-character-set=utf8mb4 "$DB_NAME" | gzip > "$target_file" && gzip -t "$target_file" 2>/dev/null; then
        log "backup manual: $target_file"
        backup_lock_release
        msg_ok "$(t "Backup gerado e verificado:\n$target_file\n\nTamanho: $(du -h "$target_file" | cut -f1)" "Backup generated and verified:\n$target_file\n\nSize: $(du -h "$target_file" | cut -f1)")" 11 76
    else
        rm -f "$target_file"
        backup_lock_release
        msg_error "" "$(t "Falha ao gerar o backup. Verifique o espaço em disco." "Failed to generate the backup. Check the free disk space.")" 9 70
    fi
}

# ======================================================================
# 5. ENVIAR BACKUP VIA SCP MANUAL / SEND MANUAL SCP BACKUP
# ======================================================================
function_send_manual_scp_backup() {
    require_database || return 0
    local host user port folder key use_saved="no"

    if [ -f "$SCP_BACKUP_CONF" ] && grep -q '^SCP_HOST="[^"]\+"' "$SCP_BACKUP_CONF" 2>/dev/null; then
        . "$SCP_BACKUP_CONF"
        if prompt_yes_no "$(t "Usar destino salvo?" "Use saved destination?")" \
            "$(t "Já existe um destino configurado:\n${SCP_USER}@${SCP_HOST}:${SCP_FOLDER}\n\nUsar esse destino agora?" "There is already a configured destination:\n${SCP_USER}@${SCP_HOST}:${SCP_FOLDER}\n\nUse this destination now?")" 11 74; then
            host="$SCP_HOST"; user="$SCP_USER"; port="$SCP_PORT"; folder="$SCP_FOLDER"; key="$SCP_KEY"
            use_saved="yes"
        fi
    fi

    if [ "$use_saved" = "no" ]; then
        msg_info "$(t "Descobrir IP e Usuário" "Find IP and User")" \
"$(t "Execute no terminal/PowerShell da máquina de DESTINO:\n\nWindows (PowerShell):\nWrite-Host \"IP: \$((Get-NetRoute -DestinationPrefix '0.0.0.0/0' | Get-NetIPAddress -AddressFamily IPv4).IPAddress) | Usuario: \$env:USERNAME\"\n\nLinux:\necho \"IP: \$(ip route get 1.1.1.1 2>/dev/null | awk '{print \$7; exit}') | Usuario: \$(whoami)\"\n\nmacOS:\necho \"IP: \$(ipconfig getifaddr \$(route -n get default 2>/dev/null | awk '/interface:/{print \$2}')) | Usuario: \$(whoami)\"" \
"Run in the DESTINATION machine terminal/PowerShell:\n\nWindows (PowerShell):\nWrite-Host \"IP: \$((Get-NetRoute -DestinationPrefix '0.0.0.0/0' | Get-NetIPAddress -AddressFamily IPv4).IPAddress) | User: \$env:USERNAME\"\n\nLinux:\necho \"IP: \$(ip route get 1.1.1.1 2>/dev/null | awk '{print \$7; exit}') | User: \$(whoami)\"\n\nmacOS:\necho \"IP: \$(ipconfig getifaddr \$(route -n get default 2>/dev/null | awk '/interface:/{print \$2}')) | User: \$(whoami)\"")" 24 90

        host=$(whiptail --title "$(t "Enviar Backup via SCP" "Send Backup via SCP")" \
            --inputbox "$(t "Endereço (IP ou domínio) do destino:" "Address (IP or hostname) of the destination:")" 10 70 3>&1 1>&2 2>&3) || return 0
        [ -z "$host" ] && return 0
        user=$(whiptail --title "$(t "Usuário" "Username")" --inputbox "$(t "Usuário SSH:" "SSH username:")" 9 60 "$REAL_USER" 3>&1 1>&2 2>&3) || return 0
        [ -z "$user" ] && return 0
        port=$(whiptail --title "Porta SSH / SSH Port" --inputbox "$(t "Porta SSH:" "SSH port:")" 9 60 "22" 3>&1 1>&2 2>&3) || return 0
        [ -z "$port" ] && port="22"
        folder=$(whiptail --title "$(t "Pasta de Destino" "Destination Folder")" --inputbox "$(t "Pasta no destino (deve existir):" "Folder on the destination (must exist):")" 10 70 "/home/${user}/Desktop" 3>&1 1>&2 2>&3) || return 0
        [ -z "$folder" ] && return 0
        key=""
    fi

    clear
    display_explanation "Gerando o backup..." "Generating the backup..."
    local target="${DIR_SQL}/${DB_NAME}_manual_$(date +%Y-%m-%d_%Hh%M).sql.gz"
    mkdir -p "$DIR_SQL"
    if ! (mysqldump --single-transaction --quick --routines --triggers \
          --default-character-set=utf8mb4 "$DB_NAME" | gzip > "$target" && gzip -t "$target" 2>/dev/null); then
        rm -f "$target"
        msg_error "" "$(t "Falha ao gerar o backup. Verifique o espaço em disco." "Failed to generate the backup. Check the free disk space.")" 9 70
        return 1
    fi
    ln -sf "$(basename "$target")" "${DIR_SQL}/ultimo_backup.sql.gz" 2>/dev/null

    display_explanation "Enviando via SCP para ${user}@${host}..." "Sending via SCP to ${user}@${host}..."
    local opts=(-P "$port" -o ConnectTimeout=10 -o StrictHostKeyChecking=accept-new)
    [ -n "$key" ] && opts+=(-i "$key")

    if scp "${opts[@]}" "$target" "${user}@${host}:${folder%/}/" 2>&1 | tee -a "$RUN_LOG"; then
        log "backup enviado via SCP manual: $target -> ${user}@${host}:${folder}"
        msg_ok "$(t "Backup gerado e enviado com sucesso!\n\nArquivo: $(basename "$target")\nDestino: ${user}@${host}:${folder}" "Backup generated and sent successfully!\n\nFile: $(basename "$target")\nDestination: ${user}@${host}:${folder}")" 11 76
    else
        msg_error "" "$(t "O backup foi gerado localmente (${target}), mas o envio por SCP falhou.\nSe você não usou o destino salvo, e a chave não estiver autorizada,\no SCP vai pedir senha (digite-a quando aparecer no terminal).\n\nLog: $RUN_LOG" "The backup was generated locally (${target}), but the SCP transfer\nfailed. If you didn't use the saved destination and the key isn't\nauthorized, SCP will prompt for a password (type it when it appears).\n\nLog: $RUN_LOG")" 13 78
        return 1
    fi
}

# ======================================================================
# 6. TESTAR O ÚLTIMO BACKUP / TEST THE LATEST BACKUP
# ======================================================================
function_test_backup() {
    require_koha || return 0
    local newest
    newest=$(find "$DIR_SQL" -name '*.sql.gz' -printf '%T@ %p\n' 2>/dev/null | sort -rn | head -n1 | cut -d' ' -f2-)
    if [ -z "$newest" ]; then
        msg_error "" "$(t "Nenhum backup automático encontrado em ${DIR_SQL}." "No automatic backup found in ${DIR_SQL}.")" 9 70
        return 0
    fi
    if ! gzip -t "$newest" 2>/dev/null; then
        msg_error "" "$(t "O último backup falhou no teste gzip e não será restaurado no teste." "The latest backup failed gzip validation and will not be tested.")" 9 74
        return 1
    fi
    prompt_yes_no "$(t "Testar Backup" "Test Backup")" \
"$(t "Um backup só vale se restaurar. Este teste importa o arquivo\nmais recente em um banco temporário e confere o conteúdo.\nO acervo em produção NÃO é tocado.\n\nArquivo: $(basename "$newest")\nData: $(date -r "$newest" '+%d/%m/%Y %H:%M')\n\nExecutar o teste agora?" "A backup is only worth it if it restores. This test imports the newest\nfile into a temporary database and checks it.\nProduction data is NOT touched.\n\nFile: $(basename "$newest")\nDate: $(date -r "$newest" '+%Y-%m-%d %H:%M')\n\nRun the test now?")" 17 76 || return 0
    clear
    local test_db="koha_teste_restauracao"
    display_explanation "Importando em banco temporário..." "Importing into a temporary database..."
    if ! mysql -e "DROP DATABASE IF EXISTS ${test_db}; CREATE DATABASE ${test_db} CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;" >/dev/null 2>&1; then
        msg_error "" "$(t "Não foi possível criar o banco temporário de teste." "Could not create the temporary test database.")" 9 72
        return 1
    fi
    if ! zcat "$newest" | mysql "$test_db"; then
        mysql -e "DROP DATABASE IF EXISTS ${test_db};" >/dev/null 2>&1 || true
        msg_error "" "$(t "O backup NÃO restaurou. Verifique o arquivo com urgência." "The backup DID NOT restore. Check the file urgently.")" 9 72
        return 1
    fi
    local tab bib usu
    tab=$(run_sql "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='${test_db}';")
    bib=$(run_sql "SELECT COUNT(*) FROM ${test_db}.biblio;")
    usu=$(run_sql "SELECT COUNT(*) FROM ${test_db}.borrowers;")
    mysql -e "DROP DATABASE IF EXISTS ${test_db};" >/dev/null 2>&1 || true
    log "teste de backup: $newest tabelas=$tab biblios=$bib"
    if [ "${tab:-0}" -gt 50 ] 2>/dev/null && [ "${bib:-0}" -ge 0 ] 2>/dev/null; then
        msg_ok "$(t "BACKUP ÍNTEGRO E RESTAURÁVEL.\n\nArquivo: $(basename "$newest")\nTabelas: ${tab}\nRegistros bibliográficos: ${bib}\nUsuários: ${usu}" "BACKUP IS INTACT AND RESTORABLE.\n\nFile: $(basename "$newest")\nTables: ${tab}\nBibliographic records: ${bib}\nPatrons: ${usu}")" 13 74
    else
        msg_error "" "$(t "O backup importou, mas tem só ${tab} tabelas. Suspeito." "The backup imported but has only ${tab} tables. Suspicious.")" 9 72
