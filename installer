function_google_search_console() {
    local opac_url=""
    local sitemap_path="sitemapindex.xml"
    local sitemap_url=""
    local robots_url=""
    local http_code=""
    local sitemap_code=""
    local robots_body=""
    local meta_robots=""
    local sitemap_script=""
    local choice=""

    clear
    require_koha || return 0

    if ! command -v curl >/dev/null 2>&1; then
        msg_error "$(t "Google Search Console" "Google Search Console")" \
            "$(t "O comando curl não está disponível.\n\nInstale as dependências do painel antes de continuar." "The curl command is not available.\n\nInstall the panel dependencies before continuing.")" 10 72
        return 1
    fi

    opac_url=$(whiptail \
        --title "$(t "Google Search Console — Endereço do OPAC" "Google Search Console — OPAC address")" \
        --inputbox "$(t "Informe o endereço PÚBLICO completo do OPAC.\n\nExemplo:\nhttps://catalogo.exemplo.org\n\nNão informe localhost, 127.0.0.1 ou um IP privado." "Enter the complete PUBLIC OPAC address.\n\nExample:\nhttps://catalog.example.org\n\nDo not enter localhost, 127.0.0.1 or a private IP address.")" \
        15 80 "https://" 3>&1 1>&2 2>&3) || return 0

    opac_url="${opac_url%/}"
    case "$opac_url" in
        http://*|https://*) ;;
        *)
            msg_error "$(t "Endereço inválido" "Invalid address")" \
                "$(t "Informe uma URL começando com http:// ou https://." "Enter a URL beginning with http:// or https://.")" 9 68
            return 1
            ;;
    esac

    sitemap_url="${opac_url}/${sitemap_path}"
    robots_url="${opac_url}/robots.txt"

    msg_info "$(t "Google Search Console — Assistente de Indexação" "Google Search Console — Indexing Assistant")" \
        "$(t "Este assistente prepara e verifica o OPAC para o Google.\n\nO painel fará automaticamente:\n• verificar se o OPAC está acessível pela internet;\n• verificar robots.txt;\n• localizar o script oficial de sitemap do Koha;\n• gerar o sitemap quando possível;\n• verificar a preferência OpacMetaRobots;\n• verificar se o sitemap está acessível publicamente.\n\nO que você precisará fazer manualmente:\n• adicionar/verificar a propriedade no Google Search Console;\n• enviar o sitemap no Search Console;\n• solicitar indexação de páginas específicas.\n\nO painel NÃO solicita nem armazena sua senha Google." \
        "This assistant prepares and checks the OPAC for Google.\n\nThe panel will automatically:\n• check whether the OPAC is publicly accessible;\n• check robots.txt;\n• locate Koha's official sitemap script;\n• generate the sitemap when possible;\n• check the OpacMetaRobots preference;\n• check whether the sitemap is publicly accessible.\n\nWhat you will need to do manually:\n• add/verify the property in Google Search Console;\n• submit the sitemap in Search Console;\n• request indexing for specific pages when necessary.\n\nThe panel does NOT request or store your Google password.")" 24 88

    display_explanation "$(t "Verificando acesso público ao OPAC..." "Checking public OPAC access...")" \
        "$(t "O Google precisa conseguir acessar o catálogo pela internet." "Google must be able to access the catalog from the internet.")"

    http_code=$(curl -L -k -sS -o /dev/null -w '%{http_code}' --connect-timeout 10 --max-time 30 "$opac_url" 2>/dev/null)

    if [[ "$http_code" =~ ^[23][0-9][0-9]$ ]]; then
        msg_ok "$(t "OPAC acessível.\n\nURL:\n$opac_url\n\nCódigo HTTP:\n$http_code" "OPAC accessible.\n\nURL:\n$opac_url\n\nHTTP status:\n$http_code")" 11 76
    else
        msg_error "$(t "O OPAC não respondeu corretamente pela internet." "The OPAC did not respond correctly from the internet.")" \
            "$(t "URL:\n$opac_url\n\nHTTP:\n${http_code:-sem resposta}\n\nVerifique DNS, Cloudflare Tunnel, Apache, HTTPS e firewall antes de tentar a indexação." "URL:\n$opac_url\n\nHTTP:\n${http_code:-no response}\n\nCheck DNS, Cloudflare Tunnel, Apache, HTTPS and firewall before attempting indexing.")" 16 82

        prompt_yes_no "$(t "Continuar?" "Continue?")" \
            "$(t "O OPAC ainda não está respondendo corretamente.\n\nDeseja continuar com as verificações locais?" "The OPAC is not responding correctly yet.\n\nDo you want to continue with local checks?")" 11 74 || return 0
    fi

    if is_database_ready; then
        display_explanation "$(t "Verificando OpacMetaRobots..." "Checking OpacMetaRobots...")" \
            "$(t "Essa preferência pode permitir ou impedir a indexação do OPAC." "This preference can allow or prevent OPAC indexing.")"

