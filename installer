funcao_configurar_ssl() {
    perguntar "SSL / HTTPS" \
"$(t "Para gerar o certificado gratuito você PRECISA de um domínio\napontando (registro A) para o IP PÚBLICO deste servidor, e a\nporta 80 aberta na internet.\n\nSe você usa Cloudflare Tunnel, CANCELE: o HTTPS já vem de lá.\n\nContinuar?" \
"To issue the free certificate you NEED a domain with an A record\npointing to this server's PUBLIC IP, and port 80 reachable.\n\nIf you use Cloudflare Tunnel, CANCEL: HTTPS already comes from it.\n\nContinue?")" 15 76 || return 0
    clear
    if ! aguardar_travas_apt; then return 1; fi
    apt_atualizar_indices
    if ! apt_instalar certbot python3-certbot-apache; then
        restaurar_timers_apt
        return 1
    fi
    restaurar_timers_apt
    if ! certbot --apache; then
        msg_erro "" "$(t "O Certbot não conseguiu concluir a emissão/configuração do certificado. O Apache não será recarregado automaticamente." "Certbot could not complete certificate issuance/configuration. Apache will not be reloaded automatically.")" 10 78
        return 1
    fi
    if ! apachectl configtest; then
        msg_erro "" "$(t "O Apache ficou com configuração inválida após o Certbot. Não vou recarregar o serviço." "Apache configuration is invalid after Certbot. The service will not be reloaded.")" 10 76
        return 1
    fi
    if ! systemctl reload apache2 >/dev/null 2>&1; then
        msg_erro "" "$(t "O certificado foi configurado, mas o Apache não aceitou o reload. Verifique o status do serviço." "The certificate was configured, but Apache rejected the reload. Check the service status.")" 10 76
        return 1
    fi
    msg_ok "$(t "HTTPS configurado com sucesso. O Certbot manterá a renovação automática." "HTTPS configured successfully. Certbot will handle automatic renewal.")" 9 72
}

# ======================================================================
# 16. SIP2 E Z39.50
# ======================================================================
funcao_interoperabilidade() {
    exigir_koha || return 0
    perguntar "SIP2 & Z39.50" \
"$(t "Z39.50 (porta 2100): permite que outras bibliotecas busquem no seu acervo.\nSIP2 (porta 6001): permite ligar totens de autoatendimento.\n\nAtivar os dois e liberar as portas no firewall?" \
"Z39.50 (port 2100): lets other libraries search your catalog.\nSIP2 (port 6001): lets you connect self-checkout terminals.\n\nEnable both and open the firewall ports?")" 13 78 || return 0
    clear
    ufw allow 2100/tcp >/dev/null 2>&1 || true
    ufw allow 6001/tcp >/dev/null 2>&1 || true

    koha-z3950-responder --enable "$INSTANCIA" >/dev/null 2>&1 || true
    koha-sip --enable "$INSTANCIA" >/dev/null 2>&1 || true
    systemctl daemon-reload >/dev/null 2>&1 || true

    local z39_ok="nao" sip_ok="nao"
    if systemctl enable --now "koha-z3950-responder@${INSTANCIA}" >/dev/null 2>&1 || systemctl is-active --quiet "koha-z3950-responder@${INSTANCIA}"; then
        z39_ok="sim"
    fi
    if systemctl enable --now "koha-sip-daemon@${INSTANCIA}" >/dev/null 2>&1 || systemctl is-active --quiet "koha-sip-daemon@${INSTANCIA}"; then
        sip_ok="sim"
    fi

    if [ "$z39_ok" = "sim" ] && [ "$sip_ok" = "sim" ]; then
        msg_ok "$(t "Z39.50 e SIP2 foram ativados com sucesso!\n\nPara o SIP2 funcionar ainda é preciso criar uma conta com\npermissão de circulação e preencher:\n/etc/koha/sites/${INSTANCIA}/SIPconfig.xml" "Z39.50 and SIP2 were enabled successfully!\n\nFor SIP2 you still need a circulation account and\nto fill in:\n/etc/koha/sites/${INSTANCIA}/SIPconfig.xml")" 12 76
    else
        msg_erro "" "$(t "A ativação foi parcial.\n\nZ39.50: ${z39_ok}\nSIP2:    ${sip_ok}\n\nVeja os serviços com: systemctl status koha-z3950-responder@${INSTANCIA} koha-sip-daemon@${INSTANCIA}" "Activation was partial.\n\nZ39.50: ${z39_ok}\nSIP2:    ${sip_ok}\n\nCheck: systemctl status koha-z3950-responder@${INSTANCIA} koha-sip-daemon@${INSTANCIA}")" 12 78
        return 1
    fi
}

