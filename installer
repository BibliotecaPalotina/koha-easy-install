validate_and_register_rclone() {
    local name="$1" err
    [ -z "$name" ] && return 1
    if ! rclone listremotes 2>/dev/null | grep -qx "${name}:"; then
        msg_error "" "$(t "Não existe nenhuma conexão chamada '$name' no rclone.\n\nConexões existentes:\n$(rclone listremotes 2>/dev/null)" "There is no rclone remote called '$name'.\n\nExisting remotes:\n$(rclone listremotes 2>/dev/null)")" 14 74
        return 1
    fi
    if ! err=$(rclone mkdir "${name}:Backup_SQL_Koha" 2>&1); then
        msg_error "" "$(t "A conexão '$name' existe, mas o teste de escrita falhou.\n\nDetalhe:\n$err" "Remote '$name' exists but the write test failed.\n\nDetail:\n$err")" 16 78
        return 1
    fi
    rclone mkdir "${name}:Backup_MARC_Koha" >/dev/null 2>&1
    write_backup_config
    if grep -qE "^RCLONE_REMOTE=" "$BACKUP_CONF" 2>/dev/null; then
        sed -i -E "s|^RCLONE_REMOTE=.*|RCLONE_REMOTE=\"${name}\"|" "$BACKUP_CONF"
    else
        echo "RCLONE_REMOTE=\"${name}\"" >> "$BACKUP_CONF"
    fi
    if ! grep -qE "^RCLONE_REMOTE=\"${name}\"$" "$BACKUP_CONF" 2>/dev/null; then
        msg_error "" "$(t "A conexão foi validada, mas NÃO consegui salvar '${name}' em ${BACKUP_CONF}.\nVerifique as permissões do arquivo." "The remote was validated, but I could NOT save '${name}' in ${BACKUP_CONF}.\nCheck the file permissions.")" 11 76
        return 1
    fi
    chmod 600 "$BACKUP_CONF"
    log "rclone remote configurado: $name"
    display_explanation "Testando o envio real para a nuvem..." "Testing the real cloud upload..."
    bash /root/backup_sql.sh >/dev/null 2>&1
    if rclone lsf "${name}:Backup_SQL_Koha" 2>/dev/null | grep -q '\.sql\.gz$'; then
        msg_ok "$(t "Nuvem ativada e testada com sucesso.\n\nRemoto: ${name}\nPasta SQL: Backup_SQL_Koha (confirmada com arquivo dentro)" "Cloud enabled and tested successfully.\n\nRemote: ${name}\nSQL folder: Backup_SQL_Koha (confirmed with a file inside)")" 11 76
    else
        msg_info "$(t "Nuvem configurada" "Cloud configured")" "$(t "A configuração foi salva, mas não encontrei o arquivo de teste em ${name}:Backup_SQL_Koha.\n\nVeja o log: ${LOG_DIR}/backup_sql.log" "Configuration saved, but I could not find the test file at ${name}:Backup_SQL_Koha.\n\nCheck the log: ${LOG_DIR}/backup_sql.log")" 11 76
    fi
    return 0
}

function_configure_rclone() {
    local choice
    choice=$(whiptail --title "$(t "Backup em Nuvem" "Cloud Backup")" \
        --cancel-button "$(t "Voltar" "Back")" \
        --menu "$(t "Como deseja configurar o envio automático de Backups?" "How do you want to configure auto cloud backups?")" 15 76 2 \
        "1" "$(t "Expresso (Google Drive)" "Express (Google Drive)")" \
        "2" "$(t "Manual (Qualquer serviço - Assistente do Rclone)" "Manual (Any service - Rclone Wizard)")" 3>&1 1>&2 2>&3) || return 0
    [ -z "$choice" ] && return 0
    if [ "$choice" = "1" ]; then
        clear
        echo "======================================================================"
        echo -e "\e[1;36m$(t "CONFIGURAÇÃO EXPRESSA DO GOOGLE DRIVE (TERMINAL PURO)" "EXPRESS GOOGLE DRIVE CONFIGURATION (PURE TERMINAL)")\e[0m"
        echo "======================================================================"
        echo ""
        echo "$(t "Como este servidor não possui navegador web, você deve autorizar" "Because this server has no web browser, you must authorize")"
        echo "$(t "a conexão a partir do seu próprio computador pessoal (Windows/Mac/Linux)." "the connection from your personal computer (Windows/Mac/Linux).")"
        echo ""
        echo "----------------------------------------------------------------------"
        echo -e "\e[1;33m$(t "PASSO 1: No seu computador pessoal, abra o PowerShell (Windows) ou Terminal (Mac/Linux)." "STEP 1: On your personal PC, open PowerShell (Windows) or Terminal (Mac/Linux).")\e[0m"
        echo "$(t "Se estiver no Windows e o 'rclone' não for reconhecido, instale com: winget install Rclone.Rclone" "If on Windows and 'rclone' is not recognized, install with: winget install Rclone.Rclone")"
        echo ""
        echo '  rclone authorize "drive"'
        echo ""
        echo "----------------------------------------------------------------------"
        echo "$(t "PASSO 2: O navegador abrirá. Faça login na conta Google da biblioteca e autorize." "STEP 2: Your browser will open. Log in with the library Google account and authorize.")"
        echo "$(t "PASSO 3: O seu computador exibirá um código extenso iniciando com '{\"' e terminando com '}'.'" "STEP 3: Your PC will print a long token string starting with '{\"' and ending with '}'.")"
        echo "----------------------------------------------------------------------"
        echo ""
        local token_input=""
        while true; do
            echo -e "\e[1;32m$(t "Cole o bloco JSON completo do token abaixo e pressione [ENTER]:" "Paste the complete token JSON string below and press [ENTER]:")\e[0m"
            read -r token_input
            token_input=$(echo "$token_input" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
            if [ -z "$token_input" ]; then
                echo -e "\n\e[1;31m[ERRO] O token não pode ser vazio. Tente novamente ou tecle Ctrl+C para cancelar.\e[0m\n"
                continue
            fi
            if [[ ! "$token_input" =~ ^\{.*\}$ ]]; then
                echo -e "\n\e[1;31m[ERRO] Formato inválido! O token deve começar com '{' e terminar com '}'. Tente novamente:\e[0m\n"
                continue
            fi
            if ! python3 -c 'import sys, json; json.loads(sys.argv[1])' "$token_input" 2>/dev/null; then
                echo -e "\n\e[1;31m[ERRO] O JSON fornecido está corrompido ou foi cortado ao copiar. Tente novamente:\e[0m\n"
                continue
            fi
            break
        done
        echo ""
        echo -e "\e[1;34m[INFO] $(t "Registrando conexão remota 'gdrive' no Rclone..." "Registering 'gdrive' remote in Rclone...")\e[0m"
        rclone config delete gdrive >/dev/null 2>&1 || true
        if rclone config create gdrive drive config_is_local false token "$token_input" --non-interactive < /dev/null >/dev/null 2>&1; then
            echo -e "\e[1;32m[OK] $(t "Conexão 'gdrive' criada com sucesso!" "'gdrive' remote successfully created!")\e[0m"
            validate_and_register_rclone "gdrive"
        else
            echo -e "\e[1;31m[ERRO] $(t "Falha ao registrar a conexão no Rclone." "Failed to register connection in Rclone.")\e[0m"
            read -r -p "$(t "Pressione [ENTER] para voltar ao menu..." "Press [ENTER] to return to menu...")"
        fi
        return 0
    else
        clear
        rclone config
        local conn_name
        conn_name=$(whiptail --title "$(t "Nome da Conexão" "Remote Name")" \
            --inputbox "$(t "Digite o NOME EXATO criado no assistente do Rclone:" "Enter the EXACT NAME configured in Rclone:")" 10 70 3>&1 1>&2 2>&3) || return 0
        validate_and_register_rclone "$conn_name"
        return 0
    fi
}

