# ======================================================================
# 3. RESTAURAR BANCO (com rede de segurança)
# ======================================================================
funcao_restaurar_banco() {
    exigir_koha || return 0

    msg_info "$(t "Origem do Arquivo" "File Source")" \
"$(t "COMO TRAZER O BACKUP PARA O SERVIDOR\n\n  Pendrive/USB: costuma aparecer em /media ou /mnt\n  Pela rede:    scp seu_backup.sql.gz root@$(ip_servidor):${REAL_HOME}/\n\nNa próxima tela navegue até a pasta e escolha o arquivo." \
"HOW TO GET THE BACKUP ONTO THE SERVER\n\n  USB drive: usually under /media or /mnt\n  Network:   scp your_backup.sql.gz root@$(ip_servidor):${REAL_HOME}/\n\nOn the next screen browse to the folder and pick the file.")" 14 78

    local arquivo
    arquivo=$(selecionar_arquivo "$REAL_HOME") || return 0
    [ -z "$arquivo" ] && return 0

    # --- validação do arquivo ANTES de tocar no banco ---
    caixa_explicacao "Conferindo o arquivo de backup..." "Checking the backup file..."
    if [[ "$arquivo" == *.gz ]]; then
        if ! gzip -t "$arquivo" 2>/dev/null; then
            msg_erro "" "$(t "O arquivo está corrompido (falhou no teste do gzip).\nNada foi alterado." "The file is corrupt (failed the gzip test).\nNothing was changed.")" 9 70
            return 0
        fi
        if ! zcat "$arquivo" 2>/dev/null | head -c 200000 | grep -qi 'CREATE TABLE'; then
            perguntar "$(t "Arquivo suspeito" "Suspicious file")" "$(t "Não encontrei comandos SQL no início do arquivo.\nEle pode não ser um backup do Koha.\n\nContinuar mesmo assim?" "No SQL statements found at the start of the file.\nIt may not be a Koha backup.\n\nContinue anyway?")" 11 72 || return 0
        fi
    else
        if ! head -c 200000 "$arquivo" | grep -qi 'CREATE TABLE'; then
            perguntar "$(t "Arquivo suspeito" "Suspicious file")" "$(t "Não encontrei comandos SQL no início do arquivo.\n\nContinuar mesmo assim?" "No SQL statements found at the start of the file.\n\nContinue anyway?")" 10 72 || return 0
        fi
    fi

    perguntar "$(t "Confirmar Restauração" "Confirm Restore")" \
"$(t "Arquivo:\n$arquivo\n\nATENÇÃO: o acervo atual será SUBSTITUÍDO.\nUm backup de segurança do estado atual será gravado antes.\n\nContinuar?" \
"File:\n$arquivo\n\nWARNING: the current catalog will be REPLACED.\nA safety backup of the current state will be written first.\n\nContinue?")" 15 76 || return 0

    clear
    # --- backup de segurança do estado atual ---
    local resgate=""
    if [ "$(sql "SELECT 1 FROM information_schema.schemata WHERE schema_name='${DB_NAME}';")" = "1" ]; then
        caixa_explicacao "Gravando backup de segurança do banco atual..." "Writing a safety backup of the current database..."
        mkdir -p "$DIR_SQL"
        resgate="${DIR_SQL}/PRE-RESTAURACAO_$(date +%Y-%m-%d_%Hh%M).sql.gz"
        if mysqldump --single-transaction --quick "$DB_NAME" 2>/dev/null | gzip > "$resgate"; then
            echo "$(t "Backup de segurança:" "Safety backup:") $resgate"
        else
            rm -f "$resgate"; resgate=""
            perguntar "$(t "Aviso" "Warning")" "$(t "Não consegui gravar o backup de segurança.\nSe a restauração falhar não haverá como voltar.\n\nContinuar assim mesmo?" "Could not write the safety backup.\nIf the restore fails there will be no way back.\n\nContinue anyway?")" 11 72 || return 0
        fi
    fi

    caixa_explicacao "Recriando o banco com charset utf8mb4..." "Recreating the database with utf8mb4 charset..."
    koha_indexadores_gerenciar stop
    mysql -e "DROP DATABASE IF EXISTS ${DB_NAME};
              CREATE DATABASE ${DB_NAME} CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
              GRANT ALL PRIVILEGES ON ${DB_NAME}.* TO '${DB_NAME}'@'localhost';
              FLUSH PRIVILEGES;" || {
        msg_erro "" "$(t "Falha ao recriar o banco. Nada foi importado." "Failed to recreate the database. Nothing was imported.")" 9 70
        return 1
    }

    caixa_explicacao "Importando o acervo (pode demorar vários minutos)..." "Importing the catalog (may take several minutes)..."
    local ok="sim"
    if [[ "$arquivo" == *.gz ]]; then
        zcat "$arquivo" | mysql --default-character-set=utf8mb4 "$DB_NAME" || ok="nao"
    else
        mysql --default-character-set=utf8mb4 "$DB_NAME" < "$arquivo" || ok="nao"
    fi

    local tabelas; tabelas=$(sql "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='${DB_NAME}';")
    if [ "$ok" = "nao" ] || [ "${tabelas:-0}" -lt 50 ] 2>/dev/null; then
        if [ -n "$resgate" ] && perguntar "$(t "Restauração falhou" "Restore failed")" \
            "$(t "A importação falhou (${tabelas:-0} tabelas).\n\nQuer voltar ao estado anterior usando o backup de segurança?" "The import failed (${tabelas:-0} tables).\n\nRoll back to the previous state using the safety backup?")" 11 74; then
            caixa_explicacao "Revertendo para o estado anterior..." "Rolling back to the previous state..."
            mysql -e "DROP DATABASE IF EXISTS ${DB_NAME}; CREATE DATABASE ${DB_NAME} CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci; GRANT ALL PRIVILEGES ON ${DB_NAME}.* TO '${DB_NAME}'@'localhost'; FLUSH PRIVILEGES;"
            zcat "$resgate" | mysql "$DB_NAME"
            msg_info "$(t "Revertido" "Rolled back")" "$(t "O banco voltou ao estado anterior." "The database was rolled back.")" 8 64
        else
            msg_erro "" "$(t "A importação falhou. Backup de segurança em:\n$resgate" "The import failed. Safety backup at:\n$resgate")" 10 74
        fi
        return 1
    fi

    caixa_explicacao "Atualizando o schema para a versão instalada do Koha..." "Upgrading the schema to the installed Koha version..."
    systemctl restart memcached >/dev/null 2>&1
    koha-upgrade-schema "$INSTANCIA"

    caixa_explicacao "Sincronizando o motor de busca..." "Synchronizing the search engine..."
    local motor="Zebra"
    if dpkg -s koha-elasticsearch >/dev/null 2>&1 && koha_es_ativo_no_xml; then motor="Elasticsearch"; fi
    mysql -e "UPDATE ${DB_NAME}.systempreferences SET value='${motor}' WHERE variable='SearchEngine';" >/dev/null 2>&1
    systemctl restart memcached >/dev/null 2>&1

    if [ "$motor" = "Elasticsearch" ]; then
        koha_broker_preparar
        systemctl restart koha-common >/dev/null 2>&1
        koha_indexadores_gerenciar start
        local corte; corte=$(date '+%Y-%m-%d %H:%M:%S')
        koha-elasticsearch --rebuild -d "$INSTANCIA"
        koha_limpar_jobs_orfaos "$corte"
    else
        koha-zebra --enable "$INSTANCIA" >/dev/null 2>&1
        systemctl enable --now "koha-zebra-daemon@${INSTANCIA}" >/dev/null 2>&1
        koha-zebra --start "$INSTANCIA" >/dev/null 2>&1
        escrever_cron_zebra
        koha-rebuild-zebra -f -v -b -a "$INSTANCIA"
    fi

    koha-plack --restart "$INSTANCIA" >/dev/null 2>&1
    validar_sistema_completo "restauração do banco"
    log "restauracao concluida a partir de $arquivo (motor=$motor)"
    msg_ok "$(t "Acervo restaurado e indexado.\n\nMotor de busca: ${motor}\nTabelas: ${tabelas}\nBackup do estado anterior: ${resgate:-nenhum}" "Catalog restored and indexed.\n\nSearch engine: ${motor}\nTables: ${tabelas}\nPrevious-state backup: ${resgate:-none}")" 13 76
}

