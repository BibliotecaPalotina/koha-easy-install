# ======================================================================
# 18. CENTRAL DE SEGURANÇA
# ======================================================================
funcao_central_seguranca() {
    local opc jail info nova
    while true; do
        opc=$(whiptail --title "$(t "Central de Segurança" "Security Center")" \
            --cancel-button "$(t "Voltar" "Back")" \
            --menu "$(t "Escolha uma ação:" "Choose an action:")" 16 76 4 \
            "1" "$(t "Status do Fail2ban (tentativas de invasão)" "Fail2ban status (intrusion attempts)")" \
            "2" "$(t "Firewall do Staff (porta 8080)" "Staff firewall (port 8080)")" \
            "3" "$(t "Rotacionar a senha do banco" "Rotate the database password")" \
            "4" "$(t "Ver regras do firewall" "Show firewall rules")" 3>&1 1>&2 2>&3) || return 0
        [ -z "$opc" ] && return 0
        case "$opc" in
            1)
                info=""
                for jail in sshd apache-auth apache-badbots; do
                    info="${info}=== ${jail} ===\n$(fail2ban-client status "$jail" 2>/dev/null || echo "$(t "jail inativa" "jail inactive")")\n\n"
                done
                whiptail --title "Fail2ban" --scrolltext --msgbox "$(printf '%b' "$info")" 24 78 2>/dev/null || true
                ;;
            2)
                if perguntar "$(t "Firewall do Staff" "Staff firewall")" \
"$(t "A porta 80 (OPAC) deve ficar aberta para o público.\nA porta 8080 (administração) pode ser fechada para a internet\nse você usa Cloudflare Tunnel ou só acessa pela rede local.\n\nBLOQUEAR o acesso externo direto à 8080?" \
"Port 80 (OPAC) must stay open to the public.\nPort 8080 (staff) can be closed to the internet if you use\nCloudflare Tunnel or only access it from the local network.\n\nBLOCK direct external access to 8080?")" 14 78; then
                    ufw delete allow 8080/tcp >/dev/null 2>&1
                    ufw allow from 127.0.0.1 to any port 8080 >/dev/null 2>&1
                    ufw allow from 192.168.0.0/16 to any port 8080 >/dev/null 2>&1
                    ufw allow from 10.0.0.0/8 to any port 8080 >/dev/null 2>&1
                    ufw deny 8080/tcp >/dev/null 2>&1
                    msg_ok "$(t "Porta 8080 liberada só para 127.0.0.1 e rede local." "Port 8080 now allowed only from 127.0.0.1 and the local network.")" 9 72
                else
                    ufw delete deny 8080/tcp >/dev/null 2>&1
                    ufw allow 8080/tcp >/dev/null 2>&1
                    msg_ok "$(t "Porta 8080 aberta." "Port 8080 is open.")" 8 60
                fi
                ;;
            3)
                exigir_koha || continue
                perguntar "$(t "Rotacionar Senha" "Rotate Password")" \
"$(t "Vou gerar uma senha nova e forte para o usuário do banco,\natualizar o koha-conf.xml e reiniciar os serviços.\n\nContinuar?" \
"A new strong password will be generated for the database user,\nkoha-conf.xml updated and services restarted.\n\nContinue?")" 12 74 || continue
                clear
                nova=$(tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 24)
                local xml_bak="${KOHA_CONF}.bak-$(date +%s)"
                cp -f "$KOHA_CONF" "$xml_bak" || {
                    msg_erro "" "$(t "Não consegui criar o backup do koha-conf.xml. A senha não foi alterada." "Could not back up koha-conf.xml. Password was not changed.")" 9 74
                    continue
                }
                if mysql -e "ALTER USER '${DB_NAME}'@'localhost' IDENTIFIED BY '${nova}'; FLUSH PRIVILEGES;"; then
                    sed -i "s|<pass>[^<]*</pass>|<pass>${nova}</pass>|g" "$KOHA_CONF"
                    if ! xmllint --noout "$KOHA_CONF" >/dev/null 2>&1; then
                        cp -f "$xml_bak" "$KOHA_CONF"
                        mysql -e "ALTER USER '${DB_NAME}'@'localhost' IDENTIFIED BY '$(senha_banco)'; FLUSH PRIVILEGES;" >/dev/null 2>&1 || true
                        msg_erro "" "$(t "A nova senha foi desfeita porque o koha-conf.xml ficou inválido.
Nada foi reiniciado." "The new password was rolled back because koha-conf.xml became invalid.
Nothing was restarted.")" 11 76
                        continue
                    fi
                    sed -i "s|Senha   / Password    : .*|Senha   / Password    : ${nova}|" /root/credenciais_koha.txt 2>/dev/null
                    systemctl restart memcached koha-common >/dev/null 2>&1
                    koha-plack --restart "$INSTANCIA" >/dev/null 2>&1
                    sleep 2
                    if validar_http "http://127.0.0.1:8080/" "Staff" >/dev/null 2>&1; then
                        log "senha do banco rotacionada"
                        msg_ok "$(t "Senha rotacionada e o Koha continua respondendo.\n\nNova senha: ${nova}\n(salva em /root/credenciais_koha.txt)" "Password rotated and Koha still responds.\n\nNew password: ${nova}\n(saved in /root/credenciais_koha.txt)")" 12 74
                    else
                        msg_erro "" "$(t "A senha mudou, mas o Koha não respondeu no teste.\nCópia do XML anterior em ${KOHA_CONF}.bak-*" "Password changed but Koha did not answer the test.\nPrevious XML copy at ${KOHA_CONF}.bak-*")" 11 76
                    fi
                else
                    msg_erro "" "$(t "Falha ao alterar a senha no MariaDB. Nada foi mudado." "Failed to change the password in MariaDB. Nothing was changed.")" 9 72
                fi
                ;;
            4)
                whiptail --title "UFW" --scrolltext --msgbox "$(ufw status verbose 2>/dev/null || echo 'ufw?')" 24 78 2>/dev/null || true
                ;;
        esac
    done
}

# ======================================================================
# 19. ATUALIZAR SISTEMA E SCHEMAS
# ======================================================================
funcao_atualizar_sistema() {
    perguntar "$(t "Atualizar" "Update")" \
"$(t "Vou atualizar os pacotes do sistema e do Koha e aplicar as\nmigrações de banco.\n\nRecomendado: gere um backup antes (opção 4).\n\nContinuar?" \
"System and Koha packages will be updated and database\nmigrations applied.\n\nRecommended: make a backup first (option 4).\n\nContinue?")" 13 74 || return 0
    clear
    if ! aguardar_travas_apt; then return 1; fi
    apt_atualizar_indices
    if ! DEBIAN_FRONTEND=noninteractive apt-get upgrade "${APT_OPTS[@]}"; then
        restaurar_timers_apt
        msg_erro "" "$(t "A atualização dos pacotes falhou. As migrações do Koha não serão executadas." "Package upgrade failed. Koha migrations will not run.")" 10 76
        return 1
    fi
    if koha_instalado; then
        caixa_explicacao "Aplicando migrações do banco..." "Applying database migrations..."
        if ! koha-upgrade-schema "$INSTANCIA"; then
            restaurar_timers_apt
            msg_erro "" "$(t "A migração do banco falhou. Os serviços não serão reiniciados automaticamente para evitar esconder o erro." "Database migration failed. Services will not be restarted automatically to avoid hiding the error.")" 11 78
            return 1
        fi
        if ! systemctl restart memcached apache2 koha-common >/dev/null 2>&1; then
            restaurar_timers_apt
            msg_erro "" "$(t "Um dos serviços principais não reiniciou após a atualização." "One of the core services did not restart after the update.")" 9 72
            return 1
        fi
        if ! koha-plack --restart "$INSTANCIA" >/dev/null 2>&1; then
            restaurar_timers_apt
            msg_erro "" "$(t "O Plack não reiniciou após a atualização." "Plack did not restart after the update.")" 9 70
            return 1
        fi
        if [ "$(obter_motor_busca)" = "Elasticsearch" ]; then
            if ! koha_indexadores_gerenciar start; then
                restaurar_timers_apt
                msg_erro "" "$(t "O indexador Elasticsearch não pôde ser iniciado após a atualização." "The Elasticsearch indexer could not be started after the update.")" 10 76
                return 1
            fi
        else
            if ! systemctl restart "koha-zebra-daemon@${INSTANCIA}" >/dev/null 2>&1; then
                restaurar_timers_apt
                msg_erro "" "$(t "O Zebra não pôde ser iniciado após a atualização." "Zebra could not be started after the update.")" 9 72
                return 1
            fi
        fi
    fi
    caixa_explicacao "Limpando pacotes órfãos..." "Cleaning orphan packages..."
    apt-get clean -y >/dev/null 2>&1 || true
    DEBIAN_FRONTEND=noninteractive apt-get autoremove --purge -y >/dev/null 2>&1 || true
    journalctl --vacuum-time=14d >/dev/null 2>&1 || true
    restaurar_timers_apt
    if validar_sistema_completo "atualização do sistema"; then
        msg_ok "$(t "Atualização concluída sem erros críticos." "Update finished with no critical errors.")" 9 70
    else
        msg_info "$(t "Atualização com avisos" "Update with warnings")" "$(t "A atualização rodou, mas a validação achou $V_FAIL falha(s) e $V_WARN aviso(s).\n\nLog: $VALIDACAO_LOG" "The update ran but validation found $V_FAIL failure(s) and $V_WARN warning(s).\n\nLog: $VALIDACAO_LOG")" 11 76
        mostrar_validacao
        return 1
    fi
    return 0
}

# ======================================================================
