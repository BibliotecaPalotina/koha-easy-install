# MOTOR DE BUSCA: XML, INDEXADOR E MENSAGERIA / SEARCH ENGINE: XML & BROKER
# ======================================================================
edit_xml() {
    python3 - "$1" "$2" "$KOHA_CONF" "${3:-}" << 'PYEOF'
import re, sys, os, tempfile

action, tag, path, body = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]

with open(path, "r", encoding="utf-8") as f:
    text = f.read()

parts = re.split(r"(<!--.*?-->)", text, flags=re.DOTALL)
pattern = re.compile(r"[ \t]*<%s>.*?</%s>[ \t]*\n?" % (tag, tag), re.DOTALL)
for i, p in enumerate(parts):
    if not p.startswith("<!--"):
        parts[i] = pattern.sub("", p)
text = "".join(parts)

if action == "inserir":
    if "</config>" not in text:
        sys.exit("ERRO: </config> nao encontrado em koha-conf.xml")
    text = text.replace("</config>", body + "</config>", 1)

st = os.stat(path)
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path))
with os.fdopen(fd, "w", encoding="utf-8") as f:
    f.write(text)
os.chown(tmp, st.st_uid, st.st_gid)
os.chmod(tmp, st.st_mode)
os.replace(tmp, path)
PYEOF
}

set_xml_elasticsearch() {
    local body=""
    [ -f "$KOHA_CONF" ] || return 1
    if [ "$1" = "inserir" ]; then
        body=$(printf '  <elasticsearch>\n    <server>127.0.0.1:9200</server>\n    <index_name>%s</index_name>\n  </elasticsearch>\n' "${DB_NAME}")
    fi
    edit_xml "$1" "elasticsearch" "$body" || return 1
    if command -v xmllint >/dev/null 2>&1 && ! xmllint --noout "$KOHA_CONF" >/dev/null 2>&1; then
        msg_error "" "$(t "A edição do koha-conf.xml gerou um XML inválido. Restaure pelo backup automático do Koha." "Editing koha-conf.xml produced invalid XML. Restore from Koha's own backup.")" 10 74
        return 1
    fi
    return 0
}

is_koha_es_active_in_xml() {
    [ -f "$KOHA_CONF" ] || return 1
    if command -v xmllint >/dev/null 2>&1; then
        local n
        n=$(xmllint --xpath 'count(/config/elasticsearch)' "$KOHA_CONF" 2>/dev/null || echo 0)
        [ "$n" -gt 0 ] && return 0
    fi
    python3 - "$KOHA_CONF" << 'PYEOF'
import sys, re
with open(sys.argv[1], 'r', encoding='utf-8') as f:
    txt = f.read()
clean = re.sub(r'<!--.*?-->', '', txt, flags=re.DOTALL)
if '<elasticsearch>' in clean:
    sys.exit(0)
sys.exit(1)
PYEOF
}

