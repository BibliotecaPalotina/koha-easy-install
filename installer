define_koha_sites_conf() {
    local f="/etc/koha/koha-sites.conf"
    [ -f "$f" ] || return 0
    cp -f "$f" "${f}.bak-$(date +%s)" 2>/dev/null
    set_conf() {
        local key="$1" val="$2"
        if grep -qE "^[[:space:]]*#?[[:space:]]*${key}=" "$f"; then
            sed -i -E "s|^[[:space:]]*#?[[:space:]]*${key}=.*|${key}=\"${val}\"|" "$f"
        else
            echo "${key}=\"${val}\"" >> "$f"
        fi
    }
    set_conf INTRAPORT 8080
    set_conf OPACPORT 80
    set_conf USE_MEMCACHED yes
    set_conf MEMCACHED_SERVERS "127.0.0.1:11211"
    set_conf MEMCACHED_PREFIX "koha_"
    set_conf ZEBRA_MARC_FORMAT marc21
    set_conf ZEBRA_LANGUAGE en
    if [ -f /etc/koha/koha-conf-site.xml.in ]; then
        sed -i 's/__MEMCACHED_SERVERS__/127.0.0.1:11211/g; s/__MEMCACHED_PREFIX__/koha_/g' /etc/koha/koha-conf-site.xml.in
    fi
}

choose_timezone() {
    local current choice
    current=$(timedatectl show -p Timezone --value 2>/dev/null)
    choice=$(whiptail --title "$(t "Fuso Horário" "Timezone")" \
        --cancel-button "$(t "Manter" "Keep")" \
        --menu "$(t "Atual:" "Current:") ${current:-UTC}\n\n$(t "Escolha o fuso do servidor:" "Choose the server timezone:")" 20 72 9 \
        "America/Sao_Paulo"  "Brasil - Brasilia/SP/RJ/PR/SC/RS/MG" \
        "America/Manaus"     "Brasil - Amazonas / Mato Grosso" \
        "America/Belem"      "Brasil - Para / Amapa" \
        "America/Fortaleza"  "Brasil - Nordeste" \
        "America/Rio_Branco" "Brasil - Acre" \
        "Europe/Lisbon"      "Portugal" \
        "UTC"                "UTC" \
        "OUTRO"              "$(t "Outro (lista completa)" "Other (full list)")" 3>&1 1>&2 2>&3) || return 1
    [ -z "$choice" ] && return 1
    if [ "$choice" = "OUTRO" ]; then
        clear
        dpkg-reconfigure tzdata
        return 1
    fi
    printf '%s' "$choice"
}

