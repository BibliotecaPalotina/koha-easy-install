# 6. CENTRO DE DIAGNÓSTICO, BACKUP E REPARO DO BANCO / DIAGNOSTICS & REPAIR
# ======================================================================
function_validate_repair_database() {
    require_database || return 0

    while true; do
        local sub_choice
        sub_choice=$(dialog --title "$(t "Centro de Diagnóstico e Reparo de Dados" "Data Diagnostics & Repair Center")" \
        --menu "$(t "Selecione a ferramenta de manutenção desejada:" "Select the desired maintenance tool:")" 18 78 4 \
        "1" "$(t "Validar e testar o último backup existente (Dry-Run)" "Validate and test latest existing backup (Dry-Run)")" \
        "2" "$(t "Checar integridade estrutural das tabelas (CHECK)" "Check structural table integrity (CHECK)")" \
        "3" "$(t "Diagnóstico completo do banco e estatísticas (ANALYZE)" "Full database diagnostics and stats (ANALYZE)")" \
        "4" "$(t "Executar reparo, otimização e limpeza de rotina (REPAIR)" "Run repair, optimization and routine cleanup (REPAIR)")" \
        3>&1 1>&2 2>&3)

        [[ $? -ne 0 ]] && break

        case "$sub_choice" in
            1)
                # Sub-ação 1: O antigo Teste de Backup (Opção 6 original)
                function_test_latest_backup_internal
                ;;
            2)
                # Sub-ação 2: Checagem rápida de tabelas (CHECK)
                if ! backup_lock_acquire; then
                    msg_error "" "$(t "Operação em andamento. Tente novamente." "Operation in progress. Try again.")" 8 60
                    continue
                fi
                clear
                display_explanation "A Executar checagem de tabelas (MariaDB CHECK)..." "Running table check (MariaDB CHECK)..."
                local check_log="${LOG_DIR}/mariadb_check-$(date '+%Y%m%d-%H%M%S').log"
                local check_rc=0
                {
                    echo "=== RELATÓRIO DE CHECAGEM DE TABELAS ==="
                    mysqlcheck --check --databases "$DB_NAME" || check_rc=$?
                } > "$check_log" 2>&1
                backup_lock_release
                dialog --title "$(t "Resultado da Checagem" "Check Result")" --scrolltext --textbox "$check_log" 20 80 2>/dev/null || true
                if [ "$check_rc" -eq 0 ]; then
                    msg_ok "$(t "Checagem de integridade concluída sem erros." "Integrity check completed without errors.")" 8 58
                else
                    msg_error "" "$(t "A checagem encontrou falhas. Veja o relatório salvo em:
${check_log}" "The integrity check found failures. See the report saved at:
${check_log}")" 10 74
                fi
                ;;
            3)
                # Sub-ação 3: Diagnóstico e análise estatística (ANALYZE)
                if ! backup_lock_acquire; then
                    msg_error "" "$(t "Operação em andamento. Tente novamente." "Operation in progress. Try again.")" 8 60
                    continue
                fi
                clear
                display_explanation "Analisando estatísticas de índices do banco..." "Analyzing database index statistics..."
                local analyze_log="${LOG_DIR}/mariadb_analyze-$(date '+%Y%m%d-%H%M%S').log"
                local analyze_rc=0
                {
                    echo "=== RELATÓRIO DE ANÁLISE (ANALYZE) ==="
                    mysqlcheck --analyze --databases "$DB_NAME" || analyze_rc=$?
                } > "$analyze_log" 2>&1
                backup_lock_release
                dialog --title "$(t "Relatório de Diagnóstico" "Diagnostics Report")" --scrolltext --textbox "$analyze_log" 20 80 2>/dev/null || true
                if [ "$analyze_rc" -eq 0 ]; then
                    msg_ok "$(t "Diagnóstico de estatísticas concluído sem erros." "Statistics diagnostics completed without errors.")" 8 62
                else
                    msg_error "" "$(t "A análise encontrou falhas. Veja o relatório salvo em:
${analyze_log}" "The analysis found failures. See the report saved at:
${analyze_log}")" 10 74
                fi
                ;;
            4)
                # Sub-ação 4: Reparo profundo, otimização e limpeza de rotina
                prompt_yes_no "$(t "Executar Reparo e Otimização" "Run Repair and Optimization")" \
                "$(t "Esta rotina vai:\n- Reparar tabelas corrompidas (REPAIR)\n- Desfragmentar índices e recuperar espaço em disco (OPTIMIZE)\n- Limpar sessões órfãs e filas antigas do Koha\n- Aplicar retenção de logs do sistema (14 dias)\n\nDeseja iniciar?" \
                "This routine will:\n- Repair corrupted tables (REPAIR)\n- Defragment indices and reclaim disk space (OPTIMIZE)\n- Clean orphaned sessions and old Koha queues\n- Apply system log retention (14 days)\n\nDo you want to start?")" 16 76 || continue

                if ! backup_lock_acquire; then
                    msg_error "" "$(t "Operação bloqueada por outra tarefa." "Operation blocked by another task.")" 8 60
                    continue
                fi

                clear
                display_explanation "Executando procedimento de autocura e otimização..." "Running self-healing and optimization procedure..."
                local repair_log="${LOG_DIR}/mariadb_repair_full-$(date '+%Y%m%d-%H%M%S').log"
                local repair_rc=0
                {
                    echo "=========================================================="
                    echo "MANUTENÇÃO PROFUNDA E AUTOCURA DO SISTEMA - $(date)"
                    echo "=========================================================="

                    echo "[1/4] Reparando tabelas..."
                    mysqlcheck --repair --databases "$DB_NAME" || repair_rc=$?

                    echo -e "\n[2/4] Otimizando banco de dados..."
                    mysqlcheck --optimize --databases "$DB_NAME" || repair_rc=$?

                    echo -e "\n[3/4] Limpando filas e sessões do Koha..."
                    koha-shell "$INSTANCE" -c "/usr/share/koha/bin/cronjobs/cleanup_database.pl --sessions --sessdays 7 --zebraqueue 10" || repair_rc=$?

                    echo -e "\n[4/4] Limpando logs antigos do sistema (Journalctl 14 dias)..."
                    journalctl --vacuum-time=14d || repair_rc=$?
                } > "$repair_log" 2>&1

                backup_lock_release
                systemctl restart memcached >/dev/null 2>&1 || true

                dialog --title "$(t "Relatório de Manutenção e Reparo" "Maintenance & Repair Report")" --scrolltext --textbox "$repair_log" 22 84 2>/dev/null || true
                if [ "$repair_rc" -eq 0 ]; then
                    msg_ok "$(t "Procedimento de reparo e otimização concluído sem erros." "Repair and optimization procedure completed without errors.")" 10 72
                else
                    msg_error "" "$(t "A rotina terminou, mas uma ou mais etapas falharam. Veja:
${repair_log}" "The routine finished, but one or more steps failed. See:
${repair_log}")" 10 74
                fi
                ;;
        esac
    done
}

# Função auxiliar para encapsular o teste do último backup (Dry-Run original)
function_test_latest_backup_internal() {
    local backup_dir="/var/backups/koha_sql"
    local latest_backup
    latest_backup=$(find "$backup_dir" -type f \( -name "*.sql" -o -name "*.sql.gz" \) -printf '%T@ %p\n' 2>/dev/null | sort -n | tail -1 | cut -f2- -d' ')

    if [[ -z "$latest_backup" ]]; then
        msg_error "" "$(t "Nenhum arquivo de backup encontrado em ${backup_dir}." "No backup file found in ${backup_dir}.")" 9 70
        return 1
    fi

    if ! backup_lock_acquire; then
        msg_error "" "$(t "Operação bloqueada por outra tarefa." "Operation blocked by another task.")" 8 60
        return 1
    fi

    clear
    display_explanation "Testando integridade do último backup em base temporária..." "Testing latest backup integrity in a temporary database..."

    local test_db="koha_restore_test_$$_$(date +%s)"
    test_db=$(printf '%s' "$test_db" | tr -cd 'A-Za-z0-9_')
    local import_ok="yes"
    local tables_count="0"
    local schema_ok="no"

    if ! mysql -e "DROP DATABASE IF EXISTS ${test_db}; CREATE DATABASE ${test_db} CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;" 2>/dev/null; then
        backup_lock_release
        msg_error "" "$(t "Não foi possível criar a base temporária para o teste." "Could not create the temporary database for the test.")" 9 74
        return 1
    fi

    if [[ "$latest_backup" =~ \.gz$ ]]; then
        if ! gzip -dc "$latest_backup" | mysql --default-character-set=utf8mb4 "$test_db" 2>/dev/null; then
            import_ok="no"
        fi
    else
        if ! mysql --default-character-set=utf8mb4 "$test_db" < "$latest_backup" 2>/dev/null; then
            import_ok="no"
        fi
    fi

    if [ "$import_ok" = "yes" ] && required_koha_tables_present "$test_db"; then
        schema_ok="yes"
    fi
    tables_count=$(mysql -N -e "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='${test_db}';" 2>/dev/null || echo "0")
    mysql -e "DROP DATABASE IF EXISTS ${test_db};" 2>/dev/null || true
    backup_lock_release

    if [[ "$import_ok" = "yes" ]] && [[ "$tables_count" =~ ^[0-9]+$ ]] && [ "$tables_count" -ge 5 ] && [ "$schema_ok" = "yes" ]; then
        msg_ok "$(t "Sucesso! O backup mais recente (${latest_backup##*/}) foi importado em uma base temporária e passou na validação estrutural mínima (${tables_count} tabelas)." "Success! The latest backup (${latest_backup##*/}) was imported into a temporary database and passed minimum schema validation (${tables_count} tables)." "¡Éxito! La copia más reciente (${latest_backup##*/}) se importó en una base temporal y pasó la validación estructural mínima (${tables_count} tablas).")" 12 84
        return 0
    fi

    if [[ "$import_ok" = "no" ]]; then
        msg_error "" "$(t "O backup mais recente falhou durante a importação na base temporária. O arquivo original não foi alterado." "The latest backup failed during import into the temporary database. The original file was not changed.")" 10 76
    else
        msg_error "" "$(t "A importação terminou, mas a base temporária não passou na validação estrutural mínima. O arquivo pode estar incompleto ou ser de outro sistema." "Import finished, but the temporary database failed the minimum schema validation. The file may be incomplete or from another system." "La importación terminó, pero la base temporal no pasó la validación estructural mínima. El archivo puede estar incompleto o pertenecer a otro sistema.")" 12 82
    fi
    return 1
}

