escrever_config_backup() {
    [ -f "$BACKUP_CONF" ] && return 0
    cat > "$BACKUP_CONF" << 'EOF'
# Configuração dos backups do Koha / Koha backup settings.
# Editada automaticamente pela opção 10 do painel (Backup em Nuvem).
RCLONE_REMOTE=""
RCLONE_PASTA_SQL="Backup_SQL_Koha"
RCLONE_PASTA_MARC="Backup_MARC_Koha"
MANTER_DIAS=7
EOF
    chmod 600 "$BACKUP_CONF"
}

escrever_scripts_backup() {
    mkdir -p "$DIR_SQL" "$DIR_MARC"
    escrever_config_backup

    cat > /root/backup_sql.sh << EOF
#!/bin/bash
# Backup do banco do Koha. Gerado pelo Koha Easy Install.
set -o pipefail
umask 077
CONF="${BACKUP_CONF}"
DB="${DB_NAME}"
DIR="${DIR_SQL}"
LOG="${LOG_DIR}/backup_sql.log"
LOCK_FILE="/var/lock/koha_backup.lock"
RCLONE_REMOTE=""; RCLONE_PASTA_SQL="Backup_SQL_Koha"; MANTER_DIAS=7
[ -f "\$CONF" ] && . "\$CONF"
case "\${MANTER_DIAS}" in ''|*[!0-9]*) MANTER_DIAS=7;; esac

registrar() { mkdir -p "\$(dirname "\$LOG")" "\$DIR"; printf '%s | %s\\n' "\$(date '+%F %T')" "\$*" >> "\$LOG"; }
exec 9>"\$LOCK_FILE"
if ! flock -n 9; then
    registrar "INFO: backup SQL ignorado porque outro backup/restauracao esta em andamento"
    exit 0
fi
mkdir -p "\$DIR"

ARQ="\$DIR/\${DB}_\$(date +%Y-%m-%d_%Hh%M).sql.gz"

if ! mysqldump --single-transaction --quick --routines --triggers \\
        --default-character-set=utf8mb4 "\$DB" 2>>"\$LOG" | gzip > "\$ARQ"; then
    registrar "FALHA ao gerar \$ARQ"
    rm -f "\$ARQ"
    exit 1
fi

if ! gzip -t "\$ARQ" 2>/dev/null; then
    registrar "FALHA: arquivo corrompido, removido: \$ARQ"
    rm -f "\$ARQ"
    exit 1
fi

TAM=\$(stat -c %s "\$ARQ" 2>/dev/null || echo 0)
if [ "\$TAM" -lt 10240 ]; then
    registrar "FALHA: backup suspeito (\$TAM bytes), removido: \$ARQ"
    rm -f "\$ARQ"
    exit 1
fi
registrar "OK: \$ARQ (\$TAM bytes)"

# Sanitiza e valida o remoto antes de enviar para a nuvem
RCLONE_REMOTE="\$(printf '%s' "\$RCLONE_REMOTE" | xargs)"
if [ -n "\$RCLONE_REMOTE" ] && [ -f /root/.config/rclone/rclone.conf ]; then
    if ! rclone listremotes --config /root/.config/rclone/rclone.conf 2>/dev/null | grep -qx "\${RCLONE_REMOTE}:"; then
        registrar "AVISO: RCLONE_REMOTE='\${RCLONE_REMOTE}' não existe no rclone.conf; upload pulado"
    elif /usr/bin/rclone --config /root/.config/rclone/rclone.conf copy "\$ARQ" "\${RCLONE_REMOTE}:\${RCLONE_PASTA_SQL}/" >>"\$LOG" 2>&1; then
        registrar "Nuvem OK: \${RCLONE_REMOTE}:\${RCLONE_PASTA_SQL}/"
    else
        registrar "AVISO: envio para a nuvem falhou (cópia local preservada)"
    fi
fi

find "\$DIR" -name '*.sql.gz' -mtime "+\${MANTER_DIAS}" -delete 2>/dev/null
exit 0
EOF

    cat > /root/backup_marc.sh << EOF
#!/bin/bash
# Backup dos registros MARC21 (bibliográficos e autoridades).
set -o pipefail
umask 077
CONF="${BACKUP_CONF}"
INST="${INSTANCIA}"
DIR="${DIR_MARC}"
LOG="${LOG_DIR}/backup_marc.log"
LOCK_FILE="/var/lock/koha_backup.lock"
RCLONE_REMOTE=""; RCLONE_PASTA_MARC="Backup_MARC_Koha"; MANTER_DIAS=7
[ -f "\$CONF" ] && . "\$CONF"
case "\${MANTER_DIAS}" in ''|*[!0-9]*) MANTER_DIAS=7;; esac

registrar() { mkdir -p "\$(dirname "\$LOG")" "\$DIR"; printf '%s | %s\\n' "\$(date '+%F %T')" "\$*" >> "\$LOG"; }
exec 9>"\$LOCK_FILE"
if ! flock -n 9; then
    registrar "INFO: backup MARC ignorado porque outro backup/restauracao esta em andamento"
    exit 0
fi
mkdir -p "\$DIR"

EXPORT="/usr/share/koha/bin/export_records.pl"
[ -f "\$EXPORT" ] || EXPORT="\$(find /usr/share/koha -name export_records.pl 2>/dev/null | head -n1)"
if [ -z "\$EXPORT" ]; then registrar "FALHA: export_records.pl nao encontrado"; exit 1; fi

DATA=\$(date '+%Y-%m-%d_%H%M')
BIB="\$DIR/biblios_\${DATA}.mrc"
AUT="\$DIR/authorities_\${DATA}.mrc"
PACOTE="\$DIR/koha_marc_\${DATA}.tar.gz"

if ! /usr/sbin/koha-shell "\$INST" -c "perl \$EXPORT --record-type=bibs --format=marc --filename=\$BIB" >>"\$LOG" 2>&1; then
    registrar "FALHA: exportacao bibliografica"; rm -f "\$BIB" "\$AUT"; exit 1
fi
if ! /usr/sbin/koha-shell "\$INST" -c "perl \$EXPORT --record-type=auths --format=marc --filename=\$AUT" >>"\$LOG" 2>&1; then
    registrar "FALHA: exportacao de autoridades"; rm -f "\$BIB" "\$AUT"; exit 1
fi

if [ ! -s "\$BIB" ]; then
    registrar "FALHA: exportacao bibliografica vazia"
    rm -f "\$BIB" "\$AUT"
    exit 1
fi
if [ ! -s "\$AUT" ]; then
    registrar "AVISO: exportacao de authorities vazia"
fi

if ! tar -czf "\$PACOTE" -C "\$DIR" "\$(basename "\$BIB")" "\$(basename "\$AUT")" 2>>"\$LOG"; then
    registrar "FALHA: criacao do pacote MARC"
    rm -f "\$PACOTE" "\$BIB" "\$AUT"
    exit 1
fi
rm -f "\$BIB" "\$AUT"
if ! tar -tzf "\$PACOTE" >/dev/null 2>&1; then
    registrar "FALHA: pacote MARC não passou no teste tar.gz"
    rm -f "\$PACOTE"
    exit 1
fi
registrar "OK: \$PACOTE (\$(stat -c %s "\$PACOTE" 2>/dev/null) bytes)"

# Sanitiza e valida o remoto antes de enviar o pacote MARC para a nuvem
RCLONE_REMOTE="\$(printf '%s' "\$RCLONE_REMOTE" | xargs)"
if [ -n "\$RCLONE_REMOTE" ] && [ -f /root/.config/rclone/rclone.conf ]; then
    if ! rclone listremotes --config /root/.config/rclone/rclone.conf 2>/dev/null | grep -qx "\${RCLONE_REMOTE}:"; then
        registrar "AVISO: RCLONE_REMOTE='\${RCLONE_REMOTE}' não existe no rclone.conf; upload pulado"
    elif /usr/bin/rclone --config /root/.config/rclone/rclone.conf copy "\$PACOTE" "\${RCLONE_REMOTE}:\${RCLONE_PASTA_MARC}/" >>"\$LOG" 2>&1; then
        registrar "Nuvem OK: \${RCLONE_REMOTE}:\${RCLONE_PASTA_MARC}/"
    else
        registrar "AVISO: envio para a nuvem falhou"
    fi
fi

find "\$DIR" -name 'koha_marc_*.tar.gz' -mtime "+\${MANTER_DIAS}" -delete 2>/dev/null
exit 0
EOF

    chmod 700 /root/backup_sql.sh /root/backup_marc.sh
    chown root:root /root/backup_sql.sh /root/backup_marc.sh
}

escrever_cron_tarefas() {
    local bloco_email=""
    if [ -f "$CRON_TASKS" ] && grep -q '^# BEGIN KOHA EMAIL NOTICES' "$CRON_TASKS"; then
        bloco_email=$(sed -n '/^# BEGIN KOHA EMAIL NOTICES$/,/^# END KOHA EMAIL NOTICES$/p' "$CRON_TASKS")
    fi

    cat > "$CRON_TASKS" << EOF
# ======================================================================
# KOHA EASY INSTALL - TAREFAS AUTOMATICAS / SCHEDULED TASKS
# ======================================================================
# COMO AJUSTAR A HORA / HOW TO CHANGE TIME
# Colunas: MINUTO HORA DIA_DO_MES MES DIA_DA_SEMANA(0=domingo) usuario comando
# Exemplo: "30 01 * * *" = todo dia as 01:30.
# Mexa apenas nas duas primeiras colunas (minuto e hora).
# ======================================================================
$CRON_PATH
MAILTO=""

# 1. Limpeza de logs do sistema (todo dia as 00:30)
30 0 * * * root /usr/bin/journalctl --vacuum-time=14d >/dev/null 2>&1

# 2. Verificacao e reparo do banco (dia 5 de cada mes, 01:00)
0 1 5 * * root /usr/bin/mysqlcheck --check --databases ${DB_NAME} >/dev/null 2>&1

# 3. Reinicio preventivo do Plack para liberar memoria (todo dia as 05:00)
0 5 * * * root /usr/sbin/koha-plack --restart ${INSTANCIA} >/dev/null 2>&1

# 4. BACKUP DIARIO DO BANCO + ENVIO PARA A NUVEM (todo dia as 23:00)
0 23 * * * root /bin/bash /root/backup_sql.sh >/dev/null 2>&1

# 5. BACKUP SEMANAL DOS REGISTROS MARC21 (domingos as 03:00)
0 3 * * 0 root /bin/bash /root/backup_marc.sh >/dev/null 2>&1

# 6. Limpeza de sessoes antigas e filas do Koha (todo dia as 01:30)
30 1 * * * root /usr/sbin/koha-shell ${INSTANCIA} -c "/usr/share/koha/bin/cronjobs/cleanup_database.pl --sessions --sessdays 2 --zebraqueue 10" >/dev/null 2>&1

EOF

    if [ -n "$bloco_email" ]; then
        printf '%s\n' "$bloco_email" >> "$CRON_TASKS"
    else
        cat >> "$CRON_TASKS" << EOF
# BEGIN KOHA EMAIL NOTICES
# 7. Avisos de atraso (08:00) e processamento da fila de e-mails (08:05)
0 8 * * * root /usr/sbin/koha-shell ${INSTANCIA} -c "/usr/share/koha/bin/cronjobs/overdue_notices.pl -v -t" >/dev/null 2>&1
5 8 * * * root /usr/sbin/koha-shell ${INSTANCIA} -c "/usr/share/koha/bin/cronjobs/process_message_queue.pl -v" >/dev/null 2>&1
# END KOHA EMAIL NOTICES
EOF
    fi

    chmod 644 "$CRON_TASKS"
    chown root:root "$CRON_TASKS"
    systemctl restart cron >/dev/null 2>&1
}

