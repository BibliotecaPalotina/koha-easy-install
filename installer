UPDATE_URL="https://raw.githubusercontent.com/BibliotecaPalotina/koha-easy-install/refs/heads/main/installer"

# ======================================================================
# 1. ELEVAÇÃO DE PRIVILÉGIOS / PRIVILEGE ESCALATION
# ======================================================================
if [ "${EUID:-$(id -u)}" -ne 0 ]; then
    echo ""
    echo "+---------------------------------------------------------------+"
    echo "| Privilégios de administrador (root) necessários.              |"
    echo "| Root privileges required. Please enter your password:         |"
    echo "+---------------------------------------------------------------+"
    echo ""

    if [ -f "$0" ]; then
        exec sudo -E bash "$0" "$@"
    else
        echo "ERRO/ERROR: Para executar via web, chame o comando com sudo:"
        echo ""
        echo "  curl -fsSL \"$UPDATE_URL\" | sudo bash"
        echo ""
        exit 1
    fi
fi

# ======================================================================
# 2. CORREÇÃO DE PIPE (CURL | BASH) E REEXECUÇÃO SEGURA
# ======================================================================
if [ ! -t 0 ]; then
    echo "[AVISO] Execução via pipe detectada. Baixando instalador para o disco local..."
    TMP_SCRIPT="/tmp/koha_installer_temp.sh"
    curl -fsSL "$UPDATE_URL" -o "$TMP_SCRIPT" || {
        echo "ERRO: Falha ao baixar o instalador."
        exit 1
    }
    chmod +x "$TMP_SCRIPT"
    exec bash "$TMP_SCRIPT" "$@" < /dev/tty
    exit 0
fi

REAL_USER="${SUDO_USER:-${USER:-root}}"
REAL_HOME="$(getent passwd "$REAL_USER" 2>/dev/null | cut -d: -f6)"
[ -z "$REAL_HOME" ] && REAL_HOME="/root"
[ -d "$REAL_HOME" ] || REAL_HOME="/root"

# ======================================================================
# IDIOMA / LANGUAGE
# ======================================================================
detect_system_language() {
    local raw="${LC_ALL:-${LC_MESSAGES:-${LANG:-${LANGUAGE:-en}}}}"
    raw="${raw%%:*}"
    raw="${raw//-/_}"
    raw="${raw,,}"
    case "$raw" in
        pt|pt_*) printf 'pt' ;;
        es|es_*) printf 'es' ;;
        *)       printf 'en' ;;
    esac
}

SYS_LANG="$(detect_system_language)"

# O terceiro argumento é o espanhol. Por compatibilidade, chamadas antigas
# com apenas português/inglês continuam funcionando normalmente.
t() {
    case "$SYS_LANG" in
        pt) printf '%b' "${1:-}" ;;
        es) printf '%b' "${3:-${2:-}}" ;;
        *)  printf '%b' "${2:-}" ;;
    esac
}

# ======================================================================
# TRAVAS DE EXECUÇÃO / EXECUTION LOCKS (PID BASED)
# ======================================================================
PANEL_LOCK_FILE="/var/lock/koha_easy_install.lock"
exec 8>"$PANEL_LOCK_FILE"
chmod 600 "$PANEL_LOCK_FILE" 2>/dev/null || true
if ! flock -n 8; then
    echo ""
    echo "$(t "ERRO: o Koha Easy Install & Tools já está em execução." "ERROR: Koha Easy Install & Tools is already running.")"
    echo ""
    exit 1
fi

BACKUP_LOCK_FILE="/var/lock/koha_backup.lock"
backup_lock_acquire() {
    exec 9>"$BACKUP_LOCK_FILE"
    chmod 600 "$BACKUP_LOCK_FILE" 2>/dev/null || true
    flock -n 9
}
backup_lock_release() {
    flock -u 9 2>/dev/null || true
}

