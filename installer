# ======================================================================
# TRANSLATION ENGINE / MOTOR DE TRADUÇÃO DO PAINEL
# ======================================================================

declare -A _TRANS_CACHE
mkdir -p "$CONFIG_DIR" 2>/dev/null
CACHE_FILE="${CONFIG_DIR}/translations_${SYS_LANG:-en}.cache"

# Baixa o arquivo do GitHub se não for inglês e não existir no HD
if [ ! -f "$CACHE_FILE" ] && [ "${SYS_LANG:-en}" != "en" ]; then
    if command -v curl >/dev/null 2>&1; then
        curl -4fsS --connect-timeout 3 --max-time 10 "${LANG_REPO_URL}/${SYS_LANG}.cache" -o "$CACHE_FILE" 2>/dev/null || true
    fi
fi

# Carrega o cache persistente (HD) para a memória
if [ -f "$CACHE_FILE" ]; then
    while IFS='=' read -r k_b64 v_b64; do
        [ -n "$k_b64" ] && [ -n "$v_b64" ] && \
            _TRANS_CACHE["$(printf '%s' "$k_b64" | base64 -d 2>/dev/null)"]="$(printf '%s' "$v_b64" | base64 -d 2>/dev/null)"
    done < "$CACHE_FILE"
fi

t() {
    local source_text="${1:-}"
    [ -z "$source_text" ] && return 0
    
    local target_lang="$(normalize_panel_language "${KOHA_PANEL_LANG:-en}")"

    if [ "$target_lang" = "en" ]; then
        printf '%b' "$source_text"
        return 0
    fi

    # Busca na memória
    if [[ -n "${_TRANS_CACHE["$source_text"]+x}" ]]; then
        printf '%b' "${_TRANS_CACHE["$source_text"]}"
        return 0
    fi

    # Fallback silencioso: se não achar a tradução, exibe o original em inglês
    printf '%b' "$source_text"
    return 0
}

# ======================================================================
# 3. SHIELDED APT
# ======================================================================
APT_OPTS=(-y -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold -o Acquire::ForceIPv4=true)

wait_for_apt_locks() {
    systemctl stop apt-daily.timer apt-daily-upgrade.timer >/dev/null 2>&1
    APT_TIMERS_STOPPED="yes"

    local wait_time=0
    while fuser /var/lib/dpkg/lock-frontend >/dev/null 2>&1 || \
          fuser /var/lib/apt/lists/lock  >/dev/null 2>&1 || \
          fuser /var/lib/dpkg/lock        >/dev/null 2>&1; do
        sleep 3
        wait_time=$((wait_time + 3))
        if [ "$wait_time" -ge 300 ]; then
            restore_apt_timers
            return 1
        fi
    done
    if ! dpkg --configure -a >/dev/null 2>&1; then
        restore_apt_timers
        return 1
    fi
    return 0
}

apt_update_indices() {
    local attempt=1 max=3
    while [ "$attempt" -le "$max" ]; do
        if apt-get update -y -o Acquire::ForceIPv4=true >/tmp/koha_apt_update.log 2>&1; then
            rm -f /tmp/koha_apt_update.log
            return 0
        fi
        sleep 2
        if apt-get update -y --fix-missing -o Acquire::ForceIPv4=true >>/tmp/koha_apt_update.log 2>&1; then
            rm -f /tmp/koha_apt_update.log
            return 0
        fi
        sleep 2
        attempt=$((attempt + 1))
    done
    return 1
}

apt_install() {
    local packages=("$@") attempt=1 max=3
    while [ "$attempt" -le "$max" ]; do
        if DEBIAN_FRONTEND=noninteractive apt-get install "${APT_OPTS[@]}" "${packages[@]}"; then
            return 0
        fi
        apt_update_indices >/dev/null 2>&1
        dpkg --configure -a >/dev/null 2>&1
        apt-get -f install "${APT_OPTS[@]}" >/dev/null 2>&1
        sleep 3
        attempt=$((attempt + 1))
    done
    return 1
}

