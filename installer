funcao_backup_manual() {
    exigir_banco || return 0
    msg_info "$(t "Destino do Backup" "Backup Destination")" \
"$(t "Escolha onde salvar o arquivo.\n\n  Pendrive/USB: normalmente em /media ou /mnt\n  Para baixar depois: scp root@$(ip_servidor):CAMINHO ." \
"Choose where to save the file.\n\n  USB drive: usually under /media or /mnt\n  To download later: scp root@$(ip_servidor):PATH .")" 12 76

    local destino; destino=$(selecionar_diretorio "$REAL_HOME") || return 0
