    whiptail --title "$(t "Status do Servidor" "Server Status")" --scrolltext --msgbox \
"$(t "SERVIÇOS" "SERVICES")
  Apache        : $(systemctl is-active apache2 2>/dev/null)
  MariaDB       : $(systemctl is-active mariadb 2>/dev/null)
