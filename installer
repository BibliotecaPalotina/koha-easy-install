                "$(t "Para testar o endereço principal do catálogo:\n\n1. Abra o Search Console.\n2. Selecione sua propriedade.\n3. Use a ferramenta 'Inspeção de URL'.\n4. Cole:\n$opac_url\n5. Aguarde a análise.\n6. Se estiver disponível, use 'Solicitar indexação'.\n\nNão é necessário solicitar cada livro individualmente.\nO sitemap é o método apropriado para informar ao Google um conjunto grande de URLs.\nSolicitar indexação também não garante indexação imediata." "To test the main catalog address:\n\n1. Open Search Console.\n2. Select your property.\n3. Use 'URL Inspection'.\n4. Paste:\n$opac_url\n5. Wait for the analysis.\n6. If available, use 'Request indexing'.\n\nYou do not need to request every book individually.\nA sitemap is the appropriate method for informing Google about a large set of URLs.\nA request for indexing also does not guarantee immediate indexing.")" 23 88
            ;;
        5)
            function_google_search_console
            return $?
            ;;
        6)
            msg_info "$(t "LINKS OFICIAIS" "OFFICIAL LINKS")" \
                "$(t "Google Search Console:\nhttps://search.google.com/search-console\n\nDocumentação oficial sobre sitemaps:\nhttps://developers.google.com/search/docs/crawling-indexing/sitemaps/overview\n\nDocumentação oficial sobre indexação:\nhttps://developers.google.com/search/docs/crawling-indexing/overview" "Google Search Console:\nhttps://search.google.com/search-console\n\nOfficial sitemap documentation:\nhttps://developers.google.com/search/docs/crawling-indexing/sitemaps/overview\n\nOfficial indexing documentation:\nhttps://developers.google.com/search/docs/crawling-indexing/overview")" 19 88
            ;;
        7)
            return 0
            ;;
    esac

    msg_info "$(t "CHECKLIST FINAL — GOOGLE" "FINAL GOOGLE CHECKLIST")" \
        "$(t "AUTOMÁTICO PELO PAINEL:\n\n[✓] OPAC testado\n[✓] Configuração OpacMetaRobots verificada\n[✓] Sitemap do Koha localizado/gerado quando possível\n[✓] Sitemap público testado\n[✓] robots.txt testado\n\nMANUALMENTE NO GOOGLE:\n\n[ ] Propriedade adicionada\n[ ] Propriedade verificada\n[ ] Sitemap enviado\n[ ] Página principal testada na Inspeção de URL\n[ ] Solicitação de indexação feita, se necessário\n\nIMPORTANTE:\nO Search Console ajuda o Google a descobrir o catálogo, mas não garante que todas as páginas sejam indexadas ou que apareçam imediatamente nos resultados." "AUTOMATICALLY BY THE PANEL:\n\n[✓] OPAC checked\n[✓] OpacMetaRobots checked\n[✓] Koha sitemap located/generated when possible\n[✓] Public sitemap tested\n[✓] robots.txt tested\n\nMANUALLY IN GOOGLE:\n\n[ ] Property added\n[ ] Property verified\n[ ] Sitemap submitted\n[ ] Homepage tested with URL Inspection\n[ ] Indexing requested if necessary\n\nIMPORTANT:\nSearch Console helps Google discover the catalog, but it does not guarantee that every page will be indexed or appear immediately in search results.")" 25 92

    log "Assistente Google Search Console executado para OPAC: $opac_url"
