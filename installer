    else
        msg_info "$(t "O sitemap não foi confirmado neste endereço." "The sitemap was not confirmed at this address.")" \
            "$(t "$sitemap_url\n\nIsso não significa necessariamente que o Koha esteja com problema.\nPode ser necessário configurar/publicar o sitemap na raiz do OPAC ou confirmar o caminho utilizado pela instalação." "$sitemap_url\n\nThis does not necessarily mean that Koha has a problem.\nThe sitemap may need to be configured/published at the OPAC root, or the path used by the installation may need to be confirmed.")" 16 84
    fi

    robots_body=$(curl -L -k -sS --connect-timeout 10 --max-time 30 "$robots_url" 2>/dev/null || true)
    if [ -n "$robots_body" ]; then
        if printf '%s\n' "$robots_body" | grep -Fqi 'Sitemap:'; then
            msg_ok "$(t "robots.txt encontrado e já possui uma linha Sitemap:" "robots.txt found and already contains a Sitemap: line.")" 10 82
        else
            msg_info "$(t "robots.txt encontrado, mas sem referência ao sitemap." "robots.txt found, but without a sitemap reference.")" \
                "$(t "Recomendação:\n\nAdicionar uma linha semelhante a:\nSitemap: $sitemap_url\n\nA alteração deve ser feita na configuração correta do OPAC, e não em um arquivo aleatório do sistema." "Recommendation:\n\nAdd a line similar to:\nSitemap: $sitemap_url\n\nThe change should be made in the correct OPAC configuration, not in an arbitrary system file.")" 15 84
        fi
    else
