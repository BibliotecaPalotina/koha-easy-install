# Função auxiliar: descobre o hostname e monta/mostra os links ativos
mostrar_links_tailscale() {
    local ts_hostname opac_ativo=false staff_ativo=false funnel_status texto

    ts_hostname=$(tailscale status --json 2>/dev/null | grep -oP '"DNSName":\s*"\K[^"]+' | head -n 1 | sed 's/\.$//')

    if [ -z "$ts_hostname" ]; then
        msg_error "" "$(t "Não foi possível detectar o endereço do Tailscale. O servidor está autenticado?" "Could not detect the Tailscale address. Is the server authenticated?")" 9 70
        return 1
    fi

    funnel_status=$(tailscale funnel status 2>&1)
    echo "$funnel_status" | grep -q '127\.0\.0\.1:80\b' && opac_ativo=true
    echo "$funnel_status" | grep -q '127\.0\.0\.1:8080\b' && staff_ativo=true

    texto=$(t "SEU DOMÍNIO TAILSCALE:\nhttps://${ts_hostname}\n\n" "YOUR TAILSCALE DOMAIN:\nhttps://${ts_hostname}\n\n")

    if [ "$opac_ativo" = true ]; then
        texto+=$(t "✅ Catálogo (OPAC):  https://${ts_hostname}\n" "✅ Catalog (OPAC):   https://${ts_hostname}\n")
    else
        texto+=$(t "⬜ Catálogo (OPAC):  não publicado\n" "⬜ Catalog (OPAC):   not published\n")
    fi

    if [ "$staff_ativo" = true ]; then
        texto+=$(t "✅ Administração:    https://${ts_hostname}:8443\n" "✅ Administration:   https://${ts_hostname}:8443\n")
    else
        texto+=$(t "⬜ Administração:    não publicada\n" "⬜ Administration:   not published\n")
    fi

    dialog --title "$(t "Links Publicados" "Published Links")" --msgbox "$texto" 14 76
}

function_configure_tailscale() {
    msg_info "Tailscale Funnel" \
        "$(t "O Tailscale Funnel publica o Koha na internet automaticamente,\ncom domínio e HTTPS prontos, sem precisar de Cloudflare nem domínio próprio." "Tailscale Funnel publishes Koha to the internet automatically,\nwith domain and HTTPS ready, no Cloudflare or custom domain needed.")" 12 76

    clear
    display_explanation "Verificando instalação do Tailscale..." "Checking Tailscale installation..."

    if ! command -v tailscale >/dev/null 2>&1; then
        display_explanation "Instalando o Tailscale via curl..." "Installing Tailscale via curl..."
        if ! curl -fsSL https://tailscale.com/install.sh | sh; then
            msg_error "" "$(t "Falha ao instalar o Tailscale. Verifique sua conexão com a internet." "Failed to install Tailscale. Check your internet connection.")" 9 74
            return 1
        fi
    fi

    if ! tailscale status >/dev/null 2>&1; then
        display_explanation "Iniciando a conexão com sua conta Tailscale..." "Initiating connection to your Tailscale account..."
        echo -e "\e[1;33m$(t "Siga o link abaixo no seu navegador para autenticar este servidor:" "Follow the link below in your browser to authenticate this server:")\e[0m"
        tailscale up
        echo ""
    fi

    if ! tailscale status >/dev/null 2>&1; then
        msg_error "" "$(t "O servidor não pôde ser autenticado no Tailscale. Tente novamente." "The server could not be authenticated on Tailscale. Try again.")" 9 70
        return 1
    fi

    local ts_hostname
    ts_hostname=$(tailscale status --json 2>/dev/null | grep -oP '"DNSName":\s*"\K[^"]+' | head -n 1 | sed 's/\.$//')
    if [ -n "$ts_hostname" ]; then
        msg_ok "$(t "Servidor conectado!\n\nSeu domínio será:\nhttps://${ts_hostname}" "Server connected!\n\nYour domain will be:\nhttps://${ts_hostname}")" 11 70
    fi

    while true; do
        local choice
        choice=$(dialog --title "$(t "Gerenciador do Tailscale Funnel" "Tailscale Funnel Manager")" \
            --cancel-button "$(t "Voltar" "Back")" \
            --menu "$(t "O que deseja fazer?" "What do you want to do?")" 18 76 5 \
            "1" "$(t "★ Publicar tudo automaticamente (OPAC + Staff)" "★ Publish everything automatically (OPAC + Staff)")" \
            "2" "$(t "Publicar só o Catálogo Público (OPAC)" "Publish only Public Catalog (OPAC)")" \
            "3" "$(t "Publicar só a Administração (Staff)" "Publish only Administration (Staff)")" \
            "4" "$(t "Ver os links publicados agora" "View currently published links")" \
            "5" "$(t "Desativar/Parar todos os Funnels ativos" "Stop all active Funnels")" \
            3>&1 1>&2 2>&3)
        [[ $? -ne 0 ]] && break

        case "$choice" in
            1)
                clear
                display_explanation "Publicando Catálogo (OPAC, porta 80)..." "Publishing Catalog (OPAC, port 80)..."
                local opac_ok=false staff_ok=false saida_opac saida_staff

                saida_opac=$(tailscale funnel --bg 80 2>&1)
                if [ $? -eq 0 ]; then
                    opac_ok=true
                else
                    msg_error "" "$(t "A Tailscale bloqueou a publicação.\n\nAcesse login.tailscale.com, vá em 'DNS' e ative 'HTTPS Certificates'. Depois, em 'Access Controls', adicione a permissão de Funnel.\n\nDetalhe do erro:\n$saida_opac" "Tailscale blocked the publication.\n\nEnable HTTPS Certificates and add Funnel permission in your Tailscale admin panel.\n\nError details:\n$saida_opac")" 18 78
                    continue
                fi

                if prompt_yes_no \
                    "$(t "Publicar Staff também?" "Publish Staff too?")" \
                    "$(t "ATENÇÃO: isso publica a administração do Koha na internet.\nSó continue se realmente precisa acessá-la remotamente.\n\nPublicar?" "WARNING: this publishes the Koha admin panel to the internet.\nOnly continue if you really need remote access to it.\n\nPublish?")" \
                    12 74; then
                    display_explanation "Publicando Administração (Staff, porta 8080)..." "Publishing Administration (Staff, port 8080)..."
                    saida_staff=$(tailscale funnel --bg --https=8443 8080 2>&1)
                    if [ $? -eq 0 ]; then
                        staff_ok=true
                    else
                        msg_error "" "$(t "Erro ao publicar a Administração:\n\n$saida_staff" "Error publishing Administration:\n\n$saida_staff")" 14 78
                    fi
                fi

                if [ "$opac_ok" = true ]; then
                    mostrar_links_tailscale
                fi
                ;;
            2)
                clear
                display_explanation "Ativando o Funnel para o Catálogo (Porta 80)..." "Enabling Funnel for Catalog (Port 80)..."
                local saida_opac
                saida_opac=$(tailscale funnel --bg 80 2>&1)
                if [ $? -eq 0 ]; then
                    mostrar_links_tailscale
                else
                    msg_error "" "$(t "Falha ao iniciar o Funnel na porta 80. Verifique as permissões (Certificados HTTPS e Access Controls) no painel admin da Tailscale.\n\nDetalhes:\n$saida_opac" "Failed to start Funnel on port 80. Check your Tailscale admin panel permissions.\n\nDetails:\n$saida_opac")" 16 78
                fi
                ;;
            3)
                if ! prompt_yes_no \
                    "$(t "Publicar Staff na internet" "Publish Staff to the Internet")" \
                    "$(t "ATENÇÃO:\n\nIsso publica a interface administrativa do Koha pela internet.\n\nUse somente se você entende o risco e realmente precisa dessa exposição.\n\nContinuar?" "WARNING:\n\nThis publishes the Koha staff administration interface to the Internet.\n\nOnly continue if you understand the risk and really need this exposure.\n\nContinue?")" \
                    15 78; then
                    continue
                fi
                clear
                display_explanation "Ativando o Funnel para a Administração (Porta 8080)..." "Enabling Funnel for Administration (Port 8080)..."
                local saida_staff
                saida_staff=$(tailscale funnel --bg --https=8443 8080 2>&1)
                if [ $? -eq 0 ]; then
                    mostrar_links_tailscale
                else
                    msg_error "" "$(t "Falha ao iniciar o Funnel na porta 8080. Verifique as permissões no painel admin da Tailscale.\n\nDetalhes:\n$saida_staff" "Failed to start Funnel on port 8080. Check admin panel permissions.\n\nDetails:\n$saida_staff")" 16 78
                fi
                ;;
            4)
                clear
                mostrar_links_tailscale
                ;;
            5)
                clear
                display_explanation "Desativando os Funnels ativos..." "Stopping active Funnels..."
                tailscale funnel off >/dev/null 2>&1 || true
                msg_ok "$(t "Todos os tunelamentos do Funnel foram desativados." "All Funnel tunnels have been turned off.")" 9 64
                ;;
        esac
    done
}

