# ======================================================================
# 15. SUPERBIBLIOTECÁRIO / SUPER LIBRARIAN
# ======================================================================
function_create_superlibrarian() {
    require_database || return 0
    local branch cat_ user pass first_name surname hash exists user_sql card_sql hash_sql surname_sql first_sql branch_sql cat_sql
    branch=$(run_sql "SELECT branchcode FROM ${DB_NAME}.branches LIMIT 1;")
    cat_=$(run_sql "SELECT categorycode FROM ${DB_NAME}.categories WHERE category_type='S' LIMIT 1;")
    [ -z "$cat_" ] && cat_=$(run_sql "SELECT categorycode FROM ${DB_NAME}.categories LIMIT 1;")
    if [ -z "$branch" ] || [ -z "$cat_" ]; then
        msg_error "" "$(t "Ainda não existem bibliotecas ou categorias de usuário no banco.\nConclua o Web Installer primeiro." "There are no libraries or patron categories yet.\nFinish the Web Installer first.")" 10 74
        return 0
    fi
    user=$(dialog --title "$(t "Usuário" "Username")" --inputbox "$(t "Nome de usuário (login):" "Username (login):")" 9 60 3>&1 1>&2 2>&3) || return 0
    [ -z "$user" ] && return 0
    if ! [[ "$user" =~ ^[A-Za-z0-9._-]+$ ]]; then
        msg_error "" "$(t "Use apenas letras, números, ponto, hífen ou sublinhado." "Use only letters, numbers, dot, hyphen or underscore.")" 8 66
        return 0
    fi
    exists=$(run_sql "SELECT COUNT(*) FROM ${DB_NAME}.borrowers WHERE userid='${user}';")
    if [ "${exists:-0}" -gt 0 ] 2>/dev/null; then
        msg_error "" "$(t "O usuário '$user' já existe.\nPara trocar a senha dele use a interface web do Koha." "User '$user' already exists.\nUse the Koha web interface to change its password.")" 9 70
        return 0
    fi

    local cardnumber exists_card
    cardnumber=$(dialog --title "$(t "Número do Cartão" "Card Number")" --inputbox "$(t "Número do cartão (cardnumber) para $user:" "Card number for $user:")" 9 60 3>&1 1>&2 2>&3) || return 0
    [ -z "$cardnumber" ] && return 0

    exists_card=$(run_sql "SELECT COUNT(*) FROM ${DB_NAME}.borrowers WHERE cardnumber='${cardnumber}';")
    if [ "${exists_card:-0}" -gt 0 ] 2>/dev/null; then
        msg_error "" "$(t "O número de cartão '$cardnumber' já está em uso por outro leitor. Tente novamente com outro número." "Card number '$cardnumber' is already in use by another patron. Try again with a different number.")" 10 74
        return 0
    fi

    pass=$(dialog --title "$(t "Senha" "Password")" --passwordbox "$(t "Senha para $user (mínimo 8 caracteres):" "Password for $user (at least 8 characters):")" 9 64 3>&1 1>&2 2>&3) || return 0
    [ "${#pass}" -lt 8 ] && { msg_error "" "$(t "Senha curta demais (mínimo 8 caracteres)." "Password too short (minimum 8 characters).")" 8 62; return 0; }
    local pass2
    pass2=$(dialog --title "$(t "Confirmar Senha" "Confirm Password")" --passwordbox "$(t "Digite a senha de novo:" "Type the password again:")" 9 64 3>&1 1>&2 2>&3) || return 0
    [ "$pass" != "$pass2" ] && { msg_error "" "$(t "As senhas não conferem." "Passwords do not match.")" 8 60; return 0; }
    first_name=$(dialog --title "$(t "Nome" "First name")" --inputbox "$(t "Nome:" "First name:")" 9 60 "Super" 3>&1 1>&2 2>&3) || return 0
    surname=$(dialog --title "$(t "Sobrenome" "Surname")" --inputbox "$(t "Sobrenome:" "Surname:")" 9 60 "Admin" 3>&1 1>&2 2>&3) || return 0
    clear
    display_explanation "Gerando o hash da senha..." "Hashing the password..."
    cat > /tmp/koha_hash.pl << 'EOF'
use strict; use warnings;
use Koha::AuthUtils qw(hash_password);
my $pw = <STDIN>; chomp $pw;
print hash_password($pw);
EOF
    chmod 644 /tmp/koha_hash.pl
    hash=$(printf '%s\n' "$pass" | koha-shell "$INSTANCE" -c "perl /tmp/koha_hash.pl" 2>/dev/null)
    rm -f /tmp/koha_hash.pl
    if [ -z "$hash" ]; then
        msg_error "" "$(t "Falha ao gerar o hash da senha." "Failed to hash the password.")" 8 62
        return 1
    fi
    user_sql=$(sql_escape_literal "$user")
    card_sql=$(sql_escape_literal "$cardnumber")
    hash_sql=$(sql_escape_literal "$hash")
    surname_sql=$(sql_escape_literal "$surname")
    first_sql=$(sql_escape_literal "$first_name")
    branch_sql=$(sql_escape_literal "$branch")
    cat_sql=$(sql_escape_literal "$cat_")
    if mysql --default-character-set=utf8mb4 "$DB_NAME" << SQLEOF 2>/dev/null
INSERT INTO borrowers (userid, cardnumber, password, surname, firstname, branchcode, categorycode, flags)
VALUES ('$user_sql', '$card_sql', '$hash_sql', '$surname_sql', '$first_sql', '$branch_sql', '$cat_sql', 1);
SQLEOF
    then
        log "superbibliotecario criado: $user (cardnumber: $cardnumber)"
        msg_ok "$(t "Superbibliotecário criado com sucesso.\n\nUsuário: $user\nCartão:  $cardnumber\n\nGuarde a senha: ela não fica salva em lugar nenhum." "Super Librarian created successfully.\n\nUser: $user\nCard: $cardnumber\n\nKeep the password safe: it is not stored anywhere.")" 12 70
    else
        msg_error "" "$(t "Não foi possível criar o usuário. Ele já existe ou faltam campos obrigatórios nesta versão do Koha.\nCrie pela interface web e marque 'Superlibrarian'." "Could not create the user. It may already exist or this Koha version requires more fields.\nCreate it in the web interface and tick 'Superlibrarian'.")" 11 76
    fi
}

# ======================================================================
# 16. CLOUDFLARE TUNNEL / CLOUDFLARE TUNNEL (modo local automatizado)
# ======================================================================
function_configure_cloudflare() {
    msg_info "$(t "Passo 1: Domínio e Nameservers" "Step 1: Domain & Nameservers")" \
"$(t "COMO ASSOCIAR SEU DOMÍNIO À CLOUDFLARE:\n\n1. OBTENHA UM DOMÍNIO GRATUITO:\n   - Digital Plat (rápido/automático): https://domain.digitalplat.org/\n   - nic.eu.org (manual, demora de 14 a 45 dias): https://nic.eu.org\n   - Ou solicite à TI um CNAME oficial (ex: catalogo.palotina.pr.gov.br)\n\n2. ADICIONE NA CLOUDFLARE (dash.cloudflare.com):\n   - Clique em 'Add a site/domain', digite o domínio e selecione Free.\n   - A Cloudflare exibirá DOIS Nameservers. Copie os dois.\n\n3. ATUALIZE ONDE REGISTROU O DOMÍNIO:\n   - No Digital Plat ou nic.eu.org, vá em DNS / Nameservers.\n   - Substitua os servidores existentes pelos DOIS da Cloudflare.\n   - Na Cloudflare, clique em 'Check nameservers' até o status ficar Ativo.\n\nEsta parte não dá pra automatizar (depende do seu registrador),\nmas o resto do processo a partir daqui é todo automático." \
"HOW TO LINK YOUR DOMAIN TO CLOUDFLARE:\n\n1. GET A FREE DOMAIN:\n   - Digital Plat (fast/automated): https://domain.digitalplat.org/\n   - nic.eu.org (manual, takes 14 to 45 days): https://nic.eu.org\n   - Or ask local IT for an official CNAME (e.g. catalog.city.gov.br)\n\n2. ADD TO CLOUDFLARE (dash.cloudflare.com):\n   - Click 'Add a site/domain', type your domain and select Free.\n   - Cloudflare provides TWO Nameservers. Copy both.\n\n3. UPDATE AT YOUR DOMAIN REGISTRAR:\n   - Replace existing servers with the TWO from Cloudflare.\n   - In Cloudflare, click 'Check nameservers' until status is Active.\n\nThis part can't be automated (depends on your registrar), but\neverything from here on is fully automatic.")" 22 78

    clear
    display_explanation "Instalando o cloudflared..." "Installing cloudflared..."
    if ! command -v cloudflared >/dev/null 2>&1; then
        if ! wait_for_apt_locks; then return 1; fi
        mkdir -p /etc/apt/keyrings && chmod 0755 /etc/apt/keyrings
        if ! curl -fsSL --retry 3 --max-time 60 https://pkg.cloudflare.com/cloudflare-main.gpg -o /etc/apt/keyrings/cloudflare-main.gpg; then
            restore_apt_timers
            msg_error "" "$(t "Falha ao baixar a chave da Cloudflare." "Failed to download the Cloudflare key.")" 8 66
            return 1
        fi
        echo "deb [signed-by=/etc/apt/keyrings/cloudflare-main.gpg] https://pkg.cloudflare.com/cloudflared any main" > /etc/apt/sources.list.d/cloudflared.list
        if ! apt_update_indices; then
            rm -f /etc/apt/sources.list.d/cloudflared.list
            restore_apt_timers
            msg_error "" "$(t "Não foi possível atualizar o repositório da Cloudflare." "Could not update the Cloudflare repository.")" 9 72
            return 1
        fi
        if ! apt_install cloudflared; then
            restore_apt_timers
            return 1
        fi
        restore_apt_timers
    fi

    # ------------------------------------------------------------------
    # Autorização (uma vez só) - clica um link, autoriza, pronto.
    # Não precisa de token, não precisa mexer em porta nenhuma.
    # ------------------------------------------------------------------
    if [ ! -f "$HOME/.cloudflared/cert.pem" ] && [ ! -f "/root/.cloudflared/cert.pem" ]; then
        msg_info "Cloudflare Tunnel" \
"$(t "AUTORIZAÇÃO (só na primeira vez):\n\nVai aparecer um link abaixo. Copie e abra em qualquer navegador,\nescolha o domínio que você já ativou na Cloudflare e clique Authorize.\n\nNão precisa colar código nenhum de volta - o servidor detecta\nsozinho quando você autorizar." "AUTHORIZATION (first time only):\n\nA link will appear below. Copy it into any browser, select the\ndomain you already activated in Cloudflare, and click Authorize.\n\nNo need to paste anything back - the server detects it automatically.")" 12 76
        clear
        cloudflared tunnel login
        echo ""
    fi

    if [ ! -f "$HOME/.cloudflared/cert.pem" ] && [ ! -f "/root/.cloudflared/cert.pem" ]; then
        msg_error "" "$(t "Autorização não concluída. Tente novamente." "Authorization not completed. Try again.")" 8 66
        return 1
    fi

    # ------------------------------------------------------------------
    # Nome do túnel (reaproveita se já existir de uma configuração anterior)
    # ------------------------------------------------------------------
    local tunnel_name="koha-library"
    if ! cloudflared tunnel list 2>/dev/null | grep -q "$tunnel_name"; then
        display_explanation "Criando o túnel '$tunnel_name'..." "Creating tunnel '$tunnel_name'..."
        if ! cloudflared tunnel create "$tunnel_name"; then
            msg_error "" "$(t "Falha ao criar o túnel." "Failed to create the tunnel.")" 8 66
            return 1
        fi
    fi

    local tunnel_id
    tunnel_id=$(cloudflared tunnel list 2>/dev/null | awk -v n="$tunnel_name" '$0 ~ n {print $1; exit}')
    if [ -z "$tunnel_id" ]; then
        msg_error "" "$(t "Não consegui identificar o ID do túnel criado." "Could not identify the created tunnel's ID.")" 8 66
        return 1
    fi

    local cred_file
    cred_file=$(find "$HOME/.cloudflared" /root/.cloudflared -name "${tunnel_id}.json" 2>/dev/null | head -n1)

    # ------------------------------------------------------------------
    # Pergunta os subdomínios (com padrão já sugerido)
    # ------------------------------------------------------------------
    local dominio opac_sub staff_sub
    dominio=$(dialog --title "$(t "Seu Domínio" "Your Domain")" --inputbox "$(t "Digite o domínio que você já ativou na Cloudflare (ex: bibliotecapalotina.org):" "Enter the domain you already activated in Cloudflare (e.g. bibliotecapalotina.org):")" 10 74 3>&1 1>&2 2>&3) || return 0
    [ -z "$dominio" ] && return 0

    opac_sub=$(dialog --title "OPAC" --inputbox "$(t "Subdomínio do Catálogo Público:" "Public Catalog subdomain:")" 10 60 "catalogo" 3>&1 1>&2 2>&3) || return 0
    staff_sub=$(dialog --title "Staff" --inputbox "$(t "Subdomínio da Administração:" "Administration subdomain:")" 10 60 "admin" 3>&1 1>&2 2>&3) || return 0

    # ------------------------------------------------------------------
    # Cria o config.yml local com as duas rotas
    # ------------------------------------------------------------------
    mkdir -p /etc/cloudflared
    cat > /etc/cloudflared/config.yml <<EOF
tunnel: ${tunnel_id}
credentials-file: ${cred_file}

ingress:
  - hostname: ${opac_sub}.${dominio}
    service: http://localhost:80
  - hostname: ${staff_sub}.${dominio}
    service: http://localhost:8080
  - service: http_status:404
EOF

    display_explanation "Registrando os subdomínios no DNS..." "Registering subdomains in DNS..."
    cloudflared tunnel route dns "$tunnel_name" "${opac_sub}.${dominio}" || true
    cloudflared tunnel route dns "$tunnel_name" "${staff_sub}.${dominio}" || true

    display_explanation "Instalando o túnel como serviço..." "Installing tunnel as a service..."
    cloudflared service uninstall >/dev/null 2>&1 || true
    cp /etc/cloudflared/config.yml /etc/cloudflared/config.yml.bak 2>/dev/null || true
    cloudflared --config /etc/cloudflared/config.yml service install
    systemctl enable --now cloudflared >/dev/null 2>&1
    sleep 3

    if systemctl is-active --quiet cloudflared; then
        msg_ok "$(t "TÚNEL ATIVO E ROTAS CRIADAS AUTOMATICAMENTE!\n\nCatálogo (OPAC): https://${opac_sub}.${dominio}\nAdministração:   https://${staff_sub}.${dominio}\n\nPode levar alguns minutos até o DNS propagar." "TUNNEL ACTIVE AND ROUTES CREATED AUTOMATICALLY!\n\nCatalog (OPAC): https://${opac_sub}.${dominio}\nAdministration: https://${staff_sub}.${dominio}\n\nMay take a few minutes for DNS to propagate.")" 12 78
    else
        msg_error "" "$(t "O serviço não ficou ativo. Veja: journalctl -u cloudflared -n 30" "The service is not active. Check: journalctl -u cloudflared -n 30")" 9 74
    fi
}

