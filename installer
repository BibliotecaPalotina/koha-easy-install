function_toggle_search_engine() {
    require_database || return 0
    local engine; engine=$(get_search_engine)
    if [ "$engine" = "Elasticsearch" ]; then
        prompt_yes_no "$(t "Motor de Busca" "Search Engine")" \
"$(t "Motor atual: ELASTICSEARCH.\n\nVoltar para o ZEBRA? Ele usa cerca de 1,5 GB de RAM a menos,\nmas perde as facetas dinâmicas e a busca avançada." \
"Current engine: ELASTICSEARCH.\n\nSwitch back to ZEBRA? It uses about 1.5 GB less RAM,\nbut loses dynamic facets and advanced search.")" 12 74 || return 0
        clear
        if ! backup_lock_acquire; then
            msg_error "" "$(t "Outro backup/restauração está em andamento. Troca de motor cancelada." "Another backup/restore is running. Engine switch cancelled.")" 9 72
            return 1
        fi
        display_explanation "Parando o indexador do Elasticsearch..." "Stopping the Elasticsearch indexer..."
        manage_koha_indexers stop
        systemctl disable --now elasticsearch >/dev/null 2>&1 || true
        display_explanation "Removendo o bloco <elasticsearch> do koha-conf.xml..." "Removing the <elasticsearch> block..."
        if ! set_xml_elasticsearch remover; then
            manage_koha_indexers start >/dev/null 2>&1 || true
            systemctl enable --now elasticsearch >/dev/null 2>&1 || true
            backup_lock_release
            return 1
        fi
        if ! mysql -e "UPDATE ${DB_NAME}.systempreferences SET value='Zebra' WHERE variable='SearchEngine';" >/dev/null 2>&1; then
            set_xml_elasticsearch inserir >/dev/null 2>&1 || true
            manage_koha_indexers start >/dev/null 2>&1 || true
            systemctl enable --now elasticsearch >/dev/null 2>&1 || true
            backup_lock_release
            msg_error "" "$(t "Não foi possível alterar SearchEngine para Zebra. A configuração do Elasticsearch foi restaurada." "Could not set SearchEngine to Zebra. Elasticsearch configuration was restored.")" 10 74
            return 1
        fi
        display_explanation "Limpando o cache de preferências (Memcached)..." "Flushing the preferences cache (Memcached)..."
        systemctl restart memcached >/dev/null 2>&1 || true
        display_explanation "Destravando e religando o Zebra..." "Unlocking and restarting Zebra..."
        systemctl disable --now "koha-zebra-daemon@${INSTANCE}" >/dev/null 2>&1 || true
        force_stop_koha_zebra
        rm -f /var/lock/koha/${INSTANCE}/rebuild/*.LCK 2>/dev/null
        rm -f /var/run/koha/${INSTANCE}/zebrasrv.pid 2>/dev/null
        chown -R "${INSTANCE}-koha:${INSTANCE}-koha" \
            "/var/lib/koha/${INSTANCE}/biblios" "/var/lib/koha/${INSTANCE}/authorities" \
            "/var/lock/koha/${INSTANCE}" 2>/dev/null || true
        systemctl enable --now "koha-zebra-daemon@${INSTANCE}" >/dev/null 2>&1
        if ! systemctl is-active --quiet "koha-zebra-daemon@${INSTANCE}"; then
            backup_lock_release
            msg_error "" "$(t "O daemon do Zebra não pôde ser iniciado. A troca de motor foi interrompida." "Zebra daemon could not be started. Engine switch was interrupted.")" 10 74
            return 1
        fi
        write_cron_zebra
        systemctl restart koha-common >/dev/null 2>&1 || true
        display_explanation "Reindexando o acervo no Zebra..." "Reindexing the catalog into Zebra..."
        if ! koha-rebuild-zebra -f -v -b -a -r "$INSTANCE"; then
            backup_lock_release
            msg_error "" "$(t "A reconstrução do Zebra falhou. O sistema continuará em Zebra; use a opção de reparar." "Zebra rebuild failed. The system will remain on Zebra; use the repair option.")" 11 76
            return 1
        fi
        backup_lock_release
        koha-plack --restart "$INSTANCE" >/dev/null 2>&1 || true
        validate_complete_system "troca para Zebra"
        msg_ok "$(t "Sistema operando com ZEBRA.\nA indexação incremental roda a cada 2 minutos." "System now running on ZEBRA.\nIncremental indexing runs every 2 minutes.")" 10 70
        return 0
    fi

    prompt_yes_no "$(t "Motor de Busca" "Search Engine")" \
"$(t "Motor atual: ZEBRA.\n\nAtivar o ELASTICSEARCH? Ele traz busca avançada e facetas\ndinâmicas, mas exige cerca de 1,5 GB de RAM a mais e mais disco." \
"Current engine: ZEBRA.\n\nEnable ELASTICSEARCH? It brings advanced search and dynamic\nfacets, but needs about 1.5 GB more RAM and more disk.")" 12 76 || return 0
    if [ "$(get_free_space_mb /)" -lt 4096 ] 2>/dev/null; then
        prompt_yes_no "$(t "Pouco espaço" "Low disk space")" "$(t "Há menos de 4 GB livres. O Elasticsearch pode não subir.\n\nContinuar mesmo assim?" "Less than 4 GB free. Elasticsearch may fail to start.\n\nContinue anyway?")" 10 70 || return 0
    fi

    clear
    if ! backup_lock_acquire; then
        msg_error "" "$(t "Outro backup/restauração está em andamento. Troca de motor cancelada." "Another backup/restore is running. Engine switch cancelled.")" 9 72
        return 1
    fi

    display_explanation "Desativando o Zebra e sua fila..." "Disabling Zebra and its queue..."
    rm -f "$CRON_ZEBRA"; systemctl restart cron >/dev/null 2>&1 || true
    systemctl disable --now "koha-zebra-daemon@${INSTANCE}" >/dev/null 2>&1 || true

    if ! dpkg -s koha-elasticsearch >/dev/null 2>&1; then
        display_explanation "Instalando o Elasticsearch 7..." "Installing Elasticsearch 7..."
        apt_update_indices
        if ! apt_install elasticsearch koha-elasticsearch; then
            write_cron_zebra
            systemctl enable --now "koha-zebra-daemon@${INSTANCE}" >/dev/null 2>&1 || true
            backup_lock_release
            msg_error "" "$(t "Falha ao instalar o Elasticsearch. O Zebra foi restaurado." "Elasticsearch installation failed. Zebra was restored.")" 10 72
            return 1
        fi
    fi

    display_explanation "Ajustando memória e configuração do Elasticsearch..." "Tuning Elasticsearch memory and configuration..."
    if ! adjust_elasticsearch_heap; then
        write_cron_zebra
        systemctl enable --now "koha-zebra-daemon@${INSTANCE}" >/dev/null 2>&1 || true
        backup_lock_release
        msg_error "" "$(t "Não foi possível gravar a configuração de memória do Elasticsearch. O Zebra foi restaurado." "Could not write Elasticsearch memory configuration. Zebra was restored.")" 11 78
        return 1
    fi
    if [ ! -f /etc/elasticsearch/elasticsearch.yml ]; then
        backup_lock_release
        msg_error "" "$(t "O arquivo de configuração do Elasticsearch não existe." "Elasticsearch configuration file is missing.")" 9 70
        write_cron_zebra; systemctl enable --now "koha-zebra-daemon@${INSTANCE}" >/dev/null 2>&1 || true
        return 1
    fi
    cp -f /etc/elasticsearch/elasticsearch.yml "/etc/elasticsearch/elasticsearch.yml.bak-$(date +%Y%m%d-%H%M%S)" 2>/dev/null || true
    grep -q '^discovery.type: single-node' /etc/elasticsearch/elasticsearch.yml 2>/dev/null || echo 'discovery.type: single-node' >> /etc/elasticsearch/elasticsearch.yml
    grep -q '^network.host: 127.0.0.1'     /etc/elasticsearch/elasticsearch.yml 2>/dev/null || echo 'network.host: 127.0.0.1'     >> /etc/elasticsearch/elasticsearch.yml
    if ! /usr/share/elasticsearch/bin/elasticsearch-plugin list 2>/dev/null | grep -q '^analysis-icu$'; then
        if ! /usr/share/elasticsearch/bin/elasticsearch-plugin install --batch analysis-icu >/dev/null 2>&1; then
            systemctl disable --now elasticsearch >/dev/null 2>&1 || true
            write_cron_zebra
            systemctl enable --now "koha-zebra-daemon@${INSTANCE}" >/dev/null 2>&1 || true
            backup_lock_release
            msg_error "" "$(t "Não foi possível instalar o plugin analysis-icu do Elasticsearch. O Zebra foi restaurado." "Could not install the Elasticsearch analysis-icu plugin. Zebra was restored.")" 11 78
            return 1
        fi
    fi

    display_explanation "Iniciando o Elasticsearch (pode levar até 1 minuto)..." "Starting Elasticsearch (up to 1 minute)..."
    systemctl daemon-reload
    systemctl enable elasticsearch >/dev/null 2>&1 || true
    if ! systemctl restart elasticsearch; then
        systemctl disable --now elasticsearch >/dev/null 2>&1 || true
        write_cron_zebra; systemctl enable --now "koha-zebra-daemon@${INSTANCE}" >/dev/null 2>&1 || true
        backup_lock_release
        msg_error "" "$(t "O Elasticsearch falhou ao iniciar. O Zebra foi restaurado." "Elasticsearch failed to start. Zebra was restored.")" 12 76
        return 1
    fi
    local es_ok="no"
    for _ in $(seq 1 60); do
        curl -sS --max-time 2 http://127.0.0.1:9200 >/dev/null 2>&1 && { es_ok="yes"; break; }
        sleep 1
    done
    if [ "$es_ok" = "no" ]; then
        systemctl disable --now elasticsearch >/dev/null 2>&1 || true
        write_cron_zebra
        systemctl enable --now "koha-zebra-daemon@${INSTANCE}" >/dev/null 2>&1 || true
        backup_lock_release
        msg_error "" "$(t "O Elasticsearch não subiu na porta 9200. O Zebra foi mantido." "Elasticsearch did not start on port 9200. Zebra was kept.")" 12 76
        return 1
    fi

    display_explanation "Declarando o Elasticsearch no koha-conf.xml..." "Declaring Elasticsearch in koha-conf.xml..."
    if ! set_xml_elasticsearch inserir; then
        systemctl disable --now elasticsearch >/dev/null 2>&1 || true
        write_cron_zebra
        systemctl enable --now "koha-zebra-daemon@${INSTANCE}" >/dev/null 2>&1 || true
        backup_lock_release
        msg_error "" "$(t "Não consegui ativar o bloco do Elasticsearch no koha-conf.xml. O Zebra foi restaurado." "Could not enable the Elasticsearch block in koha-conf.xml. Zebra was restored.")" 11 78
        return 1
    fi
    if ! mysql -e "UPDATE ${DB_NAME}.systempreferences SET value='Elasticsearch' WHERE variable='SearchEngine';" >/dev/null 2>&1; then
        set_xml_elasticsearch remover >/dev/null 2>&1 || true
        write_cron_zebra; systemctl enable --now "koha-zebra-daemon@${INSTANCE}" >/dev/null 2>&1 || true
        systemctl disable --now elasticsearch >/dev/null 2>&1 || true
        backup_lock_release
        msg_error "" "$(t "Não foi possível mudar SearchEngine para Elasticsearch. O Zebra foi restaurado." "Could not set SearchEngine to Elasticsearch. Zebra was restored.")" 10 76
        return 1
    fi
    display_explanation "Limpando o cache de preferências (Memcached)..." "Flushing the preferences cache (Memcached)..."
    systemctl restart memcached >/dev/null 2>&1 || true
    prepare_koha_broker || true
    curl -sS -X DELETE --max-time 10 "http://127.0.0.1:9200/${DB_NAME}_biblios" >/dev/null 2>&1 || true
    curl -sS -X DELETE --max-time 10 "http://127.0.0.1:9200/${DB_NAME}_authorities" >/dev/null 2>&1 || true
    display_explanation "Reiniciando o Koha com o Elasticsearch ativo..." "Restarting Koha with Elasticsearch enabled..."
    systemctl restart koha-common >/dev/null 2>&1 || true
    display_explanation "Subindo o indexador contínuo..." "Starting the continuous indexer..."
    local indexer_ok="yes"
    if ! manage_koha_indexers start; then indexer_ok="no"; fi
    local cut_time; cut_time=$(date '+%Y-%m-%d %H:%M:%S')
    local rebuild_ok="yes"
    display_explanation "Reindexando o acervo no Elasticsearch..." "Reindexing the catalog into Elasticsearch..."
    if [ "$indexer_ok" = "yes" ] && ! rebuild_koha_elasticsearch "$cut_time"; then rebuild_ok="no"; fi
    backup_lock_release
    koha-plack --restart "$INSTANCE" >/dev/null 2>&1 || true
    validate_complete_system "ativação do Elasticsearch"
    if [ "$indexer_ok" = "yes" ] && [ "$rebuild_ok" = "yes" ] && is_koha_indexer_running; then
        msg_ok "$(t "Sistema operando com ELASTICSEARCH.\n\nO indexador tem reinício automático e o vigia confere a fila a cada 5 minutos." "System now running on ELASTICSEARCH.\n\nThe indexer has automatic recovery and the watchdog checks the queue every 5 minutes.")" 12 78
    elif [ "$indexer_ok" = "no" ]; then
        msg_error "" "$(t "O Elasticsearch está ativo, mas o indexador não subiu. Use a opção de reparar." "Elasticsearch is active but the indexer did not start. Use the repair option.")" 11 76
        return 1
    else
        msg_error "" "$(t "O Elasticsearch está ativo, mas a reindexação falhou. Use a opção de Reparar Indexação." "Elasticsearch is active but rebuilding failed. Use Repair Indexing option.")" 11 78
        return 1
    fi
}

adjust_elasticsearch_heap() {
    local ram_mb heap cfg tmp
    ram_mb=$(awk '/MemTotal:/ {printf "%d", $2/1024}' /proc/meminfo 2>/dev/null)
    if   [ "${ram_mb:-0}" -ge 16384 ]; then heap="4g"
    elif [ "${ram_mb:-0}" -ge 8192 ];  then heap="2g"
    elif [ "${ram_mb:-0}" -ge 4096 ];  then heap="1g"
    else heap="512m"; fi
    mkdir -p /etc/elasticsearch/jvm.options.d || return 1
    cfg="/etc/elasticsearch/jvm.options.d/koha.options"
    tmp=$(mktemp "${cfg}.tmp.XXXXXX") || return 1
    if ! printf -- '-Xms%s\n-Xmx%s\n' "$heap" "$heap" > "$tmp"; then
        rm -f "$tmp"
        return 1
    fi
    chmod 644 "$tmp"
    chown root:root "$tmp" 2>/dev/null || true
    if ! mv -f "$tmp" "$cfg"; then
        rm -f "$tmp"
        return 1
    fi
    log "ES heap = $heap (RAM ${ram_mb}MB)"
}

