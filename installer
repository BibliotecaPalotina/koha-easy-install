  $(t "Nuvem" "Cloud")         : $(grep -o 'RCLONE_REMOTE="[^"]*"' "$BACKUP_CONF" 2>/dev/null | cut -d'"' -f2 | grep . || echo "$(t "não configurada" "not configured")")" 30 78 2>/dev/null || true
}

# ======================================================================
# 22. ATUALIZAR O PRÓPRIO PAINEL
# ======================================================================
funcao_autoatualizar() {
    perguntar "$(t "Atualizar o Painel" "Update the Panel")" \
"$(t "Baixa a versão mais recente deste painel do GitHub, confere se\no arquivo é um script válido e só então substitui o atual.\nUma cópia da versão atual é guardada antes.\n\nVersão instalada: ${VERSAO_PAINEL}\n\nContinuar?" \
"Downloads the latest version of this panel from GitHub, checks that\nthe file is a valid script and only then replaces the current one.\nA copy of the current version is kept first.\n\nInstalled version: ${VERSAO_PAINEL}\n\nContinue?")" 15 78 || return 0

    clear
    caixa_explicacao "Baixando a nova versão..." "Downloading the new version..."
    local tmp="/tmp/koha-easy-install.novo"
    if ! curl -fsSL --retry 3 --max-time 60 "$URL_ATUALIZACAO" -o "$tmp"; then
        msg_erro "" "$(t "Não foi possível baixar. O painel atual continua funcionando." "Download failed. The current panel keeps working.")" 9 72
        return 1
    fi
    if [ ! -s "$tmp" ] || ! head -n1 "$tmp" | grep -q '^#!'; then
        rm -f "$tmp"
        msg_erro "" "$(t "O arquivo baixado não é um script válido. Atualização cancelada." "The downloaded file is not a valid script. Update cancelled.")" 9 74
        return 1
    fi
    if ! bash -n "$tmp" 2>/dev/null; then
        rm -f "$tmp"
        msg_erro "" "$(t "O arquivo baixado tem erro de sintaxe. Atualização cancelada\npara não quebrar o painel." "The downloaded file has a syntax error. Update cancelled\nto avoid breaking the panel.")" 10 74
        return 1
    fi

    local destino="/usr/local/bin/options.sh"
    [ -f "$destino" ] && cp -f "$destino" "${destino}.bak-$(date +%Y%m%d-%H%M%S)"
    install -m 755 "$tmp" "$destino"
    rm -f "$tmp"
    log "painel atualizado a partir de $URL_ATUALIZACAO"
    msg_ok "$(t "Painel atualizado.\n\nFeche e abra de novo com: sudo options.sh" "Panel updated.\n\nClose and reopen with: sudo options.sh")" 10 70
}

# ======================================================================
# 23. REINICIAR O SERVIDOR
# ======================================================================
funcao_reiniciar_servidor() {
    perguntar "$(t "Reiniciar" "Reboot")" "$(t "Reiniciar o servidor agora?\nTodo mundo que estiver usando o catálogo será desconectado." "Reboot the server now?\nEveryone using the catalog will be disconnected.")" 10 74 || return 0
    clear
    echo "$(t "Reiniciando em 5 segundos..." "Rebooting in 5 seconds...")"
    log "reboot solicitado pelo painel"
    sleep 5
    reboot
}

