funcao_instalar_idiomas() {
    exigir_banco || return 0
    local itens=() par codigo nome escolha
    IFS=';' read -ra pares <<< "$IDIOMAS_KOHA"
    for par in "${pares[@]}"; do
        codigo="${par%%:*}"; nome="${par#*:}"
        itens+=("$codigo" "$nome")
    done
    escolha=$(whiptail --title "$(t "Idiomas do Koha" "Koha Languages")" \
        --cancel-button "$(t "Voltar" "Back")" \
        --menu "$(t "Escolha o pacote de idioma para instalar:" "Choose the language pack to install:")" 22 72 13 "${itens[@]}" 3>&1 1>&2 2>&3) || return 0
    [ -z "$escolha" ] && return 0
    clear
    caixa_explicacao "Baixando e instalando: $escolha" "Downloading and installing: $escolha"
    if koha-translate --install "$escolha"; then
        systemctl restart memcached >/dev/null 2>&1
        koha-plack --restart "$INSTANCIA" >/dev/null 2>&1
        if perguntar "$(t "Ativar idioma" "Enable language")" "$(t "Pacote instalado.\n\nQuer ativá-lo já nas preferências (OPAC e Staff)?" "Package installed.\n\nEnable it right away in the preferences (OPAC and Staff)?")" 10 70; then
            mysql -e "UPDATE ${DB_NAME}.systempreferences SET value=CONCAT(value,',','${escolha}') WHERE variable IN ('language','OPACLanguages') AND value NOT LIKE '%${escolha}%';" >/dev/null 2>&1
            systemctl restart memcached >/dev/null 2>&1
            koha-plack --restart "$INSTANCIA" >/dev/null 2>&1
        fi
        msg_ok "$(t "Idioma '$escolha' instalado.\nAjustes finos em: Administração > Preferências > I18N/L10N." "Language '$escolha' installed.\nFine tuning in: Administration > Preferences > I18N/L10N.")" 10 74
    else
        msg_erro "" "$(t "Falha ao baixar o idioma '$escolha'. Verifique a internet." "Failed to download language '$escolha'. Check your connection.")" 9 70
    fi
}

# ======================================================================
# 7. ALTERNAR MOTOR DE BUSCA
# ======================================================================
funcao_alternar_motor_busca() {
    exigir_banco || return 0
    local motor; motor=$(obter_motor_busca)
    if [ "$motor" = "Elasticsearch" ]; then
        perguntar "$(t "Motor de Busca" "Search Engine")" \
"$(t "Motor atual: ELASTICSEARCH.\n\nVoltar para o ZEBRA? Ele usa cerca de 1,5 GB de RAM a menos,\nmas perde as facetas dinâmicas e a busca avançada." \
"Current engine: ELASTICSEARCH.\n\nSwitch back to ZEBRA? It uses about 1.5 GB less RAM,\nbut loses dynamic facets and advanced search.")" 12 74 || return 0
        clear
        if ! backup_lock_acquire; then
            msg_erro "" "$(t "Outro backup/restauração está em andamento. Troca de motor cancelada." "Another backup/restore is running. Engine switch cancelled.")" 9 72
            return 1
        fi
        caixa_explicacao "Parando o indexador do Elasticsearch..." "Stopping the Elasticsearch indexer..."
        koha_indexadores_gerenciar stop
        systemctl disable --now elasticsearch >/dev/null 2>&1 || true
        caixa_explicacao "Removendo o bloco <elasticsearch> do koha-conf.xml..." "Removing the <elasticsearch> block..."
        if ! xml_set_elasticsearch remover; then
            koha_indexadores_gerenciar start >/dev/null 2>&1 || true
            systemctl enable --now elasticsearch >/dev/null 2>&1 || true
            backup_lock_release
            return 1
        fi
        if ! mysql -e "UPDATE ${DB_NAME}.systempreferences SET value='Zebra' WHERE variable='SearchEngine';" >/dev/null 2>&1; then
            xml_set_elasticsearch inserir >/dev/null 2>&1 || true
            koha_indexadores_gerenciar start >/dev/null 2>&1 || true
            systemctl enable --now elasticsearch >/dev/null 2>&1 || true
            backup_lock_release
            msg_erro "" "$(t "Não foi possível alterar SearchEngine para Zebra. A configuração do Elasticsearch foi restaurada." "Could not set SearchEngine to Zebra. Elasticsearch configuration was restored.")" 10 74
            return 1
        fi
        caixa_explicacao "Limpando o cache de preferências (Memcached)..." "Flushing the preferences cache (Memcached)..."
        systemctl restart memcached >/dev/null 2>&1 || true
        caixa_explicacao "Destravando e religando o Zebra..." "Unlocking and restarting Zebra..."
        systemctl disable --now "koha-zebra-daemon@${INSTANCIA}" >/dev/null 2>&1 || true
        koha_zebra_force_stop
        rm -f /var/lock/koha/${INSTANCIA}/rebuild/*.LCK 2>/dev/null
        rm -f /var/run/koha/${INSTANCIA}/zebrasrv.pid 2>/dev/null
        chown -R "${INSTANCIA}-koha:${INSTANCIA}-koha" \
            "/var/lib/koha/${INSTANCIA}/biblios" "/var/lib/koha/${INSTANCIA}/authorities" \
            "/var/lock/koha/${INSTANCIA}" 2>/dev/null || true
        systemctl enable --now "koha-zebra-daemon@${INSTANCIA}" >/dev/null 2>&1
        if ! systemctl is-active --quiet "koha-zebra-daemon@${INSTANCIA}"; then
            backup_lock_release
            msg_erro "" "$(t "O daemon do Zebra não pôde ser iniciado. A troca de motor foi interrompida." "Zebra daemon could not be started. Engine switch was interrupted.")" 10 74
            return 1
        fi
        escrever_cron_zebra
        systemctl restart koha-common >/dev/null 2>&1 || true
        caixa_explicacao "Reindexando o acervo no Zebra..." "Reindexing the catalog into Zebra..."
        if ! koha-rebuild-zebra -f -v -b -a -r "$INSTANCIA"; then
            backup_lock_release
            msg_erro "" "$(t "A reconstrução do Zebra falhou. O sistema continuará em Zebra; use a opção 8 para reparar." "Zebra rebuild failed. The system will remain on Zebra; use option 8 to repair.")" 11 76
            return 1
        fi
        backup_lock_release
        koha-plack --restart "$INSTANCIA" >/dev/null 2>&1 || true
        validar_sistema_completo "troca para Zebra"
        msg_ok "$(t "Sistema operando com ZEBRA.\nA indexação incremental roda a cada 2 minutos." "System now running on ZEBRA.\nIncremental indexing runs every 2 minutes.")" 10 70
        return 0
    fi

    perguntar "$(t "Motor de Busca" "Search Engine")" \
"$(t "Motor atual: ZEBRA.\n\nAtivar o ELASTICSEARCH? Ele traz busca avançada e facetas\ndinâmicas, mas exige cerca de 1,5 GB de RAM a mais e mais disco." \
"Current engine: ZEBRA.\n\nEnable ELASTICSEARCH? It brings advanced search and dynamic\nfacets, but needs about 1.5 GB more RAM and more disk.")" 12 76 || return 0
    if [ "$(espaco_livre_mb /)" -lt 4096 ] 2>/dev/null; then
        perguntar "$(t "Pouco espaço" "Low disk space")" "$(t "Há menos de 4 GB livres. O Elasticsearch pode não subir.\n\nContinuar mesmo assim?" "Less than 4 GB free. Elasticsearch may fail to start.\n\nContinue anyway?")" 10 70 || return 0
    fi

    clear
    if ! backup_lock_acquire; then
        msg_erro "" "$(t "Outro backup/restauração está em andamento. Troca de motor cancelada." "Another backup/restore is running. Engine switch cancelled.")" 9 72
        return 1
    fi

    caixa_explicacao "Desativando o Zebra e sua fila..." "Disabling Zebra and its queue..."
    rm -f "$CRON_ZEBRA"; systemctl restart cron >/dev/null 2>&1 || true
    systemctl disable --now "koha-zebra-daemon@${INSTANCIA}" >/dev/null 2>&1 || true

    if ! dpkg -s koha-elasticsearch >/dev/null 2>&1; then
        caixa_explicacao "Instalando o Elasticsearch 7..." "Installing Elasticsearch 7..."
        apt_atualizar_indices
        if ! apt_instalar elasticsearch koha-elasticsearch; then
            escrever_cron_zebra
            systemctl enable --now "koha-zebra-daemon@${INSTANCIA}" >/dev/null 2>&1 || true
            backup_lock_release
            msg_erro "" "$(t "Falha ao instalar o Elasticsearch. O Zebra foi restaurado." "Elasticsearch installation failed. Zebra was restored.")" 10 72
            return 1
        fi
    fi

    caixa_explicacao "Ajustando memória e configuração do Elasticsearch..." "Tuning Elasticsearch memory and configuration..."
    if ! ajustar_heap_elasticsearch; then
        escrever_cron_zebra
        systemctl enable --now "koha-zebra-daemon@${INSTANCIA}" >/dev/null 2>&1 || true
        backup_lock_release
        msg_erro "" "$(t "Não foi possível gravar a configuração de memória do Elasticsearch. O Zebra foi restaurado." "Could not write Elasticsearch memory configuration. Zebra was restored.")" 11 78
        return 1
    fi
    if [ ! -f /etc/elasticsearch/elasticsearch.yml ]; then
        backup_lock_release
        msg_erro "" "$(t "O arquivo de configuração do Elasticsearch não existe." "Elasticsearch configuration file is missing.")" 9 70
        escrever_cron_zebra; systemctl enable --now "koha-zebra-daemon@${INSTANCIA}" >/dev/null 2>&1 || true
        return 1
    fi
    cp -f /etc/elasticsearch/elasticsearch.yml "/etc/elasticsearch/elasticsearch.yml.bak-$(date +%Y%m%d-%H%M%S)" 2>/dev/null || true
    grep -q '^discovery.type: single-node' /etc/elasticsearch/elasticsearch.yml 2>/dev/null || echo 'discovery.type: single-node' >> /etc/elasticsearch/elasticsearch.yml
    grep -q '^network.host: 127.0.0.1'     /etc/elasticsearch/elasticsearch.yml 2>/dev/null || echo 'network.host: 127.0.0.1'     >> /etc/elasticsearch/elasticsearch.yml
    if ! /usr/share/elasticsearch/bin/elasticsearch-plugin list 2>/dev/null | grep -q '^analysis-icu$'; then
        if ! /usr/share/elasticsearch/bin/elasticsearch-plugin install --batch analysis-icu >/dev/null 2>&1; then
            systemctl disable --now elasticsearch >/dev/null 2>&1 || true
            escrever_cron_zebra
            systemctl enable --now "koha-zebra-daemon@${INSTANCIA}" >/dev/null 2>&1 || true
            backup_lock_release
            msg_erro "" "$(t "Não foi possível instalar o plugin analysis-icu do Elasticsearch. O Zebra foi restaurado." "Could not install the Elasticsearch analysis-icu plugin. Zebra was restored.")" 11 78
            return 1
        fi
    fi

    caixa_explicacao "Iniciando o Elasticsearch (pode levar até 1 minuto)..." "Starting Elasticsearch (up to 1 minute)..."
    systemctl daemon-reload
    systemctl enable elasticsearch >/dev/null 2>&1 || true
    if ! systemctl restart elasticsearch; then
        systemctl disable --now elasticsearch >/dev/null 2>&1 || true
        escrever_cron_zebra; systemctl enable --now "koha-zebra-daemon@${INSTANCIA}" >/dev/null 2>&1 || true
        backup_lock_release
        msg_erro "" "$(t "O Elasticsearch falhou ao iniciar. O Zebra foi restaurado." "Elasticsearch failed to start. Zebra was restored.")" 12 76
        return 1
    fi
    local es_ok="nao"
    for _ in $(seq 1 60); do
        curl -sS --max-time 2 http://127.0.0.1:9200 >/dev/null 2>&1 && { es_ok="sim"; break; }
        sleep 1
    done
    if [ "$es_ok" = "nao" ]; then
        systemctl disable --now elasticsearch >/dev/null 2>&1 || true
        escrever_cron_zebra
        systemctl enable --now "koha-zebra-daemon@${INSTANCIA}" >/dev/null 2>&1 || true
        backup_lock_release
        msg_erro "" "$(t "O Elasticsearch não subiu na porta 9200. O Zebra foi mantido." "Elasticsearch did not start on port 9200. Zebra was kept.")" 12 76
        return 1
    fi

    caixa_explicacao "Declarando o Elasticsearch no koha-conf.xml..." "Declaring Elasticsearch in koha-conf.xml..."
    if ! xml_set_elasticsearch inserir; then
        systemctl disable --now elasticsearch >/dev/null 2>&1 || true
        escrever_cron_zebra
        systemctl enable --now "koha-zebra-daemon@${INSTANCIA}" >/dev/null 2>&1 || true
        backup_lock_release
        msg_erro "" "$(t "Não consegui ativar o bloco do Elasticsearch no koha-conf.xml. O Zebra foi restaurado." "Could not enable the Elasticsearch block in koha-conf.xml. Zebra was restored.")" 11 78
        return 1
    fi
    if ! mysql -e "UPDATE ${DB_NAME}.systempreferences SET value='Elasticsearch' WHERE variable='SearchEngine';" >/dev/null 2>&1; then
        xml_set_elasticsearch remover >/dev/null 2>&1 || true
        escrever_cron_zebra; systemctl enable --now "koha-zebra-daemon@${INSTANCIA}" >/dev/null 2>&1 || true
        systemctl disable --now elasticsearch >/dev/null 2>&1 || true
        backup_lock_release
        msg_erro "" "$(t "Não foi possível mudar SearchEngine para Elasticsearch. O Zebra foi restaurado." "Could not set SearchEngine to Elasticsearch. Zebra was restored.")" 10 76
        return 1
    fi
    caixa_explicacao "Limpando o cache de preferências (Memcached)..." "Flushing the preferences cache (Memcached)..."
    systemctl restart memcached >/dev/null 2>&1 || true
    koha_broker_preparar || true
    curl -sS -X DELETE --max-time 10 "http://127.0.0.1:9200/${DB_NAME}_biblios" >/dev/null 2>&1 || true
    curl -sS -X DELETE --max-time 10 "http://127.0.0.1:9200/${DB_NAME}_authorities" >/dev/null 2>&1 || true
    caixa_explicacao "Reiniciando o Koha com o Elasticsearch ativo..." "Restarting Koha with Elasticsearch enabled..."
    systemctl restart koha-common >/dev/null 2>&1 || true
    caixa_explicacao "Subindo o indexador contínuo..." "Starting the continuous indexer..."
    local indexer_ok="sim"
    if ! koha_indexadores_gerenciar start; then indexer_ok="nao"; fi
    local corte; corte=$(date '+%Y-%m-%d %H:%M:%S')
    local rebuild_ok="sim"
    caixa_explicacao "Reindexando o acervo no Elasticsearch..." "Reindexing the catalog into Elasticsearch..."
    if [ "$indexer_ok" = "sim" ] && ! koha_rebuild_elasticsearch "$corte"; then rebuild_ok="nao"; fi
    backup_lock_release
    koha-plack --restart "$INSTANCIA" >/dev/null 2>&1 || true
    validar_sistema_completo "ativação do Elasticsearch"
    if [ "$indexer_ok" = "sim" ] && [ "$rebuild_ok" = "sim" ] && koha_indexador_esta_rodando; then
        msg_ok "$(t "Sistema operando com ELASTICSEARCH.\n\nO indexador tem reinício automático e o vigia confere a fila a cada 5 minutos." "System now running on ELASTICSEARCH.\n\nThe indexer has automatic recovery and the watchdog checks the queue every 5 minutes.")" 12 78
    elif [ "$indexer_ok" = "nao" ]; then
        msg_erro "" "$(t "O Elasticsearch está ativo, mas o indexador não subiu. Use a opção 8 para reparar." "Elasticsearch is active but the indexer did not start. Use option 8 to repair.")" 11 76
        return 1
    else
        msg_erro "" "$(t "O Elasticsearch está ativo, mas a reindexação falhou. Use a opção 8 (Reparar Indexação)." "Elasticsearch is active but rebuilding failed. Use option 8 (Repair Indexing).")" 11 78
        return 1
    fi
}

ajustar_heap_elasticsearch() {
    local ram_mb heap cfg tmp
    ram_mb=$(awk '/MemTotal:/ {printf "%d", $2/1024}' /proc/meminfo 2>/dev/null)
    if   [ "${ram_mb:-0}" -ge 16384 ]; then heap="4g"
    elif [ "${ram_mb:-0}" -ge 8192 ];  then heap="2g"
    elif [ "${ram_mb:-0}" -ge 4096 ];  then heap="1g"
    else heap="512m"; fi
    mkdir -p /etc/elasticsearch/jvm.options.d || return 1
    cfg="/etc/elasticsearch/jvm.options.d/koha.options"
    tmp=$(mktemp "${cfg}.tmp.XXXXXX") || return 1
    if ! printf -- '-Xms%s\n-Xmx%s\n' "$heap" "$heap" > "$tmp"; then
        rm -f "$tmp"
        return 1
    fi
    chmod 644 "$tmp"
    chown root:root "$tmp" 2>/dev/null || true
    if ! mv -f "$tmp" "$cfg"; then
        rm -f "$tmp"
        return 1
    fi
    log "ES heap = $heap (RAM ${ram_mb}MB)"
}

# ======================================================================
# 8. REPARAR / RECONSTRUIR A INDEXAÇÃO
# ======================================================================
funcao_reparar_indexacao() {
    exigir_banco || return 0
    local motor; motor=$(obter_motor_busca)
    if [ "$motor" = "Elasticsearch" ]; then
        local es_up idx broker pend bibs docs
        es_up=$(curl -s --max-time 5 http://127.0.0.1:9200 >/dev/null 2>&1 && echo "OK" || echo "FORA/DOWN")
        koha_indexador_esta_rodando && idx="$(t "rodando" "running")" || idx="$(t "PARADO" "STOPPED")"
        ss -lnt 2>/dev/null | grep -q ':61613' && broker="OK" || broker="$(t "ausente" "absent")"
        pend=$(koha_jobs_es_pendentes); bibs=$(koha_total_biblios); docs=$(koha_es_total_documentos)
        msg_info "$(t "Diagnóstico" "Diagnostics")" \
"Elasticsearch (9200) : ${es_up}
$(t "Bloco no XML" "Block in XML")         : $(koha_es_ativo_no_xml && echo OK || echo "$(t "AUSENTE" "MISSING")")
$(t "Indexador" "Indexer")            : ${idx}
RabbitMQ/STOMP       : ${broker}
$(t "Jobs pendentes" "Pending jobs")       : ${pend:-?}
$(t "Índice / banco" "Index / database")       : ${docs:-?} / ${bibs:-?}
$(t "Fila crescendo + índice menor que o banco = indexador parado." "Growing queue + smaller index = indexer is down.")" 18 76
        perguntar "$(t "Reparar" "Repair")" "$(t "Reinstalar o serviço do indexador, limpar o cache e religar tudo?" "Reinstall the indexer service, flush the cache and restart everything?")" 10 74 || return 0
        clear
        caixa_explicacao "Reparando os serviços de indexação..." "Repairing the indexing services..."
        systemctl restart elasticsearch >/dev/null 2>&1
        koha_broker_preparar
        systemctl restart memcached koha-common >/dev/null 2>&1
        koha_indexadores_gerenciar start
        koha-plack --restart "$INSTANCIA" >/dev/null 2>&1
        if perguntar "$(t "Reindexar" "Reindex")" "$(t "Reconstruir o índice inteiro do zero?\nEm acervos grandes pode levar vários minutos." "Rebuild the whole index from scratch?\nOn large catalogs this can take several minutes.")" 10 74; then
            clear
            local corte; corte=$(date '+%Y-%m-%d %H:%M:%S')
            koha_rebuild_elasticsearch "$corte"
        fi
        v_reset "reparo da indexação"
        validar_elasticsearch "Elasticsearch"
        if koha_indexador_esta_rodando; then
            msg_ok "$(t "Indexador ativo.\nCadastre um registro de teste e busque em ~10 segundos." "Indexer is running.\nAdd a test record and search for it after ~10 seconds.")" 10 74
        else
            msg_erro "" "$(t "O indexador não subiu. Veja:\njournalctl -u koha-es-indexer@${INSTANCIA} -n 50\ntail -n 50 /var/log/koha/${INSTANCIA}/es-indexer-output.log" "The indexer did not start. Check:\njournalctl -u koha-es-indexer@${INSTANCIA} -n 50\ntail -n 50 /var/log/koha/${INSTANCIA}/es-indexer-output.log")" 12 78
        fi
        return 0
    fi
    perguntar "$(t "Reparar Zebra" "Repair Zebra")" "$(t "Destravar o Zebra e reconstruir os índices do zero?" "Unlock Zebra and rebuild the indices from scratch?")" 10 70 || return 0
    clear
    caixa_explicacao "Destravando o Zebra..." "Unlocking Zebra..."
    systemctl disable --now "koha-zebra-daemon@${INSTANCIA}" >/dev/null 2>&1 || true
    koha_zebra_force_stop
    rm -f /var/lock/koha/${INSTANCIA}/rebuild/*.LCK 2>/dev/null
    rm -f /var/run/koha/${INSTANCIA}/zebrasrv.pid 2>/dev/null
    chown -R "${INSTANCIA}-koha:${INSTANCIA}-koha" \
        "/var/lib/koha/${INSTANCIA}/biblios" "/var/lib/koha/${INSTANCIA}/authorities" \
        "/var/lock/koha/${INSTANCIA}" 2>/dev/null
    systemctl enable --now "koha-zebra-daemon@${INSTANCIA}" >/dev/null 2>&1
    escrever_cron_zebra
    systemctl restart memcached koha-common >/dev/null 2>&1
    caixa_explicacao "Reconstruindo os índices..." "Rebuilding the indices..."
    koha-rebuild-zebra -f -v -b -a -r "$INSTANCIA"
    koha-plack --restart "$INSTANCIA" >/dev/null 2>&1
    msg_ok "$(t "Zebra destravado e acervo reindexado." "Zebra unlocked and catalog reindexed.")" 9 66
}

# ======================================================================
# 9. DIMENSIONAMENTO DO SERVIDOR
# ======================================================================
funcao_dimensionar_servidor() {
    local ram ram_int recomendado perfil wk mem db
    ram=$(awk '/MemTotal:/ {printf "%.1f", $2/1024/1024}' /proc/meminfo)
    ram_int=$(awk '/MemTotal:/ {printf "%d", ($2/1024/1024)+0.5}' /proc/meminfo)
    if   [ "$ram_int" -lt 4 ];  then recomendado=1
    elif [ "$ram_int" -lt 8 ];  then recomendado=2
    elif [ "$ram_int" -lt 16 ]; then recomendado=3
    else recomendado=4; fi
    perfil=$(whiptail --title "$(t "Dimensionamento" "Sizing")" \
        --cancel-button "$(t "Voltar" "Back")" \
        --default-item "$recomendado" \
        --menu "$(t "RAM detectada:" "Detected RAM:") ${ram} GB\n$(t "Perfil recomendado:" "Recommended profile:") ${recomendado}" 18 76 4 \
        "1" "< 4 GB   - 2 Plack, 64MB cache, 512M InnoDB" \
        "2" "4-8 GB   - 3 Plack, 128MB cache, 768M InnoDB" \
        "3" "8-16 GB  - 4 Plack, 128MB cache, 1G InnoDB" \
        "4" "16 GB+   - 6 Plack, 256MB cache, 2G InnoDB" 3>&1 1>&2 2>&3) || return 0
    [ -z "$perfil" ] && return 0
    case "$perfil" in
        1) wk=2; mem=64;  db=512M ;;
        2) wk=3; mem=128; db=768M ;;
        3) wk=4; mem=128; db=1G ;;
        4) wk=6; mem=256; db=2G ;;
        *) return 0 ;;
    esac
    clear
    caixa_explicacao "Aplicando o perfil $perfil..." "Applying profile $perfil..."
    ajustar_chave_conf() {
        local arquivo="$1" padrao="$2" linha="$3"
        [ -f "$arquivo" ] || return 0
        if grep -qE "$padrao" "$arquivo"; then sed -i -E "s|${padrao}|${linha}|" "$arquivo"
        else echo "$linha" >> "$arquivo"; fi
    }
    ajustar_chave_conf /etc/default/koha-common '^[[:space:]]*#?[[:space:]]*PLACK_WORKERS=.*'      "PLACK_WORKERS=$wk"
    ajustar_chave_conf /etc/default/koha-common '^[[:space:]]*#?[[:space:]]*PLACK_MAX_REQUESTS=.*' "PLACK_MAX_REQUESTS=100"
    ajustar_chave_conf /etc/memcached.conf       '^[[:space:]]*-m[[:space:]]+.*'                     "-m $mem"
    mkdir -p /etc/mysql/mariadb.conf.d
    local tuning="/etc/mysql/mariadb.conf.d/99-koha-tuning.cnf"
    local tuning_bak="/tmp/99-koha-tuning.bak"
    local had_tuning="nao"
    if [ -f "$tuning" ]; then
        cp -f "$tuning" "$tuning_bak" 2>/dev/null && had_tuning="sim" || {
            msg_erro "" "$(t "Não consegui criar uma cópia do ajuste do MariaDB. Alteração cancelada." "Could not back up the MariaDB tuning file. Change cancelled.")" 9 74
            return 1
        }
    else
        rm -f "$tuning_bak"
    fi
    printf '[mysqld]\ninnodb_buffer_pool_size = %s\n' "$db" > "$tuning"
    systemctl restart memcached >/dev/null 2>&1
    if ! systemctl restart mariadb; then
        if [ "$had_tuning" = "sim" ] && [ -f "$tuning_bak" ]; then
            cp -f "$tuning_bak" "$tuning" 2>/dev/null || true
        else
            rm -f "$tuning"
        fi
        systemctl restart mariadb >/dev/null 2>&1
        msg_erro "" "$(t "O MariaDB não subiu com innodb_buffer_pool_size=$db.\nO ajuste foi DESFEITO e o banco voltou ao normal.\n\nEscolha um perfil menor." "MariaDB failed to start with innodb_buffer_pool_size=$db.\nThe change was REVERTED and the database is back up.\n\nPick a smaller profile.")" 12 76
        return 1
    fi
    systemctl restart koha-common >/dev/null 2>&1
    koha-plack --restart "$INSTANCIA" >/dev/null 2>&1
    if [ "$(obter_motor_busca)" = "Elasticsearch" ]; then
        if ! ajustar_heap_elasticsearch || ! systemctl restart elasticsearch >/dev/null 2>&1; then
            msg_erro "" "$(t "O ajuste de memória do Elasticsearch falhou ou o serviço não reiniciou." "Elasticsearch memory tuning failed or the service did not restart.")" 9 74
            return 1
        fi
    fi
    log "tuning perfil=$perfil plack=$wk memcached=$mem innodb=$db"
    msg_ok "$(t "Perfil $perfil aplicado.\n\nPlack: $wk workers\nMemcached: ${mem} MB\nMariaDB InnoDB: $db\n\nTodos os serviços voltaram a subir normalmente." "Profile $perfil applied.\n\nPlack: $wk workers\nMemcached: ${mem} MB\nMariaDB InnoDB: $db\n\nAll services restarted successfully.")" 13 74
}

# ======================================================================
# CONFIG DE BACKUP
# ======================================================================
backup_conf_definir() {
    local chave="$1" valor="$2"
    escrever_config_backup
    if grep -qE "^${chave}=" "$BACKUP_CONF" 2>/dev/null; then
        sed -i -E "s|^${chave}=.*|${chave}=\"${valor}\"|" "$BACKUP_CONF"
    else
        echo "${chave}=\"${valor}\"" >> "$BACKUP_CONF"
    fi
    if ! grep -qE "^${chave}=\"${valor}\"$" "$BACKUP_CONF" 2>/dev/null; then
        log "FALHA ao gravar ${chave} em ${BACKUP_CONF}"
        return 1
    fi
    return 0
}

