function_toggle_search_engine() {
    require_database || return 0
    local engine; engine=$(get_search_engine)
    if [ "$engine" = "Elasticsearch" ]; then
        prompt_yes_no "$(t "Motor de Busca" "Search Engine")" \
"$(t "Motor atual: ELASTICSEARCH.\n\nVoltar para o ZEBRA? Ele usa cerca de 1,5 GB de RAM a menos,\nmas perde as facetas dinâmicas e a busca avançada." \
"Current engine: ELASTICSEARCH.\n\nSwitch back to ZEBRA? It uses about 1.5 GB less RAM,\nbut loses dynamic facets and advanced search.")" 12 74 || return 0
        clear
        if ! backup_lock_acquire; then
            msg_error "" "$(t "Outro backup/restauração está em andamento. Troca de motor cancelada." "Another backup/restore is running. Engine switch cancelled.")" 9 72
            return 1
        fi
        display_explanation "Parando o indexador do Elasticsearch..." "Stopping the Elasticsearch indexer..."
        manage_koha_indexers stop
        systemctl disable --now elasticsearch >/dev/null 2>&1 || true
        display_explanation "Removendo o bloco <elasticsearch> do koha-conf.xml..." "Removing the <elasticsearch> block..."
        if ! set_xml_elasticsearch remover; then
            manage_koha_indexers start >/dev/null 2>&1 || true
            systemctl enable --now elasticsearch >/dev/null 2>&1 || true
            backup_lock_release
            return 1
        fi
        if ! set_search_engine "Zebra"; then
            set_xml_elasticsearch inserir >/dev/null 2>&1 || true
            manage_koha_indexers start >/dev/null 2>&1 || true
            systemctl enable --now elasticsearch >/dev/null 2>&1 || true
            backup_lock_release
            msg_error "" "$(t "Não foi possível alterar SearchEngine para Zebra. A configuração do Elasticsearch foi restaurada." "Could not set SearchEngine to Zebra. Elasticsearch configuration was restored.")" 10 74
            return 1
        fi
        display_explanation "Limpando o cache de preferências (Memcached)..." "Flushing the preferences cache (Memcached)..."
        systemctl restart memcached >/dev/null 2>&1 || true
        display_explanation "Destravando e religando o Zebra..." "Unlocking and restarting Zebra..."
        systemctl disable --now "koha-zebra-daemon@${INSTANCE}" >/dev/null 2>&1 || true
        force_stop_koha_zebra
        rm -f /var/lock/koha/${INSTANCE}/rebuild/*.LCK 2>/dev/null
        rm -f /var/run/koha/${INSTANCE}/zebrasrv.pid 2>/dev/null
        chown -R "${INSTANCE}-koha:${INSTANCE}-koha" \
            "/var/lib/koha/${INSTANCE}/biblios" "/var/lib/koha/${INSTANCE}/authorities" \
            "/var/lock/koha/${INSTANCE}" 2>/dev/null || true
        systemctl enable --now "koha-zebra-daemon@${INSTANCE}" >/dev/null 2>&1
        if ! systemctl is-active --quiet "koha-zebra-daemon@${INSTANCE}"; then
            backup_lock_release
            msg_error "" "$(t "O daemon do Zebra não pôde ser iniciado. A troca de motor foi interrompida." "Zebra daemon could not be started. Engine switch was interrupted.")" 10 74
            return 1
        fi
        write_cron_zebra
        systemctl restart koha-common >/dev/null 2>&1 || true
        display_explanation "Reindexando o acervo no Zebra..." "Reindexing the catalog into Zebra..."
        if ! koha-rebuild-zebra -f -v -b -a -r "$INSTANCE"; then
            backup_lock_release
            msg_error "" "$(t "A reconstrução do Zebra falhou. O sistema continuará em Zebra; use a opção de reparar." "Zebra rebuild failed. The system will remain on Zebra; use the repair option.")" 11 76
            return 1
        fi
        backup_lock_release
        koha-plack --restart "$INSTANCE" >/dev/null 2>&1 || true
        validate_complete_system "troca para Zebra"
        msg_ok "$(t "Sistema operando com ZEBRA.\nA indexação incremental roda a cada 2 minutos." "System now running on ZEBRA.\nIncremental indexing runs every 2 minutes.")" 10 70
        return 0
    fi

    prompt_yes_no "$(t "Motor de Busca" "Search Engine")" \
"$(t "Motor atual: ZEBRA.\n\nAtivar o ELASTICSEARCH? Ele traz busca avançada e facetas\ndinâmicas, mas exige cerca de 1,5 GB de RAM a mais e mais disco." \
"Current engine: ZEBRA.\n\nEnable ELASTICSEARCH? It brings advanced search and dynamic\nfacets, but needs about 1.5 GB more RAM and more disk.")" 12 76 || return 0
    if [ "$(get_free_space_mb /)" -lt 4096 ] 2>/dev/null; then
        prompt_yes_no "$(t "Pouco espaço" "Low disk space")" "$(t "Há menos de 4 GB livres. O Elasticsearch pode não subir.\n\nContinuar mesmo assim?" "Less than 4 GB free. Elasticsearch may fail to start.\n\nContinue anyway?")" 10 70 || return 0
    fi

    clear
    if ! backup_lock_acquire; then
