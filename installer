  Elasticsearch : $(systemctl is-active elasticsearch 2>/dev/null)
  Indexador ES  : ${idx}
  Cloudflare    : $(systemctl is-active cloudflared 2>/dev/null)

$(t "BUSCA" "SEARCH")
  $(t "Motor" "Engine")        : ${motor:-?}
