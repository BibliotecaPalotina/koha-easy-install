definir_koha_sites_conf() {
    local f="/etc/koha/koha-sites.conf"
    [ -f "$f" ] || return 0
    cp -f "$f" "${f}.bak-$(date +%s)" 2>/dev/null
    set_conf() {
        local chave="$1" valor="$2"
        if grep -qE "^[[:space:]]*#?[[:space:]]*${chave}=" "$f"; then
            sed -i -E "s|^[[:space:]]*#?[[:space:]]*${chave}=.*|${chave}=\"${valor}\"|" "$f"
        else
            echo "${chave}=\"${valor}\"" >> "$f"
        fi
    }
    set_conf INTRAPORT 8080
    set_conf OPACPORT 80
    set_conf USE_MEMCACHED yes
    set_conf MEMCACHED_SERVERS "127.0.0.1:11211"
    set_conf MEMCACHED_PREFIX "koha_"
    set_conf ZEBRA_MARC_FORMAT marc21
    set_conf ZEBRA_LANGUAGE en
    if [ -f /etc/koha/koha-conf-site.xml.in ]; then
        sed -i 's/__MEMCACHED_SERVERS__/127.0.0.1:11211/g; s/__MEMCACHED_PREFIX__/koha_/g' /etc/koha/koha-conf-site.xml.in
    fi
}

escolher_fuso_horario() {
