validate_and_register_rclone() {
    local name="$1" actual=""
    [ -n "$name" ] || { msg_error "" "$(t "Nome do remote não pode ser vazio." "Remote name cannot be empty.")" 9 64; return 1; }
    command -v rclone >/dev/null 2>&1 || { msg_error "" "$(t "Rclone não está instalado." "Rclone is not installed.")" 9 64; return 1; }
    if ! rclone listremotes --config /root/.config/rclone/rclone.conf 2>/dev/null | grep -qx "${name}:"; then
        msg_error "" "$(t "O remote '$name' não existe no rclone. Configure-o primeiro." "Remote '$name' does not exist in rclone. Configure it first.")" 9 74
        return 1
    fi
    write_backup_config
    if ! set_shell_config_value "$BACKUP_CONF" RCLONE_REMOTE "$name"; then
        msg_error "" "$(t "Não foi possível salvar o remote de forma segura." "Could not save the remote safely.")" 9 70
        return 1
    fi
    actual=$(bash -c '. "$1"; printf "%s" "$RCLONE_REMOTE"' _ "$BACKUP_CONF" 2>/dev/null || true)
    if [ "$actual" != "$name" ]; then
        msg_error "" "$(t "O remote não foi salvo corretamente." "The remote was not saved correctly.")" 9 70
        return 1
    fi
    log "rclone configurado: ${name}"
    msg_ok "$(t "Remote '$name' validado e salvo.\n\nOs próximos backups usarão este remote." "Remote '$name' validated and saved.\n\nFuture backups will use this remote.")" 10 72
    return 0
}

