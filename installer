# ======================================================================
# 3. RESTAURAR BANCO / RESTORE DATABASE
# ======================================================================
backup_database_for_rollback() {
    local destination="$1"
    local exists

    mkdir -p "$(dirname "$destination")" || return 1
    exists=$(run_sql_checked "SELECT COUNT(*) FROM information_schema.schemata WHERE schema_name='${DB_NAME}';") || return 1
    [ "$exists" = "1" ] || return 2

    display_explanation "Criando backup de segurança do banco atual..." "Creating a safety backup of the current database..."
    if ! mysqldump --single-transaction --quick --routines --triggers \
        --default-character-set=utf8mb4 "$DB_NAME" 2>>"$RUN_LOG" | gzip >"$destination"; then
        rm -f "$destination"
        return 1
    fi
    gzip -t "$destination" >/dev/null 2>&1 || { rm -f "$destination"; return 1; }
    if ! ( set +o pipefail; gzip -dc -- "$destination" 2>/dev/null | grep -iE 'CREATE TABLE|INSERT INTO' >/dev/null ); then
        rm -f "$destination"
        return 1
    fi

    log "Backup de rollback criado: $destination"
    return 0
}

rollback_database_from_backup() {
    local backup="$1"
    local pass
    local db_pass_sql

    [ -s "$backup" ] || return 1
    gzip -t "$backup" >/dev/null 2>&1 || return 1

    pass=$(get_database_password) || return 1
    [ -n "$pass" ] || return 1
    db_pass_sql=$(sql_escape_literal "$pass")

    log "Iniciando rollback do banco a partir de: $backup"
    mysql -e "
        DROP DATABASE IF EXISTS ${DB_NAME};
        CREATE DATABASE ${DB_NAME} CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
        CREATE USER IF NOT EXISTS '${DB_NAME}'@'localhost' IDENTIFIED BY '${db_pass_sql}';
        ALTER USER '${DB_NAME}'@'localhost' IDENTIFIED BY '${db_pass_sql}';
        GRANT ALL PRIVILEGES ON ${DB_NAME}.* TO '${DB_NAME}'@'localhost';
        FLUSH PRIVILEGES;
    " >/dev/null 2>&1 || return 1

    if ! gzip -dc -- "$backup" | mysql --default-character-set=utf8mb4 "$DB_NAME" >/dev/null 2>&1; then
        log "FALHA: importação do backup de rollback falhou."
        return 1
    fi

    log "Rollback do banco concluído."
    return 0
}

restore_engine_after_database_rollback() {
    local old_engine="$1"

    if [ "$old_engine" = "Elasticsearch" ]; then
        set_xml_elasticsearch inserir >/dev/null 2>&1 || true
        set_search_engine "Elasticsearch" >/dev/null 2>&1 || true
        prepare_koha_broker >/dev/null 2>&1 || true
        systemctl restart elasticsearch >/dev/null 2>&1 || true
        systemctl restart memcached koha-common >/dev/null 2>&1 || true
        manage_koha_indexers start >/dev/null 2>&1 || true
    else
        set_xml_elasticsearch remover >/dev/null 2>&1 || true
        set_search_engine "Zebra" >/dev/null 2>&1 || true
        manage_koha_indexers stop >/dev/null 2>&1 || true
        systemctl disable --now elasticsearch >/dev/null 2>&1 || true
        write_cron_zebra
        systemctl enable --now "koha-zebra-daemon@${INSTANCE}" >/dev/null 2>&1 || true
        systemctl restart "koha-zebra-daemon@${INSTANCE}" >/dev/null 2>&1 || true
    fi
    koha-plack --restart "$INSTANCE" >/dev/null 2>&1 || true
}

import_sql_backup() {
    local file="$1"
    if [[ "$file" == *.gz ]]; then
        gzip -dc -- "$file" | mysql --default-character-set=utf8mb4 "$DB_NAME"
    else
        mysql --default-character-set=utf8mb4 "$DB_NAME" < "$file"
    fi
}

function_restore_database() {
    require_koha || return 0

msg_info "$(t "Origem do Arquivo" "File Source")" \
        "$(t "COMO ENVIAR O BACKUP PARA O SERVIDOR:\n\nOPÇÃO 1 — Windows (Arrastar e Soltar):\n1. No Bloco de Notas, cole o código abaixo e salve na Área de Trabalho como 'Enviar_Backup.bat':\n\n@echo off\nchcp 65001 >nul\nscp \"%~1\" ${REAL_USER}@$(get_server_ip):${REAL_HOME}/\npause\n\n2. Depois, basta ARRASTAR o arquivo .sql em cima desse ícone.\n\nOPÇÃO 2 — Linux, macOS ou Terminal Direto:\n    scp \"caminho_do_arquivo.sql\" ${REAL_USER}@$(get_server_ip):${REAL_HOME}/\n\nOPÇÃO 3 — Pendrive/USB: conecte no servidor e verifique em /media ou /mnt" "HOW TO SEND THE BACKUP TO THE SERVER:\n\nOPTION 1 — Windows (Drag and Drop):\n1. In Notepad, paste the code below and save on Desktop as 'Enviar_Backup.bat':\n\n@echo off\nchcp 65001 >nul\nscp \"%~1\" ${REAL_USER}@$(get_server_ip):${REAL_HOME}/\npause\n\n2. Then, just DRAG the .sql file onto that icon.\n\nOPTION 2 — Linux, macOS or Direct Terminal:\n    scp \"path_to_file.sql\" ${REAL_USER}@$(get_server_ip):${REAL_HOME}/\n\nOPTION 3 — USB drive: plug into server and check /media or /mnt")" 28 82
    local file
    file=$(select_file "$REAL_HOME") || return 0
    [ -z "$file" ] && return 0

    display_explanation "Conferindo o arquivo de backup..." "Checking the backup file..."
    if [[ "$file" == *.gz ]]; then
        if ! gzip -t "$file" 2>/dev/null; then
            msg_error "" "$(t "O arquivo está corrompido (falhou no teste do gzip).\nNada foi alterado." "The file is corrupt (failed the gzip test).\nNothing was changed.")" 9 70
            return 0
        fi
        if ! ( set +o pipefail; gzip -dc -- "$file" 2>/dev/null | head -c 200000 | grep -qi 'CREATE TABLE' ); then
            prompt_yes_no "$(t "Arquivo suspeito" "Suspicious file")" "$(t "Não encontrei comandos SQL no início do arquivo.\nEle pode não ser um backup do Koha.\n\nContinuar mesmo assim?" "No SQL statements found at the start of the file.\nIt may not be a Koha backup.\n\nContinue anyway?")" 11 72 || return 0
        fi
    else
        if ! head -c 200000 "$file" | grep -qi 'CREATE TABLE'; then
            prompt_yes_no "$(t "Arquivo suspeito" "Suspicious file")" "$(t "Não encontrei comandos SQL no início do arquivo.\n\nContinuar mesmo assim?" "No SQL statements found at the start of the file.\n\nContinue anyway?")" 10 72 || return 0
        fi
    fi

    prompt_yes_no "$(t "Confirmar Restauração" "Confirm Restore")" \
        "$(t "Arquivo:\n$file\n\nATENÇÃO: o acervo atual será SUBSTITUÍDO.\n\nAntes disso, o instalador criará automaticamente um backup de segurança para rollback.\n\nContinuar?" "File:\n$file\n\nWARNING: the current catalog will be REPLACED.\n\nBefore that, the installer will automatically create a safety backup for rollback.\n\nContinue?")" 15 78 || return 0

    clear
    if ! backup_lock_acquire; then
        msg_error "" "$(t "Outro backup ou restauração já está em andamento.\nNada foi alterado." "Another backup or restore is already running.\nNothing was changed.")" 10 72
        return 0
    fi

    local configured_db_pass db_pass_sql
    local rollback_file="${DIR_SQL}/PRE-RESTORE_${DB_NAME}_$(date +%Y%m%d-%H%M%S).sql.gz"
    local old_engine="Zebra"
    local tables="0"
    local ok="yes"
    local rollback_ok="no"
    local rebuild_ok="yes"
    local cut_time

    old_engine=$(get_search_engine)
    [ "$old_engine" = "Elasticsearch" ] || old_engine="Zebra"

    if ! backup_database_for_rollback "$rollback_file"; then
        backup_lock_release
        msg_error "" "$(t "Não foi possível criar o backup automático de segurança do banco atual.\nA restauração foi cancelada e nada foi substituído." "Could not create the automatic safety backup of the current database.\nThe restore was cancelled and nothing was replaced.")" 11 78
        return 1
    fi

    manage_koha_indexers stop
    systemctl stop "koha-zebra-daemon@${INSTANCE}" >/dev/null 2>&1 || true

    configured_db_pass=$(get_database_password)
    if [ -z "$configured_db_pass" ]; then
        configured_db_pass=$(python3 -c 'import secrets,string; print("".join(secrets.choice(string.ascii_letters+string.digits) for _ in range(32)))')
        msg_info "$(t "Senha do banco" "Database password")" "$(t "A senha existente não foi encontrada no koha-conf.xml. Será gerada uma nova e usada no Koha." "The existing database password was not found in koha-conf.xml. A new password will be generated and used by Koha.")" 10 74
    fi
    db_pass_sql=$(sql_escape_literal "$configured_db_pass")

    display_explanation "Recriando o banco com charset utf8mb4..." "Recreating the database with utf8mb4 charset..."
    if ! mysql -e "DROP DATABASE IF EXISTS ${DB_NAME};
            CREATE DATABASE ${DB_NAME} CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
            CREATE USER IF NOT EXISTS '${DB_NAME}'@'localhost' IDENTIFIED BY '${db_pass_sql}';
            ALTER USER '${DB_NAME}'@'localhost' IDENTIFIED BY '${db_pass_sql}';
            GRANT ALL PRIVILEGES ON ${DB_NAME}.* TO '${DB_NAME}'@'localhost';
            FLUSH PRIVILEGES;"; then
        if rollback_database_from_backup "$rollback_file"; then
            restore_engine_after_database_rollback "$old_engine"
            backup_lock_release
            msg_error "" "$(t "Não foi possível recriar o banco de dados.\n\nO banco anterior foi restaurado automaticamente.\nBackup de segurança mantido em:\n$rollback_file" "Could not recreate the database.\n\nThe previous database was restored automatically.\nSafety backup kept at:\n$rollback_file")" 14 80
        else
            backup_lock_release
            msg_error "" "$(t "Não foi possível recriar o banco de dados e o rollback automático falhou.\n\nNÃO faça novas alterações no banco.\nBackup de segurança disponível em:\n$rollback_file" "Could not recreate the database and automatic rollback failed.\n\nDO NOT make further database changes.\nSafety backup available at:\n$rollback_file")" 15 80
        fi
        return 1
    fi

    local xml_backup=""
    if [ -n "$configured_db_pass" ] && ! grep -Fq "<pass>${configured_db_pass}</pass>" "$KOHA_CONF" 2>/dev/null; then
        xml_backup="${KOHA_CONF}.bak-$(date +%Y%m%d-%H%M%S)"
        if ! cp -p "$KOHA_CONF" "$xml_backup"; then
            if rollback_database_from_backup "$rollback_file"; then
                restore_engine_after_database_rollback "$old_engine"
                backup_lock_release
                msg_error "" "$(t "Não foi possível criar o backup do koha-conf.xml.\n\nO banco anterior foi restaurado automaticamente." "Could not create a backup of koha-conf.xml.\n\nThe previous database was restored automatically.")" 12 78
            else
                backup_lock_release
                msg_error "" "$(t "Não foi possível criar o backup do koha-conf.xml e o rollback do banco falhou.\n\nBackup SQL disponível em:\n$rollback_file" "Could not back up koha-conf.xml and database rollback failed.\n\nSQL safety backup available at:\n$rollback_file")" 13 80
            fi
            return 1
        fi
        sed -i "s|<pass>[^<]*</pass>|<pass>${configured_db_pass}</pass>|g" "$KOHA_CONF"
        if command -v xmllint >/dev/null 2>&1 && ! xmllint --noout "$KOHA_CONF" >/dev/null 2>&1; then
            cp -p "$xml_backup" "$KOHA_CONF" 2>/dev/null || true
            if rollback_database_from_backup "$rollback_file"; then
                restore_engine_after_database_rollback "$old_engine"
                backup_lock_release
                msg_error "" "$(t "Não foi possível atualizar o koha-conf.xml.\n\nO banco anterior foi restaurado automaticamente." "Could not update koha-conf.xml.\n\nThe previous database was restored automatically.")" 12 76
            else
                backup_lock_release
                msg_error "" "$(t "Não foi possível atualizar o koha-conf.xml e o rollback do banco falhou.\n\nBackup de segurança disponível em:\n$rollback_file" "Could not update koha-conf.xml and the database rollback failed.\n\nSafety backup available at:\n$rollback_file")" 13 78
            fi
            return 1
        fi
        if [ -f /root/credenciais_koha.txt ]; then
            sed -i "s|Senha    / Password    : .*|Senha    / Password    : ${configured_db_pass}|" /root/credenciais_koha.txt 2>/dev/null || true
        fi
    fi

    display_explanation "Importando o acervo (pode demorar vários minutos)..." "Importing the catalog (may take several minutes)..."
    if ! run_with_dialog "$(t "Erro na Importação" "Import Error")" \
        "$(t "importação do backup SQL" "SQL backup import")" \
        import_sql_backup "$file"; then
        ok="no"
    fi

    tables=$(run_sql_checked "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='${DB_NAME}';" 2>/dev/null || printf '0')
    local schema_check_rc=0
    required_koha_tables_present || schema_check_rc=$?
    if [ "$ok" = "no" ] || ! [[ "$tables" =~ ^[0-9]+$ ]] || [ "$tables" -lt 5 ] || [ "$schema_check_rc" -ne 0 ]; then
        log "Falha na restauração: import_ok=$ok, tables=${tables:-0}, missing=${KOHA_SCHEMA_MISSING:-desconhecido}. Tentando rollback."
        if rollback_database_from_backup "$rollback_file"; then
            rollback_ok="yes"
            restore_engine_after_database_rollback "$old_engine"
        fi
        backup_lock_release
        if [ "$rollback_ok" = "yes" ]; then
            msg_error "" "$(t "A importação falhou ou produziu um banco incompleto.\n\nO banco anterior foi restaurado automaticamente.\nBackup de segurança mantido em:\n$rollback_file" "The import failed or produced an incomplete database.\n\nThe previous database was restored automatically.\nSafety backup kept at:\n$rollback_file")" 14 80
        else
            msg_error "" "$(t "A restauração falhou e o rollback automático também falhou.\n\nNÃO faça novas alterações no banco.\nBackup de segurança disponível em:\n$rollback_file" "The restore failed and the automatic rollback also failed.\n\nDO NOT make further database changes.\nSafety backup available at:\n$rollback_file")" 15 80
        fi
        return 1
    fi

    display_explanation "Atualizando o schema para a versão instalada do Koha..." "Upgrading the schema to the installed Koha version..."
    systemctl restart memcached >/dev/null 2>&1 || true
    if ! koha-upgrade-schema "$INSTANCE"; then
        log "Falha no koha-upgrade-schema. Tentando rollback para $rollback_file"
        if rollback_database_from_backup "$rollback_file"; then
            rollback_ok="yes"
            restore_engine_after_database_rollback "$old_engine"
        fi
        backup_lock_release
        if [ "$rollback_ok" = "yes" ]; then
            msg_error "" "$(t "A migração do schema falhou.\n\nO banco anterior foi restaurado automaticamente.\nBackup de segurança mantido em:\n$rollback_file" "Schema migration failed.\n\nThe previous database was restored automatically.\nSafety backup kept at:\n$rollback_file")" 14 80
        else
            msg_error "" "$(t "A migração do schema falhou e o rollback automático também falhou.\n\nO backup de segurança permanece em:\n$rollback_file" "Schema migration failed and automatic rollback also failed.\n\nThe safety backup remains at:\n$rollback_file")" 13 80
        fi
        return 1
    fi

    display_explanation "Sincronizando o motor de busca..." "Synchronizing the search engine..."
    local engine="Zebra"
    if dpkg -s koha-elasticsearch >/dev/null 2>&1 && is_koha_es_active_in_xml; then
        engine="Elasticsearch"
    fi
    if ! set_search_engine "$engine"; then
        if rollback_database_from_backup "$rollback_file"; then
            restore_engine_after_database_rollback "$old_engine"
        fi
        backup_lock_release
        msg_error "" "$(t "Não consegui definir o motor de busca após a restauração.\nO backup de segurança permanece em:\n$rollback_file" "Could not set the search engine after restore.\nThe safety backup remains at:\n$rollback_file")" 11 78
        return 1
    fi
    systemctl restart memcached >/dev/null 2>&1 || true

    cut_time=$(date '+%Y-%m-%d %H:%M:%S')
    if [ "$engine" = "Elasticsearch" ]; then
        if ! prepare_koha_broker; then
            rollback_database_from_backup "$rollback_file" >/dev/null 2>&1 && restore_engine_after_database_rollback "$old_engine"
            backup_lock_release
            msg_error "" "$(t "Não foi possível configurar a mensageria do Koha para o Elasticsearch.\nA restauração foi desfeita quando possível.\n\nBackup: $rollback_file" "Could not configure Koha job messaging for Elasticsearch.\nThe restore was rolled back when possible.\n\nBackup: $rollback_file")" 13 80
            return 1
        fi
        systemctl restart koha-common >/dev/null 2>&1 || true
        if ! manage_koha_indexers start; then rebuild_ok="no"; fi
        if [ "$rebuild_ok" = "yes" ] && ! rebuild_koha_elasticsearch "$cut_time"; then rebuild_ok="no"; fi
    else
        systemctl enable --now "koha-zebra-daemon@${INSTANCE}" >/dev/null 2>&1 || true
        systemctl restart "koha-zebra-daemon@${INSTANCE}" >/dev/null 2>&1 || true
        write_cron_zebra
        if ! koha-rebuild-zebra -f -v -b -a "$INSTANCE"; then rebuild_ok="no"; fi
    fi

    backup_lock_release
    systemctl restart memcached >/dev/null 2>&1 || true
    koha-plack --restart "$INSTANCE" >/dev/null 2>&1 || true

    validate_complete_system "restauração do banco"
    log "restauracao concluida a partir de $file (motor=$engine rebuild=$rebuild_ok rollback_point=$rollback_file)"

    if [ "$rebuild_ok" = "no" ]; then
        msg_error "" "$(t "O banco foi restaurado, mas a reconstrução do índice falhou.\n\nUse a Central de Busca e Indexação para reparar o índice.\n\nPonto de rollback disponível em:\n$rollback_file" "The database was restored, but index rebuilding failed.\n\nUse the Search & Indexing Center to repair the index.\n\nRollback point available at:\n$rollback_file")" 13 80
        return 1
    fi

    msg_ok "$(t "Acervo restaurado e indexado com sucesso!\n\nMotor de busca: ${engine}\nTabelas: ${tables}\n\nPonto de segurança mantido em:\n${rollback_file}" "Catalog restored and indexed successfully!\n\nSearch engine: ${engine}\nTables: ${tables}\n\nSafety point kept at:\n${rollback_file}")" 14 80
    return 0
}

