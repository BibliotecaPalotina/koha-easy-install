# ======================================================================
# 3. RESTAURAR BANCO (TRAVA REMOVIDA PARA PERMITIR RESTAURAÇÃO DIRETA)
# ======================================================================
funcao_restaurar_banco() {
    exigir_koha || return 0

    msg_info "$(t "Origem do Arquivo" "File Source")" \
"$(t "COMO ENVIAR O BACKUP PARA O SERVIDOR:\n\nOPÇÃO 1 — Windows (Arrastar e Soltar):\n1. No Bloco de Notas, cole o código abaixo e salve na Área de Trabalho como 'Enviar_Backup.bat':\n   @echo off\n   chcp 65001 >nul\n   scp \"%~1\" ${REAL_USER}@$(ip_servidor):${REAL_HOME}/\n   pause\n2. Depois, basta ARRASTAR o arquivo .sql em cima desse ícone.\n\nOPÇÃO 2 — Linux, macOS ou Terminal Direto:\n   scp \"caminho_do_arquivo.sql\" ${REAL_USER}@$(ip_servidor):${REAL_HOME}/\n\nOPÇÃO 3 — Pendrive/USB: conecte no servidor e verifique em /media ou /mnt\n\n(Na próxima tela, navegue até a pasta e selecione o arquivo importado.)" \
"HOW TO SEND THE BACKUP TO THE SERVER:\n\nOPTION 1 — Windows (Drag and Drop):\n1. In Notepad, paste the code below and save on Desktop as 'Enviar_Backup.bat':\n   @echo off\n   chcp 65001 >nul\n   scp \"%~1\" ${REAL_USER}@$(ip_servidor):${REAL_HOME}/\n   pause\n2. Then, just DRAG the .sql file onto that icon.\n\nOPTION 2 — Linux, macOS or Direct Terminal:\n   scp \"path_to_file.sql\" ${REAL_USER}@$(ip_servidor):${REAL_HOME}/\n\nOPTION 3 — USB drive: plug into server and check /media or /mnt\n\n(On the next screen, browse to the folder and select the file.)")" 28 82

    local arquivo
    arquivo=$(selecionar_arquivo "$REAL_HOME") || return 0
    [ -z "$arquivo" ] && return 0

    caixa_explicacao "Conferindo o arquivo de backup..." "Checking the backup file..."
    if [[ "$arquivo" == *.gz ]]; then
        if ! gzip -t "$arquivo" 2>/dev/null; then
            msg_erro "" "$(t "O arquivo está corrompido (falhou no teste do gzip).\nNada foi alterado." "The file is corrupt (failed the gzip test).\nNothing was changed.")" 9 70
            return 0
        fi
        if ! zcat "$arquivo" 2>/dev/null | head -c 200000 | grep -qi 'CREATE TABLE'; then
            perguntar "$(t "Arquivo suspeito" "Suspicious file")" "$(t "Não encontrei comandos SQL no início do arquivo.\nEle pode não ser um backup do Koha.\n\nContinuar mesmo assim?" "No SQL statements found at the start of the file.\nIt may not be a Koha backup.\n\nContinue anyway?")" 11 72 || return 0
        fi
    else
        if ! head -c 200000 "$arquivo" | grep -qi 'CREATE TABLE'; then
            perguntar "$(t "Arquivo suspeito" "Suspicious file")" "$(t "Não encontrei comandos SQL no início do arquivo.\n\nContinuar mesmo assim?" "No SQL statements found at the start of the file.\n\nContinue anyway?")" 10 72 || return 0
        fi
    fi

    perguntar "$(t "Confirmar Restauração" "Confirm Restore")" \
"$(t "Arquivo:\n$arquivo\n\nATENÇÃO: o acervo atual será SUBSTITUÍDO.\n\nContinuar?" \
"File:\n$arquivo\n\nWARNING: the current catalog will be REPLACED.\n\nContinue?")" 13 74 || return 0

    clear
    if ! backup_lock_acquire; then
        msg_erro "" "$(t "Outro backup ou restauração já está em andamento.\nNada foi alterado." "Another backup or restore is already running.\nNothing was changed.")" 10 72
        return 0
    fi

    local falhar_restore=0
    local rollback_ok="nao"

    caixa_explicacao "Recriando o banco com charset utf8mb4..." "Recreating the database with utf8mb4 charset..."
    koha_indexadores_gerenciar stop
    if ! mysql -e "DROP DATABASE IF EXISTS ${DB_NAME};
              CREATE DATABASE ${DB_NAME} CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
              GRANT ALL PRIVILEGES ON ${DB_NAME}.* TO '${DB_NAME}'@'localhost';
              FLUSH PRIVILEGES;"; then
        backup_lock_release
        msg_erro "" "$(t "Não foi possível recriar o banco de dados." "Could not recreate the database.")" 9 70
        return 1
    fi

    caixa_explicacao "Importando o acervo (pode demorar vários minutos)..." "Importing the catalog (may take several minutes)..."
    local ok="sim"
    if [[ "$arquivo" == *.gz ]]; then
        if ! zcat "$arquivo" | mysql --default-character-set=utf8mb4 "$DB_NAME"; then ok="nao"; fi
    else
        if ! mysql --default-character-set=utf8mb4 "$DB_NAME" < "$arquivo"; then ok="nao"; fi
    fi

    local tabelas; tabelas=$(sql "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='${DB_NAME}';")
    if [ "$ok" = "nao" ] || [ "${tabelas:-0}" -lt 50 ] 2>/dev/null; then
        falhar_restore=1
        backup_lock_release
        msg_erro "" "$(t "A importação não produziu um banco Koha completo (${tabelas:-0} tabelas)." "The import did not produce a complete Koha database (${tabelas:-0} tables).")" 11 76
        return 1
    fi

    caixa_explicacao "Atualizando o schema para a versão instalada do Koha..." "Upgrading the schema to the installed Koha version..."
    systemctl restart memcached >/dev/null 2>&1 || true
    if ! koha-upgrade-schema "$INSTANCIA"; then
        backup_lock_release
        msg_erro "" "$(t "A migração do schema falhou. O banco importado foi preservado para diagnóstico." "Schema migration failed. The imported database was preserved for diagnosis.")" 11 78
        return 1
    fi

    caixa_explicacao "Sincronizando o motor de busca..." "Synchronizing the search engine..."
    local motor="Zebra"
    if dpkg -s koha-elasticsearch >/dev/null 2>&1 && koha_es_ativo_no_xml; then motor="Elasticsearch"; fi
    if ! mysql -e "UPDATE ${DB_NAME}.systempreferences SET value='${motor}' WHERE variable='SearchEngine';" >/dev/null 2>&1; then
        backup_lock_release
        msg_erro "" "$(t "Não consegui definir o motor de busca após a restauração." "Could not set the search engine after restore.")" 9 72
        return 1
    fi
    systemctl restart memcached >/dev/null 2>&1 || true

    local rebuild_ok="sim"
    local corte
    corte=$(date '+%Y-%m-%d %H:%M:%S')
    if [ "$motor" = "Elasticsearch" ]; then
        koha_broker_preparar || true
        systemctl restart koha-common >/dev/null 2>&1 || true
        if ! koha_indexadores_gerenciar start; then rebuild_ok="nao"; fi
        if [ "$rebuild_ok" = "sim" ] && ! koha_rebuild_elasticsearch "$corte"; then rebuild_ok="nao"; fi
    else
        systemctl enable --now "koha-zebra-daemon@${INSTANCIA}" >/dev/null 2>&1 || true
        systemctl restart "koha-zebra-daemon@${INSTANCIA}" >/dev/null 2>&1 || true
        escrever_cron_zebra
        if ! koha-rebuild-zebra -f -v -b -a "$INSTANCIA"; then rebuild_ok="nao"; fi
    fi

    backup_lock_release
    systemctl restart memcached >/dev/null 2>&1 || true
    koha-plack --restart "$INSTANCIA" >/dev/null 2>&1 || true

    validar_sistema_completo "restauração do banco"
    log "restauracao concluida a partir de $arquivo (motor=$motor rebuild=$rebuild_ok)"

    if [ "$rebuild_ok" = "nao" ]; then
        msg_erro "" "$(t "O banco foi restaurado, mas a reconstrução do índice falhou.\nUse a opção 8 (Reparar / reconstruir indexação)." "The database was restored, but index rebuilding failed.\nUse option 8 (Repair / rebuild indexing).")" 11 78
        return 1
    fi

    msg_ok "$(t "Acervo restaurado e indexado com sucesso!\n\nMotor de busca: ${motor}\nTabelas: ${tabelas}" "Catalog restored and indexed successfully!\n\nSearch engine: ${motor}\nTables: ${tabelas}")" 12 74
    return 0
}

