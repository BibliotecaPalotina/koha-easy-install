    echo -e "\e[1;33m>>> $(t "Displaying the last 50 log lines in real-time...")\e[0m"
    echo -e "\e[1;33m>>> $(t "Press [CTRL+C] at any time to exit and return to the menu.")\e[0m\n"
    
