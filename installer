function_repair_indexing() {
    require_database || return 0
    local engine; engine=$(get_search_engine)
    if [ "$engine" = "Elasticsearch" ]; then
        local es_up idx broker pend bibs docs
        es_up=$(curl -s --max-time 5 http://127.0.0.1:9200 >/dev/null 2>&1 && echo "OK" || echo "FORA/DOWN")
        is_koha_indexer_running && idx="$(t "rodando" "running")" || idx="$(t "PARADO" "STOPPED")"
        ss -lnt 2>/dev/null | grep -q ':61613' && broker="OK" || broker="$(t "ausente" "absent")"
        pend=$(get_pending_es_jobs); bibs=$(get_total_biblios); docs=$(get_total_es_documents)
        msg_info "$(t "Diagnóstico" "Diagnostics")" \
"Elasticsearch (9200) : ${es_up}
$(t "Bloco no XML" "Block in XML")         : $(is_koha_es_active_in_xml && echo OK || echo "$(t "AUSENTE" "MISSING")")
$(t "Indexador" "Indexer")            : ${idx}
RabbitMQ/STOMP       : ${broker}
$(t "Jobs pendentes" "Pending jobs")       : ${pend:-?}
$(t "Índice / banco" "Index / database")       : ${docs:-?} / ${bibs:-?}
$(t "Fila crescendo + índice menor que o banco = indexador parado." "Growing queue + smaller index = indexer is down.")" 18 76
        prompt_yes_no "$(t "Reparar" "Repair")" "$(t "Reinstalar o serviço do indexador, limpar o cache e religar tudo?" "Reinstall the indexer service, flush the cache and restart everything?")" 10 74 || return 0
        clear
        display_explanation "Reparando os serviços de indexação..." "Repairing the indexing services..."
        systemctl restart elasticsearch >/dev/null 2>&1
        prepare_koha_broker
        systemctl restart memcached koha-common >/dev/null 2>&1
        manage_koha_indexers start
        koha-plack --restart "$INSTANCE" >/dev/null 2>&1
        if prompt_yes_no "$(t "Reindexar" "Reindex")" "$(t "Reconstruir o índice inteiro do zero?\nEm acervos grandes pode levar vários minutos." "Rebuild the whole index from scratch?\nOn large catalogs this can take several minutes.")" 10 74; then
            clear
            local cut_time; cut_time=$(date '+%Y-%m-%d %H:%M:%S')
            rebuild_koha_elasticsearch "$cut_time"
        fi
        v_reset "reparo da indexação"
        validate_elasticsearch "Elasticsearch"
        if is_koha_indexer_running; then
            msg_ok "$(t "Indexador ativo.\nCadastre um registro de teste e busque em ~10 segundos." "Indexer is running.\nAdd a test record and search for it after ~10 seconds.")" 10 74
        else
            msg_error "" "$(t "O indexador não subiu. Veja:\njournalctl -u koha-es-indexer@${INSTANCE} -n 50\ntail -n 50 /var/log/koha/${INSTANCE}/es-indexer-output.log" "The indexer did not start. Check:\njournalctl -u koha-es-indexer@${INSTANCE} -n 50\ntail -n 50 /var/log/koha/${INSTANCE}/es-indexer-output.log")" 12 78
        fi
        return 0
    fi
    prompt_yes_no "$(t "Reparar Zebra" "Repair Zebra")" "$(t "Destravar o Zebra e reconstruir os índices do zero?" "Unlock Zebra and rebuild the indices from scratch?")" 10 70 || return 0
    clear
    display_explanation "Destravando o Zebra..." "Unlocking Zebra..."
    systemctl disable --now "koha-zebra-daemon@${INSTANCE}" >/dev/null 2>&1 || true
    force_stop_koha_zebra
    rm -f /var/lock/koha/${INSTANCE}/rebuild/*.LCK 2>/dev/null
    rm -f /var/run/koha/${INSTANCE}/zebrasrv.pid 2>/dev/null
    chown -R "${INSTANCE}-koha:${INSTANCE}-koha" \
        "/var/lib/koha/${INSTANCE}/biblios" "/var/lib/koha/${INSTANCE}/authorities" \
        "/var/lock/koha/${INSTANCE}" 2>/dev/null
    systemctl enable --now "koha-zebra-daemon@${INSTANCE}" >/dev/null 2>&1
    write_cron_zebra
    systemctl restart memcached koha-common >/dev/null 2>&1
    display_explanation "Reconstruindo os índices..." "Rebuilding the indices..."
    koha-rebuild-zebra -f -v -b -a -r "$INSTANCE"
    koha-plack --restart "$INSTANCE" >/dev/null 2>&1
    msg_ok "$(t "Zebra destravado e acervo reindexado." "Zebra unlocked and catalog reindexed.")" 9 66
}

# ======================================================================
# 10. DIMENSIONAMENTO DO SERVIDOR / SERVER SIZING
# ======================================================================
function_size_server() {
    local ram ram_int recommended profile wk mem db
    ram=$(awk '/MemTotal:/ {printf "%.1f", $2/1024/1024}' /proc/meminfo)
    ram_int=$(awk '/MemTotal:/ {printf "%d", ($2/1024/1024)+0.5}' /proc/meminfo)
    if   [ "$ram_int" -lt 4 ];  then recommended=1
    elif [ "$ram_int" -lt 8 ];  then recommended=2
    elif [ "$ram_int" -lt 16 ]; then recommended=3
    else recommended=4; fi
    profile=$(whiptail --title "$(t "Dimensionamento" "Sizing")" \
        --cancel-button "$(t "Voltar" "Back")" \
        --default-item "$recommended" \
        --menu "$(t "RAM detectada:" "Detected RAM:") ${ram} GB\n$(t "Perfil recomendado:" "Recommended profile:") ${recommended}" 18 76 4 \
        "1" "< 4 GB   - 2 Plack, 64MB cache, 512M InnoDB" \
        "2" "4-8 GB   - 3 Plack, 128MB cache, 768M InnoDB" \
        "3" "8-16 GB  - 4 Plack, 128MB cache, 1G InnoDB" \
        "4" "16 GB+   - 6 Plack, 256MB cache, 2G InnoDB" 3>&1 1>&2 2>&3) || return 0
    [ -z "$profile" ] && return 0
    case "$profile" in
        1) wk=2; mem=64;  db=512M ;;
        2) wk=3; mem=128; db=768M ;;
        3) wk=4; mem=128; db=1G ;;
        4) wk=6; mem=256; db=2G ;;
        *) return 0 ;;
    esac
    clear
    display_explanation "Aplicando o perfil $profile..." "Applying profile $profile..."
    adjust_conf_key() {
        local file="$1" pattern="$2" line="$3"
        [ -f "$file" ] || return 0
        if grep -qE "$pattern" "$file"; then sed -i -E "s|${pattern}|${line}|" "$file"
        else echo "$line" >> "$file"; fi
    }
    adjust_conf_key /etc/default/koha-common '^[[:space:]]*#?[[:space:]]*PLACK_WORKERS=.*'      "PLACK_WORKERS=$wk"
    adjust_conf_key /etc/default/koha-common '^[[:space:]]*#?[[:space:]]*PLACK_MAX_REQUESTS=.*' "PLACK_MAX_REQUESTS=100"
    adjust_conf_key /etc/memcached.conf       '^[[:space:]]*-m[[:space:]]+.*'                     "-m $mem"
    mkdir -p /etc/mysql/mariadb.conf.d
    local tuning="/etc/mysql/mariadb.conf.d/99-koha-tuning.cnf"
    local tuning_bak="/tmp/99-koha-tuning.bak"
    local had_tuning="no"
    if [ -f "$tuning" ]; then
        cp -f "$tuning" "$tuning_bak" 2>/dev/null && had_tuning="yes" || {
            msg_error "" "$(t "Não consegui criar uma cópia do ajuste do MariaDB. Alteração cancelada." "Could not back up the MariaDB tuning file. Change cancelled.")" 9 74
            return 1
        }
    else
        rm -f "$tuning_bak"
    fi
    printf '[mysqld]\ninnodb_buffer_pool_size = %s\n' "$db" > "$tuning"
    systemctl restart memcached >/dev/null 2>&1
    if ! systemctl restart mariadb; then
        if [ "$had_tuning" = "yes" ] && [ -f "$tuning_bak" ]; then
            cp -f "$tuning_bak" "$tuning" 2>/dev/null || true
        else
            rm -f "$tuning"
        fi
        systemctl restart mariadb >/dev/null 2>&1
        msg_error "" "$(t "O MariaDB não subiu com innodb_buffer_pool_size=$db.\nO ajuste foi DESFEITO e o banco voltou ao normal.\n\nEscolha um perfil menor." "MariaDB failed to start with innodb_buffer_pool_size=$db.\nThe change was REVERTED and the database is back up.\n\nPick a smaller profile.")" 12 76
        return 1
    fi
    systemctl restart koha-common >/dev/null 2>&1
    koha-plack --restart "$INSTANCE" >/dev/null 2>&1
    if [ "$(get_search_engine)" = "Elasticsearch" ]; then
        if ! adjust_elasticsearch_heap || ! systemctl restart elasticsearch >/dev/null 2>&1; then
            msg_error "" "$(t "O ajuste de memória do Elasticsearch falhou ou o serviço não reiniciou." "Elasticsearch memory tuning failed or the service did not restart.")" 9 74
            return 1
        fi
    fi
    log "tuning perfil=$profile plack=$wk memcached=$mem innodb=$db"
    msg_ok "$(t "Perfil $profile aplicado.\n\nPlack: $wk workers\nMemcached: ${mem} MB\nMariaDB InnoDB: $db\n\nTodos os serviços voltaram a subir normalmente." "Profile $profile applied.\n\nPlack: $wk workers\nMemcached: ${mem} MB\nMariaDB InnoDB: $db\n\nAll services restarted successfully.")" 13 74
}

