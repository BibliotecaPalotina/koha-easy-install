# ======================================================================
# 1. INSTALAÇÃO DO SERVIDOR / SERVER INSTALLATION
# ======================================================================
function_install_koha() {
    msg_info "$(t "Instalação" "Installation")" \
        "$(t "Este assistente vai instalar MariaDB, Apache, Memcached e o Koha (motor de busca Zebra por padrão).\n\nPode levar de 10 a 30 minutos. Não feche o terminal." "This wizard installs MariaDB, Apache, Memcached and Koha (Zebra search engine by default).\n\nIt can take 10 to 30 minutes. Do not close the terminal.")" 13 74
    clear
    validate_pre_installation || return 0

    local tz
    tz=$(choose_timezone) && [ -n "$tz" ] && timedatectl set-timezone "$tz" >/dev/null 2>&1

    wait_for_apt_locks || return 1

    display_explanation "Configurando idioma e codificação UTF-8..." "Configuring locales and UTF-8..."
    apt_update_indices
    apt_install locales || return 1
    locale-gen pt_BR.UTF-8 en_US.UTF-8 >/dev/null 2>&1
    if [ "$SYS_LANG" = "pt" ]; then update-locale LANG=pt_BR.UTF-8; else update-locale LANG=en_US.UTF-8; fi

    display_explanation "Sincronizando o relógio (NTP)..." "Synchronizing the clock (NTP)..."
    apt_install systemd-timesyncd >/dev/null 2>&1
    systemctl enable --now systemd-timesyncd >/dev/null 2>&1
    timeout 15 bash -c 'until timedatectl show -p NTPSynchronized --value | grep -q yes; do sleep 1; done' >/dev/null 2>&1

    display_explanation "Criando memória virtual (SWAP de 4 GB)..." "Creating virtual memory (4 GB SWAP)..."
    if [ "$(swapon --show 2>/dev/null | wc -l)" -le 1 ] && [ ! -f /swapfile ]; then
        if [ "$(get_free_space_mb /)" -ge 8192 ] 2>/dev/null; then
            fallocate -l 4G /swapfile 2>/dev/null || dd if=/dev/zero of=/swapfile bs=1M count=4096 status=none
            chmod 600 /swapfile
            mkswap /swapfile >/dev/null 2>&1
            if swapon /swapfile 2>/dev/null; then
                grep -q '^/swapfile' /etc/fstab || echo '/swapfile none swap sw 0 0' >> /etc/fstab
            else
                rm -f /swapfile
                echo "$(t "[AVISO] SWAP não pôde ser ativada (normal em WSL/containers)." "[WARN] SWAP could not be enabled (normal on WSL/containers).")"
            fi
        else
            echo "$(t "[AVISO] Espaço insuficiente para SWAP de 4 GB. Pulando." "[WARN] Not enough space for a 4 GB SWAP. Skipping.")"
        fi
    fi

    wait_for_apt_locks || return 1
    display_explanation "Atualizando o sistema..." "Upgrading the system..."
    apt_update_indices
    if ! DEBIAN_FRONTEND=noninteractive apt-get upgrade "${APT_OPTS[@]}"; then
        restore_apt_timers
        msg_error "" "$(t "A atualização do sistema falhou. O Koha não será alterado nesta etapa." "System upgrade failed. Koha will not be changed at this stage.")" 10 74
        return 1
    fi

    display_explanation "Instalando dependências essenciais..." "Installing essential dependencies..."
    apt_install nano curl wget gpg ca-certificates ufw apt-transport-https \
                 fail2ban libsasl2-modules rclone avahi-daemon memcached \
                 python3 libxml2-utils unzip pv glabels || return 1
    systemctl enable --now avahi-daemon fail2ban memcached >/dev/null 2>&1

    display_explanation "Adicionando os repositórios do Koha e do Elasticsearch..." "Adding Koha and Elasticsearch repositories..."
    mkdir -p /usr/share/keyrings
    if ! curl -fsSL --retry 3 --max-time 60 https://debian.koha-community.org/koha/gpg.asc \
        | gpg --dearmor --yes -o /usr/share/keyrings/koha-keyring.gpg 2>/dev/null; then
        msg_error "" "$(t "Não foi possível baixar a chave do repositório do Koha. Verifique a internet." "Could not download the Koha repository key. Check your internet connection.")" 9 74
        return 1
    fi
    echo "deb [signed-by=/usr/share/keyrings/koha-keyring.gpg] https://debian.koha-community.org/koha stable main" > /etc/apt/sources.list.d/koha.list

    if curl -fsSL --retry 3 --max-time 60 https://artifacts.elastic.co/GPG-KEY-elasticsearch \
        | gpg --dearmor --yes -o /usr/share/keyrings/elasticsearch-keyring.gpg 2>/dev/null; then
        echo "deb [signed-by=/usr/share/keyrings/elasticsearch-keyring.gpg] https://artifacts.elastic.co/packages/7.x/apt stable main" > /etc/apt/sources.list.d/elastic-7.x.list
    else
        rm -f /etc/apt/sources.list.d/elastic-7.x.list
        echo "$(t "[AVISO] Repositório do Elasticsearch indisponível; seguindo só com o Zebra." "[WARN] Elasticsearch repository unavailable; continuing with Zebra only.")"
    fi

    apt_update_indices
    display_explanation "Instalando MariaDB e Koha (esta é a etapa mais demorada)..." "Installing MariaDB and Koha (longest step)..."
    apt_install mariadb-server koha-common || return 1
    systemctl enable --now mariadb >/dev/null 2>&1

    display_explanation "Configurando o Apache e os padrões do Koha..." "Configuring Apache and Koha defaults..."
    define_koha_sites_conf
    a2enmod rewrite cgi deflate headers proxy proxy_http >/dev/null 2>&1
    grep -qE '^[[:space:]]*Listen[[:space:]]+8080' /etc/apache2/ports.conf 2>/dev/null \
        || sed -i '/^[[:space:]]*Listen[[:space:]]\+80$/a Listen 8080' /etc/apache2/ports.conf
    systemctl restart apache2 memcached >/dev/null 2>&1

    local exists="no"
    [ -d "/etc/koha/sites/${INSTANCE}" ] && exists="yes"
    [ "$(run_sql "SELECT 1 FROM information_schema.schemata WHERE schema_name='${DB_NAME}';")" = "1" ] && exists="yes"

    if [ "$exists" = "yes" ]; then
        prompt_yes_no "$(t "Instância já existe" "Instance already exists")" \
            "$(t "Já existe uma instalação do Koha nesta máquina.\n\nREINSTALAR APAGA o banco ${DB_NAME} e toda a configuração.\nIsso NÃO pode ser desfeito por este script.\n\nQuer continuar para a confirmação final?" "A Koha installation already exists.\n\nREINSTALLING DELETES the ${DB_NAME} database and all configuration.\nThis CANNOT be undone by this script.\n\nContinue to the final confirmation?")" 16 76 || return 0

        local confirm
        confirm=$(whiptail --title "$(t "CONFIRMAÇÃO FINAL" "FINAL CONFIRMATION")" --inputbox \
            "$(t "Digite exatamente a palavra abaixo para apagar tudo:\n\nREINSTALAR" "Type exactly the word below to erase everything:\n\nREINSTALL")" 12 66 3>&1 1>&2 2>&3) || return 0
        if [ "$confirm" != "$(t "REINSTALAR" "REINSTALL")" ]; then
            msg_info "$(t "Cancelado" "Cancelled")" "$(t "Confirmação incorreta. Nada foi apagado." "Wrong confirmation. Nothing was deleted.")" 8 62
            return 0
        fi

        display_explanation "Salvando um backup de segurança antes de apagar..." "Saving a safety backup before deleting..."
        if ! backup_lock_acquire; then
            msg_error "" "$(t "Outro backup ou restauração está em andamento. A reinstalação foi cancelada." "Another backup or restore is already running. Reinstallation was cancelled.")" 9 74
            return 1
        fi
        mkdir -p "$DIR_SQL"
        local rescue="${DIR_SQL}/PRE-REINSTALACAO_$(date +%Y-%m-%d_%Hh%M).sql.gz"
        if ! mysqldump --single-transaction --quick --routines --triggers "$DB_NAME" 2>/dev/null | gzip > "$rescue" || ! gzip -t "$rescue" 2>/dev/null || [ "$(stat -c %s "$rescue" 2>/dev/null || echo 0)" -lt 10240 ]; then
            rm -f "$rescue"
            backup_lock_release
            prompt_yes_no "$(t "Backup de segurança falhou" "Safety backup failed")" \
                "$(t "Não foi possível validar o backup pré-reinstalação.\n\nPor segurança, a instalação anterior NÃO será apagada.\n\nTentar novamente?" "The pre-reinstallation backup could not be validated.\n\nFor safety, the previous installation will NOT be deleted.\n\nTry again?")" 13 74 >/dev/null 2>&1 || true
            return 1
        fi
        echo "$(t "Backup de segurança:" "Safety backup:") $rescue"

        display_explanation "Removendo a instalação anterior..." "Removing the previous installation..."
        manage_koha_indexers stop
        if [ -d "/etc/koha/sites/${INSTANCE}" ]; then
            if ! koha-remove "$INSTANCE" >/dev/null 2>&1; then
                backup_lock_release
                msg_error "" "$(t "O Koha não conseguiu remover a instância anterior. Nenhum DROP adicional foi executado." "Koha could not remove the previous instance. No additional DROP was executed.")" 10 74
                return 1
            fi
        fi
        if ! mysql -e "DROP DATABASE IF EXISTS ${DB_NAME}; DROP USER IF EXISTS '${DB_NAME}'@'localhost'; FLUSH PRIVILEGES;" >/dev/null 2>&1; then
            backup_lock_release
            msg_error "" "$(t "Não foi possível limpar completamente o banco/usuário da instalação anterior." "Could not completely clean the previous database/user.")" 9 74
            return 1
        fi
        rm -rf "/etc/koha/sites/${INSTANCE}"
        backup_lock_release
    fi

    display_explanation "Criando a instância '${INSTANCE}' do Koha..." "Creating the '${INSTANCE}' Koha instance..."
    if ! koha-create --create-db "$INSTANCE"; then
        msg_error "" "$(t "Falha ao criar a instância do Koha.\nVeja o terminal para o erro exato." "Failed to create the Koha instance.\nSee the terminal for the exact error.")" 9 70
        return 1
    fi

    sed -i 's/__MEMCACHED_SERVERS__/127.0.0.1:11211/g; s/__MEMCACHED_PREFIX__/koha_library:/g' "$KOHA_CONF" 2>/dev/null

    a2dissite 000-default >/dev/null 2>&1
    a2ensite "$INSTANCE" >/dev/null 2>&1
    systemctl restart apache2 memcached koha-common >/dev/null 2>&1

    [ "$SYS_LANG" = "pt" ] && koha-translate --install pt-BR >/dev/null 2>&1
    koha-plack --enable "$INSTANCE" >/dev/null 2>&1
    koha-plack --start  "$INSTANCE" >/dev/null 2>&1

    display_explanation "Ativando o Zebra e a indexação incremental..." "Enabling Zebra and incremental indexing..."
    koha-zebra --enable "$INSTANCE" >/dev/null 2>&1
    koha-zebra --start  "$INSTANCE" >/dev/null 2>&1
    systemctl enable --now "koha-zebra-daemon@${INSTANCE}" >/dev/null 2>&1
    write_cron_zebra
    koha-worker --start "$INSTANCE" >/dev/null 2>&1
    koha-worker --start --queue long_tasks "$INSTANCE" >/dev/null 2>&1

    display_explanation "Criando backups automáticos e credenciais..." "Creating automatic backups and credentials..."
    local db_pass ip
    db_pass=$(get_database_password)
    ip=$(get_server_ip)
    write_backup_scripts
