#!/usr/bin/env bash
# ======================================================================
# KOHA EASY INSTALL - ADVANCED MANAGEMENT SUITE
# Suíte de implantação, manutenção, tuning e backups do Koha ILS.
# Deployment, maintenance, tuning and backup suite for Koha ILS.
# ----------------------------------------------------------------------
# Arquivo único e autossuficiente. Atualização pela opção "Atualizar
# este painel" (baixa, valida a sintaxe e só então substitui).
# ======================================================================

# Sem "set -e": em painel interativo ele derruba o programa inteiro
# quando qualquer comando secundário falha. Os erros são tratados
# explicitamente nas funções abaixo.
set -o pipefail
umask 022

VERSAO_PAINEL="3.0"
URL_ATUALIZACAO="https://raw.githubusercontent.com/BibliotecaPalotina/koha-easy-install/refs/heads/main/installer"

# ======================================================================
# ELEVAÇÃO DE PRIVILÉGIOS
# ======================================================================
if [ "${EUID:-$(id -u)}" -ne 0 ]; then
    echo ""
    echo "+---------------------------------------------------------------+"
    echo "| Privilegios de administrador (root) necessarios.              |"
    echo "| Root privileges required. Please enter your password:         |"
    echo "+---------------------------------------------------------------+"
    echo ""
    if [ -f "$0" ]; then
        exec sudo -E bash "$0" "$@"
    fi
    echo "ERRO/ERROR: rode como root / run as root: sudo bash $0"
    exit 1
fi

REAL_USER="${SUDO_USER:-${USER:-root}}"
REAL_HOME="$(getent passwd "$REAL_USER" 2>/dev/null | cut -d: -f6)"
[ -z "$REAL_HOME" ] && REAL_HOME="/root"
[ -d "$REAL_HOME" ] || REAL_HOME="/root"

# ======================================================================
# IDIOMA
# ======================================================================
case "${LANG:-}${LC_ALL:-}" in
    pt*|*pt_BR*) SYS_LANG="pt" ;;
    *)           SYS_LANG="en" ;;
esac

t() { if [ "$SYS_LANG" = "pt" ]; then printf '%b' "$1"; else printf '%b' "$2"; fi; }

# ======================================================================
# CONSTANTES GLOBAIS
# ======================================================================
INSTANCIA="library"
DB_NAME="koha_${INSTANCIA}"
KOHA_CONF="/etc/koha/sites/${INSTANCIA}/koha-conf.xml"
CRON_TASKS="/etc/cron.d/koha_tasks"
CRON_ZEBRA="/etc/cron.d/koha_zebra_queue"
CRON_ES="/etc/cron.d/koha_es_watchdog"
CONF_DIR="/etc/koha-easy-install"
BACKUP_CONF="${CONF_DIR}/backup.conf"
DIR_SQL="/var/backups/koha_sql"
DIR_MARC="/var/backups/koha_marc"
LOG_DIR="/var/log/koha-easy-install"
RUN_LOG="${LOG_DIR}/painel-$(date '+%Y%m%d').log"
CRON_PATH='PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'

mkdir -p "$LOG_DIR" "$CONF_DIR" 2>/dev/null

log() { printf '%s | %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$RUN_LOG" 2>/dev/null; }
log "===== painel iniciado (v$VERSAO_PAINEL, usuario=$REAL_USER) ====="

# ======================================================================
# DEPENDÊNCIAS MÍNIMAS DO PRÓPRIO PAINEL
# ======================================================================
for dep in whiptail curl python3; do
    if ! command -v "$dep" >/dev/null 2>&1; then
        echo "$(t "Instalando dependência do painel: $dep" "Installing panel dependency: $dep")"
        DEBIAN_FRONTEND=noninteractive apt-get install -y "$dep" >/dev/null 2>&1 || {
            echo "$(t "Não foi possível instalar '$dep'. Abortando." "Could not install '$dep'. Aborting.")"
            exit 1
        }
    fi
done

# ======================================================================
# LIMPEZA AO SAIR (mesmo com Ctrl+C): devolve os timers do APT
# ======================================================================
APT_TIMERS_PARADOS="nao"
restaurar_timers_apt() {
    [ "$APT_TIMERS_PARADOS" = "sim" ] || return 0
    systemctl start apt-daily.timer apt-daily-upgrade.timer unattended-upgrades >/dev/null 2>&1
    APT_TIMERS_PARADOS="nao"
}
ao_sair() { restaurar_timers_apt; log "===== painel encerrado ====="; }
trap ao_sair EXIT
trap 'echo ""; echo "$(t "Interrompido pelo usuário." "Interrupted by user.")"; exit 130' INT TERM

# ======================================================================
# INTERFACE
# ======================================================================
caixa_explicacao() {
    local msg; msg="$(t "$1" "$2")"
    echo ""
    echo "+---------------------------------------------------------------------------+"
    echo "| $msg"
    echo "+---------------------------------------------------------------------------+"
    echo ""
    log "ETAPA: $msg"
}

msg_info()  { whiptail --title "$1" --msgbox "$2" "${3:-12}" "${4:-74}" 2>/dev/null || true; }
msg_erro()  { log "ERRO: $2"; whiptail --title "$(t "Erro" "Error")" --msgbox "$2" "${3:-10}" "${4:-74}" 2>/dev/null || true; }
msg_ok()    { whiptail --title "$(t "Sucesso" "Success")" --msgbox "$1" "${2:-10}" "${3:-74}" 2>/dev/null || true; }
perguntar() { whiptail --title "$1" --yesno "$2" "${3:-12}" "${4:-74}" 2>/dev/null; }

pausar_terminal() {
    echo ""
    echo "$(t "Pressione [ENTER] para voltar ao painel..." "Press [ENTER] to return to the panel...")"
    read -r _ || true
}

# ======================================================================
# REDE / SISTEMA
# ======================================================================
ip_servidor() {
    local ip=""
    ip=$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="src"){print $(i+1); exit}}')
    [ -z "$ip" ] && ip=$(hostname -I 2>/dev/null | awk '{print $1}')
    [ -z "$ip" ] && ip="127.0.0.1"
    printf '%s' "$ip"
}

portas_ssh() {
    local p=""
    p=$(grep -shoriE '^[[:space:]]*Port[[:space:]]+[0-9]+' /etc/ssh/sshd_config /etc/ssh/sshd_config.d/*.conf 2>/dev/null | grep -oE '[0-9]+' | sort -u)
    [ -z "$p" ] && p=$(ss -lntp 2>/dev/null | grep -i sshd | awk '{print $4}' | sed 's/.*[:.]//' | sort -u)
    [ -z "$p" ] && p="22"
    printf '%s' "$p"
}

espaco_livre_mb() { df -Pm "${1:-/}" 2>/dev/null | awk 'NR==2{print $4}'; }

koha_instalado() { [ -f "$KOHA_CONF" ]; }

banco_pronto() {
    mysql -Nse "SELECT 1 FROM information_schema.tables WHERE table_schema='${DB_NAME}' AND table_name='systempreferences' LIMIT 1;" 2>/dev/null | grep -q 1
}

exigir_koha() {
    if ! koha_instalado; then
        msg_erro "" "$(t "O Koha ainda não foi instalado.\nUse a opção 1 do painel." "Koha is not installed yet.\nUse option 1 in the panel.")" 9 64
        return 1
    fi
    return 0
}

exigir_banco() {
    exigir_koha || return 1
    if ! banco_pronto; then
        msg_erro "" "$(t "O banco ainda está vazio.\n\nConclua o Web Installer no navegador (Staff) ou restaure um backup pela opção 3." "Database is still empty.\n\nFinish the Web Installer in the browser (Staff) or restore a backup with option 3.")" 11 72
        return 1
    fi
    return 0
}

senha_banco() {
    [ -f "$KOHA_CONF" ] || return 1
    grep -oP '(?<=<pass>)[^<]+' "$KOHA_CONF" 2>/dev/null | head -n 1
}

# Executa SQL como root (socket), sem senha em linha de comando.
sql() { mysql -N -B -e "$1" 2>/dev/null; }

# ======================================================================
# APT BLINDADO
# ======================================================================
APT_OPTS=(-y -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold)

aguardar_travas_apt() {
    caixa_explicacao "Verificando travas do APT/DPKG..." "Checking APT/DPKG locks..."
    systemctl stop apt-daily.timer apt-daily-upgrade.timer unattended-upgrades \
        apt-daily.service apt-daily-upgrade.service >/dev/null 2>&1
    APT_TIMERS_PARADOS="sim"

    local espera=0
    while fuser /var/lib/dpkg/lock-frontend >/dev/null 2>&1 || \
          fuser /var/lib/apt/lists/lock  >/dev/null 2>&1 || \
          fuser /var/lib/dpkg/lock       >/dev/null 2>&1; do
        echo "$(t "[INFO] APT ocupado. Aguardando 3s..." "[INFO] APT busy. Waiting 3s...")"
        sleep 3
        espera=$((espera + 3))
        if [ "$espera" -ge 300 ]; then
            echo "$(t "[AVISO] APT travado há 5 minutos. Seguindo mesmo assim." "[WARN] APT locked for 5 minutes. Continuing anyway.")"
            break
        fi
    done
    dpkg --configure -a >/dev/null 2>&1
}

apt_atualizar_indices() {
    apt-get update -y >/dev/null 2>&1 || apt-get update -y --fix-missing >/dev/null 2>&1 || true
}

apt_instalar() {
    local pacotes=("$@") tentativa=1 max=3
    while [ "$tentativa" -le "$max" ]; do
        if DEBIAN_FRONTEND=noninteractive apt-get install "${APT_OPTS[@]}" "${pacotes[@]}"; then
            log "APT ok: ${pacotes[*]}"
            return 0
        fi
        echo ""
        echo "$(t "[AVISO] Tentativa $tentativa de $max falhou. Corrigindo índices..." "[WARN] Attempt $tentativa of $max failed. Fixing indices...")"
        apt-get update -y --fix-missing >/dev/null 2>&1
        dpkg --configure -a >/dev/null 2>&1
        apt-get -f install "${APT_OPTS[@]}" >/dev/null 2>&1
        sleep 3
        tentativa=$((tentativa + 1))
    done
    log "APT FALHOU: ${pacotes[*]}"
    msg_erro "" "$(t "Falha ao instalar após $max tentativas:\n${pacotes[*]}\n\nVerifique a internet e o espaço em disco." "Failed to install after $max attempts:\n${pacotes[*]}\n\nCheck your internet connection and disk space.")" 12 74
    return 1
}

# ======================================================================
# EXPLORADOR DE ARQUIVOS / PASTAS
# ======================================================================
selecionar_arquivo() {
    local atual="${1:-/}" escolha itens=()
    [ -d "$atual" ] || atual="/"
    while true; do
        itens=()
        [ "$atual" != "/" ] && itens+=(".." "$(t "[Voltar]" "[Back]")")
        while IFS= read -r d; do
            [ -n "$d" ] && itens+=("$d" "$(t "[Pasta]" "[Folder]")")
        done < <(find "$atual" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort)
        while IFS= read -r f; do
            [ -n "$f" ] && itens+=("$f" "$(t "Arquivo de backup" "Backup file")")
        done < <(find "$atual" -mindepth 1 -maxdepth 1 -type f \( -name '*.sql' -o -name '*.sql.gz' \) -printf '%f\n' 2>/dev/null | sort)

        [ ${#itens[@]} -eq 0 ] && itens+=(".." "$(t "[Vazio - Voltar]" "[Empty - Back]")")

        escolha=$(whiptail --title "$(t "Explorador de Arquivos" "File Explorer")" \
            --cancel-button "$(t "Voltar" "Back")" \
            --menu "$(t "Pasta atual:" "Current folder:") $atual\n\n$(t "Escolha o backup (.sql ou .sql.gz):" "Pick the backup (.sql or .sql.gz):")" \
            22 76 12 "${itens[@]}" 3>&1 1>&2 2>&3) || return 1
        [ -z "$escolha" ] && return 1

        if [ "$escolha" = ".." ]; then
            atual=$(dirname "$atual")
        elif [ -d "$atual/$escolha" ]; then
            atual="${atual%/}/$escolha"
        elif [ -f "$atual/$escolha" ]; then
            printf '%s' "${atual%/}/$escolha"
            return 0
        fi
    done
}

selecionar_diretorio() {
    local atual="${1:-/}" escolha dirs=() marcador
    marcador=">>> $(t "SALVAR AQUI" "SAVE HERE") <<<"
    [ -d "$atual" ] || atual="/"
    while true; do
        dirs=("$marcador" "$atual")
        [ "$atual" != "/" ] && dirs+=(".." "$(t "[Voltar]" "[Back]")")
        while IFS= read -r d; do
            [ -n "$d" ] && dirs+=("$d" "$(t "[Pasta]" "[Folder]")")
        done < <(find "$atual" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort)

        escolha=$(whiptail --title "$(t "Seletor de Pasta" "Folder Picker")" \
            --cancel-button "$(t "Voltar" "Back")" \
            --menu "$(t "Pasta atual:" "Current folder:") $atual" 22 76 12 "${dirs[@]}" 3>&1 1>&2 2>&3) || return 1
        [ -z "$escolha" ] && return 1

        if [ "$escolha" = "$marcador" ]; then
            printf '%s' "$atual"; return 0
        elif [ "$escolha" = ".." ]; then
            atual=$(dirname "$atual")
        elif [ -d "$atual/$escolha" ]; then
            atual="${atual%/}/$escolha"
        fi
    done
}

# ======================================================================
# SISTEMA DE VALIDAÇÃO
# ======================================================================
VALIDACAO_LOG="${LOG_DIR}/validacao-$(date '+%Y%m%d-%H%M%S').log"
V_OK=0; V_WARN=0; V_FAIL=0

v_reset() {
    V_OK=0; V_WARN=0; V_FAIL=0
    VALIDACAO_LOG="${LOG_DIR}/validacao-$(date '+%Y%m%d-%H%M%S').log"
    {
        echo "======================================================================"
        echo "KOHA EASY INSTALL - RELATORIO DE VALIDACAO / VALIDATION REPORT"
        echo "Contexto/Context: ${1:-geral}"
        echo "Data/Date: $(date '+%Y-%m-%d %H:%M:%S %Z')"
        echo "Host: $(hostname)   Painel: v${VERSAO_PAINEL}"
        echo "======================================================================"
    } > "$VALIDACAO_LOG"
}
v_ok()   { V_OK=$((V_OK+1));     printf '[ OK ] %s\n' "$1" | tee -a "$VALIDACAO_LOG"; }
v_warn() { V_WARN=$((V_WARN+1)); printf '[AVISO] %s\n' "$1" | tee -a "$VALIDACAO_LOG"; }
v_fail() { V_FAIL=$((V_FAIL+1)); printf '[FALHA] %s\n' "$1" | tee -a "$VALIDACAO_LOG"; }
v_info() { printf '[INFO] %s\n' "$1" | tee -a "$VALIDACAO_LOG"; }

validar_comando() {
    if command -v "$1" >/dev/null 2>&1; then v_ok "$2: '$1' $(t "disponível" "available")."; return 0; fi
    v_fail "$2: '$1' $(t "não encontrado" "not found")."; return 1
}

validar_arquivo() {
    if [ -f "$1" ]; then v_ok "$2: $1"; return 0; fi
    v_fail "$2: $(t "ausente" "missing"): $1"; return 1
}

validar_servico() {
    local s="$1" d="$2" req="${3:-sim}"
    if ! systemctl cat "$s" >/dev/null 2>&1; then
        if [ "$req" = "sim" ]; then v_fail "$d: $(t "serviço não instalado" "service not installed") ($s)."
        else v_warn "$d: $(t "opcional, não instalado" "optional, not installed") ($s)."; fi
        return 1
    fi
    if systemctl is-active --quiet "$s"; then v_ok "$d: $(t "ativo" "active") ($s)."; return 0; fi
    if [ "$req" = "sim" ]; then v_fail "$d: $(t "INATIVO" "INACTIVE") ($s)."
    else v_warn "$d: $(t "opcional, inativo" "optional, inactive") ($s)."; fi
    return 1
}

validar_porta_local() {
    if ss -lnt 2>/dev/null | awk '{print $4}' | grep -Eq "([.:]$1)\$"; then
        v_ok "$2: TCP $1 $(t "em escuta" "listening")."; return 0
    fi
    v_fail "$2: TCP $1 $(t "não está em escuta" "not listening")."; return 1
}

validar_http() {
    local code
    code=$(curl -sS -L --max-time 10 -o /dev/null -w '%{http_code}' "$1" 2>/dev/null)
    if [[ "$code" =~ ^[23][0-9][0-9]$ ]]; then v_ok "$2: HTTP $code."; return 0; fi
    v_fail "$2: HTTP ${code:-$(t "sem resposta" "no response")} ($1)."; return 1
}

validar_mariadb() {
    local c
    if ! mysql -Nse 'SELECT 1;' >/dev/null 2>&1; then
        v_fail "MariaDB: $(t "conexão local falhou" "local connection failed")."; return 1
    fi
    v_ok "MariaDB: $(t "conexão local OK" "local connection OK")."
    c=$(sql "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='${DB_NAME}';")
    c="${c:-0}"
    if [ "$c" -gt 50 ] 2>/dev/null; then
        v_ok "${DB_NAME}: $c $(t "tabelas" "tables")."
    else
        v_warn "${DB_NAME}: $c $(t "tabelas (aguardando Web Installer ou restauração)" "tables (waiting for Web Installer or restore)")."
    fi
    local charset
    charset=$(sql "SELECT default_character_set_name FROM information_schema.schemata WHERE schema_name='${DB_NAME}';")
    case "$charset" in
        utf8mb4) v_ok "${DB_NAME}: charset utf8mb4." ;;
        "")      : ;;
        *)       v_warn "${DB_NAME}: charset '$charset' ($(t "o recomendado é utf8mb4" "utf8mb4 is recommended"))." ;;
    esac
    return 0
}

obter_motor_busca() { sql "SELECT value FROM ${DB_NAME}.systempreferences WHERE variable='SearchEngine' LIMIT 1;"; }

validar_koha_instancia() {
    local e
    validar_arquivo "$KOHA_CONF" "Koha: $(t "configuração" "configuration")"
    validar_arquivo "/etc/apache2/sites-enabled/${INSTANCIA}.conf" "Apache: $(t "site do Koha" "Koha site")"

    if command -v koha-list >/dev/null 2>&1 && koha-list 2>/dev/null | grep -qx "$INSTANCIA"; then
        v_ok "Koha: $(t "instância registrada" "instance registered") ('$INSTANCIA')."
    else
        v_fail "Koha: $(t "instância não registrada" "instance not registered") ('$INSTANCIA')."
    fi

    if [ -f "$KOHA_CONF" ] && command -v xmllint >/dev/null 2>&1; then
        if xmllint --noout "$KOHA_CONF" >/dev/null 2>&1; then
            v_ok "Koha: koha-conf.xml $(t "bem formado" "well-formed")."
        else
            v_fail "Koha: koha-conf.xml $(t "com erro de XML" "has an XML error")."
        fi
    fi

    if command -v koha-plack >/dev/null 2>&1; then
        if koha-plack --status "$INSTANCIA" 2>/dev/null | grep -qi "running"; then
            v_ok "Plack: $(t "rodando" "running")."
        else
            v_warn "Plack: $(t "status não confirmado" "status unconfirmed")."
        fi
    fi

    e=$(obter_motor_busca)
    case "$e" in
        Zebra|Elasticsearch) v_info "Koha: SearchEngine=$e." ;;
        "")                  v_warn "Koha: SearchEngine $(t "ainda não definido" "not defined yet")." ;;
        *)                   v_warn "Koha: SearchEngine=$e (?)." ;;
    esac
}

validar_zebra() {
    [ "$1" != "Zebra" ] && return 0
    if systemctl is-active --quiet "koha-zebra-daemon@${INSTANCIA}" || pgrep -f "zebrasrv" >/dev/null 2>&1; then
        v_ok "Zebra: $(t "daemon ativo" "daemon active")."
    else
        v_fail "Zebra: $(t "daemon INATIVO" "daemon INACTIVE")."
    fi
    if [ -f "$CRON_ZEBRA" ]; then
        v_ok "Zebra: $(t "indexação incremental agendada" "incremental indexing scheduled")."
    else
        v_warn "Zebra: $(t "sem cron de indexação incremental (registros novos podem demorar)" "no incremental indexing cron (new records may lag)")."
    fi
}

validar_cron() {
    validar_arquivo "$CRON_TASKS" "Cron: $(t "arquivo central" "central file")" || return 1
    [ "$(stat -c '%a' "$CRON_TASKS" 2>/dev/null)" = "644" ] \
        && v_ok "Cron: $(t "permissões 644" "permissions 644")." \
        || v_warn "Cron: $(t "permissões diferentes de 644 (o cron ignora o arquivo)" "permissions differ from 644 (cron ignores the file)")."
    grep -q '^PATH=' "$CRON_TASKS" 2>/dev/null \
        && v_ok "Cron: PATH $(t "declarado" "declared")." \
        || v_fail "Cron: $(t "sem linha PATH (koha-shell não é encontrado e as tarefas falham em silêncio)" "no PATH line (koha-shell is not found and tasks fail silently)")."
    grep -q 'backup_sql.sh'  "$CRON_TASKS" 2>/dev/null && v_ok "Cron: backup SQL." || v_warn "Cron: backup SQL $(t "ausente" "missing")."
    grep -q 'backup_marc.sh' "$CRON_TASKS" 2>/dev/null && v_ok "Cron: backup MARC21." || v_warn "Cron: backup MARC21 $(t "ausente" "missing")."
    validar_servico cron "Cron"
}

validar_ufw() {
    if ! command -v ufw >/dev/null 2>&1; then
        v_warn "UFW: $(t "não instalado" "not installed")."; return 1
    fi
    if ufw status 2>/dev/null | grep -q '^Status: active'; then
        v_ok "UFW: $(t "firewall ativo" "firewall active")."
    else
        v_warn "UFW: $(t "firewall inativo (normal em WSL/containers)" "firewall inactive (normal on WSL/containers)")."
    fi
}

validar_backups() {
    local ultimo idade
    if [ -d "$DIR_SQL" ]; then
        ultimo=$(find "$DIR_SQL" -name '*.sql.gz' -printf '%T@ %p\n' 2>/dev/null | sort -rn | head -n1 | cut -d' ' -f2-)
        if [ -n "$ultimo" ]; then
            idade=$(( ( $(date +%s) - $(stat -c %Y "$ultimo") ) / 86400 ))
            if [ "$idade" -le 2 ]; then
                v_ok "Backup SQL: $(t "mais recente com" "newest is") ${idade}d ($(basename "$ultimo"))."
            else
                v_warn "Backup SQL: $(t "mais recente tem" "newest is") ${idade} $(t "dias" "days old")."
            fi
            gzip -t "$ultimo" >/dev/null 2>&1 \
                && v_ok "Backup SQL: $(t "arquivo íntegro" "archive is intact")." \
                || v_fail "Backup SQL: $(t "arquivo CORROMPIDO" "archive is CORRUPT"): $ultimo"
        else
            v_warn "Backup SQL: $(t "nenhum arquivo local ainda" "no local file yet")."
        fi
    fi
    if [ -f "$BACKUP_CONF" ] && grep -q '^RCLONE_REMOTE="[^"]\+"' "$BACKUP_CONF" 2>/dev/null; then
        v_ok "Nuvem: $(t "remote do rclone configurado" "rclone remote configured")."
    else
        v_warn "Nuvem: $(t "backup remoto não configurado (opção 8)" "remote backup not configured (option 8)")."
    fi
}

validar_rede_e_sistema() {
    local ram livre
    validar_comando curl "Internet"
    if getent hosts debian.koha-community.org >/dev/null 2>&1; then
        v_ok "DNS: debian.koha-community.org OK."
    else
        v_fail "DNS: $(t "não resolve" "cannot resolve") debian.koha-community.org."
    fi
    ram=$(awk '/MemTotal:/ {printf "%.1f", $2/1024/1024}' /proc/meminfo 2>/dev/null)
    v_info "RAM: ${ram:-?} GB."
    livre=$(espaco_livre_mb /)
    if [ "${livre:-0}" -ge 5120 ] 2>/dev/null; then v_ok "Disco: ${livre} MB $(t "livres" "free")."
    elif [ "${livre:-0}" -ge 2048 ] 2>/dev/null; then v_warn "Disco: ${livre} MB $(t "livres" "free")."
    else v_fail "Disco: ${livre:-0} MB $(t "livres (menos de 2 GB)" "free (under 2 GB)")."; fi
    swapon --show 2>/dev/null | grep -q '/' && v_ok "SWAP: $(t "ativa" "active")." || v_warn "SWAP: $(t "inexistente" "none")."
    timedatectl show -p NTPSynchronized --value 2>/dev/null | grep -q '^yes$' \
        && v_ok "NTP: $(t "sincronizado" "synchronized")." \
        || v_warn "NTP: $(t "não confirmado" "unconfirmed")."
    v_info "$(t "Fuso horário" "Timezone"): $(timedatectl show -p Timezone --value 2>/dev/null)"
}

validar_sistema_completo() {
    local engine
    v_reset "${1:-validação completa}"
    v_info "=== SISTEMA / REDE ==="
    validar_rede_e_sistema
    v_info "=== SERVIÇOS ==="
    validar_servico mariadb     "MariaDB"
    validar_servico apache2     "Apache"
    validar_servico memcached   "Memcached"
    validar_servico koha-common "Koha common"
    validar_servico cron        "Cron"
    validar_servico fail2ban    "Fail2ban" "nao"
    v_info "=== KOHA / BANCO ==="
    validar_mariadb
    validar_koha_instancia
    validar_porta_local 80   "OPAC"
    validar_porta_local 8080 "Staff"
    validar_http "http://127.0.0.1:80/"   "OPAC"
    validar_http "http://127.0.0.1:8080/" "Staff"
    engine=$(obter_motor_busca)
    v_info "=== BUSCA ==="
    validar_zebra "$engine"
    validar_elasticsearch "$engine"
    v_info "=== APACHE / CRON / BACKUP / FIREWALL ==="
    apachectl configtest >/dev/null 2>&1 && v_ok "Apache: configtest OK." || v_fail "Apache: configtest $(t "falhou" "failed")."
    validar_cron
    validar_backups
    validar_ufw
    printf '\nRESULTADO: OK=%s | AVISOS=%s | FALHAS=%s\nLog: %s\n' "$V_OK" "$V_WARN" "$V_FAIL" "$VALIDACAO_LOG" | tee -a "$VALIDACAO_LOG"
    log "validacao '${1:-geral}': ok=$V_OK warn=$V_WARN fail=$V_FAIL"
    [ "$V_FAIL" -eq 0 ]
}

validar_pre_instalacao() {
    local livre p
    v_reset "pré-instalação"
    [ "$EUID" -eq 0 ] && v_ok "Root OK." || v_fail "Root: $(t "privilégios insuficientes" "insufficient privileges")."

    if [ -r /etc/os-release ] && grep -qiE '^(ID|ID_LIKE)=.*(debian|ubuntu)' /etc/os-release; then
        v_ok "SO: $(t "base Debian/Ubuntu" "Debian/Ubuntu based") ($(. /etc/os-release; echo "$PRETTY_NAME"))."
    else
        v_fail "SO: $(t "este instalador só suporta Debian/Ubuntu" "this installer only supports Debian/Ubuntu")."
    fi

    validar_comando apt-get   "APT"
    validar_comando dpkg      "DPKG"
    validar_comando systemctl "Systemd"
    validar_comando ss        "Rede"
    validar_comando wget      "Download"
    validar_comando gpg       "GPG"

    getent hosts debian.koha-community.org >/dev/null 2>&1 \
        && v_ok "DNS: $(t "repositório Koha resolve" "Koha repository resolves")." \
        || v_fail "DNS: $(t "repositório Koha não resolve" "Koha repository does not resolve")."
    curl -fsSI --max-time 10 https://debian.koha-community.org/koha/ >/dev/null 2>&1 \
        && v_ok "HTTPS: $(t "repositório Koha respondeu" "Koha repository responded")." \
        || v_fail "HTTPS: $(t "repositório Koha não respondeu" "Koha repository did not respond")."

    livre=$(espaco_livre_mb /)
    if [ "${livre:-0}" -ge 10240 ] 2>/dev/null; then v_ok "Disco: ${livre} MB."
    elif [ "${livre:-0}" -ge 5120 ] 2>/dev/null; then v_warn "Disco: ${livre} MB ($(t "apertado para Elasticsearch" "tight for Elasticsearch"))."
    else v_fail "Disco: ${livre:-0} MB ($(t "mínimo recomendado: 5 GB" "recommended minimum: 5 GB"))."; fi

    for p in 80 8080; do
        if ss -lnt 2>/dev/null | awk '{print $4}' | grep -Eq "([.:]$p)\$"; then
            v_warn "TCP $p $(t "já está em uso (outro servidor web?)" "already in use (another web server?)")."
        else
            v_ok "TCP $p $(t "livre" "free")."
        fi
    done

    if [ "$V_FAIL" -ne 0 ]; then
        msg_erro "" "$(t "A pré-validação encontrou $V_FAIL erro(s) crítico(s).\nAvisos: $V_WARN\n\nLog: $VALIDACAO_LOG" "Pre-validation found $V_FAIL critical error(s).\nWarnings: $V_WARN\n\nLog: $VALIDACAO_LOG")" 12 74
        return 1
    fi
    perguntar "$(t "Pré-validação OK" "Pre-validation OK")" \
        "$(t "Nenhum erro crítico.\n\nOK: $V_OK   Avisos: $V_WARN\n\nIniciar a instalação agora?" "No critical errors.\n\nOK: $V_OK   Warnings: $V_WARN\n\nStart the installation now?")" 12 70
}

mostrar_validacao() {
    [ -f "$VALIDACAO_LOG" ] || { msg_info "$(t "Validação" "Validation")" "$(t "Nenhum relatório gerado ainda." "No report generated yet.")" 8 60; return; }
    whiptail --title "$(t "Relatório" "Report")" --scrolltext --textbox "$VALIDACAO_LOG" 30 100 2>/dev/null || true
}

# ======================================================================
# MOTOR DE BUSCA: XML, INDEXADOR E MENSAGERIA
# ======================================================================
xml_editar() {
    # $1 = ação, $2 = tag, $3 = conteúdo interno (para inserir)
    python3 - "$1" "$2" "$KOHA_CONF" "${3:-}" << 'PYEOF'
import re, sys, os, tempfile

acao, tag, path, corpo = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]

with open(path, "r", encoding="utf-8") as f:
    texto = f.read()

# Preserva blocos comentados: só mexe fora de <!-- -->
partes = re.split(r"(<!--.*?-->)", texto, flags=re.DOTALL)
padrao = re.compile(r"[ \t]*<%s>.*?</%s>[ \t]*\n?" % (tag, tag), re.DOTALL)
for i, p in enumerate(partes):
    if not p.startswith("<!--"):
        partes[i] = padrao.sub("", p)
texto = "".join(partes)

if acao == "inserir":
    if "</config>" not in texto:
        sys.exit("ERRO: </config> nao encontrado em koha-conf.xml")
    texto = texto.replace("</config>", corpo + "</config>", 1)

# Escrita atômica preservando dono e permissões do original
st = os.stat(path)
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path))
with os.fdopen(fd, "w", encoding="utf-8") as f:
    f.write(texto)
os.chown(tmp, st.st_uid, st.st_gid)
os.chmod(tmp, st.st_mode)
os.replace(tmp, path)
PYEOF
}

xml_set_elasticsearch() {
    local corpo=""
    [ -f "$KOHA_CONF" ] || return 1
    if [ "$1" = "inserir" ]; then
        corpo="  <elasticsearch>\n    <server>127.0.0.1:9200</server>\n    <index_name>${DB_NAME}</index_name>\n  </elasticsearch>\n"
        corpo=$(printf '%b' "$corpo")
    fi
    xml_editar "$1" "elasticsearch" "$corpo" || return 1
    if command -v xmllint >/dev/null 2>&1 && ! xmllint --noout "$KOHA_CONF" >/dev/null 2>&1; then
        msg_erro "" "$(t "A edição do koha-conf.xml gerou um XML inválido. Restaure pelo backup automático do Koha." "Editing koha-conf.xml produced invalid XML. Restore from Koha's own backup.")" 10 74
        return 1
    fi
    return 0
}

koha_es_ativo_no_xml() { grep -q "<elasticsearch>" "$KOHA_CONF" 2>/dev/null; }

# Mensageria opcional. Sem ela o Koha lê a fila direto do banco.
koha_broker_preparar() {
    dpkg -s rabbitmq-server >/dev/null 2>&1 || return 1
    rabbitmq-plugins enable rabbitmq_stomp >/dev/null 2>&1
    systemctl enable --now rabbitmq-server >/dev/null 2>&1
    return 0
}

koha_es_worker_path() {
    local p
    for p in /usr/share/koha/bin/workers/es_indexer_daemon.pl \
             /usr/share/koha/bin/workers/background_jobs_worker.pl; do
        [ -f "$p" ] && { printf '%s' "$p"; return 0; }
    done
    p=$(find /usr/share/koha -name 'es_indexer_daemon.pl' 2>/dev/null | head -n1)
    [ -n "$p" ] && { printf '%s' "$p"; return 0; }
    return 1
}

# ----------------------------------------------------------------------
# O daemon do pacote é supervisionado pelo utilitário "daemon": ao
# receber SIGTERM ele registra "stopping" e NÃO volta sozinho, e o
# koha-common só o reergue para instâncias listadas em
# `koha-list --enabled --elasticsearch`. Resultado prático: o indexador
# some e os registros novos nunca entram na busca. Por isso usamos uma
# unidade systemd própria, com Restart=always, mais um watchdog.
# ----------------------------------------------------------------------
koha_instalar_servico_indexador() {
    local worker cmd
    worker=$(koha_es_worker_path) || return 1
    if [[ "$worker" == *background_jobs_worker.pl ]]; then
        cmd="/usr/bin/perl ${worker} --queue elastic_index"
    else
        cmd="/usr/bin/perl ${worker}"
    fi

    cat > /etc/systemd/system/koha-es-indexer@.service << EOF
[Unit]
Description=Koha Elasticsearch indexer daemon (%i)
After=network-online.target mariadb.service elasticsearch.service memcached.service koha-common.service
Wants=elasticsearch.service mariadb.service
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStartPre=-/usr/sbin/koha-es-indexer --stop --quiet %i
ExecStart=/usr/sbin/koha-shell %i -c "${cmd}"
Restart=always
RestartSec=10
TimeoutStopSec=20
SyslogIdentifier=koha-es-indexer-%i

[Install]
WantedBy=multi-user.target
EOF

    cat > /usr/local/bin/koha-es-watchdog.sh << EOF
#!/bin/bash
# Religa o indexador do Elasticsearch se ele cair ou se a fila travar.
INST="${INSTANCIA}"
DB="${DB_NAME}"
UNIT="koha-es-indexer@\${INST}"

grep -q "<elasticsearch>" "/etc/koha/sites/\${INST}/koha-conf.xml" 2>/dev/null || exit 0

# Garante um único consumidor: derruba o daemon do wrapper do pacote.
/usr/sbin/koha-es-indexer --stop --quiet "\$INST" >/dev/null 2>&1

if ! systemctl is-active --quiet "\$UNIT"; then
    logger -t koha-es-watchdog "indexador parado; reiniciando \$UNIT"
    systemctl restart "\$UNIT"
    exit 0
fi

PEND=\$(mysql -Nse "SELECT COUNT(*) FROM \${DB}.background_jobs WHERE type='update_elastic_index' AND status='new' AND enqueued_on < DATE_SUB(NOW(), INTERVAL 5 MINUTE);" 2>/dev/null || echo 0)
if [ "\${PEND:-0}" -gt 0 ]; then
    logger -t koha-es-watchdog "\$PEND job(s) presos; reiniciando \$UNIT"
    systemctl restart "\$UNIT"
fi
EOF
    chmod 755 /usr/local/bin/koha-es-watchdog.sh

    {
        echo "$CRON_PATH"
        echo "# Vigia do indexador Elasticsearch (a cada 5 minutos)"
        echo "*/5 * * * * root /usr/local/bin/koha-es-watchdog.sh >/dev/null 2>&1"
    } > "$CRON_ES"
    chmod 644 "$CRON_ES"

    systemctl daemon-reload
    systemctl enable "koha-es-indexer@${INSTANCIA}" >/dev/null 2>&1
    systemctl restart cron >/dev/null 2>&1
    return 0
}

koha_indexadores_gerenciar() {
    if [ "$1" = "start" ]; then
        koha-worker --start "$INSTANCIA" >/dev/null 2>&1
        koha-worker --start --queue long_tasks "$INSTANCIA" >/dev/null 2>&1
        if koha_es_ativo_no_xml; then
            koha_instalar_servico_indexador || return 1
            systemctl restart "koha-es-indexer@${INSTANCIA}" >/dev/null 2>&1
        fi
    else
        systemctl disable --now "koha-es-indexer@${INSTANCIA}" >/dev/null 2>&1
        koha-es-indexer --stop --quiet "$INSTANCIA" >/dev/null 2>&1
        rm -f "$CRON_ES"
        systemctl restart cron >/dev/null 2>&1
    fi
    return 0
}

koha_indexador_esta_rodando() {
    systemctl is-active --quiet "koha-es-indexer@${INSTANCIA}" && return 0
    pgrep -f "es_indexer_daemon" >/dev/null 2>&1 && return 0
    pgrep -af "background_jobs_worker" 2>/dev/null | grep -q "elastic_index" && return 0
    return 1
}

koha_jobs_es_pendentes()   { local n; n=$(sql "SELECT COUNT(*) FROM ${DB_NAME}.background_jobs WHERE type='update_elastic_index' AND status IN ('new','started');"); printf '%s' "${n:-0}"; }
koha_es_total_documentos() { curl -sS --max-time 5 "http://127.0.0.1:9200/${DB_NAME}_biblios/_count" 2>/dev/null | grep -oP '"count"\s*:\s*\K[0-9]+' | head -n1; }
koha_total_biblios()       { sql "SELECT COUNT(*) FROM ${DB_NAME}.biblio;"; }

# Cancela jobs que o rebuild completo já contemplou, para o contador
# de pendências não ficar sujo para sempre.
koha_limpar_jobs_orfaos() {
    local corte="$1"
    mysql -e "UPDATE ${DB_NAME}.background_jobs SET status='cancelled' WHERE type='update_elastic_index' AND status='new' AND enqueued_on < '${corte}';" >/dev/null 2>&1
}

validar_elasticsearch() {
    local e="$1" pend docs bibs
    if ! dpkg -s elasticsearch >/dev/null 2>&1 && ! dpkg -s koha-elasticsearch >/dev/null 2>&1; then
        [ "$e" = "Elasticsearch" ] \
            && v_fail "Elasticsearch: $(t "selecionado no Koha, mas o pacote não está instalado" "selected in Koha but package is missing")." \
            || v_warn "Elasticsearch: $(t "não instalado (ok, o motor atual é o Zebra)" "not installed (fine, current engine is Zebra)")."
        return 0
    fi

    if systemctl is-active --quiet elasticsearch; then
        v_ok "Elasticsearch: $(t "serviço ativo" "service active")."
    else
        [ "$e" = "Elasticsearch" ] \
            && v_fail "Elasticsearch: $(t "serviço INATIVO" "service INACTIVE")." \
            || v_warn "Elasticsearch: $(t "instalado, mas inativo" "installed but inactive")."
    fi

    if curl -sS --max-time 5 http://127.0.0.1:9200/ >/dev/null 2>&1; then
        v_ok "Elasticsearch: API 9200 $(t "respondeu" "responded")."
    elif [ "$e" = "Elasticsearch" ]; then
        v_fail "Elasticsearch: API 9200 $(t "sem resposta" "no response")."
    fi

    [ "$e" = "Elasticsearch" ] || return 0

    koha_es_ativo_no_xml \
        && v_ok "Koha: $(t "bloco <elasticsearch> presente no koha-conf.xml" "<elasticsearch> block present in koha-conf.xml")." \
        || v_fail "Koha: $(t "bloco <elasticsearch> AUSENTE (o indexador não sobe sem ele)" "<elasticsearch> block MISSING (the indexer will not start)")."

    curl -sS --max-time 5 "http://127.0.0.1:9200/_cat/indices/${DB_NAME}_*?format=json" 2>/dev/null | grep -q "${DB_NAME}_" \
        && v_ok "Elasticsearch: $(t "índices do Koha encontrados" "Koha indices found")." \
        || v_warn "Elasticsearch: $(t "índices do Koha não confirmados" "Koha indices unconfirmed")."

    if koha_indexador_esta_rodando; then
        v_ok "Indexador: koha-es-indexer $(t "rodando" "running")."
    else
        v_fail "Indexador: koha-es-indexer $(t "PARADO - registros novos não entram na busca" "STOPPED - new records will not reach search")."
    fi

    [ -f /etc/systemd/system/koha-es-indexer@.service ] \
        && v_ok "Indexador: $(t "serviço systemd instalado (reinício automático)" "systemd unit installed (auto-restart)")." \
        || v_warn "Indexador: $(t "sem serviço systemd dedicado" "no dedicated systemd unit")."

    ss -lnt 2>/dev/null | grep -q ':61613' \
        && v_ok "Mensageria: RabbitMQ/STOMP (61613) OK." \
        || v_warn "Mensageria: $(t "sem RabbitMQ; o Koha lerá a fila direto do banco" "no RabbitMQ; Koha will read the queue straight from the database")."

    pend=$(koha_jobs_es_pendentes)
    if [ "${pend:-0}" -eq 0 ] 2>/dev/null; then
        v_ok "Fila: $(t "nenhum job de indexação pendente" "no pending indexing jobs")."
    elif [ "${pend:-0}" -le 20 ] 2>/dev/null; then
        v_warn "Fila: $pend $(t "job(s) pendente(s)" "pending job(s)")."
    else
        v_fail "Fila: $pend $(t "jobs pendentes - o indexador não está consumindo" "pending jobs - the indexer is not consuming")."
    fi

    bibs=$(koha_total_biblios); docs=$(koha_es_total_documentos)
    if [[ "$bibs" =~ ^[0-9]+$ ]] && [[ "$docs" =~ ^[0-9]+$ ]]; then
        if [ "$docs" -ge "$bibs" ]; then
            v_ok "Cobertura: $docs $(t "documentos para" "documents for") $bibs $(t "registros" "records")."
        else
            v_warn "Cobertura: $docs/$bibs ($(t "faltam" "missing") $((bibs-docs)))."
        fi
    fi
}

