function_cloudflare_status() {
    if [ ! -f /etc/cloudflared/config.yml ]; then
        msg_error "" "$(t "The tunnel is not configured yet.\nUse the installation option first.")" 9 70
        return
    fi

    local opac_host staff_host c_status
    opac_host=$(grep -B1 "localhost:80$" /etc/cloudflared/config.yml | grep "hostname:" | awk '{print $NF}' 2>/dev/null)
    staff_host=$(grep -B1 "localhost:8080$" /etc/cloudflared/config.yml | grep "hostname:" | awk '{print $NF}' 2>/dev/null)

    [ -z "$opac_host" ] && opac_host="$(t "Not configured")"
    [ -z "$staff_host" ] && staff_host="$(t "Not configured")"

    c_status="OFFLINE"
    systemctl is-active --quiet cloudflared && c_status="ONLINE"

    local tmp_cf
    tmp_cf=$(mktemp /tmp/koha_cf.XXXXXX) || return 1

    cat > "$tmp_cf" << EOF
$(t "TUNNEL STATUS:") ${c_status}
----------------------------------------------------------------------

$(t "PUBLIC INTERNET URLS:")

  $(t "Public Catalog (OPAC):")
  https://${opac_host}

  $(t "Administration (Staff):")
  https://${staff_host}

----------------------------------------------------------------------
$(t "ACTIVE SECURITY FEATURES:")

  • $(t "Hidden IP: server real IP is invisible from internet attacks.")
  • $(t "Closed Ports: no need to forward router/firewall ports.")
  • $(t "SSL Encryption: automatic secure HTTPS connections.")
EOF

    whiptail --title "$(t "Cloudflare Information")" --textbox "$tmp_cf" 20 76 2>/dev/null || true
    rm -f "$tmp_cf"
}

function_cloudflare_setup() {
    msg_info "$(t "Step 1: Domain & Nameservers")" \
"$(t "HOW TO LINK YOUR DOMAIN TO CLOUDFLARE:\n\n1. GET A FREE DOMAIN:\n    - Digital Plat (fast/automated): https://domain.digitalplat.org/\n    - nic.eu.org (manual, takes 14 to 45 days): https://nic.eu.org\n    - Or ask local IT for an official CNAME (e.g. catalog.palotina.pr.gov.br)\n\n2. ADD TO CLOUDFLARE (dash.cloudflare.com):\n    - Click 'Add a site/domain', type your domain and select Free.\n    - Cloudflare provides TWO Nameservers. Copy both.\n\n3. UPDATE AT YOUR DOMAIN REGISTRAR:\n    - Replace existing servers with the TWO from Cloudflare.\n    - In Cloudflare, click 'Check nameservers' until status is Active.\n\nThis part can't be automated, but everything from here on is fully automatic.")" 22 78

    clear
    display_explanation "Installing cloudflared..."
    if ! command -v cloudflared >/dev/null 2>&1; then
        if ! wait_for_apt_locks; then return 1; fi
        mkdir -p /etc/apt/keyrings && chmod 0755 /etc/apt/keyrings
        if ! curl -fsSL --retry 3 --max-time 60 https://pkg.cloudflare.com/cloudflare-main.gpg -o /etc/apt/keyrings/cloudflare-main.gpg; then
            restore_apt_timers
            msg_error "" "$(t "Failed to download the Cloudflare key.")" 8 66
            return 1
        fi
        echo "deb [signed-by=/etc/apt/keyrings/cloudflare-main.gpg] https://pkg.cloudflare.com/cloudflared any main" > /etc/apt/sources.list.d/cloudflared.list
        if ! apt_update_indices; then
            rm -f /etc/apt/sources.list.d/cloudflared.list
            restore_apt_timers
            msg_error "" "$(t "Could not update the Cloudflare repository.")" 9 72
            return 1
        fi
        if ! apt_install cloudflared; then
            restore_apt_timers
            return 1
        fi
        restore_apt_timers
    fi

    if [ ! -f "$REAL_HOME/.cloudflared/cert.pem" ] && [ ! -f "/root/.cloudflared/cert.pem" ]; then
        msg_info "$(t "Cloudflare Tunnel")" \
"$(t "AUTHORIZATION (first time only):\n\nA link will appear below. Copy it into any browser, select the\ndomain you already activated in Cloudflare, and click Authorize.\n\nNo need to paste anything back - the server detects it automatically.")" 12 76
        clear
        cloudflared tunnel login
        echo ""
    fi

    if [ ! -f "$REAL_HOME/.cloudflared/cert.pem" ] && [ ! -f "/root/.cloudflared/cert.pem" ]; then
        msg_error "" "$(t "Authorization not completed. Try again.")" 8 66
        return 1
    fi

    local tunnel_name="koha-library"
    display_explanation "Checking Cloudflare tunnel..."
    
    local tunnel_id_check
    tunnel_id_check=$(cloudflared tunnel list 2>/dev/null | awk -v n="$tunnel_name" '$0 ~ n {print $1; exit}')

    if [ -n "$tunnel_id_check" ] && { [ -f "$REAL_HOME/.cloudflared/${tunnel_id_check}.json" ] || [ -f "/root/.cloudflared/${tunnel_id_check}.json" ]; }; then
        log "Tunnel '$tunnel_name' already exists with credentials; reusing..."
    else
        display_explanation "Creating tunnel '$tunnel_name'..."
        if [ -n "$tunnel_id_check" ]; then
            cloudflared tunnel delete -f "$tunnel_name" >/dev/null 2>&1 || true
        fi

        if ! cloudflared tunnel create "$tunnel_name"; then
            msg_error "" "$(t "Failed to create tunnel.")" 10 74
            return 1
        fi
    fi

    local tunnel_id
    tunnel_id=$(cloudflared tunnel list 2>/dev/null | awk -v n="$tunnel_name" '$0 ~ n {print $1; exit}')
    if [ -z "$tunnel_id" ]; then
        msg_error "" "$(t "Could not identify the tunnel ID.")" 8 66
        return 1
    fi

    local cred_file
    cred_file=$(find "$REAL_HOME/.cloudflared" /root/.cloudflared -name "${tunnel_id}.json" 2>/dev/null | head -n1)
    if [ -z "$cred_file" ]; then
        msg_error "" "$(t "Tunnel credentials file (.json) not found.")" 9 70
        return 1
    fi

    local dominio opac_sub staff_sub
    dominio=$(whiptail --title "$(t "Your Domain")" --inputbox "$(t "Enter the domain you already activated in Cloudflare (e.g. bibliotecapalotina.org):")" 10 74 3>&1 1>&2 2>&3) || return 0
    [ -z "$dominio" ] && return 0

    opac_sub=$(whiptail --title "OPAC" --inputbox "$(t "Public Catalog subdomain:")" 10 60 "catalog" 3>&1 1>&2 2>&3) || return 0
    staff_sub=$(whiptail --title "Staff" --inputbox "$(t "Administration subdomain:")" 10 60 "admin" 3>&1 1>&2 2>&3) || return 0

    mkdir -p /etc/cloudflared
    cat > /etc/cloudflared/config.yml <<EOF
tunnel: ${tunnel_id}
credentials-file: ${cred_file}

ingress:
  - hostname: ${opac_sub}.${dominio}
    service: http://localhost:80
  - hostname: ${staff_sub}.${dominio}
    service: http://localhost:8080
  - service: http_status:404
EOF

    display_explanation "Registering subdomains in DNS..."
    cloudflared tunnel route dns -f "$tunnel_name" "${opac_sub}.${dominio}" || true
    cloudflared tunnel route dns -f "$tunnel_name" "${staff_sub}.${dominio}" || true

    display_explanation "Installing tunnel as a service..."
    cloudflared service uninstall >/dev/null 2>&1 || true
    cp /etc/cloudflared/config.yml /etc/cloudflared/config.yml.bak 2>/dev/null || true
    cloudflared --config /etc/cloudflared/config.yml service install
    systemctl enable --now cloudflared >/dev/null 2>&1
    sleep 3

    if systemctl is-active --quiet cloudflared; then
        if is_database_ready; then
            display_explanation "Setting Koha URL system preferences..."
            local full_opac="https://${opac_sub}.${dominio}"
            local full_staff="https://${staff_sub}.${dominio}"

            mysql -e "INSERT INTO ${DB_NAME}.systempreferences (variable, value, type) VALUES ('OPACBaseURL', '${full_opac}', 'Free') ON DUPLICATE KEY UPDATE value='${full_opac}';" >/dev/null 2>&1 || true
            mysql -e "INSERT INTO ${DB_NAME}.systempreferences (variable, value, type) VALUES ('staffClientBaseURL', '${full_staff}', 'Free') ON DUPLICATE KEY UPDATE value='${full_staff}';" >/dev/null 2>&1 || true

            local k_sites="/etc/koha/koha-sites.conf"
            if [ -f "$k_sites" ]; then
                sed -i -E "s|^[[:space:]]*DEFAULTSOPACURL=.*|DEFAULTSOPACURL=\"${full_opac}\"|" "$k_sites" 2>/dev/null || true
                sed -i -E "s|^[[:space:]]*DEFAULTSINTRAURL=.*|DEFAULTSINTRAURL=\"${full_staff}\"|" "$k_sites" 2>/dev/null || true
            fi

            systemctl restart memcached >/dev/null 2>&1 || true
            /usr/sbin/koha-plack --restart "$INSTANCE" >/dev/null 2>&1 || true
        fi

        function_cloudflare_status
    else
        msg_error "" "$(t "The service is not active. Check: journalctl -u cloudflared -n 30")" 9 74
    fi
}

function_configure_cloudflare() {
    while true; do
        local tunnel_active="$(t "INACTIVE")"
        systemctl is-active --quiet cloudflared && tunnel_active="$(t "ACTIVE")"

        local choice
        choice=$(whiptail --title "$(t "Cloudflare Tunnel Manager")" \
            --cancel-button "$(t "Back")" \
            --menu "$(t "Tunnel Status: $tunnel_active\n\nCloudflare Tunnel safely exposes Koha without opening ports.\n\nWhat do you want to do?")" 18 78 4 \
            "1" "$(t "⚙  Install and Configure Tunnel (First Use)")" \
            "2" "$(t "ℹ  View Public Links and Security Status")" \
            "3" "$(t "↻  Restart Tunnel Service")" \
            "4" "$(t "✖  Disable and Remove Tunnel (Go Offline)")" \
            3>&1 1>&2 2>&3)
        [[ $? -ne 0 ]] && break

        case "$choice" in
            1) function_cloudflare_setup ;;
            2) function_cloudflare_status ;;
            3)
                clear
                display_explanation "Restarting Cloudflare Tunnel..."
                systemctl restart cloudflared >/dev/null 2>&1
                msg_ok "$(t "Service restarted successfully.")" 8 60
                ;;
            4)
                if prompt_yes_no "$(t "Disable Tunnel")" "$(t "This will stop the service and remove auto-start.\nYour catalog will go offline to the internet.\n\nContinue?")" 10 70; then
                    clear
                    display_explanation "Uninstalling service..."
                    cloudflared service uninstall >/dev/null 2>&1 || true
                    systemctl disable --now cloudflared >/dev/null 2>&1 || true
                    msg_ok "$(t "Tunnel disabled.\nKoha is now only accessible on the local network.")" 10 70
                fi
                ;;
        esac
    done
}

# ======================================================================
# 15. GOOGLE SEARCH CONSOLE / OPAC INDEXING
# ======================================================================
function_google_search_console() {
    local opac_url=""
    local sitemap_path="sitemapindex.xml"
    local sitemap_url=""
    local robots_url=""
    local http_code=""
    local sitemap_code=""
    local robots_body=""
    local meta_robots=""
    local sitemap_script=""
    local choice=""

    clear
    require_koha || return 0

    if ! command -v curl >/dev/null 2>&1; then
        msg_error "$(t "Google Search Console")" \
            "$(t "The curl command is not available.\n\nInstall the panel dependencies before continuing.")" 10 72
        return 1
    fi

    opac_url=$(whiptail \
        --title "$(t "Google Search Console — OPAC address")" \
        --inputbox "$(t "Enter the complete PUBLIC OPAC address.\n\nExample:\nhttps://catalog.example.org\n\nDo not enter localhost, 127.0.0.1 or a private IP address.")" \
        15 80 "https://" 3>&1 1>&2 2>&3) || return 0

    opac_url="${opac_url%/}"
    case "$opac_url" in
        http://*|https://*) ;;
        *)
            msg_error "$(t "Invalid address")" \
                "$(t "Enter a URL beginning with http:// or https://.")" 9 68
            return 1
            ;;
    esac

    sitemap_url="${opac_url}/${sitemap_path}"
    robots_url="${opac_url}/robots.txt"

    msg_info "$(t "Google Search Console — Indexing Assistant")" \
        "$(t "This assistant prepares and checks the OPAC for Google.\n\nThe panel will automatically:\n• check whether the OPAC is publicly accessible;\n• check robots.txt;\n• locate Koha's official sitemap script;\n• generate the sitemap when possible;\n• check the OpacMetaRobots preference;\n• check whether the sitemap is publicly accessible.\n\nWhat you will need to do manually:\n• add/verify the property in Google Search Console;\n• submit the sitemap in Search Console;\n• request indexing for specific pages when necessary.\n\nThe panel does NOT request or store your Google password.")" 24 88

    display_explanation "Checking public OPAC access..."

    http_code=$(curl -L -k -sS -o /dev/null -w '%{http_code}' --connect-timeout 10 --max-time 30 "$opac_url" 2>/dev/null)

    if [[ "$http_code" =~ ^[23][0-9][0-9]$ ]]; then
        msg_ok "$(t "OPAC accessible.\n\nURL:\n$opac_url\n\nHTTP status:\n$http_code")" 11 76
    else
        msg_error "$(t "Connection Error")" \
            "$(t "The OPAC did not respond correctly from the internet.\n\nURL:\n$opac_url\n\nHTTP:\n${http_code:-no response}\n\nCheck DNS, Cloudflare Tunnel, Apache, HTTPS and firewall before attempting indexing.")" 16 82

        prompt_yes_no "$(t "Continue?")" \
            "$(t "The OPAC is not responding correctly yet.\n\nDo you want to continue with local checks?")" 11 74 || return 0
    fi

    if is_database_ready; then
        display_explanation "Checking OpacMetaRobots..."

        meta_robots=$(run_sql "SELECT value FROM ${DB_NAME}.systempreferences WHERE variable='OpacMetaRobots' LIMIT 1;" 2>/dev/null || true)

        if printf '%s' "$meta_robots" | grep -qi 'noindex'; then
            msg_error "$(t "Warning: NOINDEX Detected")" \
                "$(t "WARNING: the OPAC is configured with NOINDEX.\n\nCurrent value:\n$meta_robots\n\nWhile 'noindex' is configured, Google may be instructed not to index the pages.\n\nTo fix it manually:\n\nKoha Staff\n→ Administration\n→ System preferences\n→ OPAC\n→ OpacMetaRobots\n\nRemove the 'noindex' option and save.\nThe panel does NOT change this automatically.")" 22 88
        else
            msg_ok "$(t "OpacMetaRobots does not contain 'noindex'.\n\nCurrent value:\n${meta_robots:-not defined}")" 12 78
        fi
    fi

    sitemap_script=""
    if [ -f "/usr/share/koha/misc/cronjobs/sitemap.pl" ]; then
        sitemap_script="/usr/share/koha/misc/cronjobs/sitemap.pl"
    else
        sitemap_script=$(find /usr/share/koha -type f -path '*/misc/cronjobs/sitemap.pl' 2>/dev/null | head -n 1 || true)
    fi
    if [ -n "$sitemap_script" ]; then
        display_explanation "Generating Koha sitemap..."
        if koha-shell "$INSTANCE" "/usr/bin/perl $sitemap_script" >/tmp/koha_google_sitemap.log 2>&1; then
            log "Koha sitemap generated successfully."
        else
            log "Warning: could not run sitemap automatically."
        fi
    else
        log "Warning: sitemap.pl script not found."
    fi

    display_explanation "Checking the published sitemap..."

    sitemap_code=$(curl -L -k -sS -o /dev/null -w '%{http_code}' --connect-timeout 10 --max-time 30 "$sitemap_url" 2>/dev/null)

    if [[ "$sitemap_code" =~ ^2[0-9][0-9]$ ]]; then
        msg_ok "$(t "Sitemap found!\n\nURL:\n$sitemap_url\n\nHTTP:\n$sitemap_code")" 12 82
    else
        msg_info "$(t "Sitemap unconfirmed")" \
            "$(t "The sitemap was not confirmed at this address.\n\n$sitemap_url\n\nThis does not necessarily mean that Koha has a problem.\nThe sitemap may need to be configured/published at the OPAC root, or the path used by the installation may need to be confirmed.")" 16 84
    fi

    robots_body=$(curl -L -k -sS --connect-timeout 10 --max-time 30 "$robots_url" 2>/dev/null || true)
    if [ -n "$robots_body" ]; then
        if printf '%s\n' "$robots_body" | grep -Fqi 'Sitemap:'; then
            msg_ok "$(t "robots.txt found and already contains a Sitemap: line.")" 10 82
        else
            msg_info "$(t "robots.txt without sitemap")" \
                "$(t "robots.txt found, but without a sitemap reference.\n\nRecommendation:\n\nAdd a line similar to:\nSitemap: $sitemap_url\n\nThe change should be made in the correct OPAC configuration, not in an arbitrary system file.")" 15 84
        fi
    else
        msg_info "$(t "robots.txt missing")" \
            "$(t "robots.txt did not respond.\n\nIt is recommended to make robots.txt correctly available on the public OPAC.")" 10 78
    fi

    choice=$(whiptail \
        --title "$(t "Google Search Console — Next steps")" \
        --menu "$(t "Automatic preparation is complete.\n\nChoose what you want to do:")" \
        20 88 7 \
        "1" "$(t "Open Google Search Console instructions")" \
        "2" "$(t "Property verification — step by step")" \
        "3" "$(t "Submit sitemap — step by step")" \
        "4" "$(t "Request indexing — step by step")" \
        "5" "$(t "Run the checks again")" \
        "6" "$(t "Official Google links")" \
        "7" "$(t "Back")" 3>&1 1>&2 2>&3) || return 0

    case "$choice" in
        1)
            msg_info "$(t "GOOGLE SEARCH CONSOLE")" \
                "$(t "Open on your computer:\nhttps://search.google.com/search-console\n\nThen add the property corresponding to the public OPAC address:\n$opac_url")" 16 84
            ;;
        2)
            msg_info "$(t "PROPERTY VERIFICATION — DO THIS MANUALLY")" \
                "$(t "1. Open:\nhttps://search.google.com/search-console\n\n2. Click 'Add property'.\n\n3. Choose 'URL prefix'.\n\n4. Paste exactly:\n$opac_url\n\n5. Google will show the available verification methods.\nOne option is DNS verification, performed at the domain provider.\nAnother option is HTML file or meta tag verification, when available.\n\nIMPORTANT:\nIf the domain belongs to a municipality or another institution, DNS changes may need to be performed by the IT administrator.\nThe panel does not need your Google password.")" 27 92
            ;;
        3)
            msg_info "$(t "SUBMIT THE SITEMAP — DO THIS MANUALLY")" \
                "$(t "After the property has been verified:\n\n1. Open:\nhttps://search.google.com/search-console\n\n2. Select:\n$opac_url\n\n3. Open 'Sitemaps' in the left menu.\n\n4. Enter:\n$sitemap_path\n\n5. Click 'Submit'.\n\nGoogle will then know where the sitemap is located.\n\nWARNING:\nSubmitting a sitemap does not guarantee that every page will be indexed.")" 22 88
            ;;
        4)
            msg_info "$(t "REQUEST INDEXING — DO THIS MANUALLY")" \
                "$(t "To test the main catalog address:\n\n1. Open Search Console.\n2. Select your property.\n3. Use 'URL Inspection'.\n4. Paste:\n$opac_url\n5. Wait for the analysis.\n6. If available, use 'Request indexing'.\n\nYou do not need to request every book individually.\nA sitemap is the appropriate method for informing Google about a large set of URLs.\nA request for indexing also does not guarantee immediate indexing.")" 23 88
            ;;
        5)
            function_google_search_console
            return $?
            ;;
        6)
            msg_info "$(t "OFFICIAL LINKS")" \
                "$(t "Google Search Console:\nhttps://search.google.com/search-console\n\nOfficial sitemap documentation:\nhttps://developers.google.com/search/docs/crawling-indexing/sitemaps/overview\n\nOfficial indexing documentation:\nhttps://developers.google.com/search/docs/crawling-indexing/overview")" 19 88
            ;;
        7)
            return 0
            ;;
    esac

    msg_info "$(t "FINAL GOOGLE CHECKLIST")" \
        "$(t "AUTOMATICALLY BY THE PANEL:\n\n[✓] OPAC checked\n[✓] OpacMetaRobots checked\n[✓] Koha sitemap located/generated when possible\n[✓] Public sitemap tested\n[✓] robots.txt tested\n\nMANUALLY IN GOOGLE:\n\n[ ] Property added\n[ ] Property verified\n[ ] Sitemap submitted\n[ ] Homepage tested with URL Inspection\n[ ] Indexing requested if necessary\n\nIMPORTANT:\nSearch Console helps Google discover the catalog, but it does not guarantee that every page will be indexed or appear immediately in search results.")" 25 92

    log "Google Search Console assistant executed for OPAC: $opac_url"
}

# ======================================================================
# 16. SSL CERTIFICATE
# ======================================================================
function_configure_ssl() {
    prompt_yes_no "$(t "SSL / HTTPS")" \
"$(t "To issue the free certificate you NEED a domain with an A record\npointing to this server's PUBLIC IP, and port 80 reachable.\n\nIf you use Cloudflare Tunnel, CANCEL: HTTPS already comes from it.\n\nContinue?")" 15 76 || return 0
    clear
    if ! wait_for_apt_locks; then return 1; fi
    apt_update_indices
    if ! apt_install certbot python3-certbot-apache; then
        restore_apt_timers
        return 1
    fi
    restore_apt_timers
    if ! certbot --apache; then
        msg_error "" "$(t "Certbot could not complete certificate issuance/configuration. Apache will not be reloaded automatically.")" 10 78
        return 1
    fi
    if ! apachectl configtest; then
        msg_error "" "$(t "Apache configuration is invalid after Certbot. The service will not be reloaded.")" 10 76
        return 1
    fi
    if ! systemctl restart apache2 >/dev/null 2>&1; then
        msg_error "" "$(t "The certificate was configured, but Apache failed to restart. Check the service status.")" 10 76
        return 1
    fi
    msg_ok "$(t "HTTPS configured successfully. Certbot will handle automatic renewal.")" 9 72
}

# ======================================================================
# 17. INTEROPERABILITY (SIP2 / Z39.50)
# ======================================================================
function_interoperability() {
    require_koha || return 0
    prompt_yes_no "$(t "SIP2 & Z39.50")" \
"$(t "Z39.50 (port 2100): lets other libraries search your catalog.\nSIP2 (port 6001): lets you connect self-checkout terminals.\n\nEnable both and open the firewall ports?")" 13 78 || return 0
    clear
    ufw allow 2100/tcp >/dev/null 2>&1 || true
    ufw allow 6001/tcp >/dev/null 2>&1 || true

    /usr/sbin/koha-z3950-responder --enable "$INSTANCE" >/dev/null 2>&1 || true
    /usr/sbin/koha-sip --enable "$INSTANCE" >/dev/null 2>&1 || true
    systemctl daemon-reload >/dev/null 2>&1 || true

    local z39_ok="no" sip_ok="no"
    if systemctl enable --now "koha-z3950-responder@${INSTANCE}" >/dev/null 2>&1 || systemctl is-active --quiet "koha-z3950-responder@${INSTANCE}"; then
        z39_ok="yes"
    fi
    if systemctl enable --now "koha-sip-daemon@${INSTANCE}" >/dev/null 2>&1 || systemctl is-active --quiet "koha-sip-daemon@${INSTANCE}"; then
        sip_ok="yes"
    fi

    local z39_status sip_status
    [ "$z39_ok" = "yes" ] && z39_status="$(t "active")" || z39_status="$(t "inactive")"
    [ "$sip_ok" = "yes" ] && sip_status="$(t "active")" || sip_status="$(t "inactive")"

    if [ "$z39_ok" = "yes" ] && [ "$sip_ok" = "yes" ]; then
        msg_ok "$(t "Z39.50 and SIP2 were enabled successfully!\n\nFor SIP2 you still need a circulation account and\nto fill in:\n/etc/koha/sites/${INSTANCE}/SIPconfig.xml")" 12 76
    else
        msg_error "" "$(t "Activation was partial.\n\nZ39.50: ${z39_status}\nSIP2:    ${sip_status}\n\nCheck: systemctl status koha-z3950-responder@${INSTANCE} koha-sip-daemon@${INSTANCE}")" 12 78
        return 1
    fi
}

