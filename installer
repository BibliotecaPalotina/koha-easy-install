escrever_config_backup() {
    [ -f "$BACKUP_CONF" ] && return 0
    cat > "$BACKUP_CONF" << 'EOF'
# Configuração dos backups do Koha / Koha backup settings.
# Editada automaticamente pela opção 8 do painel (Backup em Nuvem).
RCLONE_REMOTE=""
RCLONE_PASTA_SQL="Backup_SQL_Koha"
RCLONE_PASTA_MARC="Backup_MARC_Koha"
MANTER_DIAS=7
EOF
    chmod 600 "$BACKUP_CONF"
}

escrever_scripts_backup() {
    mkdir -p "$DIR_SQL" "$DIR_MARC"
    escrever_config_backup

    cat > /root/backup_sql.sh << EOF
#!/bin/bash
# Backup do banco do Koha. Gerado pelo Koha Easy Install.
set -o pipefail
CONF="${BACKUP_CONF}"
DB="${DB_NAME}"
DIR="${DIR_SQL}"
LOG="${LOG_DIR}/backup_sql.log"
RCLONE_REMOTE=""; RCLONE_PASTA_SQL="Backup_SQL_Koha"; MANTER_DIAS=7
[ -f "\$CONF" ] && . "\$CONF"

registrar() { printf '%s | %s\n' "\$(date '+%F %T')" "\$*" >> "\$LOG"; }
mkdir -p "\$DIR"

ARQ="\$DIR/\${DB}_\$(date +%Y-%m-%d_%Hh%M).sql.gz"

# --single-transaction evita travar o catálogo durante o dump (InnoDB).
if ! mysqldump --single-transaction --quick --routines --triggers \\
        --default-character-set=utf8mb4 "\$DB" 2>>"\$LOG" | gzip > "\$ARQ"; then
    registrar "FALHA ao gerar \$ARQ"
    rm -f "\$ARQ"
    exit 1
fi

if ! gzip -t "\$ARQ" 2>/dev/null; then
    registrar "FALHA: arquivo corrompido, removido: \$ARQ"
    rm -f "\$ARQ"
    exit 1
fi

TAM=\$(stat -c %s "\$ARQ" 2>/dev/null || echo 0)
if [ "\$TAM" -lt 10240 ]; then
    registrar "FALHA: backup suspeito (\$TAM bytes), removido: \$ARQ"
    rm -f "\$ARQ"
    exit 1
fi
registrar "OK: \$ARQ (\$TAM bytes)"

# Envio para a nuvem (copy, nunca move: o local é a nossa garantia).
if [ -n "\$RCLONE_REMOTE" ] && [ -f /root/.config/rclone/rclone.conf ]; then
    if /usr/bin/rclone --config /root/.config/rclone/rclone.conf copy "\$ARQ" "\${RCLONE_REMOTE}:\${RCLONE_PASTA_SQL}" >>"\$LOG" 2>&1; then
        registrar "Nuvem OK: \${RCLONE_REMOTE}:\${RCLONE_PASTA_SQL}"
    else
        registrar "AVISO: envio para a nuvem falhou (cópia local preservada)"
    fi
fi

find "\$DIR" -name '*.sql.gz' -mtime "+\${MANTER_DIAS}" -delete 2>/dev/null
exit 0
EOF

    cat > /root/backup_marc.sh << EOF
#!/bin/bash
# Backup dos registros MARC21 (bibliográficos e autoridades).
set -o pipefail
CONF="${BACKUP_CONF}"
INST="${INSTANCIA}"
DIR="${DIR_MARC}"
LOG="${LOG_DIR}/backup_marc.log"
RCLONE_REMOTE=""; RCLONE_PASTA_MARC="Backup_MARC_Koha"; MANTER_DIAS=7
[ -f "\$CONF" ] && . "\$CONF"

registrar() { printf '%s | %s\n' "\$(date '+%F %T')" "\$*" >> "\$LOG"; }
mkdir -p "\$DIR"

EXPORT="/usr/share/koha/bin/export_records.pl"
[ -f "\$EXPORT" ] || EXPORT="\$(find /usr/share/koha -name export_records.pl 2>/dev/null | head -n1)"
if [ -z "\$EXPORT" ]; then registrar "FALHA: export_records.pl nao encontrado"; exit 1; fi

DATA=\$(date '+%Y-%m-%d_%H%M')
BIB="\$DIR/biblios_\${DATA}.mrc"
AUT="\$DIR/authorities_\${DATA}.mrc"
PACOTE="\$DIR/koha_marc_\${DATA}.tar.gz"

/usr/sbin/koha-shell "\$INST" -c "perl \$EXPORT --record-type=bibs  --format=marc --filename=\$BIB" >>"\$LOG" 2>&1
/usr/sbin/koha-shell "\$INST" -c "perl \$EXPORT --record-type=auths --format=marc --filename=\$AUT" >>"\$LOG" 2>&1

if [ ! -s "\$BIB" ]; then
    registrar "FALHA: exportacao bibliografica vazia"
    rm -f "\$BIB" "\$AUT"
    exit 1
fi

tar -czf "\$PACOTE" -C "\$DIR" "\$(basename "\$BIB")" "\$(basename "\$AUT")" 2>>"\$LOG"
rm -f "\$BIB" "\$AUT"
registrar "OK: \$PACOTE (\$(stat -c %s "\$PACOTE" 2>/dev/null) bytes)"

if [ -n "\$RCLONE_REMOTE" ] && [ -f /root/.config/rclone/rclone.conf ]; then
    /usr/bin/rclone --config /root/.config/rclone/rclone.conf copy "\$PACOTE" "\${RCLONE_REMOTE}:\${RCLONE_PASTA_MARC}" >>"\$LOG" 2>&1 \\
        && registrar "Nuvem OK" || registrar "AVISO: envio para a nuvem falhou"
fi

find "\$DIR" -name 'koha_marc_*.tar.gz' -mtime "+\${MANTER_DIAS}" -delete 2>/dev/null
exit 0
EOF

    chmod 700 /root/backup_sql.sh /root/backup_marc.sh
}

escrever_cron_tarefas() {
    # Preserva o bloco de e-mails se já existir
    local bloco_email=""
    if [ -f "$CRON_TASKS" ] && grep -q '^# BEGIN KOHA EMAIL NOTICES' "$CRON_TASKS"; then
        bloco_email=$(sed -n '/^# BEGIN KOHA EMAIL NOTICES$/,/^# END KOHA EMAIL NOTICES$/p' "$CRON_TASKS")
    fi

    cat > "$CRON_TASKS" << EOF
# ======================================================================
# KOHA EASY INSTALL - TAREFAS AUTOMATICAS / SCHEDULED TASKS
# ======================================================================
# COMO AJUSTAR A HORA / HOW TO CHANGE TIME
# Colunas: MINUTO HORA DIA_DO_MES MES DIA_DA_SEMANA(0=domingo) usuario comando
# Exemplo: "30 01 * * *" = todo dia as 01:30.
# Mexa apenas nas duas primeiras colunas (minuto e hora).
# ======================================================================
# A linha PATH abaixo e OBRIGATORIA: sem ela o cron nao encontra o
# koha-shell (que fica em /usr/sbin) e as tarefas falham em silencio.
$CRON_PATH
MAILTO=""

# 1. Limpeza de logs do sistema (todo dia as 00:30)
30 0 * * * root /usr/bin/journalctl --vacuum-time=14d >/dev/null 2>&1

# 2. Verificacao e reparo do banco (dia 5 de cada mes, 01:00)
0 1 5 * * root /usr/bin/mysqlcheck --check --auto-repair --databases ${DB_NAME} >/dev/null 2>&1

# 3. Reinicio preventivo do Plack para liberar memoria (todo dia as 05:00)
0 5 * * * root /usr/sbin/koha-plack --restart ${INSTANCIA} >/dev/null 2>&1

# 4. BACKUP DIARIO DO BANCO + ENVIO PARA A NUVEM (todo dia as 23:00)
0 23 * * * root /bin/bash /root/backup_sql.sh >/dev/null 2>&1

# 5. BACKUP SEMANAL DOS REGISTROS MARC21 (domingos as 03:00)
0 3 * * 0 root /bin/bash /root/backup_marc.sh >/dev/null 2>&1

# 6. Limpeza de sessoes antigas e filas do Koha (todo dia as 01:30)
30 1 * * * root /usr/sbin/koha-shell ${INSTANCIA} -c "/usr/share/koha/bin/cronjobs/cleanup_database.pl --sessions --sessdays 2 --zebraqueue 10" >/dev/null 2>&1

EOF

    if [ -n "$bloco_email" ]; then
        printf '%s\n' "$bloco_email" >> "$CRON_TASKS"
    else
        cat >> "$CRON_TASKS" << EOF
# BEGIN KOHA EMAIL NOTICES
# 7. Avisos de atraso (08:00) e processamento da fila de e-mails (08:05)
0 8 * * * root /usr/sbin/koha-shell ${INSTANCIA} -c "/usr/share/koha/bin/cronjobs/overdue_notices.pl -v -t" >/dev/null 2>&1
5 8 * * * root /usr/sbin/koha-shell ${INSTANCIA} -c "/usr/share/koha/bin/cronjobs/process_message_queue.pl -v" >/dev/null 2>&1
# END KOHA EMAIL NOTICES
EOF
    fi

    chmod 644 "$CRON_TASKS"
    chown root:root "$CRON_TASKS"
    systemctl restart cron >/dev/null 2>&1
}

escrever_cron_zebra() {
    {
        echo "$CRON_PATH"
        echo "# Indexacao incremental do Zebra (a cada 2 minutos)"
        echo "*/2 * * * * root /usr/sbin/koha-shell ${INSTANCIA} -c \"/usr/share/koha/bin/migration_tools/rebuild_zebra.pl -b -a -z\" >/dev/null 2>&1"
    } > "$CRON_ZEBRA"
    chmod 644 "$CRON_ZEBRA"
    systemctl restart cron >/dev/null 2>&1
}

configurar_firewall() {
    command -v ufw >/dev/null 2>&1 || return 0
    local p
    for p in $(portas_ssh); do ufw allow "${p}/tcp" >/dev/null 2>&1; done
    for p in 80 443 8080 587 53682; do ufw allow "${p}/tcp" >/dev/null 2>&1; done
    if ! ufw --force enable >/dev/null 2>&1; then
        log "UFW nao pode ser ativado (provavel WSL/container)"
    fi
}

escrever_banner() {
    local ip="$1" user="$2"
    cat > /etc/issue << EOF
\\S

  +-------------------------------------------------------------+
  |                     K O H A   L I B R A R Y                  |
  |            PUBLIC CATALOG & AUTOMATION SUITE                 |
  +-------------------------------------------------------------+
  |  PAINEL DE CONTROLE / CONTROL DASHBOARD:  sudo options.sh    |
  +-------------------------------------------------------------+
  |  Staff (Intranet) : http://${ip}:8080
  |  OPAC  (Publico)  : http://${ip}:80
  |  Usuario / User   : ${user}
  |  Senha  / Pass    : cat /root/credenciais_koha.txt
  +-------------------------------------------------------------+

EOF
    cp -f /etc/issue /etc/issue.net 2>/dev/null
    cp -f /etc/issue /etc/motd 2>/dev/null
}

# ======================================================================
# 1. INSTALAÇÃO DO SERVIDOR
# ======================================================================
funcao_instalar_koha() {
    msg_info "$(t "Instalação" "Installation")" \
        "$(t "Este assistente vai instalar MariaDB, Apache, Memcached e o Koha (motor de busca Zebra por padrão).\n\nPode levar de 10 a 30 minutos. Não feche o terminal." "This wizard installs MariaDB, Apache, Memcached and Koha (Zebra search engine by default).\n\nIt can take 10 to 30 minutes. Do not close the terminal.")" 13 74
    clear
    validar_pre_instalacao || return 0

    local fuso
    fuso=$(escolher_fuso_horario) && [ -n "$fuso" ] && timedatectl set-timezone "$fuso" >/dev/null 2>&1

    aguardar_travas_apt

    caixa_explicacao "Configurando idioma e codificação UTF-8..." "Configuring locales and UTF-8..."
    apt_atualizar_indices
    apt_instalar locales || return 1
    locale-gen pt_BR.UTF-8 en_US.UTF-8 >/dev/null 2>&1
    if [ "$SYS_LANG" = "pt" ]; then update-locale LANG=pt_BR.UTF-8; else update-locale LANG=en_US.UTF-8; fi

    caixa_explicacao "Sincronizando o relógio (NTP)..." "Synchronizing the clock (NTP)..."
    apt_instalar systemd-timesyncd >/dev/null 2>&1
    systemctl enable --now systemd-timesyncd >/dev/null 2>&1
    timeout 15 bash -c 'until timedatectl show -p NTPSynchronized --value | grep -q yes; do sleep 1; done' >/dev/null 2>&1

    caixa_explicacao "Criando memória virtual (SWAP de 4 GB)..." "Creating virtual memory (4 GB SWAP)..."
    if [ "$(swapon --show 2>/dev/null | wc -l)" -le 1 ] && [ ! -f /swapfile ]; then
        if [ "$(espaco_livre_mb /)" -ge 8192 ] 2>/dev/null; then
            fallocate -l 4G /swapfile 2>/dev/null || dd if=/dev/zero of=/swapfile bs=1M count=4096 status=none
            chmod 600 /swapfile
            mkswap /swapfile >/dev/null 2>&1
            if swapon /swapfile 2>/dev/null; then
                grep -q '^/swapfile' /etc/fstab || echo '/swapfile none swap sw 0 0' >> /etc/fstab
            else
                rm -f /swapfile
                echo "$(t "[AVISO] SWAP não pôde ser ativada (normal em WSL/containers)." "[WARN] SWAP could not be enabled (normal on WSL/containers).")"
            fi
        else
            echo "$(t "[AVISO] Espaço insuficiente para SWAP de 4 GB. Pulando." "[WARN] Not enough space for a 4 GB SWAP. Skipping.")"
        fi
    fi

    aguardar_travas_apt
    caixa_explicacao "Atualizando o sistema..." "Upgrading the system..."
    apt_atualizar_indices
    DEBIAN_FRONTEND=noninteractive apt-get upgrade "${APT_OPTS[@]}"

caixa_explicacao "Instalando dependências essenciais..." "Installing essential dependencies..."
    apt_instalar nano curl wget gpg ca-certificates ufw apt-transport-https \
                 fail2ban libsasl2-modules rclone avahi-daemon memcached \
                 python3 libxml2-utils unzip pv glabels || return 1
    systemctl enable --now avahi-daemon fail2ban memcached >/dev/null 2>&1

    caixa_explicacao "Adicionando os repositórios do Koha e do Elasticsearch..." "Adding Koha and Elasticsearch repositories..."
    mkdir -p /usr/share/keyrings
    if ! curl -fsSL --retry 3 --max-time 60 https://debian.koha-community.org/koha/gpg.asc \
        | gpg --dearmor --yes -o /usr/share/keyrings/koha-keyring.gpg 2>/dev/null; then
        msg_erro "" "$(t "Não foi possível baixar a chave do repositório do Koha. Verifique a internet." "Could not download the Koha repository key. Check your internet connection.")" 9 74
        return 1
    fi
    echo "deb [signed-by=/usr/share/keyrings/koha-keyring.gpg] https://debian.koha-community.org/koha stable main" > /etc/apt/sources.list.d/koha.list

    if curl -fsSL --retry 3 --max-time 60 https://artifacts.elastic.co/GPG-KEY-elasticsearch \
        | gpg --dearmor --yes -o /usr/share/keyrings/elasticsearch-keyring.gpg 2>/dev/null; then
        echo "deb [signed-by=/usr/share/keyrings/elasticsearch-keyring.gpg] https://artifacts.elastic.co/packages/7.x/apt stable main" > /etc/apt/sources.list.d/elastic-7.x.list
    else
        rm -f /etc/apt/sources.list.d/elastic-7.x.list
        echo "$(t "[AVISO] Repositório do Elasticsearch indisponível; seguindo só com o Zebra." "[WARN] Elasticsearch repository unavailable; continuing with Zebra only.")"
    fi

    apt_atualizar_indices
    caixa_explicacao "Instalando MariaDB e Koha (esta é a etapa mais demorada)..." "Installing MariaDB and Koha (longest step)..."
    apt_instalar mariadb-server koha-common || return 1
    systemctl enable --now mariadb >/dev/null 2>&1

    caixa_explicacao "Configurando o Apache e os padrões do Koha..." "Configuring Apache and Koha defaults..."
    definir_koha_sites_conf
    a2enmod rewrite cgi deflate headers proxy proxy_http >/dev/null 2>&1
    grep -qE '^[[:space:]]*Listen[[:space:]]+8080' /etc/apache2/ports.conf 2>/dev/null \
        || sed -i '/^[[:space:]]*Listen[[:space:]]\+80$/a Listen 8080' /etc/apache2/ports.conf
    systemctl restart apache2 memcached >/dev/null 2>&1

    # ---- instância existente ----
    local existe="nao"
    [ -d "/etc/koha/sites/${INSTANCIA}" ] && existe="sim"
    [ "$(sql "SELECT 1 FROM information_schema.schemata WHERE schema_name='${DB_NAME}';")" = "1" ] && existe="sim"

    if [ "$existe" = "sim" ]; then
        perguntar "$(t "Instância já existe" "Instance already exists")" \
            "$(t "Já existe uma instalação do Koha nesta máquina.\n\nREINSTALAR APAGA o banco ${DB_NAME} e toda a configuração.\nIsso NÃO pode ser desfeito por este script.\n\nQuer continuar para a confirmação final?" "A Koha installation already exists.\n\nREINSTALLING DELETES the ${DB_NAME} database and all configuration.\nThis CANNOT be undone by this script.\n\nContinue to the final confirmation?")" 16 76 || return 0

        local confirma
        confirma=$(whiptail --title "$(t "CONFIRMAÇÃO FINAL" "FINAL CONFIRMATION")" --inputbox \
            "$(t "Digite exatamente a palavra abaixo para apagar tudo:\n\nREINSTALAR" "Type exactly the word below to erase everything:\n\nREINSTALL")" 12 66 3>&1 1>&2 2>&3) || return 0
        if [ "$confirma" != "$(t "REINSTALAR" "REINSTALL")" ]; then
            msg_info "$(t "Cancelado" "Cancelled")" "$(t "Confirmação incorreta. Nada foi apagado." "Wrong confirmation. Nothing was deleted.")" 8 62
            return 0
        fi

        caixa_explicacao "Salvando um backup de segurança antes de apagar..." "Saving a safety backup before deleting..."
        mkdir -p "$DIR_SQL"
        local resgate="${DIR_SQL}/PRE-REINSTALACAO_$(date +%Y-%m-%d_%Hh%M).sql.gz"
        mysqldump --single-transaction --quick "$DB_NAME" 2>/dev/null | gzip > "$resgate" || rm -f "$resgate"
        [ -s "$resgate" ] && echo "$(t "Backup de segurança:" "Safety backup:") $resgate"

        caixa_explicacao "Removendo a instalação anterior..." "Removing the previous installation..."
        koha_indexadores_gerenciar stop
        koha-remove "$INSTANCIA" >/dev/null 2>&1
        mysql -e "DROP DATABASE IF EXISTS ${DB_NAME};" >/dev/null 2>&1
        mysql -e "DROP USER IF EXISTS '${DB_NAME}'@'localhost';" >/dev/null 2>&1
        rm -rf "/etc/koha/sites/${INSTANCIA}"
    fi

    caixa_explicacao "Criando a instância '${INSTANCIA}' do Koha..." "Creating the '${INSTANCIA}' Koha instance..."
    if ! koha-create --create-db "$INSTANCIA"; then
        msg_erro "" "$(t "Falha ao criar a instância do Koha.\nVeja o terminal para o erro exato." "Failed to create the Koha instance.\nSee the terminal for the exact error.")" 9 70
        return 1
    fi

    sed -i 's/__MEMCACHED_SERVERS__/127.0.0.1:11211/g; s/__MEMCACHED_PREFIX__/koha_library:/g' "$KOHA_CONF" 2>/dev/null

    a2dissite 000-default >/dev/null 2>&1
    a2ensite "$INSTANCIA" >/dev/null 2>&1
    systemctl restart apache2 memcached koha-common >/dev/null 2>&1

    [ "$SYS_LANG" = "pt" ] && koha-translate --install pt-BR >/dev/null 2>&1
    koha-plack --enable "$INSTANCIA" >/dev/null 2>&1
    koha-plack --start  "$INSTANCIA" >/dev/null 2>&1

    caixa_explicacao "Ativando o Zebra e a indexação incremental..." "Enabling Zebra and incremental indexing..."
    koha-zebra --enable "$INSTANCIA" >/dev/null 2>&1
    koha-zebra --start  "$INSTANCIA" >/dev/null 2>&1
    systemctl enable --now "koha-zebra-daemon@${INSTANCIA}" >/dev/null 2>&1
    escrever_cron_zebra
    koha-worker --start "$INSTANCIA" >/dev/null 2>&1
    koha-worker --start --queue long_tasks "$INSTANCIA" >/dev/null 2>&1

    caixa_explicacao "Criando backups automáticos e credenciais..." "Creating automatic backups and credentials..."
    local db_pass ip
    db_pass=$(senha_banco)
    ip=$(ip_servidor)
    escrever_scripts_backup
    escrever_cron_tarefas

    cat > /root/credenciais_koha.txt << EOF
======================================================================
 CREDENCIAIS DO KOHA / KOHA CREDENTIALS  (instancia: ${INSTANCIA})
 Gerado em / Generated on: $(date '+%F %T')
======================================================================
 Staff (administracao) : http://${ip}:8080
 OPAC  (catalogo)      : http://${ip}:80

 Usuario / Username    : ${DB_NAME}
 Senha   / Password    : ${db_pass}

 Esta senha e a do banco de dados e serve para o primeiro acesso
 (Web Installer). Depois crie um superbibliotecario proprio
 (opcao 11 do painel) e guarde este arquivo em local seguro.

 Configuracao : ${KOHA_CONF}
 Backups      : ${DIR_SQL} e ${DIR_MARC}
 Painel       : sudo options.sh
======================================================================
EOF
    chmod 600 /root/credenciais_koha.txt

    configurar_firewall
    escrever_banner "$ip" "$DB_NAME"

    if [ -f "$0" ]; then
        install -m 755 "$0" /usr/local/bin/options.sh 2>/dev/null
    fi

    caixa_explicacao "Limpando arquivos temporários..." "Cleaning temporary files..."
    apt-get clean -y >/dev/null 2>&1
    DEBIAN_FRONTEND=noninteractive apt-get autoremove --purge -y >/dev/null 2>&1
    journalctl --vacuum-time=7d >/dev/null 2>&1
    restaurar_timers_apt

    clear
    validar_sistema_completo "instalação concluída"
    log "instalacao concluida (ok=$V_OK warn=$V_WARN fail=$V_FAIL)"

    msg_info "$(t "Instalação Concluída" "Installation Complete")" \
"$(t "INSTALAÇÃO CONCLUÍDA.\n\nACESSO:\n  Staff: http://${ip}:8080\n  OPAC:  http://${ip}:80\n\nCREDENCIAIS (também em /root/credenciais_koha.txt):\n  Usuário: ${DB_NAME}\n  Senha:   ${db_pass}\n\nPASSO FINAL: abra a URL do Staff no navegador e conclua o Web Installer.\nSe você já tem um backup antigo, pule o Web Installer e use a opção 3.\n\nValidação: OK=$V_OK  Avisos=$V_WARN  Falhas=$V_FAIL" \
"INSTALLATION COMPLETE.\n\nACCESS:\n  Staff: http://${ip}:8080\n  OPAC:  http://${ip}:80\n\nCREDENTIALS (also in /root/credenciais_koha.txt):\n  User: ${DB_NAME}\n  Pass: ${db_pass}\n\nFINAL STEP: open the Staff URL in your browser and finish the Web Installer.\nIf you already have a backup, skip it and use option 3.\n\nValidation: OK=$V_OK  Warnings=$V_WARN  Failures=$V_FAIL")" 24 78
}

definir_koha_sites_conf() {
    local f="/etc/koha/koha-sites.conf"
    [ -f "$f" ] || return 0
    cp -f "$f" "${f}.bak-$(date +%s)" 2>/dev/null
    set_conf() {
        local chave="$1" valor="$2"
        if grep -qE "^[[:space:]]*#?[[:space:]]*${chave}=" "$f"; then
            sed -i -E "s|^[[:space:]]*#?[[:space:]]*${chave}=.*|${chave}=\"${valor}\"|" "$f"
        else
            echo "${chave}=\"${valor}\"" >> "$f"
        fi
    }
    set_conf INTRAPORT 8080
    set_conf OPACPORT 80
    set_conf USE_MEMCACHED yes
    set_conf MEMCACHED_SERVERS "127.0.0.1:11211"
    set_conf MEMCACHED_PREFIX "koha_"
    set_conf ZEBRA_MARC_FORMAT marc21
    set_conf ZEBRA_LANGUAGE en
    if [ -f /etc/koha/koha-conf-site.xml.in ]; then
        sed -i 's/__MEMCACHED_SERVERS__/127.0.0.1:11211/g; s/__MEMCACHED_PREFIX__/koha_/g' /etc/koha/koha-conf-site.xml.in
    fi
}

escolher_fuso_horario() {
    local atual escolha
    atual=$(timedatectl show -p Timezone --value 2>/dev/null)
    escolha=$(whiptail --title "$(t "Fuso Horário" "Timezone")" \
        --cancel-button "$(t "Manter" "Keep")" \
        --menu "$(t "Atual:" "Current:") ${atual:-UTC}\n\n$(t "Escolha o fuso do servidor:" "Choose the server timezone:")" 20 72 9 \
        "America/Sao_Paulo"  "Brasil - Brasilia/SP/RJ/PR/SC/RS/MG" \
        "America/Manaus"     "Brasil - Amazonas / Mato Grosso" \
        "America/Belem"      "Brasil - Para / Amapa" \
        "America/Fortaleza"  "Brasil - Nordeste" \
        "America/Rio_Branco" "Brasil - Acre" \
        "Europe/Lisbon"      "Portugal" \
        "UTC"                "UTC" \
        "OUTRO"              "$(t "Outro (lista completa)" "Other (full list)")" 3>&1 1>&2 2>&3) || return 1
    [ -z "$escolha" ] && return 1
    if [ "$escolha" = "OUTRO" ]; then
        clear
        dpkg-reconfigure tzdata
        return 1
    fi
    printf '%s' "$escolha"
}

