# ======================================================================
# 13. SUPERBIBLIOTECÁRIO
# ======================================================================
funcao_criar_superbibliotecario() {
    exigir_banco || return 0
    local branch cat_ usuario senha nome sobrenome hash existe
    branch=$(sql "SELECT branchcode FROM ${DB_NAME}.branches LIMIT 1;")
    cat_=$(sql "SELECT categorycode FROM ${DB_NAME}.categories WHERE category_type='S' LIMIT 1;")
    [ -z "$cat_" ] && cat_=$(sql "SELECT categorycode FROM ${DB_NAME}.categories LIMIT 1;")
    if [ -z "$branch" ] || [ -z "$cat_" ]; then
        msg_erro "" "$(t "Ainda não existem bibliotecas ou categorias de usuário no banco.\nConclua o Web Installer primeiro." "There are no libraries or patron categories yet.\nFinish the Web Installer first.")" 10 74
        return 0
    fi
    usuario=$(whiptail --title "$(t "Usuário" "Username")" --inputbox "$(t "Nome de usuário (login):" "Username (login):")" 9 60 3>&1 1>&2 2>&3) || return 0
    [ -z "$usuario" ] && return 0
    if ! [[ "$usuario" =~ ^[A-Za-z0-9._-]+$ ]]; then
        msg_erro "" "$(t "Use apenas letras, números, ponto, hífen ou sublinhado." "Use only letters, numbers, dot, hyphen or underscore.")" 8 66
        return 0
    fi
    existe=$(sql "SELECT COUNT(*) FROM ${DB_NAME}.borrowers WHERE userid='${usuario}';")
    if [ "${existe:-0}" -gt 0 ] 2>/dev/null; then
        msg_erro "" "$(t "O usuário '$usuario' já existe.\nPara trocar a senha dele use a interface web do Koha." "User '$usuario' already exists.\nUse the Koha web interface to change its password.")" 9 70
        return 0
    fi

    local cardnumber existe_card
    cardnumber=$(whiptail --title "$(t "Número do Cartão" "Card Number")" --inputbox "$(t "Número do cartão (cardnumber) para $usuario:" "Card number for $usuario:")" 9 60 3>&1 1>&2 2>&3) || return 0
    [ -z "$cardnumber" ] && return 0

    existe_card=$(sql "SELECT COUNT(*) FROM ${DB_NAME}.borrowers WHERE cardnumber='${cardnumber}';")
    if [ "${existe_card:-0}" -gt 0 ] 2>/dev/null; then
        msg_erro "" "$(t "O número de cartão '$cardnumber' já está em uso por outro leitor. Tente novamente com outro número." "Card number '$cardnumber' is already in use by another patron. Try again with a different number.")" 10 74
        return 0
    fi

    senha=$(whiptail --title "$(t "Senha" "Password")" --passwordbox "$(t "Senha para $usuario (mínimo 8 caracteres):" "Password for $usuario (at least 8 characters):")" 9 64 3>&1 1>&2 2>&3) || return 0
    [ "${#senha}" -lt 8 ] && { msg_erro "" "$(t "Senha curta demais (mínimo 8 caracteres)." "Password too short (minimum 8 characters).")" 8 62; return 0; }
    local senha2
    senha2=$(whiptail --title "$(t "Confirmar Senha" "Confirm Password")" --passwordbox "$(t "Digite a senha de novo:" "Type the password again:")" 9 64 3>&1 1>&2 2>&3) || return 0
    [ "$senha" != "$senha2" ] && { msg_erro "" "$(t "As senhas não conferem." "Passwords do not match.")" 8 60; return 0; }
    nome=$(whiptail --title "$(t "Nome" "First name")" --inputbox "$(t "Nome:" "First name:")" 9 60 "Super" 3>&1 1>&2 2>&3) || return 0
    sobrenome=$(whiptail --title "$(t "Sobrenome" "Surname")" --inputbox "$(t "Sobrenome:" "Surname:")" 9 60 "Admin" 3>&1 1>&2 2>&3) || return 0
    clear
    caixa_explicacao "Gerando o hash da senha..." "Hashing the password..."
    cat > /tmp/koha_hash.pl << 'EOF'
use strict; use warnings;
use Koha::AuthUtils qw(hash_password);
my $pw = <STDIN>; chomp $pw;
print hash_password($pw);
EOF
    chmod 644 /tmp/koha_hash.pl
    hash=$(printf '%s\n' "$senha" | koha-shell "$INSTANCIA" -c "perl /tmp/koha_hash.pl" 2>/dev/null)
    rm -f /tmp/koha_hash.pl
    if [ -z "$hash" ]; then
        msg_erro "" "$(t "Falha ao gerar o hash da senha." "Failed to hash the password.")" 8 62
        return 1
    fi
    esc() { printf '%s' "${1//\'/\'\'}"; }
    if mysql --default-character-set=utf8mb4 "$DB_NAME" << SQLEOF 2>/dev/null
INSERT INTO borrowers (userid, cardnumber, password, surname, firstname, branchcode, categorycode, flags)
VALUES ('$(esc "$usuario")', '$(esc "$cardnumber")', '$(esc "$hash")', '$(esc "$sobrenome")', '$(esc "$nome")', '$(esc "$branch")', '$(esc "$cat_")', 1);
SQLEOF
    then
        log "superbibliotecario criado: $usuario (cardnumber: $cardnumber)"
        msg_ok "$(t "Superbibliotecário criado com sucesso.\n\nUsuário: $usuario\nCartão:  $cardnumber\n\nGuarde a senha: ela não fica salva em lugar nenhum." "Super Librarian created successfully.\n\nUser: $usuario\nCard: $cardnumber\n\nKeep the password safe: it is not stored anywhere.")" 12 70
    else
        msg_erro "" "$(t "Não foi possível criar o usuário. Ele já existe ou faltam campos obrigatórios nesta versão do Koha.\nCrie pela interface web e marque 'Superlibrarian'." "Could not create the user. It may already exist or this Koha version requires more fields.\nCreate it in the web interface and tick 'Superlibrarian'.")" 11 76
    fi
}

