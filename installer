validate_elasticsearch() {
    local e="$1" pend docs bibs
    if ! dpkg -s elasticsearch >/dev/null 2>&1 && ! dpkg -s koha-elasticsearch >/dev/null 2>&1; then
        [ "$e" = "Elasticsearch" ] \
            && v_fail "Elasticsearch: $(t "selecionado no Koha, mas o pacote não está instalado" "selected in Koha but package is missing")." \
            || v_warn "Elasticsearch: $(t "não instalado (ok, o motor atual é o Zebra)" "not installed (fine, current engine is Zebra)")."
        return 0
    fi

    if systemctl is-active --quiet elasticsearch; then
        v_ok "Elasticsearch: $(t "serviço ativo" "service active")."
    else
        [ "$e" = "Elasticsearch" ] \
            && v_fail "Elasticsearch: $(t "serviço INATIVO" "service INACTIVE")." \
            || v_warn "Elasticsearch: $(t "instalado, mas inativo" "installed but inactive")."
    fi

    if curl -sS --max-time 5 http://127.0.0.1:9200/ >/dev/null 2>&1; then
        v_ok "Elasticsearch: API 9200 $(t "respondeu" "responded")."
    elif [ "$e" = "Elasticsearch" ]; then
        v_fail "Elasticsearch: API 9200 $(t "sem resposta" "no response")."
    fi

    [ "$e" = "Elasticsearch" ] || return 0

    is_koha_es_active_in_xml \
        && v_ok "Koha: $(t "bloco <elasticsearch> presente no koha-conf.xml" "<elasticsearch> block present in koha-conf.xml")." \
        || v_fail "Koha: $(t "bloco <elasticsearch> AUSENTE (o indexador não sobe sem ele)" "<elasticsearch> block MISSING (the indexer will not start)")."

    curl -sS --max-time 5 "http://127.0.0.1:9200/_cat/indices/${DB_NAME}_*?format=json" 2>/dev/null | grep -q "${DB_NAME}_" \
        && v_ok "Elasticsearch: $(t "índices do Koha encontrados" "Koha indices found")." \
        || v_warn "Elasticsearch: $(t "índices do Koha não confirmados" "Koha indices unconfirmed")."

    if is_koha_indexer_running; then
        v_ok "Indexador: koha-es-indexer $(t "rodando" "running")."
    else
        v_fail "Indexador: koha-es-indexer $(t "PARADO - registros novos não entram na busca" "STOPPED - new records will not reach search")."
    fi

    [ -f /etc/systemd/system/koha-es-indexer@.service ] \
        && v_ok "Indexador: $(t "serviço systemd instalado (reinício automático)" "systemd unit installed (auto-restart)")." \
        || v_warn "Indexador: $(t "sem serviço systemd dedicado" "no dedicated systemd unit")."

    ss -lnt 2>/dev/null | grep -q ':61613' \
        && v_ok "Mensageria: RabbitMQ/STOMP (61613) OK." \
        || v_warn "Mensageria: $(t "sem RabbitMQ; o Koha lerá a fila direto do banco" "no RabbitMQ; Koha will read the queue straight from the database")."

    pend=$(get_pending_es_jobs)
    if [ "${pend:-0}" -eq 0 ] 2>/dev/null; then
        v_ok "Fila: $(t "nenhum job de indexação pendente" "no pending indexing jobs")."
    elif [ "${pend:-0}" -le 20 ] 2>/dev/null; then
        v_warn "Fila: $pend $(t "job(s) pendente(s)" "pending job(s)")."
    else
        v_fail "Fila: $pend $(t "jobs pendentes - o indexador não está consumindo" "pending jobs - the indexer is not consuming")."
    fi

    bibs=$(get_total_biblios); docs=$(get_total_es_documents)
    if [[ "$bibs" =~ ^[0-9]+$ ]] && [[ "$docs" =~ ^[0-9]+$ ]]; then
        if [ "$docs" -ge "$bibs" ]; then
            v_ok "Cobertura: $docs $(t "documentos para" "documents for") $bibs $(t "registros" "records")."
        else
            v_warn "Cobertura: $docs/$bibs ($(t "faltam" "missing") $((bibs-docs)))."
        fi
    fi
}

