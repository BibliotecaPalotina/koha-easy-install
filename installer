        log_backup "AVISO: RCLONE_REMOTE='\${RCLONE_REMOTE}' não existe no rclone.conf; upload pulado"
    elif /usr/bin/rclone --config /root/.config/rclone/rclone.conf copy "\$PACKAGE" "\${RCLONE_REMOTE}:\${RCLONE_MARC_FOLDER}/" >>"\$LOG" 2>&1; then
        log_backup "Nuvem OK: \${RCLONE_REMOTE}:\${RCLONE_MARC_FOLDER}/"
    else
        log_backup "AVISO: envio para a nuvem falhou"
    fi
fi

find "\$DIR" -name 'koha_marc_*.tar.gz' -mtime "+\${KEEP_DAYS}" -delete 2>/dev/null
exit 0
EOF

    chmod 700 /root/backup_sql.sh /root/backup_marc.sh
    chown root:root /root/backup_sql.sh /root/backup_marc.sh
}

write_cron_tasks() {
    local email_block=""
    if [ -f "$CRON_TASKS" ] && grep -q '^# BEGIN KOHA EMAIL NOTICES' "$CRON_TASKS"; then
        email_block=$(sed -n '/^# BEGIN KOHA EMAIL NOTICES$/,/^# END KOHA EMAIL NOTICES$/p' "$CRON_TASKS")
    fi

    cat > "$CRON_TASKS" << EOF
# ======================================================================
# KOHA EASY INSTALL & TOOLS - TAREFAS AUTOMÁTICAS / SCHEDULED TASKS
# ======================================================================
# [PT] Este arquivo controla as manutenções automáticas periódicas do Koha.
# [EN] This file controls Koha's periodic automated maintenance routines.
#
# Formato / Format:
# MIN HORA DIA_MES MES DIA_SEMANA(0=domingo) USUÁRIO COMANDO
# ======================================================================
$CRON_PATH
MAILTO=""

# [PT] Limpeza de logs do sistema antigos (mantém os últimos 14 dias) - Diário às 00:30
# [EN] System log cleanup (keeps last 14 days) - Daily at 00:30
30 0 * * * root /usr/bin/journalctl --vacuum-time=14d >/dev/null 2>&1

# [PT] Verificação preventiva de integridade das tabelas do banco - Dia 5 de cada mês à 01:00
# [EN] Database table integrity check - 5th day of every month at 01:00
0 1 5 * * root /usr/bin/mysqlcheck --check --databases ${DB_NAME} >/dev/null 2>&1

# [PT] Reinicialização do acelerador Plack para liberar memória acumulada - Diário às 05:00
# [EN] Plack accelerator restart to flush accumulated memory - Daily at 05:00
0 5 * * * root /usr/sbin/koha-plack --restart ${INSTANCE} >/dev/null 2>&1

# [PT] Backup completo do banco de dados (SQL comprimido) - Diário às 23:00
# [EN] Full database backup (compressed SQL) - Daily at 23:00
0 23 * * * root /bin/bash /root/backup_sql.sh >/dev/null 2>&1

# [PT] Backup dos registros bibliográficos e autoridades em MARC21 - Domingos às 03:00
# [EN] MARC21 bibliographic and authority records backup - Sundays at 03:00
0 3 * * 0 root /bin/bash /root/backup_marc.sh >/dev/null 2>&1

# [PT] Limpeza de sessões inativas e fila do Zebra - Diário às 01:30
# [EN] Clear old user sessions and Zebra queue - Daily at 01:30
30 1 * * * root /usr/sbin/koha-shell ${INSTANCE} -c "/usr/share/koha/bin/cronjobs/cleanup_database.pl --sessions --sessdays 2 --zebraqueue 10" >/dev/null 2>&1
EOF

    if [ -n "$email_block" ]; then
        printf '%s\n' "$email_block" >> "$CRON_TASKS"
    else
        cat >> "$CRON_TASKS" << EOF

# BEGIN KOHA EMAIL NOTICES
# [PT] Processa regras de atraso e gera notificações aos leitores - Diário às 08:00
# [EN] Triggers overdue rules and generates patron notices - Daily at 08:00
0 8 * * * root /usr/sbin/koha-shell ${INSTANCE} -c "/usr/share/koha/bin/cronjobs/overdue_notices.pl -v -t" >/dev/null 2>&1

# [PT] Dispara os e-mails pendentes na fila de saída - Diário às 08:05
# [EN] Dispatches pending emails from message queue - Daily at 08:05
5 8 * * * root /usr/sbin/koha-shell ${INSTANCE} -c "/usr/share/koha/bin/cronjobs/process_message_queue.pl -v" >/dev/null 2>&1
# END KOHA EMAIL NOTICES
EOF
    fi

    chmod 644 "$CRON_TASKS"
    chown root:root "$CRON_TASKS"
    systemctl restart cron >/dev/null 2>&1
}

