funcao_configurar_cloudflare() {
    msg_info "Cloudflare Tunnel" \
"$(t "Publica o Koha na internet sem abrir portas no roteador.\n\n1. Entre em one.dash.cloudflare.com (Zero Trust)\n2. Networks > Tunnels > Create a tunnel\n3. Escolha Debian 64-bit e copie o comando gerado\n\nNa próxima tela cole o comando inteiro ou só o token." \
"Publishes Koha on the internet without opening router ports.\n\n1. Go to one.dash.cloudflare.com (Zero Trust)\n2. Networks > Tunnels > Create a tunnel\n3. Pick Debian 64-bit and copy the generated command\n\nOn the next screen paste the whole command or just the token.")" 16 76

    local entrada token
    entrada=$(whiptail --title "Token Cloudflare" --inputbox "$(t "Cole aqui:" "Paste here:")" 10 76 3>&1 1>&2 2>&3) || return 0
    [ -z "$entrada" ] && return 0
    token=$(printf '%s' "$entrada" | grep -oE 'ey[A-Za-z0-9_-]{40,}' | head -n1)
    if [ -z "$token" ]; then
        msg_erro "" "$(t "Não encontrei um token válido (deve começar com 'ey')." "No valid token found (it must start with 'ey').")" 9 70
        return 0
    fi

    clear
    caixa_explicacao "Instalando o cloudflared..." "Installing cloudflared..."
    if ! command -v cloudflared >/dev/null 2>&1; then
        mkdir -p /etc/apt/keyrings && chmod 0755 /etc/apt/keyrings
        curl -fsSL https://pkg.cloudflare.com/cloudflare-main.gpg -o /etc/apt/keyrings/cloudflare-main.gpg || {
            msg_erro "" "$(t "Falha ao baixar a chave da Cloudflare." "Failed to download the Cloudflare key.")" 8 66; return 1; }
        echo "deb [signed-by=/etc/apt/keyrings/cloudflare-main.gpg] https://pkg.cloudflare.com/cloudflared any main" > /etc/apt/sources.list.d/cloudflared.list
        apt_atualizar_indices
        apt_instalar cloudflared || return 1
    fi

    cloudflared service uninstall >/dev/null 2>&1
    if cloudflared service install "$token"; then
        systemctl enable --now cloudflared >/dev/null 2>&1
        sleep 3
        if systemctl is-active --quiet cloudflared; then
            msg_ok "$(t "Túnel ativo.\n\nAgora no painel da Cloudflare crie os Public Hostnames:\n  catalogo.seudominio  ->  http://127.0.0.1:80   (OPAC)\n  admin.seudominio     ->  http://127.0.0.1:8080 (Staff)" "Tunnel is up.\n\nNow create the Public Hostnames in the Cloudflare dashboard:\n  catalog.yourdomain ->  http://127.0.0.1:80   (OPAC)\n  admin.yourdomain   ->  http://127.0.0.1:8080 (Staff)")" 13 78
        else
            msg_erro "" "$(t "O serviço não ficou ativo. Veja: journalctl -u cloudflared -n 30" "The service is not active. Check: journalctl -u cloudflared -n 30")" 9 74
        fi
    else
        msg_erro "" "$(t "Falha ao instalar o serviço do túnel." "Failed to install the tunnel service.")" 8 66
    fi
}

