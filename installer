ES_REBUILD_LOCK_FILE="/var/lock/koha_es_rebuild.lock"
ES_REBUILD_MARKER="/run/koha-easy-install/es-rebuild.in-progress"

rebuild_koha_elasticsearch() {
    local cut_time="${1:-$(date '+%Y-%m-%d %H:%M:%S')}"
    local rc
    mkdir -p "$(dirname "$ES_REBUILD_MARKER")" || return 1

    (
        exec 7>"$ES_REBUILD_LOCK_FILE"
        chmod 600 "$ES_REBUILD_LOCK_FILE" 2>/dev/null || true
        if ! flock -n 7; then
            log "Rebuild Elasticsearch ignorado: outro rebuild já está em execução."
            exit 75
        fi
        printf '%s\n' "${BASHPID:-$$}" > "$ES_REBUILD_MARKER" || exit 1
        trap 'rm -f "$ES_REBUILD_MARKER"' EXIT HUP INT TERM
        if ! command -v koha-elasticsearch >/dev/null 2>&1; then
            log "koha-elasticsearch não encontrado."
            exit 1
        fi
        koha-elasticsearch --rebuild -d "$INSTANCE"
    )
    rc=$?

    if [ "$rc" -eq 0 ]; then
        clear_orphan_jobs "$cut_time"
    elif [ "$rc" -eq 75 ]; then
        msg_info "$(t "Reindexação já em andamento" "Reindex already running")" \
            "$(t "Outro processo já está reconstruindo o índice Elasticsearch. Aguarde a conclusão." "Another process is already rebuilding the Elasticsearch index. Wait for it to finish.")" 9 72
    fi
    return "$rc"
}

