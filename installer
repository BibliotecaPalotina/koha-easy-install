        "6" "$(t "Links oficiais do Google" "Official Google links")" \
        "7" "$(t "Voltar" "Back")" 3>&1 1>&2 2>&3) || return 0

    case "$choice" in
        1)
            msg_info "$(t "GOOGLE SEARCH CONSOLE" "GOOGLE SEARCH CONSOLE")" \
                "$(t "Abra no computador:\nhttps://search.google.com/search-console\n\nDepois adicione a propriedade correspondente ao endereço público do OPAC:\n$opac_url" "Open on your computer:\nhttps://search.google.com/search-console\n\nThen add the property corresponding to the public OPAC address:\n$opac_url")" 16 84
            ;;
        2)
            msg_info "$(t "VERIFICAÇÃO DA PROPRIEDADE — FAÇA MANUALMENTE" "PROPERTY VERIFICATION — DO THIS MANUALLY")" \
                "$(t "1. Abra:\nhttps://search.google.com/search-console\n\n2. Clique em 'Adicionar propriedade'.\n\n3. Escolha 'Prefixo do URL'.\n\n4. Cole exatamente:\n$opac_url\n\n5. O Google mostrará os métodos disponíveis para verificar a propriedade.\nUma opção é a verificação por DNS, realizada no provedor do domínio.\nOutra opção é utilizar arquivo HTML ou meta tag, quando disponível.\n\nIMPORTANTE:\nSe o domínio for da prefeitura ou de outra instituição, a alteração de DNS poderá precisar ser feita pelo responsável de TI.\nO painel não precisa da sua senha Google." "1. Open:\nhttps://search.google.com/search-console\n\n2. Click 'Add property'.\n\n3. Choose 'URL prefix'.\n\n4. Paste exactly:\n$opac_url\n\n5. Google will show the available verification methods.\nOne option is DNS verification, performed at the domain provider.\nAnother option is HTML file or meta tag verification, when available.\n\nIMPORTANT:\nIf the domain belongs to a municipality or another institution, DNS changes may need to be performed by the IT administrator.\nThe panel does not need your Google password.")" 27 92
            ;;
