# ======================================================================
# 22. ATUALIZAR O PRÓPRIO PAINEL
# ======================================================================
funcao_autoatualizar() {
    perguntar "$(t "Atualizar o Painel" "Update the Panel")" \
"$(t "Baixa a versão mais recente deste painel do GitHub, confere se\no arquivo é um script válido e só então substitui o atual.\nUma cópia da versão atual é guardada antes.\n\nVersão instalada: ${VERSAO_PAINEL}\n\nContinuar?" \
"Downloads the latest version of this panel from GitHub, checks that\nthe file is a valid script and only then replaces the current one.\nA copy of the current version is kept first.\n\nInstalled version: ${VERSAO_PAINEL}\n\nContinue?")" 15 78 || return 0
    clear
    caixa_explicacao "Baixando a nova versão..." "Downloading the new version..."
    local destino="/usr/local/bin/options.sh"
    local dir_destino; dir_destino=$(dirname "$destino")
    local tmp; tmp="$(mktemp "${dir_destino}/.options.sh.update.XXXXXX")" || {
        msg_erro "" "$(t "Não consegui criar um arquivo temporário no mesmo diretório do painel." "Could not create a temporary file in the panel directory.")" 9 76
        return 1
    }
    if ! curl -fsSL --retry 3 --retry-delay 2 --connect-timeout 10 --max-time 120 "$URL_ATUALIZACAO" -o "$tmp"; then
        rm -f "$tmp"
        msg_erro "" "$(t "Não foi possível baixar. O painel atual continua funcionando." "Download failed. The current panel keeps working.")" 9 72
        return 1
    fi
    local tam; tam=$(stat -c %s "$tmp" 2>/dev/null || echo 0)
    if [ "$tam" -lt 10240 ] || ! head -n1 "$tmp" | grep -q '^#!.*bash' || \
       ! grep -q 'KOHA EASY INSTALL' "$tmp" || ! grep -q '"25"' "$tmp"; then
        rm -f "$tmp"
        msg_erro "" "$(t "O arquivo baixado está incompleto, não parece ser o painel correto ou está inválido ($tam bytes). Atualização cancelada." "The downloaded file is incomplete, not the expected panel, or invalid ($tam bytes). Update cancelled.")" 11 78
        return 1
    fi
    if ! bash -n "$tmp" 2>/dev/null; then
        rm -f "$tmp"
        msg_erro "" "$(t "O arquivo baixado tem erro de sintaxe. Atualização cancelada para não quebrar o painel." "The downloaded file has a syntax error. Update cancelled to avoid breaking the panel.")" 10 76
        return 1
    fi

    chmod 755 "$tmp"
    local backup="${destino}.bak-$(date +%Y%m%d-%H%M%S)"
    if [ -f "$destino" ]; then
        if ! cp -p "$destino" "$backup"; then
            rm -f "$tmp"
            msg_erro "" "$(t "Não consegui criar a cópia de segurança do painel atual. Atualização cancelada." "Could not create a backup of the current panel. Update cancelled.")" 10 76
            return 1
        fi
    fi

    if mv -f "$tmp" "$destino" && chmod 755 "$destino" && chown root:root "$destino"; then
        log "painel atualizado a partir de $URL_ATUALIZACAO; backup=$backup"
        msg_ok "$(t "Painel atualizado com sucesso!\n\nBackup da versão anterior:\n${backup}\n\nFeche e abra de novo com: sudo options.sh" "Panel updated successfully!\n\nBackup of previous version:\n${backup}\n\nClose and reopen with: sudo options.sh")" 12 76
        rm -f "$PANEL_LOCK_FILE"
        exit 0
    fi

    rm -f "$tmp"
    if [ -f "$backup" ]; then
        cp -p "$backup" "$destino" 2>/dev/null || true
    fi
    msg_erro "" "$(t "Falha ao substituir $destino. Tente novamente; a versão anterior foi preservada." "Failed to replace $destino. Try again; the previous version was preserved.")" 10 76
    return 1
}

