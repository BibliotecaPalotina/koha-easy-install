# MOTOR DE BUSCA: XML, INDEXADOR E MENSAGERIA
# ======================================================================
xml_editar() {
    # $1 = ação, $2 = tag, $3 = conteúdo interno (para inserir)
    python3 - "$1" "$2" "$KOHA_CONF" "${3:-}" << 'PYEOF'
import re, sys, os, tempfile

acao, tag, path, corpo = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]

with open(path, "r", encoding="utf-8") as f:
    texto = f.read()

# Preserva blocos comentados: só mexe fora de <!-- -->
partes = re.split(r"(<!--.*?-->)", texto, flags=re.DOTALL)
padrao = re.compile(r"[ \t]*<%s>.*?</%s>[ \t]*\n?" % (tag, tag), re.DOTALL)
for i, p in enumerate(partes):
    if not p.startswith("<!--"):
        partes[i] = padrao.sub("", p)
texto = "".join(partes)

if acao == "inserir":
    if "</config>" not in texto:
        sys.exit("ERRO: </config> nao encontrado em koha-conf.xml")
    texto = texto.replace("</config>", corpo + "</config>", 1)

# Escrita atômica preservando dono e permissões do original
st = os.stat(path)
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path))
with os.fdopen(fd, "w", encoding="utf-8") as f:
    f.write(texto)
os.chown(tmp, st.st_uid, st.st_gid)
os.chmod(tmp, st.st_mode)
os.replace(tmp, path)
PYEOF
}

xml_set_elasticsearch() {
    local corpo=""
    [ -f "$KOHA_CONF" ] || return 1
    if [ "$1" = "inserir" ]; then
        corpo=$(printf '  <elasticsearch>\n    <server>127.0.0.1:9200</server>\n    <index_name>%s</index_name>\n  </elasticsearch>\n' "${DB_NAME}")
    fi
    xml_editar "$1" "elasticsearch" "$corpo" || return 1
    if command -v xmllint >/dev/null 2>&1 && ! xmllint --noout "$KOHA_CONF" >/dev/null 2>&1; then
        msg_erro "" "$(t "A edição do koha-conf.xml gerou um XML inválido. Restaure pelo backup automático do Koha." "Editing koha-conf.xml produced invalid XML. Restore from Koha's own backup.")" 10 74
        return 1
    fi
    return 0
}

koha_es_ativo_no_xml() {
    [ -f "$KOHA_CONF" ] || return 1
    if command -v xmllint >/dev/null 2>&1; then
        local n
        n=$(xmllint --xpath 'count(/config/elasticsearch)' "$KOHA_CONF" 2>/dev/null || echo 0)
        [ "$n" = "1" ] && return 0
        return 1
    fi
    # Fallback somente se xmllint não estiver disponível.
    grep -qE '^[[:space:]]*<elasticsearch>[[:space:]]*$' "$KOHA_CONF" 2>/dev/null
}

