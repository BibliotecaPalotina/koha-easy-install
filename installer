function_configure_cloudflare() {
    msg_info "$(t "Passo 1: Domínio e Nameservers" "Step 1: Domain & Nameservers")" \
"$(t "COMO ASSOCIAR SEU DOMÍNIO À CLOUDFLARE:\n\n1. OBTENHA UM DOMÍNIO GRATUITO:\n   - Digital Plat (rápido/automático): https://domain.digitalplat.org/\n   - nic.eu.org (manual, demora de 14 a 45 dias): https://nic.eu.org\n   - Ou solicite à TI um CNAME oficial (ex: catalogo.palotina.pr.gov.br)\n\n2. ADICIONE NA CLOUDFLARE (dash.cloudflare.com):\n   - Clique em 'Add a site/domain', digite o domínio e selecione Free.\n   - A Cloudflare exibirá DOIS Nameservers (ex: vera.ns.cloudflare.com\n     e rob.ns.cloudflare.com). Copie os dois.\n\n3. ATUALIZE ONDE REGISTROU O DOMÍNIO:\n   - No Digital Plat ou nic.eu.org, vá em DNS / Nameservers.\n   - Substitua os servidores existentes pelos DOIS da Cloudflare.\n   - Na Cloudflare, clique em 'Check nameservers' até o status ficar Ativo." \
"HOW TO LINK YOUR DOMAIN TO CLOUDFLARE:\n\n1. GET A FREE DOMAIN:\n   - Digital Plat (fast/automated): https://domain.digitalplat.org/\n   - nic.eu.org (manual, takes 14 to 45 days): https://nic.eu.org\n   - Or ask local IT for an official CNAME (e.g. catalog.city.gov.br)\n\n2. ADD TO CLOUDFLARE (dash.cloudflare.com):\n   - Click 'Add a site/domain', type your domain and select Free.\n   - Cloudflare provides TWO Nameservers (e.g. vera.ns.cloudflare.com\n     and rob.ns.cloudflare.com). Copy both.\n\n3. UPDATE AT YOUR DOMAIN REGISTRAR:\n   - In Digital Plat or nic.eu.org, go to DNS / Nameservers settings.\n   - Replace existing servers with the TWO from Cloudflare.\n   - In Cloudflare, click 'Check nameservers' until status is Active.")" 22 78
    msg_info "Cloudflare Tunnel" \
"$(t "Publica o Koha na internet sem abrir portas no roteador.\n\n1. Acesse: one.dash.cloudflare.com (Zero Trust)\n2. Networks > Tunnels > Create a tunnel > Escolha 'Debian 64-bit'\n\n3. ATENÇÃO NA TELA DA CLOUDFLARE:\n   - Ignore o primeiro bloco de comandos (instalação).\n   - Copie o comando do 2º bloco ('sudo cloudflared service install...')\n     ou do 3º bloco ('cloudflared tunnel run...').\n\nNa próxima tela, cole o comando copiado (ou apenas a chave 'ey...')." \
"Publishes Koha on the internet without opening router ports.\n\n1. Go to: one.dash.cloudflare.com (Zero Trust)\n2. Networks > Tunnels > Create a tunnel > Choose 'Debian 64-bit'\n\n3. ATTENTION ON CLOUDFLARE SCREEN:\n   - Ignore the 1st command block (installation commands).\n   - Copy the command from the 2nd block ('sudo cloudflared service install...')\n     or the 3rd block ('cloudflared tunnel run...').\n\nOn the next screen, paste the copied command (or just the 'ey...' token).")" 18 78
    local input token
    input=$(whiptail --title "Token Cloudflare" --inputbox "$(t "Cole aqui:" "Paste here:")" 10 76 3>&1 1>&2 2>&3) || return 0
    [ -z "$input" ] && return 0
    token=$(printf '%s' "$input" | grep -oE 'ey[A-Za-z0-9_-]{40,}' | head -n1)
    if [ -z "$token" ]; then
        msg_error "" "$(t "Não encontrei um token válido (deve começar com 'ey')." "No valid token found (it must start with 'ey').")" 9 70
        return 0
    fi
    clear
    display_explanation "Instalando o cloudflared..." "Installing cloudflared..."
    if ! command -v cloudflared >/dev/null 2>&1; then
        if ! wait_for_apt_locks; then return 1; fi
        mkdir -p /etc/apt/keyrings && chmod 0755 /etc/apt/keyrings
        if ! curl -fsSL --retry 3 --max-time 60 https://pkg.cloudflare.com/cloudflare-main.gpg -o /etc/apt/keyrings/cloudflare-main.gpg; then
            restore_apt_timers
            msg_error "" "$(t "Falha ao baixar a chave da Cloudflare." "Failed to download the Cloudflare key.")" 8 66
            return 1
        fi
        echo "deb [signed-by=/etc/apt/keyrings/cloudflare-main.gpg] https://pkg.cloudflare.com/cloudflared any main" > /etc/apt/sources.list.d/cloudflared.list
        apt_update_indices
        if ! apt_install cloudflared; then
            restore_apt_timers
            return 1
        fi
        restore_apt_timers
    fi
    cloudflared service uninstall >/dev/null 2>&1
    if cloudflared service install "$token"; then
        systemctl enable --now cloudflared >/dev/null 2>&1
        sleep 3
        if systemctl is-active --quiet cloudflared; then
            msg_ok "$(t "TÚNEL ATIVO! PASSO FINAL NO ZERO TRUST:\n\n1. No túnel, vá em 'Public Hostnames' > 'Add a public hostname'.\n\n   IMPORTANTE: Use sempre 'localhost' (ou 127.0.0.1).\n   NUNCA use o IP da rede local (ex: 192.168.x.x), pois se o IP do\n   servidor mudar via DHCP, o túnel vai quebrar!\n\n   PARA O CATÁLOGO PÚBLICO (OPAC):\n   - Subdomain: catalogo   | Domain: selecione o seu domínio\n   - Type: HTTP            | URL: localhost:80 (ou 127.0.0.1:80)\n\n   PARA A ADMINISTRAÇÃO (STAFF):\n   - Subdomain: admin      | Domain: selecione o seu domínio\n   - Type: HTTP            | URL: localhost:8080 (ou 127.0.0.1:8080)\n\n2. GOOGLE SEARCH CONSOLE:\n   - Adicione via 'Prefixo do URL': https://catalogo.seudominio\n   - Pegue a 'Tag HTML' (<meta ...>) e cole em:\n     Koha Staff > Administração > Preferências > opacheader\n   - Envie o sitemap: sitemap.xml" \
"TUNNEL ACTIVE! FINAL STEP IN ZERO TRUST:\n\n1. In your tunnel, go to 'Public Hostnames' > 'Add a public hostname'.\n\n   IMPORTANT: Always use 'localhost' (or 127.0.0.1).\n   NEVER use local LAN IP (e.g. 192.168.x.x). If DHCP changes the\n   server IP, the tunnel will immediately break!\n\n   FOR OPAC (PUBLIC CATALOG):\n   - Subdomain: catalog    | Domain: select your domain\n   - Type: HTTP            | URL: localhost:80 (or 127.0.0.1:80)\n\n   FOR STAFF (ADMIN):\n   - Subdomain: admin      | Domain: select your domain\n   - Type: HTTP            | URL: localhost:8080 (or 127.0.0.1:8080)\n\n2. GOOGLE SEARCH CONSOLE:\n   - Add property via 'URL prefix': https://catalog.yourdomain\n   - Copy 'HTML Tag' (<meta ...>) and paste into:\n     Koha Staff > Administration > Preferences > opacheader\n   - Submit sitemap: sitemap.xml")" 26 80
        else
            msg_error "" "$(t "O serviço não ficou ativo. Veja: journalctl -u cloudflared -n 30" "The service is not active. Check: journalctl -u cloudflared -n 30")" 9 74
        fi
    else
        msg_error "" "$(t "Falha ao instalar o serviço do túnel." "Failed to install the tunnel service.")" 8 66
    fi
}

# ======================================================================
# 17. CERTIFICADO SSL / SSL CERTIFICATE
# ======================================================================
function_configure_ssl() {
    prompt_yes_no "SSL / HTTPS" \
"$(t "Para gerar o certificado gratuito você PRECISA de um domínio\napontando (registro A) para o IP PÚBLICO deste servidor, e a\nporta 80 aberta na internet.\n\nSe você usa Cloudflare Tunnel, CANCELE: o HTTPS já vem de lá.\n\nContinuar?" \
"To issue the free certificate you NEED a domain with an A record\npointing to this server's PUBLIC IP, and port 80 reachable.\n\nIf you use Cloudflare Tunnel, CANCEL: HTTPS already comes from it.\n\nContinue?")" 15 76 || return 0
    clear
    if ! wait_for_apt_locks; then return 1; fi
    apt_update_indices
    if ! apt_install certbot python3-certbot-apache; then
        restore_apt_timers
        return 1
    fi
    restore_apt_timers
    if ! certbot --apache; then
        msg_error "" "$(t "O Certbot não conseguiu concluir a emissão/configuração do certificado. O Apache não será recarregado automaticamente." "Certbot could not complete certificate issuance/configuration. Apache will not be reloaded automatically.")" 10 78
        return 1
    fi
    if ! apachectl configtest; then
        msg_error "" "$(t "O Apache ficou com configuração inválida após o Certbot. Não vou recarregar o serviço." "Apache configuration is invalid after Certbot. The service will not be reloaded.")" 10 76
        return 1
    fi
    if ! systemctl reload apache2 >/dev/null 2>&1; then
        msg_error "" "$(t "O certificado foi configurado, mas o Apache não aceitou o reload. Verifique o status do serviço." "The certificate was configured, but Apache rejected the reload. Check the service status.")" 10 76
        return 1
    fi
    msg_ok "$(t "HTTPS configurado com sucesso. O Certbot manterá a renovação automática." "HTTPS configured successfully. Certbot will handle automatic renewal.")" 9 72
}

# ======================================================================
# 18. INTEROPERABILIDADE / INTEROPERABILITY (SIP2 / Z39.50)
# ======================================================================
function_interoperability() {
    require_koha || return 0
    prompt_yes_no "SIP2 & Z39.50" \
"$(t "Z39.50 (porta 2100): permite que outras bibliotecas busquem no seu acervo.\nSIP2 (porta 6001): permite ligar totens de autoatendimento.\n\nAtivar os dois e liberar as portas no firewall?" \
"Z39.50 (port 2100): lets other libraries search your catalog.\nSIP2 (port 6001): lets you connect self-checkout terminals.\n\nEnable both and open the firewall ports?")" 13 78 || return 0
    clear
    ufw allow 2100/tcp >/dev/null 2>&1 || true
    ufw allow 6001/tcp >/dev/null 2>&1 || true

    koha-z3950-responder --enable "$INSTANCE" >/dev/null 2>&1 || true
    koha-sip --enable "$INSTANCE" >/dev/null 2>&1 || true
    systemctl daemon-reload >/dev/null 2>&1 || true

    local z39_ok="nao" sip_ok="nao"
    if systemctl enable --now "koha-z3950-responder@${INSTANCE}" >/dev/null 2>&1 || systemctl is-active --quiet "koha-z3950-responder@${INSTANCE}"; then
        z39_ok="sim"
    fi
    if systemctl enable --now "koha-sip-daemon@${INSTANCE}" >/dev/null 2>&1 || systemctl is-active --quiet "koha-sip-daemon@${INSTANCE}"; then
        sip_ok="sim"
    fi

    if [ "$z39_ok" = "sim" ] && [ "$sip_ok" = "sim" ]; then
        msg_ok "$(t "Z39.50 e SIP2 foram ativados com sucesso!\n\nPara o SIP2 funcionar ainda é preciso criar uma conta com\npermissão de circulação e preencher:\n/etc/koha/sites/${INSTANCE}/SIPconfig.xml" "Z39.50 and SIP2 were enabled successfully!\n\nFor SIP2 you still need a circulation account and\nto fill in:\n/etc/koha/sites/${INSTANCE}/SIPconfig.xml")" 12 76
    else
        msg_error "" "$(t "A ativação foi parcial.\n\nZ39.50: ${z39_ok}\nSIP2:    ${sip_ok}\n\nVeja os serviços com: systemctl status koha-z3950-responder@${INSTANCE} koha-sip-daemon@${INSTANCE}" "Activation was partial.\n\nZ39.50: ${z39_ok}\nSIP2:    ${sip_ok}\n\nCheck: systemctl status koha-z3950-responder@${INSTANCE} koha-sip-daemon@${INSTANCE}")" 12 78
        return 1
    fi
}

# ======================================================================
# 19. RELÓGIO E FUSO HORÁRIO / CLOCK AND TIMEZONE
# ======================================================================
function_configure_clock() {
    local tz
    tz=$(choose_timezone) || { systemctl restart cron >/dev/null 2>&1; return 0; }
    [ -n "$tz" ] && timedatectl set-timezone "$tz" >/dev/null 2>&1
    systemctl enable --now systemd-timesyncd >/dev/null 2>&1
    systemctl restart cron >/dev/null 2>&1
    msg_ok "$(t "Fuso ajustado para: $(timedatectl show -p Timezone --value)\nHora atual: $(date '+%d/%m/%Y %H:%M')\n\nO cron foi reiniciado para pegar o novo horário." "Timezone set to: $(timedatectl show -p Timezone --value)\nCurrent time: $(date '+%Y-%m-%d %H:%M')\n\nCron was restarted to pick up the new time.")" 11 74
}

# ======================================================================
# 20. CENTRAL DE SEGURANÇA / SECURITY CENTER
# ======================================================================
function_security_center() {
    local opc jail info new_pass
    while true; do
        opc=$(whiptail --title "$(t "Central de Segurança" "Security Center")" \
            --cancel-button "$(t "Voltar" "Back")" \
            --menu "$(t "Escolha uma ação:" "Choose an action:")" 16 76 4 \
            "1" "$(t "Status do Fail2ban (tentativas de invasão)" "Fail2ban status (intrusion attempts)")" \
            "2" "$(t "Firewall do Staff (porta 8080)" "Staff firewall (port 8080)")" \
            "3" "$(t "Rotacionar a senha do banco" "Rotate the database password")" \
            "4" "$(t "Ver regras do firewall" "Show firewall rules")" 3>&1 1>&2 2>&3) || return 0
        [ -z "$opc" ] && return 0
        case "$opc" in
            1)
                info=""
                for jail in sshd apache-auth apache-badbots; do
                    info="${info}=== ${jail} ===\n$(fail2ban-client status "$jail" 2>/dev/null || echo "$(t "jail inativa" "jail inactive")")\n\n"
                done
                whiptail --title "Fail2ban" --scrolltext --msgbox "$(printf '%b' "$info")" 24 78 2>/dev/null || true
                ;;
            2)
                if prompt_yes_no "$(t "Firewall do Staff" "Staff firewall")" \
"$(t "A porta 80 (OPAC) deve ficar aberta para o público.\nA porta 8080 (administração) pode ser fechada para a internet\nse você usa Cloudflare Tunnel ou só acessa pela rede local.\n\nBLOQUEAR o acesso externo direto à 8080?" \
"Port 80 (OPAC) must stay open to the public.\nPort 8080 (staff) can be closed to the internet if you use\nCloudflare Tunnel or only access it from the local network.\n\nBLOCK direct external access to 8080?")" 14 78; then
                    ufw delete allow 8080/tcp >/dev/null 2>&1
                    ufw allow from 127.0.0.1 to any port 8080 >/dev/null 2>&1
                    ufw allow from 192.168.0.0/16 to any port 8080 >/dev/null 2>&1
                    ufw allow from 10.0.0.0/8 to any port 8080 >/dev/null 2>&1
                    ufw deny 8080/tcp >/dev/null 2>&1
                    msg_ok "$(t "Porta 8080 liberada só para 127.0.0.1 e rede local." "Port 8080 now allowed only from 127.0.0.1 and the local network.")" 9 72
                else
                    ufw delete deny 8080/tcp >/dev/null 2>&1
                    ufw allow 8080/tcp >/dev/null 2>&1
                    msg_ok "$(t "Porta 8080 aberta." "Port 8080 is open.")" 8 60
                fi
                ;;
            3)
                require_koha || continue
                prompt_yes_no "$(t "Rotacionar Senha" "Rotate Password")" \
"$(t "Vou gerar uma senha nova e forte para o usuário do banco,\natualizar o koha-conf.xml e reiniciar os serviços.\n\nContinuar?" \
"A new strong password will be generated for the database user,\nkoha-conf.xml updated and services restarted.\n\nContinue?")" 12 74 || continue
                clear
                new_pass=$(tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 24)
                local xml_bak="${KOHA_CONF}.bak-$(date +%s)"
                cp -f "$KOHA_CONF" "$xml_bak" || {
                    msg_error "" "$(t "Não consegui criar o backup do koha-conf.xml. A senha não foi alterada." "Could not back up koha-conf.xml. Password was not changed.")" 9 74
                    continue
                }
                if mysql -e "ALTER USER '${DB_NAME}'@'localhost' IDENTIFIED BY '${new_pass}'; FLUSH PRIVILEGES;"; then
                    sed -i "s|<pass>[^<]*</pass>|<pass>${new_pass}</pass>|g" "$KOHA_CONF"
                    if ! xmllint --noout "$KOHA_CONF" >/dev/null 2>&1; then
                        cp -f "$xml_bak" "$KOHA_CONF"
                        mysql -e "ALTER USER '${DB_NAME}'@'localhost' IDENTIFIED BY '$(get_database_password)'; FLUSH PRIVILEGES;" >/dev/null 2>&1 || true
                        msg_error "" "$(t "A nova senha foi desfeita porque o koha-conf.xml ficou inválido.\nNada foi reiniciado." "The new password was rolled back because koha-conf.xml became invalid.\nNothing was restarted.")" 11 76
                        continue
                    fi
                    sed -i "s|Senha   / Password    : .*|Senha   / Password    : ${new_pass}|" /root/credenciais_koha.txt 2>/dev/null
                    systemctl restart memcached koha-common >/dev/null 2>&1
                    koha-plack --restart "$INSTANCE" >/dev/null 2>&1
                    sleep 2
                    if validate_http "http://127.0.0.1:8080/" "Staff" >/dev/null 2>&1; then
                        log "senha do banco rotacionada"
                        msg_ok "$(t "Senha rotacionada e o Koha continua respondendo.\n\nNova senha: ${new_pass}\n(salva em /root/credenciais_koha.txt)" "Password rotated and Koha still responds.\n\nNew password: ${new_pass}\n(saved in /root/credenciais_koha.txt)")" 12 74
                    else
                        msg_error "" "$(t "A senha mudou, mas o Koha não respondeu no teste.\nCópia do XML anterior em ${KOHA_CONF}.bak-*" "Password changed but Koha did not answer the test.\nPrevious XML copy at ${KOHA_CONF}.bak-*")" 11 76
                    fi
                else
                    msg_error "" "$(t "Falha ao alterar a senha no MariaDB. Nada foi mudado." "Failed to change the password in MariaDB. Nothing was changed.")" 9 72
                fi
                ;;
            4)
                whiptail --title "UFW" --scrolltext --msgbox "$(ufw status verbose 2>/dev/null || echo 'ufw?')" 24 78 2>/dev/null || true
                ;;
        esac
    done
}

# ======================================================================
# 21. ATUALIZAR SISTEMA E SCHEMAS / UPDATE SYSTEM AND SCHEMAS
# ======================================================================
function_update_system() {
    prompt_yes_no "$(t "Atualizar" "Update")" \
"$(t "Vou atualizar os pacotes do sistema e do Koha e aplicar as\nmigrações de banco.\n\nRecomendado: gere um backup antes.\n\nContinuar?" \
"System and Koha packages will be updated and database\nmigrations applied.\n\nRecommended: make a backup first.\n\nContinue?")" 13 74 || return 0
    clear
    if ! wait_for_apt_locks; then return 1; fi
    apt_update_indices
    if ! DEBIAN_FRONTEND=noninteractive apt-get upgrade "${APT_OPTS[@]}"; then
        restore_apt_timers
        msg_error "" "$(t "A atualização dos pacotes falhou. As migrações do Koha não serão executadas." "Package upgrade failed. Koha migrations will not run.")" 10 76
        return 1
    fi
    if is_koha_installed; then
        display_explanation "Aplicando migrações do banco..." "Applying database migrations..."
        if ! koha-upgrade-schema "$INSTANCE"; then
            restore_apt_timers
            msg_error "" "$(t "A migração do banco falhou. Os serviços não serão reiniciados automaticamente para evitar esconder o erro." "Database migration failed. Services will not be restarted automatically to avoid hiding the error.")" 11 78
            return 1
        fi
        if ! systemctl restart memcached apache2 koha-common >/dev/null 2>&1; then
            restore_apt_timers
            msg_error "" "$(t "Um dos serviços principais não reiniciou após a atualização." "One of the core services did not restart after the update.")" 9 72
            return 1
        fi
        if ! koha-plack --restart "$INSTANCE" >/dev/null 2>&1; then
            restore_apt_timers
            msg_error "" "$(t "O Plack não reiniciou após a atualização." "Plack did not restart after the update.")" 9 70
            return 1
        fi
        if [ "$(get_search_engine)" = "Elasticsearch" ]; then
            if ! manage_koha_indexers start; then
                restore_apt_timers
                msg_error "" "$(t "O indexador Elasticsearch não pôde ser iniciado após a atualização." "The Elasticsearch indexer could not be started after the update.")" 10 76
                return 1
            fi
        else
            if ! systemctl restart "koha-zebra-daemon@${INSTANCE}" >/dev/null 2>&1; then
                restore_apt_timers
                msg_error "" "$(t "O Zebra não pôde ser iniciado após a atualização." "Zebra could not be started after the update.")" 9 72
                return 1
            fi
        fi
    fi
    display_explanation "Limpando pacotes órfãos..." "Cleaning orphan packages..."
    apt-get clean -y >/dev/null 2>&1 || true
    DEBIAN_FRONTEND=noninteractive apt-get autoremove --purge -y >/dev/null 2>&1 || true
    journalctl --vacuum-time=14d >/dev/null 2>&1 || true
    restore_apt_timers
    if validate_complete_system "atualização do sistema"; then
        msg_ok "$(t "Atualização concluída sem erros críticos." "Update finished with no critical errors.")" 9 70
    else
        msg_info "$(t "Atualização com avisos" "Update with warnings")" "$(t "A atualização rodou, mas a validação achou $V_FAIL falha(s) e $V_WARN aviso(s).\n\nLog: $VALIDATION_LOG" "The update ran but validation found $V_FAIL failure(s) and $V_WARN warning(s).\n\nLog: $VALIDATION_LOG")" 11 76
        show_validation_report
        return 1
    fi
    return 0
}

# ======================================================================
# 22. VALIDAR SISTEMA COMPLETO / FULL SYSTEM VALIDATION
# ======================================================================
function_validate_system() {
    clear
    if validate_complete_system "validação manual"; then
        msg_ok "$(t "Nenhuma falha crítica.\n\nOK: $V_OK   Avisos: $V_WARN" "No critical failures.\n\nOK: $V_OK   Warnings: $V_WARN")" 10 70
    else
        msg_info "$(t "Problemas encontrados" "Issues found")" "$(t "Falhas: $V_FAIL   Avisos: $V_WARN   OK: $V_OK" "Failures: $V_FAIL   Warnings: $V_WARN   OK: $V_OK")" 10 70
    fi
    show_validation_report
}

