fi

if ! tar -czf "\$PACKAGE" -C "\$DIR" "\$(basename "\$BIB_FILE")" "\$(basename "\$AUTH_FILE")" 2>>"\$LOG"; then
    log_backup "FALHA: criacao do pacote MARC"
    rm -f "\$PACKAGE" "\$BIB_FILE" "\$AUTH_FILE"
