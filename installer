log "===== painel iniciado (v$PANEL_VERSION, usuario=$REAL_USER) ====="

# ======================================================================
# DEPENDÊNCIAS MÍNIMAS DO PRÓPRIO PAINEL (COM DIALOG)
# ======================================================================
# O painel pode precisar mexer no APT para instalar suas próprias dependências.
# Guardamos o estado real dos serviços antes de pará-los e restauramos somente
# o que estava ativo antes, inclusive se houver interrupção/erro precoce.
APT_TIMERS_STOPPED="no"
APT_DAILY_TIMER_WAS_ACTIVE="no"
APT_DAILY_UPGRADE_TIMER_WAS_ACTIVE="no"
APT_DAILY_SERVICE_WAS_ACTIVE="no"
APT_DAILY_UPGRADE_SERVICE_WAS_ACTIVE="no"
APT_STATE_SAVED="no"

save_and_stop_apt_services() {
    [ "$APT_STATE_SAVED" = "yes" ] && return 0

    APT_DAILY_TIMER_WAS_ACTIVE="no"
    APT_DAILY_UPGRADE_TIMER_WAS_ACTIVE="no"
    APT_DAILY_SERVICE_WAS_ACTIVE="no"
    APT_DAILY_UPGRADE_SERVICE_WAS_ACTIVE="no"

    systemctl is-active --quiet apt-daily.timer && APT_DAILY_TIMER_WAS_ACTIVE="yes"
    systemctl is-active --quiet apt-daily-upgrade.timer && APT_DAILY_UPGRADE_TIMER_WAS_ACTIVE="yes"
    systemctl is-active --quiet apt-daily.service && APT_DAILY_SERVICE_WAS_ACTIVE="yes"
    systemctl is-active --quiet apt-daily-upgrade.service && APT_DAILY_UPGRADE_SERVICE_WAS_ACTIVE="yes"

    systemctl stop apt-daily.timer apt-daily-upgrade.timer apt-daily.service apt-daily-upgrade.service >/dev/null 2>&1 || true
    APT_TIMERS_STOPPED="yes"
    APT_STATE_SAVED="yes"
}

restore_apt_timers() {
    [ "$APT_TIMERS_STOPPED" = "yes" ] || return 0

    if [ "$APT_DAILY_TIMER_WAS_ACTIVE" = "yes" ]; then
        systemctl start apt-daily.timer >/dev/null 2>&1 || true
    fi
    if [ "$APT_DAILY_UPGRADE_TIMER_WAS_ACTIVE" = "yes" ]; then
        systemctl start apt-daily-upgrade.timer >/dev/null 2>&1 || true
    fi
    if [ "$APT_DAILY_SERVICE_WAS_ACTIVE" = "yes" ]; then
        systemctl start apt-daily.service >/dev/null 2>&1 || true
    fi
    if [ "$APT_DAILY_UPGRADE_SERVICE_WAS_ACTIVE" = "yes" ]; then
        systemctl start apt-daily-upgrade.service >/dev/null 2>&1 || true
    fi

    APT_TIMERS_STOPPED="no"
    APT_STATE_SAVED="no"
}

on_exit() {
    restore_apt_timers
    flock -u 8 2>/dev/null || true
    log "===== painel encerrado ====="
}
trap on_exit EXIT
trap 'echo ""; echo "$(t "Interrompido pelo usuário." "Interrupted by user." "Interrumpido por el usuario.")"; exit 130' INT TERM

save_and_stop_apt_services
if command -v fuser >/dev/null 2>&1; then
    initial_wait=0
    while fuser /var/lib/dpkg/lock-frontend >/dev/null 2>&1 || \
          fuser /var/lib/dpkg/lock >/dev/null 2>&1 || \
          fuser /var/lib/apt/lists/lock >/dev/null 2>&1; do
        sleep 2
        initial_wait=$((initial_wait + 2))
        if [ "$initial_wait" -ge 120 ]; then
            echo "$(t "O APT/DPKG continua ocupado após 2 minutos. Abortando com segurança." "APT/DPKG is still busy after 2 minutes. Aborting safely." "APT/DPKG continúa ocupado después de 2 minutos. La operación se cancelará de forma segura.")"
            restore_apt_timers
            exit 1
        fi
    done
fi
# ======================================================================
# INSTALAÇÃO SEGURA DAS DEPENDÊNCIAS DO PAINEL
# ======================================================================
save_and_stop_apt_services

# 1. Libera travas pendentes do APT/DPKG
if command -v fuser >/dev/null 2>&1; then
    for lock in /var/lib/dpkg/lock-frontend /var/lib/dpkg/lock /var/lib/apt/lists/lock; do
        fuser -k "$lock" >/dev/null 2>&1 || true
    done
fi
dpkg --configure -a >/dev/null 2>&1 || true

# 2. Sincroniza o relógio antes de tocar nos repositórios
if command -v timedatectl >/dev/null 2>&1; then
    timedatectl set-ntp true >/dev/null 2>&1 || true
    systemctl restart systemd-timesyncd >/dev/null 2>&1 || true
fi

# 3. Detecta dependências faltantes
deps_to_install=()
for dep in dialog curl python3 unzip psmisc; do
    if ! command -v "$dep" >/dev/null 2>&1; then
        deps_to_install+=("$dep")
    fi
done

# 4. Instala com flags defensivas caso falte algum pacote
if [ ${#deps_to_install[@]} -gt 0 ]; then
    echo ""
    echo "Instalando dependências essenciais: ${deps_to_install[*]}..."
    echo ""

    apt-get update -y -o Acquire::ForceIPv4=true -o Acquire::Check-Valid-Until=false || true

    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        -o Acquire::Check-Valid-Until=false "${deps_to_install[@]}" || true
fi

restore_apt_timers
# ======================================================================
# LIMPEZA AO SAIR / CLEANUP ON EXIT
# ======================================================================
# O trap foi instalado antes do bloco APT acima para que interrupções precoces
# também restaurem corretamente o estado original dos serviços.

