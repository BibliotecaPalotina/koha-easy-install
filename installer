# ======================================================================
# 24. RESOURCE MONITORING (HTOP/NETHOGS)
# ======================================================================
function_run_monitor() {
    if ! command -v htop >/dev/null 2>&1 || ! command -v nethogs >/dev/null 2>&1; then
        whiptail --title "$(t "Installing")" --infobox "$(t "Please wait, installing telemetry tools (htop and nethogs)...")" 8 70
        apt-get update -qq && apt-get install -y htop nethogs -qq
    fi
    local opc
    opc=$(whiptail --title "$(t "Resource Monitoring")" \
        --menu "$(t "Choose the real-time tool:\n\n(Press 'F10' or 'Q' to exit the screen and return to the panel)")" 14 76 2 \
        "1" "$(t "Htop (CPU, RAM and Active Processes usage)")" \
        "2" "$(t "Nethogs (Network Bandwidth usage by Process)")" \
        3>&1 1>&2 2>&3) || return 0

    if [ "$opc" = "1" ]; then
        htop
    elif [ "$opc" = "2" ]; then
        local iface
        iface=$(ip route | awk '/default/ {print $5}')
