}
msg_error() {
    log "ERRO: $2"
    dialog --title "$(t "Erro" "Error")" --msgbox "$2" "${3:-14}" "${4:-78}" 2>/dev/null || true
}
msg_ok() {
    dialog --title "$(t "Sucesso" "Success")" --msgbox "$1" "${2:-10}" "${3:-74}" 2>/dev/null || true
}
prompt_yes_no() {
    dialog --title "$1" --yesno "$2" "${3:-12}" "${4:-74}" 2>/dev/null
}

run_with_dialog() {
    local title="$1"
    local desc="$2"
    local log_temp="/tmp/koha_action_err.log"
    local rc
    local err_msg
    shift 2

    if [ "$#" -eq 0 ]; then
        msg_error "$title" \
            "$(t "Nenhum comando foi informado para: $desc" "No command was supplied for: $desc")" \
            10 74
        return 2
    fi

    : > "$log_temp"
    "$@" >"$log_temp" 2>&1
    rc=$?

    if [ "$rc" -ne 0 ]; then
        err_msg=$(tail -n 20 "$log_temp" 2>/dev/null)
        msg_error "$title" \
            "$(t "Falha em: $desc\n\nCódigo de saída: $rc\n\nDetalhes:\n$err_msg" \
                "Failed during: $desc\n\nExit code: $rc\n\nDetails:\n$err_msg")" \
            20 82
        log "FALHA: $desc (rc=$rc)"
        log "Detalhes: $err_msg"
        rm -f "$log_temp"
        return "$rc"
    fi

    rm -f "$log_temp"
    return 0
}

